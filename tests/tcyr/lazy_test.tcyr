# lazy_test.tcyr — the lazy registry (src/lazy.cyr) against stub detectors.
# Every stub emits one profile of its backend's accelerator type and counts
# its calls; detect_apple emits two (Metal GPU + Neural Engine), because it is
# the one backend whose profiles span two families. A lazy query for a family
# must return what full detection returns for that family, and no backend may
# run twice however the families are queried. The CUDA stub also pushes a
# warning, and the Gaudi stub one when it may exec, and the post-pass stubs
# count their calls (2.5.2).

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/assert.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/fs.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/thread.cyr"

include "lib/sakshi.cyr"
include "src/log.cyr"
include "src/units.cyr"
include "src/error.cyr"
include "src/types.cyr"
include "src/quantization.cyr"
include "src/profile.cyr"
include "src/system_io.cyr"

# --- Stub detectors ---

# Per-backend call counters, indexed by backend id (alloc'd in the runner).
var _calls = 0;

fn _stub(profiles, backend, atype) {
    store64(_calls + backend * 8, load64(_calls + backend * 8) + 1);
    vec_push(profiles, profile_new(atype, 0, BYTES_PER_GIB));
    return 0;
}

fn detect_cuda(p, w) {
    vec_push(w, warning_parse("cuda", "bad line"));
    return _stub(p, BACKEND_CUDA, ACCEL_CUDA);
}
fn detect_rocm(p, w) { return _stub(p, BACKEND_ROCM, ACCEL_ROCM); }
# When _vk_moltenvk is 1 the Vulkan stub reports what MoltenVK does on a Mac:
# the Metal GPU again, as an integrated GPU on system RAM.
var _vk_moltenvk = 0;

fn detect_vulkan_opts(p, w, a, l) {
    _stub(p, BACKEND_VULKAN, ACCEL_VULKAN);
    if (_vk_moltenvk == 1) {
        var v = vec_get(p, vec_len(p) - 1);
        profile_set_shared_mem(v, profile_memory_bytes(v));
    }
    return 0;
}
fn detect_intel_npu(p, w) { return _stub(p, BACKEND_INTEL_NPU, ACCEL_INTEL_NPU); }
fn detect_amd_xdna(p, w) { return _stub(p, BACKEND_AMD_XDNA, ACCEL_AMD_XDNA); }
fn detect_tpu(p, w) { return _stub(p, BACKEND_TPU, ACCEL_TPU); }
# The Gaudi and Neuron stubs keep the last allow_exec they were given, as the
# Apple stub does; the Gaudi one looks for hl-smi only with exec.
var _gaudi_exec = 0 - 1;
var _neuron_exec = 0 - 1;

fn detect_gaudi_opts(p, w, a) {
    _gaudi_exec = a;
    if (a == 1) { vec_push(w, warning_tool_not_found("hl-smi")); }
    return _stub(p, BACKEND_GAUDI, ACCEL_GAUDI);
}
fn detect_neuron_opts(p, w, a) {
    _neuron_exec = a;
    return _stub(p, BACKEND_NEURON, ACCEL_NEURON);
}
fn detect_intel_oneapi(p, w) { return _stub(p, BACKEND_INTEL_ONEAPI, ACCEL_INTEL_ONEAPI); }
fn detect_qualcomm(p, w) { return _stub(p, BACKEND_QUALCOMM, ACCEL_QUALCOMM); }
fn detect_cerebras_opts(p, w, a) { return _stub(p, BACKEND_CEREBRAS, ACCEL_CEREBRAS); }
fn detect_graphcore_opts(p, w, a) { return _stub(p, BACKEND_GRAPHCORE, ACCEL_GRAPHCORE); }
fn detect_groq(p, w) { return _stub(p, BACKEND_GROQ, ACCEL_GROQ); }
fn detect_samsung_npu(p, w) { return _stub(p, BACKEND_SAMSUNG_NPU, ACCEL_SAMSUNG_NPU); }
fn detect_mediatek_apu(p, w) { return _stub(p, BACKEND_MEDIATEK_APU, ACCEL_MEDIATEK_APU); }

# Apple Silicon: the Metal GPU and the Neural Engine, from one probe. The
# registry calls the allow_exec-aware entry point; _apple_exec keeps the last
# allow_exec it was given.
var _apple_exec = 0 - 1;

fn detect_apple_opts(p, w, a) {
    _apple_exec = a;
    _stub(p, BACKEND_APPLE, ACCEL_METAL);
    vec_push(p, profile_new(ACCEL_APPLE_NPU, 0, 4 * BYTES_PER_GIB));
    return 0;
}

fn enrich_bandwidth(p) { return 0; }
fn enrich_pcie(p) { return 0; }

# Counts, in numa_node, how often each accelerator profile is enriched.
fn enrich_numa(p) {
    var n = vec_len(p);
    var i = 0;
    while (i < n) {
        var q = vec_get(p, i);
        i = i + 1;
        if (profile_accel_type(q) == ACCEL_CPU) { continue; }
        if (profile_numa_node(q) == PROFILE_NONE) { profile_set_numa_node(q, 1); }
        else { profile_set_numa_node(q, profile_numa_node(q) + 1); }
    }
    return 0;
}

# Calls of the system passes and of the system-memory read.
var _ic_calls = 0;
var _storage_calls = 0;
var _env_calls = 0;
var _mem_calls = 0;

# When _ic_timeout is 1 the interconnect stub reports what a hung
# `nvidia-smi nvlink -s` leaves: a deadline kill.
var _ic_timeout = 0;

fn detect_interconnects_opts(s, p, w, x) {
    _ic_calls = _ic_calls + 1;
    if (_ic_timeout == 1) { vec_push(w, warning_timeout("nvidia-smi", 10000)); }
    return 0;
}
fn detect_storage(s) { _storage_calls = _storage_calls + 1; return 0; }
fn detect_environment(s) { _env_calls = _env_calls + 1; return 0; }
fn detect_system_memory() { _mem_calls = _mem_calls + 1; return 16 * BYTES_PER_GIB; }
fn detect_system_memory_opts(a) { _mem_calls = _mem_calls + 1; return 16 * BYTES_PER_GIB; }

include "src/registry.cyr"
include "src/lazy.cyr"

fn _reset_calls() {
    memset(_calls, 0, 8 * AIHW_BACKEND_COUNT);
    _ic_calls = 0;
    _storage_calls = 0;
    _env_calls = 0;
    _mem_calls = 0;
    return 0;
}

fn _system_pass_calls() { return _ic_calls + _storage_calls + _env_calls; }

# Warnings in `v` with this code and tool.
fn _count_warning(v, code, tool) {
    var n = vec_len(v);
    var c = 0;
    var i = 0;
    while (i < n) {
        var w = vec_get(v, i);
        if (warning_code(w) == code && streq(warning_tool(w), tool) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn _calls_of(backend) { return load64(_calls + backend * 8); }

# Profiles of accelerator type `t` in vec `v`.
fn _count_type(v, t) {
    var n = vec_len(v);
    var c = 0;
    var i = 0;
    while (i < n) {
        if (profile_accel_type(vec_get(v, i)) == t) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# --- Family masks ---

# Each family mask holds every backend that can emit that family's profiles.
# Apple is the one backend in two masks (GPU + NPU); every other pair of
# masks is disjoint, and together they reach every backend with a detector.
fn test_family_masks() {
    var gpu = _family_builder_mask(FAMILY_GPU);
    var npu = _family_builder_mask(FAMILY_NPU);
    var tpu = _family_builder_mask(FAMILY_TPU);
    var asic = _family_builder_mask(FAMILY_AI_ASIC);
    assert_eq(builder_is_enabled(gpu, BACKEND_CUDA), 1, "gpu mask: cuda");
    assert_eq(builder_is_enabled(gpu, BACKEND_ROCM), 1, "gpu mask: rocm");
    assert_eq(builder_is_enabled(gpu, BACKEND_VULKAN), 1, "gpu mask: vulkan");
    assert_eq(builder_is_enabled(gpu, BACKEND_APPLE), 1, "gpu mask: apple");
    assert_eq(builder_is_enabled(gpu, BACKEND_INTEL_ONEAPI), 1, "gpu mask: oneapi");
    assert_eq(builder_is_enabled(gpu, BACKEND_WINDOWS), 1, "gpu mask: windows");
    assert_eq(builder_is_enabled(npu, BACKEND_APPLE), 1, "npu mask: apple");
    assert_eq(gpu & npu, 1 << BACKEND_APPLE, "gpu/npu share only apple");
    assert_eq(gpu & tpu, 0, "gpu/tpu disjoint");
    assert_eq(gpu & asic, 0, "gpu/asic disjoint");
    assert_eq(npu & tpu, 0, "npu/tpu disjoint");
    assert_eq(npu & asic, 0, "npu/asic disjoint");
    assert_eq(tpu & asic, 0, "tpu/asic disjoint");
    # AGNOS_GPU is a reserved backend id with no detector yet.
    var all = builder_without(builder_all(), BACKEND_AGNOS_GPU);
    assert_eq(gpu | npu | tpu | asic, all, "every detector reachable lazily");
    return 0;
}

# --- Lazy queries ---

# The 2.3.25 gap: an NPU query on a fresh lazy registry never ran the Apple
# backend, so the Neural Engine was missing. A GPU query afterwards must not
# run Apple again (its Metal profile arrived with the NPU probe).
fn test_npu_first_finds_neural_engine() {
    _reset_calls();
    var lr = lazy_new();
    var npus = lazy_by_family(lr, FAMILY_NPU);
    assert_eq(_count_type(npus, ACCEL_APPLE_NPU), 1, "npu first: neural engine");
    assert_eq(_count_type(npus, ACCEL_INTEL_NPU), 1, "npu first: intel npu");
    assert_eq(_calls_of(BACKEND_APPLE), 1, "npu first: apple ran once");
    var gpus = lazy_by_family(lr, FAMILY_GPU);
    assert_eq(_count_type(gpus, ACCEL_METAL), 1, "then gpu: metal");
    assert_eq(_calls_of(BACKEND_APPLE), 1, "then gpu: apple not rerun");
    var all = lazy_probed_profiles(lr);
    assert_eq(_count_type(all, ACCEL_METAL), 1, "one metal profile");
    assert_eq(_count_type(all, ACCEL_APPLE_NPU), 1, "one neural engine profile");
    return 0;
}

fn test_gpu_first_then_npu() {
    _reset_calls();
    var lr = lazy_new();
    var gpus = lazy_by_family(lr, FAMILY_GPU);
    assert_eq(_count_type(gpus, ACCEL_METAL), 1, "gpu first: metal");
    var npus = lazy_by_family(lr, FAMILY_NPU);
    assert_eq(_count_type(npus, ACCEL_APPLE_NPU), 1, "then npu: neural engine");
    assert_eq(_calls_of(BACKEND_APPLE), 1, "gpu then npu: apple ran once");
    var all = lazy_probed_profiles(lr);
    assert_eq(_count_type(all, ACCEL_APPLE_NPU), 1, "gpu then npu: no duplicate");
    return 0;
}

# For every family, a query on a fresh lazy registry returns the same
# profiles, by accelerator type, as full detection filtered to that family.
fn test_family_query_matches_full_detection() {
    _reset_calls();
    var full = reg_profiles(registry_detect());
    var fam = FAMILY_GPU;
    while (fam <= FAMILY_AI_ASIC) {
        var got = lazy_by_family(lazy_new(), fam);
        var mismatches = 0;
        var t = 0;
        while (t < ACCEL_TYPE_COUNT) {
            if (t != ACCEL_CPU) {
                if (accel_family(t) == fam) {
                    if (_count_type(got, t) != _count_type(full, t)) { mismatches = mismatches + 1; }
                }
            }
            t = t + 1;
        }
        assert_eq(mismatches, 0, family_name(fam));
        fam = fam + 1;
    }
    return 0;
}

# A family query runs only that family's backends: a TPU query must not
# start the GPU tools (the reason the lazy registry exists).
fn test_tpu_query_runs_only_tpu() {
    _reset_calls();
    var tpus = lazy_by_family(lazy_new(), FAMILY_TPU);
    assert_eq(_count_type(tpus, ACCEL_TPU), 1, "tpu found");
    var others = 0;
    var b = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (b != BACKEND_TPU) { others = others + _calls_of(b); }
        b = b + 1;
    }
    assert_eq(others, 0, "tpu query ran no other backend");
    return 0;
}

# Probing everything runs each backend exactly once and yields exactly the
# profiles full detection yields.
# One device seen by two families' probes (2.4.0): an NPU query runs Apple
# (Metal + Neural Engine), a later GPU query runs Vulkan, whose MoltenVK view
# of the same GPU arrives in another partial registry. The lazy list drops it
# on merge, so the GPU query and the full registry hold one Metal GPU.
fn test_lazy_dedup_across_families() {
    _vk_moltenvk = 1;
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_NPU);
    var gpus = lazy_by_family(lr, FAMILY_GPU);
    assert_eq(_count_type(gpus, ACCEL_METAL), 1, "lazy: metal");
    assert_eq(_count_type(gpus, ACCEL_VULKAN), 0, "lazy: moltenvk view dropped");
    var all = reg_profiles(lazy_into_registry(lr));
    assert_eq(_count_type(all, ACCEL_VULKAN), 0, "lazy registry: moltenvk view dropped");
    _vk_moltenvk = 0;
    return 0;
}

fn test_into_registry_runs_each_backend_once() {
    _reset_calls();
    var full = reg_profiles(registry_detect());
    _reset_calls();
    var lazy_all = reg_profiles(lazy_into_registry(lazy_new()));
    var reruns = 0;
    var b = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (_calls_of(b) > 1) { reruns = reruns + 1; }
        b = b + 1;
    }
    assert_eq(reruns, 0, "no backend ran twice");
    assert_eq(_calls_of(BACKEND_APPLE), 1, "apple ran once");
    assert_eq(vec_len(lazy_all), vec_len(full), "same profile count as full detection");
    var mismatches = 0;
    var t = 0;
    while (t < ACCEL_TYPE_COUNT) {
        if (_count_type(lazy_all, t) != _count_type(full, t)) { mismatches = mismatches + 1; }
        t = t + 1;
    }
    assert_eq(mismatches, 0, "same profiles by type as full detection");
    return 0;
}

# --- A probe runs its family's detectors and nothing else (2.5.2) ---

# Through 2.5.1 each probe was a full registry_detect_with: it read system
# memory for a CPU profile it then dropped, and ran the system passes, whose
# interconnect pass runs `nvidia-smi nvlink -s`.
fn test_probe_runs_no_system_pass() {
    var fam = FAMILY_GPU;
    while (fam <= FAMILY_AI_ASIC) {
        var lr = lazy_new();
        _reset_calls();
        lazy_by_family(lr, fam);
        assert_eq(_system_pass_calls(), 0, family_name(fam));
        assert_eq(_mem_calls, 0, family_name(fam));
        fam = fam + 1;
    }
    return 0;
}

# lazy_into_registry runs each system pass once, after any queries before it.
fn test_into_registry_system_passes_once() {
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_GPU);
    lazy_by_family(lr, FAMILY_AI_ASIC);
    _reset_calls();
    lazy_into_registry(lr);
    assert_eq(_ic_calls, 1, "interconnects once");
    assert_eq(_storage_calls, 1, "storage once");
    assert_eq(_env_calls, 1, "environment once");
    _reset_calls();
    lazy_into_registry(lazy_new());
    assert_eq(_system_pass_calls(), 3, "fresh registry: each system pass once");
    return 0;
}

# Every accelerator profile is enriched once, however the families are
# queried; through 2.5.1 the probe's post-passes and lazy_into_registry's
# both enriched it.
fn test_enriched_once() {
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_NPU);
    var all = reg_profiles(lazy_into_registry(lr));
    var wrong = 0;
    var accels = 0;
    var i = 0;
    while (i < vec_len(all)) {
        var p = vec_get(all, i);
        i = i + 1;
        if (profile_accel_type(p) == ACCEL_CPU) { continue; }
        accels = accels + 1;
        if (profile_numa_node(p) != 1) { wrong = wrong + 1; }
    }
    assert(accels > 0, "accelerators found");
    assert_eq(wrong, 0, "each accelerator enriched once");
    return 0;
}

# The Neural Engine and the Metal GPU come from one Apple probe. When the NPU
# family is asked first, that probe must still allow exec (the system_profiler
# fallback), or the GPU family loses what registry_detect finds.
fn test_npu_first_apple_allows_exec() {
    _apple_exec = 0 - 1;
    lazy_by_family(lazy_new(), FAMILY_NPU);
    assert_eq(_apple_exec, 1, "npu first: apple with exec");
    _apple_exec = 0 - 1;
    lazy_by_family(lazy_new(), FAMILY_GPU);
    assert_eq(_apple_exec, 1, "gpu first: apple with exec");
    return 0;
}

# The probes' warnings are kept: in lazy_warnings after a query, and in the
# registry lazy_into_registry returns, as in registry_detect's. Through 2.5.1
# lazy_into_registry's registry had none of them.
fn test_warnings_kept() {
    var full = reg_warnings(registry_detect());
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_GPU);
    assert_eq(_count_warning(lazy_warnings(lr), HWA_ERR_PARSE, "cuda"), 1, "gpu query: cuda warning");
    assert_eq(_count_warning(lazy_warnings(lr), HWA_ERR_TOOL_NOT_FOUND, "hl-smi"), 0, "gpu query: no asic warning");
    var rw = reg_warnings(lazy_into_registry(lr));
    assert_eq(vec_len(rw), vec_len(full), "as many warnings as registry_detect");
    assert_eq(_count_warning(rw, HWA_ERR_PARSE, "cuda"), 1, "registry: cuda warning");
    assert_eq(_count_warning(rw, HWA_ERR_TOOL_NOT_FOUND, "hl-smi"), 1, "registry: gaudi warning");
    var again = reg_warnings(lazy_into_registry(lr));
    assert_eq(vec_len(again), vec_len(full), "second registry: not doubled");
    return 0;
}

# lazy_into_registry logs its system pass's warnings, as registry_detect does
# (2.5.5): a hung `nvidia-smi nvlink -s` was a WARN line from registry_detect
# and silent from the lazy registry. Every family is probed first, so the
# CUDA stub's parse warning is logged before the ring is cleared.
fn test_into_registry_logs_system_pass() {
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_GPU);
    lazy_by_family(lr, FAMILY_NPU);
    lazy_by_family(lr, FAMILY_TPU);
    lazy_by_family(lr, FAMILY_AI_ASIC);
    var lvl = sakshi_get_level();
    sakshi_set_level(SK_WARN);
    sakshi_output_buffer();
    sakshi_ring_clear();
    _ic_timeout = 1;
    lazy_into_registry(lr);
    var n_lazy = sakshi_ring_event_count();
    sakshi_ring_clear();
    registry_detect();
    var n_full = sakshi_ring_event_count();
    _ic_timeout = 0;
    sakshi_set_output(SK_OUT_STDERR);
    sakshi_set_level(lvl);
    assert_eq(n_lazy, 1, "lazy: the nvlink timeout logged");
    assert_eq(n_full, 2, "registry_detect: the cuda parse warning and the nvlink timeout logged");
    return 0;
}

# --- No-exec detection finds Gaudi and Neuron (2.5.5) ---

# Through 2.5.4 a no-exec mask dropped both backends, so registry_detect_no_exec
# found neither the habanalabs nodes nor /dev/neuron<N>. They run now, told
# not to exec; registry_detect still lets them.
fn test_no_exec_finds_gaudi_neuron() {
    _reset_calls();
    _gaudi_exec = 0 - 1;
    _neuron_exec = 0 - 1;
    var r = registry_detect_no_exec();
    var p = reg_profiles(r);
    assert_eq(_count_type(p, ACCEL_GAUDI), 1, "no_exec: Gaudi found");
    assert_eq(_count_type(p, ACCEL_NEURON), 1, "no_exec: Neuron found");
    assert_eq(_gaudi_exec, 0, "no_exec: Gaudi told not to exec");
    assert_eq(_neuron_exec, 0, "no_exec: Neuron told not to exec");
    assert_eq(_count_warning(reg_warnings(r), HWA_ERR_TOOL_NOT_FOUND, "hl-smi"), 0, "no_exec: hl-smi not looked for");
    assert_eq(_calls_of(BACKEND_CUDA), 0, "no_exec: CUDA still masked out");
    registry_detect();
    assert_eq(_gaudi_exec, 1, "registry_detect: Gaudi may exec");
    assert_eq(_neuron_exec, 1, "registry_detect: Neuron may exec");
    # A selective mask of them runs their tools, as through 2.5.4; only
    # with_opts(mask, 0) holds them to their device nodes.
    var mask = builder_with(builder_none(), BACKEND_NEURON);
    _neuron_exec = 0 - 1;
    var only = reg_profiles(registry_detect_with(mask));
    assert_eq(_count_type(only, ACCEL_NEURON), 1, "a Neuron-only mask: Neuron found");
    assert_eq(_neuron_exec, 1, "a Neuron-only mask may run neuron-ls, as in 2.5.4");
    _gaudi_exec = 0 - 1;
    _apple_exec = 0 - 1;
    registry_detect_with(builder_without(builder_without(builder_all(), BACKEND_CUDA), BACKEND_INTEL_ONEAPI));
    assert_eq(_gaudi_exec, 1, "all but CUDA and oneAPI: Gaudi may run hl-smi");
    assert_eq(_apple_exec, 1, "all but CUDA and oneAPI: Apple may run system_profiler");
    _neuron_exec = 0 - 1;
    var held = reg_profiles(registry_detect_with_opts(mask, 0));
    assert_eq(_count_type(held, ACCEL_NEURON), 1, "with_opts(mask, 0): Neuron found");
    assert_eq(_neuron_exec, 0, "with_opts(mask, 0): Neuron told not to exec");
    # with_opts(all, 0) strips the backends that need a tool before dispatch,
    # whatever the caller's mask holds.
    _reset_calls();
    registry_detect_with_opts(builder_all(), 0);
    assert_eq(_calls_of(BACKEND_CUDA), 0, "with_opts(all, 0): CUDA stripped");
    assert_eq(_calls_of(BACKEND_INTEL_ONEAPI), 0, "with_opts(all, 0): oneAPI stripped");
    assert_eq(_calls_of(BACKEND_ROCM), 1, "with_opts(all, 0): ROCm kept");
    return 0;
}

# --- What a lazy registry hands out is a copy (2.5.5) ---

# Through 2.5.4 lazy_probed_profiles and lazy_warnings returned the live vecs,
# which a later probe grows and compacts in place (profiles_dedup), so a
# reader on another thread could index past a vec_truncate.
fn test_probed_profiles_is_snapshot() {
    _vk_moltenvk = 1;
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_NPU);
    var snap = lazy_probed_profiles(lr);
    var n0 = vec_len(snap);
    lazy_by_family(lr, FAMILY_GPU);
    assert_eq(vec_len(snap), n0, "probed_profiles: a snapshot, not the live list");
    assert(vec_len(lazy_probed_profiles(lr)) > n0, "probed_profiles: a new call sees the GPU probe");
    var mine = lazy_probed_profiles(lr);
    var n1 = vec_len(mine);
    vec_push(mine, profile_cpu(BYTES_PER_GIB));
    assert_eq(vec_len(lazy_probed_profiles(lr)), n1, "probed_profiles: the caller's pushes stay its own");
    _vk_moltenvk = 0;
    return 0;
}

fn test_warnings_is_snapshot() {
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_GPU);
    var ws = lazy_warnings(lr);
    var w0 = vec_len(ws);
    lazy_by_family(lr, FAMILY_AI_ASIC);
    assert_eq(vec_len(ws), w0, "warnings: a snapshot, unchanged by a later query");
    assert_eq(vec_len(lazy_warnings(lr)), w0 + 1, "warnings: a new call has the ASIC probe's");
    return 0;
}

# A reader walking snapshots while another thread probes: every snapshot is
# whole and stays as it was taken (no Vulkan view the dedup drops, no length
# that moves under the reader). The reader walks each snapshot many times,
# so a probe can land mid-walk.
var _cc_lr = 0;
var _cc_done = 0;

fn _gpu_prober(arg) {
    lazy_by_family(_cc_lr, FAMILY_GPU);
    atomic_store(&_cc_done, 1);
    return 0;
}

fn test_lazy_concurrent_readers() {
    _vk_moltenvk = 1;
    var bad = 0;
    var runs = 0;
    while (runs < 100) {
        _cc_lr = lazy_new();
        lazy_by_family(_cc_lr, FAMILY_NPU);
        atomic_store(&_cc_done, 0);
        var t = thread_create(&_gpu_prober, 0);
        if (t == 0) { _gpu_prober(0); }
        var cap = 0;
        while (atomic_load(&_cc_done) == 0 && cap < 100000) {
            var snap = lazy_probed_profiles(_cc_lr);
            var n = vec_len(snap);
            var k = 0;
            while (k < 50) {
                if (_count_type(snap, ACCEL_VULKAN) != 0) { bad = bad + 1; }
                k = k + 1;
            }
            if (vec_len(snap) != n) { bad = bad + 1; }
            cap = cap + 1;
        }
        if (t != 0) { thread_join(t); }
        runs = runs + 1;
    }
    assert_eq(bad, 0, "concurrent probe: every snapshot whole");
    _vk_moltenvk = 0;
    return 0;
}

# --- Family bits and repeat queries (2.5.5) ---

# The probed bit is a shift, guarded: a family past bit 63 is never probed
# and marks nothing (an unguarded 1 << 70 wraps to bit 6).
fn test_family_bits() {
    var lr = lazy_new();
    assert_eq(_lazy_is_probed(lr, FAMILY_CPU), 1, "bits: CPU probed at start");
    assert_eq(_lazy_is_probed(lr, FAMILY_GPU), 0, "bits: GPU not yet");
    lazy_by_family(lr, FAMILY_GPU);
    assert_eq(_lazy_is_probed(lr, FAMILY_GPU), 1, "bits: GPU after its query");
    assert_eq(lazy_probed(lr), 3, "bits: CPU and GPU only");
    _lazy_mark_probed(lr, 70);
    assert_eq(lazy_probed(lr), 3, "bits: family 70 marks nothing");
    assert_eq(_lazy_is_probed(lr, 70), 0, "bits: family 70 never probed");
    _lazy_mark_probed(lr, 0 - 1);
    assert_eq(lazy_probed(lr), 3, "bits: a negative family marks nothing");
    assert_eq(vec_len(lazy_by_family(lr, 70)), 0, "bits: family 70 finds nothing");
    return 0;
}

# lazy_by_family_into refills the caller's vec under the lock: repeat
# queries allocate nothing; lazy_count_by_family counts what it returns.
fn test_by_family_into_bounded() {
    var lr = lazy_new();
    var out = vec_new();
    lazy_by_family_into(lr, FAMILY_GPU, out);
    var n = vec_len(out);
    assert(n > 0, "into: GPUs found");
    assert_eq(lazy_count_by_family(lr, FAMILY_GPU), n, "count: as many as into returns");
    var u0 = alloc_used();
    var i = 0;
    while (i < 1000) {
        lazy_by_family_into(lr, FAMILY_GPU, out);
        lazy_count_by_family(lr, FAMILY_GPU);
        i = i + 1;
    }
    assert_eq(alloc_used() - u0, 0, "into: 1000 repeat queries allocate nothing");
    assert_eq(vec_len(out), n, "into: the same GPUs");
    return 0;
}

# The getters' _into forms refill the caller's vec under the lock: repeat
# calls allocate nothing (each plain getter call allocates a vec), and what
# they hold is still a copy.
fn test_getters_into_bounded() {
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_GPU);
    lazy_by_family(lr, FAMILY_AI_ASIC);
    var wo = vec_new();
    var po = vec_new();
    lazy_warnings_into(lr, wo);
    lazy_probed_profiles_into(lr, po);
    var u0 = alloc_used();
    var i = 0;
    while (i < 1000) {
        lazy_warnings_into(lr, wo);
        lazy_probed_profiles_into(lr, po);
        i = i + 1;
    }
    assert_eq(alloc_used() - u0, 0, "getters into: 1000 repeat calls allocate nothing");
    assert_eq(vec_len(wo), vec_len(lazy_warnings(lr)), "warnings_into: the same warnings");
    var n = vec_len(lazy_probed_profiles(lr));
    assert_eq(vec_len(po), n, "probed_into: the same profiles");
    vec_push(po, profile_cpu(BYTES_PER_GIB));
    assert_eq(vec_len(lazy_probed_profiles(lr)), n, "probed_into: the caller's pushes stay its own");
    return 0;
}

# --- Run all tests ---

alloc_init();
_calls = alloc(8 * AIHW_BACKEND_COUNT);

test_family_masks();
test_npu_first_finds_neural_engine();
test_gpu_first_then_npu();
test_family_query_matches_full_detection();
test_tpu_query_runs_only_tpu();
test_into_registry_runs_each_backend_once();
test_lazy_dedup_across_families();
test_probe_runs_no_system_pass();
test_into_registry_system_passes_once();
test_enriched_once();
test_npu_first_apple_allows_exec();
test_warnings_kept();
test_into_registry_logs_system_pass();
test_no_exec_finds_gaudi_neuron();
test_probed_profiles_is_snapshot();
test_warnings_is_snapshot();
test_lazy_concurrent_readers();
test_family_bits();
test_by_family_into_bounded();
test_getters_into_bounded();

var fails = assert_summary();
syscall(60, fails);
