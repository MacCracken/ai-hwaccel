# --- Apple macOS output parsing ---

fn test_apple_macos_parse() {
    var hw = str_from("Hardware Overview:\n  Chip: Apple M4 Pro\n  Memory: 36 GB\n  Cores: 14\n");
    var profiles = vec_new();
    _parse_apple_macos(hw, profiles);

    assert_eq(vec_len(profiles), 2, "2 profiles (Metal + ANE)");

    var gpu = vec_get(profiles, 0);
    assert_eq(profile_accel_type(gpu), ACCEL_METAL, "Metal GPU");
    assert_eq(profile_memory_bytes(gpu) / BYTES_PER_GIB, 36, "36 GiB");
    assert(streq(profile_device_name(gpu), "Apple M4 Pro") == 1, "M4 Pro name");

    var ane = vec_get(profiles, 1);
    assert_eq(profile_accel_type(ane), ACCEL_APPLE_NPU, "Apple NPU");
    # M4 gets 8 GiB ANE estimate
    assert_eq(profile_memory_bytes(ane) / BYTES_PER_GIB, 8, "M4 ANE 8 GiB");
    return 0;
}

fn test_apple_m2_ane() {
    var hw = str_from("  Chip: Apple M2\n  Memory: 16 GB\n");
    var profiles = vec_new();
    _parse_apple_macos(hw, profiles);

    var ane = vec_get(profiles, 1);
    assert_eq(profile_memory_bytes(ane) / BYTES_PER_GIB, 6, "M2 ANE 6 GiB");
    return 0;
}

# An Intel Mac's system_profiler output has no `Chip:` line: no Metal GPU and
# no Neural Engine (2.5.1; through 2.5.0 both appeared, named "Apple Silicon"
# and sized by the Mac's RAM).
fn test_apple_intel_mac() {
    var hw = str_from("Hardware Overview:\n  Model Name: MacBook Pro\n  Processor Name: Quad-Core Intel Core i7\n  Processor Speed: 2.3 GHz\n  Memory: 32 GB\n");
    var profiles = vec_new();
    _parse_apple_macos(hw, profiles);
    assert_eq(vec_len(profiles), 0, "Intel Mac: no Apple GPU or ANE");
    return 0;
}

# --- Edge device defaults ---

fn test_edge_defaults() {
    # Qualcomm: 32 GiB
    var qp = profile_new(ACCEL_QUALCOMM, 0, 32 * BYTES_PER_GIB);
    assert_eq(profile_memory_bytes(qp) / BYTES_PER_GIB, 32, "Qualcomm 32 GiB");
    assert_eq(profile_family(qp), FAMILY_AI_ASIC, "Qualcomm = AI ASIC");

    # Samsung NPU: 2 GiB
    var sp = profile_new(ACCEL_SAMSUNG_NPU, 0, 2 * BYTES_PER_GIB);
    assert_eq(profile_memory_bytes(sp) / BYTES_PER_GIB, 2, "Samsung 2 GiB");
    assert_eq(profile_family(sp), FAMILY_NPU, "Samsung = NPU");

    # MediaTek: 2 GiB
    var mp = profile_new(ACCEL_MEDIATEK_APU, 0, 2 * BYTES_PER_GIB);
    assert_eq(profile_memory_bytes(mp) / BYTES_PER_GIB, 2, "MediaTek 2 GiB");
    assert_eq(profile_family(mp), FAMILY_NPU, "MediaTek = NPU");
    return 0;
}

# --- Cloud ASIC defaults ---

fn test_cloud_asic_defaults() {
    # Cerebras: 44 GiB
    var cp = profile_new(ACCEL_CEREBRAS, 0, 44 * BYTES_PER_GIB);
    assert_eq(profile_memory_bytes(cp) / BYTES_PER_GIB, 44, "Cerebras 44 GiB");
    assert_eq(profile_family(cp), FAMILY_AI_ASIC, "Cerebras = AI ASIC");
    assert_eq(accel_rank(ACCEL_CEREBRAS), 85, "Cerebras rank 85");

    # Graphcore: 900 MiB
    var gp = profile_new(ACCEL_GRAPHCORE, 0, 900 * 1024 * 1024);
    assert_eq(profile_memory_bytes(gp) / (1024 * 1024), 900, "Graphcore 900 MiB");
    assert_eq(profile_family(gp), FAMILY_AI_ASIC, "Graphcore = AI ASIC");

    # Groq: 230 MiB
    var grp = profile_new(ACCEL_GROQ, 0, 230 * 1024 * 1024);
    assert_eq(profile_memory_bytes(grp) / (1024 * 1024), 230, "Groq 230 MiB");
    assert_eq(profile_family(grp), FAMILY_AI_ASIC, "Groq = AI ASIC");
    assert_eq(groq_rank(), 55, "Groq rank 55");
    return 0;
}

# --- Intel profiles ---

fn test_intel_profiles() {
    # Intel NPU: 2 GiB, NPU family
    var inp = profile_new(ACCEL_INTEL_NPU, 0, 2 * BYTES_PER_GIB);
    assert_eq(profile_family(inp), FAMILY_NPU, "Intel NPU = NPU");
    assert_eq(accel_supports_training(ACCEL_INTEL_NPU), 0, "Intel NPU no train");

    # Intel oneAPI: GPU family
    var iop = profile_new(ACCEL_INTEL_ONEAPI, 0, 16 * BYTES_PER_GIB);
    assert_eq(profile_family(iop), FAMILY_GPU, "oneAPI = GPU");
    assert_eq(accel_supports_training(ACCEL_INTEL_ONEAPI), 1, "oneAPI trains");
    return 0;
}

# --- AMD XDNA ---

# --- xpu-smi discovery --dump (2.5.3) ---
# Inline output in the format Intel's XPU Manager V1.x user guide documents for
# `xpu-smi discovery --dump`: a header of property labels, then a CSV row per
# device, strings quoted. Not a capture from hardware.

fn test_xpu_smi_dump() {
    var out = str_from("Device ID,Device Name,Memory Physical Size,PCI Device ID\n0,\"Intel(R) Data Center GPU Max 1550\",\"131072.00 MiB\",\"0x0bd5\"\n1,\"Intel(R) Data Center GPU Max 1550\",\"131072.00 MiB\",\"0x0bd5\"\n");
    var profs = vec_new();
    var w = vec_new();
    assert_eq(parse_xpu_smi_dump(out, profs, w), 2, "max 1550 x2: two profiles");
    assert_eq(vec_len(w), 0, "max 1550 x2: no warning");
    var p = vec_get(profs, 1);
    assert_eq(profile_accel_type(p), ACCEL_INTEL_ONEAPI, "oneapi type");
    assert_eq(profile_device_id(p), 1, "device id from its column");
    assert_streq(profile_device_name(p), "Intel(R) Data Center GPU Max 1550", "name, unquoted");
    assert_eq(profile_memory_bytes(p), 128 * BYTES_PER_GIB, "131072 MiB");
    assert_eq(profile_pci_id(p), pci_id_make(0x8086, 0x0BD5), "pci_id 8086:0bd5");
    return 0;
}

# Columns are found by label, in any order; N/A falls back (16 GiB, row index);
# CRLF lines and a comma inside a quoted name parse.
fn test_xpu_smi_dump_order_and_gaps() {
    var out = str_from("Device Name,PCI Device ID,Device ID,Memory Physical Size\r\n\"Intel(R) Arc(TM) A770 Graphics\",\"0x56a0\",N/A,\"N/A\"\r\n\"Intel(R) Graphics, rev 2\",\"N/A\",3,\"16384.00 MiB\"\r\n");
    var profs = vec_new();
    assert_eq(parse_xpu_smi_dump(out, profs, vec_new()), 2, "reordered: two profiles");
    var a = vec_get(profs, 0);
    var b = vec_get(profs, 1);
    assert_streq(profile_device_name(a), "Intel(R) Arc(TM) A770 Graphics", "reordered: name");
    assert_eq(profile_pci_id(a), pci_id_make(0x8086, 0x56A0), "reordered: pci_id");
    assert_eq(profile_device_id(a), 0, "N/A device id: the row index");
    assert_eq(profile_memory_bytes(a), 16 * BYTES_PER_GIB, "N/A memory: 16 GiB");
    assert_streq(profile_device_name(b), "Intel(R) Graphics, rev 2", "quoted comma kept");
    assert_eq(profile_device_id(b), 3, "device id 3");
    assert_eq(profile_memory_bytes(b), 16 * BYTES_PER_GIB, "16384 MiB");
    assert_eq(profile_pci_id(b), 0, "N/A pci id: none");
    return 0;
}

# xpu-smi prints a service error with exit status 0: no profile, a warning.
# Empty output and a bare header (no device) are answers, not errors.
fn test_xpu_smi_dump_errors() {
    var w = vec_new();
    var profs = vec_new();
    assert_eq(parse_xpu_smi_dump(str_from("Error: XPUM Service Status Error. \n"), profs, w), 0, "service error: no profile");
    assert_eq(vec_len(w), 1, "service error: one warning");
    assert_eq(warning_code(vec_get(w, 0)), HWA_ERR_PARSE, "service error: a parse warning");
    var w2 = vec_new();
    assert_eq(parse_xpu_smi_dump(str_from(""), profs, w2), 0, "empty: no profile");
    assert_eq(parse_xpu_smi_dump(str_from("Device ID,Device Name,Memory Physical Size,PCI Device ID\n"), profs, w2), 0, "header only: no profile");
    assert_eq(vec_len(w2), 0, "empty, header only: no warning");
    assert_eq(vec_len(profs), 0, "nothing pushed");
    return 0;
}

# A line after the rows that is not a device row, such as a daemon message,
# pushes a parse warning; through 2.5.4 it became a nameless 16 GiB GPU
# (2.5.5). So does a row with neither a name nor a PCI Device ID.
fn test_xpu_smi_dump_not_a_row() {
    var hdr = "Device ID,Device Name,Memory Physical Size,PCI Device ID\n";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, hdr);
    str_builder_add_cstr(sb, "0,\"Intel(R) Arc(TM) A770 Graphics\",\"16288.00 MiB\",\"0x56a0\"\n");
    str_builder_add_cstr(sb, "Warning: the XPU Manager daemon is not running\n");
    var profs = vec_new();
    var w = vec_new();
    assert_eq(parse_xpu_smi_dump(str_builder_build(sb), profs, w), 1, "trailing message: one profile");
    assert_eq(vec_len(w), 1, "trailing message: one warning");
    if (vec_len(w) == 1) { assert_eq(warning_code(vec_get(w, 0)), HWA_ERR_PARSE, "trailing message: a parse warning"); }
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, hdr);
    str_builder_add_cstr(sb2, "1,N/A,\"8192.00 MiB\",N/A\n");
    var w2 = vec_new();
    assert_eq(parse_xpu_smi_dump(str_builder_build(sb2), vec_new(), w2), 0, "no name or PCI ID: no profile");
    assert_eq(vec_len(w2), 1, "no name or PCI ID: one warning");
    return 0;
}

# Memory Physical Size keeps its fraction (2.5.5: "0.50 GiB" fell back to 16).
fn test_xpu_memory_bytes() {
    assert_eq(_xpu_memory_bytes(str_from("16288.00 MiB")), 16288 * 1024 * 1024, "16288.00 MiB");
    assert_eq(_xpu_memory_bytes(str_from("0.50 GiB")), 512 * 1024 * 1024, "0.50 GiB");
    assert_eq(_xpu_memory_bytes(str_from("48.5 GiB")), 49664 * 1024 * 1024, "48.5 GiB");
    assert_eq(_xpu_memory_bytes(str_from("16384.00 GiB")), 16 * 1024 * BYTES_PER_GIB, "16 TiB: kept");
    assert_eq(_xpu_memory_bytes(str_from("16384.01 GiB")), 0, "past 16 TiB: 0");
    assert_eq(_xpu_memory_bytes(str_from("99999999999999 MiB")), 0, "huge: 0");
    assert_eq(_xpu_memory_bytes(str_from("N/A")), 0, "no number: 0");
    return 0;
}

# A run that failed is reported once, by its exit-status warning: its output
# is parsed without the parse warning its error text would add (2.5.5).
fn test_xpu_take_output() {
    var err = str_from("Error: XPUM Service Status Error. \n");
    var w = vec_new();
    assert_eq(xpu_take_output(err, 1, vec_new(), w), 0, "failed run: no profile");
    assert_eq(vec_len(w), 0, "failed run: no parse warning");
    var w2 = vec_new();
    assert_eq(xpu_take_output(err, 0, vec_new(), w2), 0, "exit 0: no profile");
    assert_eq(vec_len(w2), 1, "exit 0: the parse warning");
    var rsb = str_builder_new();
    str_builder_add_cstr(rsb, "Device ID,Device Name,Memory Physical Size,PCI Device ID\n");
    str_builder_add_cstr(rsb, "0,\"Intel(R) Arc(TM) A770 Graphics\",\"16288.00 MiB\",\"0x56a0\"\n");
    var rows = str_builder_build(rsb);
    assert_eq(xpu_take_output(rows, 1, vec_new(), vec_new()), 1, "failed run: rows still count");
    assert_eq(xpu_take_output(0, 0, vec_new(), w2), 0, "no output: nothing");
    return 0;
}

# --- Cloud ASIC memory (2.5.5) ---
# Through 2.5.4 the Cerebras and Graphcore lines were read for digits at their
# start only, so the defaults always applied.

fn test_asic_size_bytes() {
    var mib = 1024 * 1024;
    assert_eq(asic_size_bytes(str_from("Memory: 40 GB"), BYTES_PER_GIB), 40 * BYTES_PER_GIB, "Memory: 40 GB");
    assert_eq(asic_size_bytes(str_from("  memory: 1800 MB"), mib), 1800 * mib, "memory: 1800 MB");
    assert_eq(asic_size_bytes(str_from("SRAM: 0.5 GiB"), mib), 512 * mib, "SRAM: 0.5 GiB");
    assert_eq(asic_size_bytes(str_from("Memory: 900MiB (on-chip)"), mib), 900 * mib, "no space, a note after");
    assert_eq(asic_size_bytes(str_from("Memory: 44"), BYTES_PER_GIB), 44 * BYTES_PER_GIB, "no unit: the default unit");
    assert_eq(asic_size_bytes(str_from("Memory: 2 tb"), mib), 2048 * BYTES_PER_GIB, "TB, lowercase");
    assert_eq(asic_size_bytes(str_from("Memory bandwidth: 20 PB/s"), BYTES_PER_GIB), 0, "PB/s is not a size");
    assert_eq(asic_size_bytes(str_from("Memory BW: 20 GB/s"), BYTES_PER_GIB), 0, "GB/s is not a size");
    assert_eq(asic_size_bytes(str_from("Memory usage: 50%"), BYTES_PER_GIB), 0, "a percentage is not a size");
    assert_eq(asic_size_bytes(str_from("Memory: 40 Gbit"), BYTES_PER_GIB), 0, "an unknown unit is not a size");
    assert_eq(asic_size_bytes(str_from("Memory: n/a"), BYTES_PER_GIB), 0, "no number");
    assert_eq(asic_size_bytes(str_from("Memory: 17 TB"), BYTES_PER_GIB), 0, "past 16 TiB");
    return 0;
}

fn test_cloud_asic_memory_parse() {
    var cs = str_from("System: CS-2\nMemory: 40 GB\nMemory bandwidth: 20 PB/s\n");
    assert_eq(parse_cerebras_memory(cs), 40 * BYTES_PER_GIB, "cerebras: 40 GB, the rate line skipped");
    var none = parse_cerebras_memory(str_from("System: CS-2\n"));
    assert_eq(none, 44 * BYTES_PER_GIB, "cerebras: no memory line: 44 GiB");
    assert_eq(parse_gcinfo_memory(str_from("IPU: 0\nSRAM: 896 MB\n")), 896 * 1024 * 1024, "graphcore: SRAM: 896 MB");
    assert_eq(parse_gcinfo_memory(str_from("memory: 1800 MB\n")), 1800 * 1024 * 1024, "graphcore: memory: 1800 MB");
    assert_eq(parse_gcinfo_memory(str_from("")), 900 * 1024 * 1024, "graphcore: nothing: 900 MiB");
    return 0;
}

# --- neuron-ls --json-output (2.5.5) ---

fn _fixture(path) {
    var cap = 65536;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap - 1);
    assert_gt(n, 0, path);
    if (n <= 0) { return str_from(""); }
    store8(buf + n, 0);
    return str_new(buf, n);
}

# The documented shape (no "model" key, pretty-printed, nc_count far from the
# device's first key) parses: through 2.5.4 it gave no device at all. Ids are
# neuron_device's, not the caller's vec length (here after a CPU and a Gaudi).
fn test_neuron_ls_documented() {
    var p = vec_new();
    vec_push(p, profile_cpu(16 * BYTES_PER_GIB));
    vec_push(p, profile_gaudi(0, GAUDI2));
    var w = vec_new();
    var doc = _fixture("tests/fixtures/from-docs/neuron-ls-trn1.json");
    assert_eq(parse_neuron_ls_json(doc, NEURON_TRAINIUM, p, w), 2, "trn1: two devices");
    assert_eq(vec_len(w), 0, "trn1: no warning");
    if (vec_len(p) != 4) { return 0; }
    var a = vec_get(p, 2);
    var b = vec_get(p, 3);
    assert_eq(profile_device_id(a), 0, "trn1: first is device 0 after the CPU and a Gaudi");
    assert_eq(profile_device_id(b), 1, "trn1: second is device 1");
    assert_eq(profile_neuron_cores(a), 2, "trn1: nc_count 2");
    assert_eq(profile_memory_bytes(a), 34359738368, "trn1: memory_size, not a key in the process command");
    assert_eq(profile_neuron_chip(a), NEURON_TRAINIUM, "trn1: chip from DMI");
    assert_streq(profile_device_name(a), "AWS Trainium", "trn1: name");
    var p2 = vec_new();
    var trn2 = _fixture("tests/fixtures/from-docs/neuron-ls-trn2.json");
    assert_eq(parse_neuron_ls_json(trn2, NEURON_TRAINIUM, p2, w), 2, "trn2: two devices");
    if (vec_len(p2) == 2) {
        assert_eq(profile_neuron_cores(vec_get(p2, 1)), 8, "trn2: 8 NeuronCores");
        assert_eq(profile_memory_bytes(vec_get(p2, 1)), 96 * BYTES_PER_GIB, "trn2: 96 GiB");
    }
    return 0;
}

fn test_neuron_ls_edges() {
    var w = vec_new();
    assert_eq(parse_neuron_ls_json(str_from("[]\n"), NEURON_INFERENTIA, vec_new(), w), 0, "[]: no device");
    assert_eq(parse_neuron_ls_json(str_from(""), NEURON_INFERENTIA, vec_new(), w), 0, "empty: no device");
    assert_eq(vec_len(w), 0, "[] and empty: no warning");
    var err = str_from("neuron-ls: no Neuron device found\n");
    assert_eq(parse_neuron_ls_json(err, NEURON_INFERENTIA, vec_new(), w), 0, "error text: no device");
    assert_eq(vec_len(w), 1, "error text: a parse warning");

    # No neuron_device: the array index. An object with neither key is not a
    # device but still takes its index.
    var p = vec_new();
    var idx = str_from("[{}, {\"nc_count\":4}, {\"nc_count\":4}]");
    assert_eq(parse_neuron_ls_json(idx, NEURON_INFERENTIA, p, vec_new()), 2, "two devices, one empty object");
    if (vec_len(p) == 2) {
        assert_eq(profile_device_id(vec_get(p, 0)), 1, "no neuron_device: the array index");
        assert_eq(profile_device_id(vec_get(p, 1)), 2, "no neuron_device: the array index (2)");
        assert_eq(profile_memory_bytes(vec_get(p, 1)), 64 * BYTES_PER_GIB, "no memory_size: 4 cores x 16 GiB");
    }

    # A device without a usable nc_count is still listed, at 2 cores, with a
    # warning; memory_size inside a nested object is not the device's.
    var p2 = vec_new();
    var w2 = vec_new();
    var badnc = str_from("[{\"neuron_device\":3,\"x\":{\"memory_size\":1},\"nc_count\":99999}]");
    assert_eq(parse_neuron_ls_json(badnc, NEURON_TRAINIUM, p2, w2), 1, "bad nc_count: listed");
    assert_eq(vec_len(w2), 1, "bad nc_count: a warning");
    if (vec_len(p2) == 1) {
        var d = vec_get(p2, 0);
        assert_eq(profile_device_id(d), 3, "bad nc_count: id 3");
        assert_eq(profile_neuron_cores(d), 2, "bad nc_count: 2 cores");
        assert_eq(profile_memory_bytes(d), 32 * BYTES_PER_GIB, "nested memory_size ignored: 2 x 16 GiB");
    }

    # An escaped quote inside a value does not end it.
    var p5 = vec_new();
    var esc = str_from("[{\"neuron_device\":0,\"bdf\":\"x\\\"y\",\"nc_count\":4}]");
    parse_neuron_ls_json(esc, NEURON_INFERENTIA, p5, vec_new());
    if (vec_len(p5) == 1) { assert_eq(profile_neuron_cores(vec_get(p5, 0)), 4, "escaped quote in a value"); }

    # memory_size past 16 TiB is not used.
    var p3 = vec_new();
    var huge = str_from("[{\"neuron_device\":0,\"nc_count\":2,\"memory_size\":99999999999999999}]");
    parse_neuron_ls_json(huge, NEURON_INFERENTIA, p3, vec_new());
    if (vec_len(p3) == 1) {
        assert_eq(profile_memory_bytes(vec_get(p3, 0)), 32 * BYTES_PER_GIB, "huge memory_size: per-core figure");
    }

    # The older shape the bench and fuzz harness feed: "model" names the chip.
    var p4 = vec_new();
    var model = str_from("[{\"model\":\"trn1\",\"nc_count\":2,\"memory_per_nc_mb\":16384}]");
    assert_eq(_parse_neuron_json(model, p4), 1, "model shape: one device");
    if (vec_len(p4) == 1) {
        assert_eq(profile_neuron_chip(vec_get(p4, 0)), NEURON_TRAINIUM, "model shape: trn1 is Trainium");
        assert_eq(profile_memory_bytes(vec_get(p4, 0)), 32 * BYTES_PER_GIB, "model shape: memory_per_nc_mb x cores");
    }
    return 0;
}

fn test_amd_xdna_profile() {
    var xp = profile_new(ACCEL_AMD_XDNA, 0, 2 * BYTES_PER_GIB);
    assert_eq(profile_family(xp), FAMILY_NPU, "XDNA = NPU");
    assert_eq(accel_supports_training(ACCEL_AMD_XDNA), 0, "XDNA no train");
    return 0;
}

# --- All backend names ---

fn test_all_backend_names() {
    assert(streq(backend_name(BACKEND_APPLE), "apple") == 1, "apple");
    assert(streq(backend_name(BACKEND_INTEL_NPU), "intel-npu") == 1, "intel-npu");
    assert(streq(backend_name(BACKEND_AMD_XDNA), "amd-xdna") == 1, "amd-xdna");
    assert(streq(backend_name(BACKEND_INTEL_ONEAPI), "intel-oneapi") == 1, "intel-oneapi");
    assert(streq(backend_name(BACKEND_QUALCOMM), "qualcomm") == 1, "qualcomm");
    assert(streq(backend_name(BACKEND_CEREBRAS), "cerebras") == 1, "cerebras");
    assert(streq(backend_name(BACKEND_GRAPHCORE), "graphcore") == 1, "graphcore");
    assert(streq(backend_name(BACKEND_GROQ), "groq") == 1, "groq");
    assert(streq(backend_name(BACKEND_SAMSUNG_NPU), "samsung-npu") == 1, "samsung-npu");
    assert(streq(backend_name(BACKEND_MEDIATEK_APU), "mediatek-apu") == 1, "mediatek-apu");
    return 0;
}
# --- Apple Silicon from sysctl (the native macOS path) ---

fn test_apple_silicon_brand() {
    assert_eq(apple_is_silicon_brand("Apple M5 Pro"), 1, "M5 Pro is Apple Silicon");
    assert_eq(apple_is_silicon_brand("Apple M1"), 1, "M1 is Apple Silicon");
    assert_eq(apple_is_silicon_brand("Apple M1 (Virtual)"), 1, "M1 VM is Apple Silicon");
    assert_eq(apple_is_silicon_brand("Intel(R) Core(TM) i9-9980HK CPU @ 2.40GHz"), 0, "Intel Mac is not");
    assert_eq(apple_is_silicon_brand(""), 0, "empty brand");
    assert_eq(apple_is_silicon_brand(0), 0, "no brand");
    return 0;
}

# What the native path emits on ecb (sysctl: "Apple M5 Pro", hw.memsize
# 51539607552), and the Neural Engine table by generation.
fn test_apple_emit_silicon() {
    var profiles = vec_new();
    apple_emit_silicon(profiles, "Apple M5 Pro", 51539607552);
    assert_eq(vec_len(profiles), 2, "metal gpu + neural engine");
    var gpu = vec_get(profiles, 0);
    assert_eq(profile_accel_type(gpu), ACCEL_METAL, "metal gpu");
    assert(streq(profile_device_name(gpu), "Apple M5 Pro") == 1, "gpu named after the chip");
    assert_eq(profile_memory_bytes(gpu), 51539607552, "gpu has the unified memory");
    var ane = vec_get(profiles, 1);
    assert_eq(profile_accel_type(ane), ACCEL_APPLE_NPU, "neural engine");
    assert(streq(profile_device_name(ane), "Apple Neural Engine") == 1, "ane name");
    # A chip past the table gets the newest figure, not the M1's (2.5.5).
    assert_eq(profile_memory_bytes(ane), 8 * BYTES_PER_GIB, "M5 past the table: 8 GiB");
    assert_eq(_apple_ane_bytes(str_from("Apple M4 Max")), 8 * BYTES_PER_GIB, "M4: 8 GiB");
    assert_eq(_apple_ane_bytes(str_from("Apple M3")), 8 * BYTES_PER_GIB, "M3: 8 GiB");
    assert_eq(_apple_ane_bytes(str_from("Apple M2 Ultra")), 6 * BYTES_PER_GIB, "M2: 6 GiB");
    assert_eq(_apple_ane_bytes(str_from("Apple M1 Pro")), 4 * BYTES_PER_GIB, "M1: 4 GiB");
    assert_eq(_apple_ane_bytes(str_from("Apple M1")), 4 * BYTES_PER_GIB, "M1 at the end: 4 GiB");
    assert_eq(_apple_ane_bytes(str_from("Apple M1 (Virtual)")), 4 * BYTES_PER_GIB, "M1 VM: 4 GiB");
    # A generation is matched as a word: an M10 or M21 is not an M1 or M2.
    assert_eq(_apple_ane_bytes(str_from("Apple M10")), 8 * BYTES_PER_GIB, "M10 is not an M1");
    assert_eq(_apple_ane_bytes(str_from("Apple M21 Pro")), 8 * BYTES_PER_GIB, "M21 is not an M2");
    assert_eq(_apple_ane_bytes(str_from("Apple XM1")), 8 * BYTES_PER_GIB, "XM1 is not an M1");
    assert_eq(_apple_ane_bytes(str_from("")), 8 * BYTES_PER_GIB, "no name: newest figure");
    # Both draw on unified memory, so totals count them once (2.3.28).
    assert_eq(profile_shared_bytes(gpu), 51539607552, "gpu memory is unified");
    assert_eq(profile_shared_bytes(ane), 8 * BYTES_PER_GIB, "ane memory is unified");
    return 0;
}

# Asahi's device-tree `compatible` names the SoC, its strings NUL-separated
# (2.5.5; every Asahi Mac got 4 GiB before).
fn _compat(a, b) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_putc(sb, 0);
    str_builder_add_cstr(sb, b);
    str_builder_putc(sb, 0);
    str_builder_add_cstr(sb, "apple,arm-platform");
    return str_builder_build(sb);
}

fn test_asahi_ane() {
    assert_eq(_asahi_ane_bytes(_compat("apple,j293", "apple,t8103")), 4 * BYTES_PER_GIB, "t8103 (M1): 4 GiB");
    assert_eq(_asahi_ane_bytes(_compat("apple,j314s", "apple,t6000")), 4 * BYTES_PER_GIB, "t6000 (M1 Pro): 4 GiB");
    assert_eq(_asahi_ane_bytes(_compat("apple,j413", "apple,t8112")), 6 * BYTES_PER_GIB, "t8112 (M2): 6 GiB");
    assert_eq(_asahi_ane_bytes(_compat("apple,j414s", "apple,t6020")), 6 * BYTES_PER_GIB, "t6020 (M2 Pro): 6 GiB");
    assert_eq(_asahi_ane_bytes(_compat("apple,j504", "apple,t8122")), 8 * BYTES_PER_GIB, "t8122 (M3): 8 GiB");
    return 0;
}

# The native path and the system_profiler fallback describe the same machine
# identically: same types, names and memory.
fn test_apple_native_matches_system_profiler() {
    var native = vec_new();
    apple_emit_silicon(native, "Apple M4 Pro", 36 * BYTES_PER_GIB);
    var parsed = vec_new();
    _parse_apple_macos(str_from("  Chip: Apple M4 Pro\n  Memory: 36 GB\n"), parsed);
    assert_eq(vec_len(parsed), vec_len(native), "same profile count");
    var i = 0;
    var diffs = 0;
    while (i < vec_len(native)) {
        var a = vec_get(native, i);
        var b = vec_get(parsed, i);
        if (profile_accel_type(a) != profile_accel_type(b)) { diffs = diffs + 1; }
        if (profile_memory_bytes(a) != profile_memory_bytes(b)) { diffs = diffs + 1; }
        if (streq(profile_device_name(a), profile_device_name(b)) != 1) { diffs = diffs + 1; }
        i = i + 1;
    }
    assert_eq(diffs, 0, "native == system_profiler");
    return 0;
}

# Count warnings about `tool` in vec `w`.
fn _tool_warnings(w, tool) {
    var c = 0;
    var i = 0;
    while (i < vec_len(w)) {
        if (streq(warning_tool(vec_get(w, i)), tool) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Without exec, the system_profiler fallback is never attempted, and off
# macOS it is not attempted with exec either (2.5.1). This unit runs on Linux,
# where through 2.5.0 the exec attempt showed up as a `system_profiler`
# not-found warning.
fn test_apple_no_exec_spawns_nothing() {
    var w0 = vec_new();
    detect_apple_opts(vec_new(), w0, 0);
    assert_eq(_tool_warnings(w0, "system_profiler"), 0, "no-exec: no system_profiler attempt");
    #ifndef CYRIUS_TARGET_MACOS
    var w1 = vec_new();
    detect_apple_opts(vec_new(), w1, 1);
    assert_eq(_tool_warnings(w1, "system_profiler"), 0, "exec, off macOS: no system_profiler attempt");
    #endif
    return 0;
}

