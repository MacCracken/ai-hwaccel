# --- Planning tests ---

fn test_plan_single_device() {
    # 7B model on 80 GiB GPU — fits on one device
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 80 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var sp = reg_plan_sharding(r, 7000000000, QUANT_FP16);
    assert_eq(plan_strategy(sp), SHARD_NONE, "single device = no shard");
    assert_eq(plan_num_shards(sp), 1, "1 shard");
    assert_eq(plan_min_devices(sp), 1, "1 device");
    assert(plan_est_tps_x1000(sp) > 0, "positive throughput");
    return 0;
}

fn test_plan_pipeline_parallel() {
    # 70B model on 2x 24 GiB GPUs — doesn't fit on one, pipeline parallel
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    # 70B at INT4: 42 GB needed, 48 GB available
    var sp = reg_plan_sharding(r, 70000000000, QUANT_INT4);
    assert_eq(plan_strategy(sp), SHARD_PIPELINE, "pipeline parallel");
    assert_eq(plan_num_shards(sp), 2, "2 shards");
    assert_eq(plan_min_devices(sp), 2, "2 devices");

    # Verify shards have layer ranges
    var s0 = vec_get(plan_shards(sp), 0);
    var s1 = vec_get(plan_shards(sp), 1);
    assert(shard_layer_end(s1) > shard_layer_start(s0), "layers distributed");
    return 0;
}

fn test_plan_tensor_parallel_nvswitch() {
    # 70B model on 4x 80 GiB GPUs with NVSwitch -> tensor parallel
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    var gi = 0;
    while (gi < 4) {
        vec_push(profiles, profile_cuda(gi, 80 * BYTES_PER_GIB));
        gi = gi + 1;
    }
    var r = registry_from_profiles(profiles);

    # Add NVSwitch to system_io
    var sio = reg_system_io(r);
    sio_add_interconnect(sio, interconnect_new(ICK_NVSWITCH, "nvswitch", 900000));

    var sp = reg_plan_sharding(r, 70000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp), SHARD_TENSOR, "tensor parallel with NVSwitch");
    assert_eq(plan_num_shards(sp), 4, "4 shards");
    return 0;
}

fn test_plan_tpu_tensor() {
    # Multiple TPU profiles (4 separate 1-chip TPUs), model too large for one
    # 70B at BF16 = 168 GB. Each V5p chip = 95 GiB ~= 102 GB. Doesn't fit one.
    # 4 chips = 408 GB total. 168 GB < 408 GB. Fits across 4.
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_tpu(0, 1, TPU_V5P));
    vec_push(profiles, profile_tpu(1, 1, TPU_V5P));
    vec_push(profiles, profile_tpu(2, 1, TPU_V5P));
    vec_push(profiles, profile_tpu(3, 1, TPU_V5P));
    var r = registry_from_profiles(profiles);

    var sp = reg_plan_sharding(r, 70000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp), SHARD_TENSOR, "TPU tensor parallel");
    assert(plan_est_tps_x1000(sp) > 0, "TPU throughput");
    return 0;
}

fn test_plan_cpu_fallback() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(256 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var sp = reg_plan_sharding(r, 7000000000, QUANT_FP16);
    assert_eq(plan_strategy(sp), SHARD_NONE, "CPU fallback = no shard");
    assert_eq(shard_device_type(vec_get(plan_shards(sp), 0)), ACCEL_CPU, "CPU device");
    return 0;
}

# 1 if every shard of `sp` fits the memory of the profile it names.
fn _shards_fit(r, sp) {
    var sh = plan_shards(sp);
    var profs = reg_profiles(r);
    var i = 0;
    while (i < vec_len(sh)) {
        var s = vec_get(sh, i);
        var j = 0;
        while (j < vec_len(profs)) {
            var q = vec_get(profs, j);
            if (profile_accel_type(q) == shard_device_type(s) && profile_device_id(q) == shard_device_id(s)) {
                if (shard_memory_bytes(s) > profile_memory_bytes(q)) { return 0; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 1;
}

# 1 if the pipeline stages cover layers 0..n-1 in order, without gaps.
fn _layers_contiguous(sp, n) {
    var sh = plan_shards(sp);
    var next = 0;
    var i = 0;
    while (i < vec_len(sh)) {
        var s = vec_get(sh, i);
        if (shard_layer_start(s) != next) { return 0; }
        if (shard_layer_end(s) < shard_layer_start(s)) { return 0; }
        next = shard_layer_end(s) + 1;
        i = i + 1;
    }
    return next == n;
}

fn test_plan_pipeline_heterogeneous() {
    # 80 GiB + 8 GiB, 75B INT8 = 90e9 bytes: needs both, neither may
    # overflow (2.5.4 put 45e9 on the 8 GiB card).
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(256 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 80 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 8 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);
    var sp = reg_plan_sharding(r, 75000000000, QUANT_INT8);
    assert_eq(plan_strategy(sp), SHARD_PIPELINE, "hetero: pipeline");
    assert_eq(_shards_fit(r, sp), 1, "hetero: every shard fits its device");
    assert_eq(_layers_contiguous(sp, 300), 1, "hetero: stages cover all 300 layers");
    assert_eq(plan_fits(sp), 1, "hetero: fits");
    return 0;
}

fn test_plan_laptop_dgpu_igpu() {
    # 8 GiB dGPU + iGPU with a 24 GiB shared heap, 13B BF16 (31.2e9): the
    # dGPU ranks first but holds only 14 of 52 layers.
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(32 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 8 * BYTES_PER_GIB));
    vec_push(profiles, profile_new(ACCEL_VULKAN, 1, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);
    var sp = reg_plan_sharding(r, 13000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp), SHARD_PIPELINE, "laptop: pipeline");
    assert_eq(_shards_fit(r, sp), 1, "laptop: the 8 GiB dGPU is not overcommitted");
    assert_eq(_layers_contiguous(sp, 52), 1, "laptop: stages cover all 52 layers");
    return 0;
}

fn test_plan_pipeline_layer_balance() {
    # 13B FP16 (31.2e9, 52 layers) on 8 x 4 GiB: 2.5.4 gave the last stage
    # 10 layers (6e9 bytes on a 4.3e9 card) while reporting 3.9e9.
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    var k = 0;
    while (k < 8) {
        vec_push(profiles, profile_cuda(k, 4 * BYTES_PER_GIB));
        k = k + 1;
    }
    var r = registry_from_profiles(profiles);
    var sp = reg_plan_sharding(r, 13000000000, QUANT_FP16);
    assert_eq(plan_strategy(sp), SHARD_PIPELINE, "balance: pipeline");
    assert_eq(plan_num_shards(sp), 8, "balance: 8 stages");
    var last = vec_get(plan_shards(sp), plan_num_shards(sp) - 1);
    assert(shard_num_layers(last) <= 7, "balance: last stage <= 7 of 52 layers");
    assert_eq(_layers_contiguous(sp, 52), 1, "balance: stages cover all 52 layers");
    assert_eq(_shards_fit(r, sp), 1, "balance: every stage fits 4 GiB");
    return 0;
}

fn test_plan_tensor_needs_one_kind() {
    # 2 x 80 GiB CUDA + a 24 GiB Vulkan iGPU on NVSwitch, 70B BF16: an equal
    # 56e9 slice does not fit the iGPU, so tensor parallel is out.
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 80 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 80 * BYTES_PER_GIB));
    vec_push(profiles, profile_new(ACCEL_VULKAN, 2, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);
    sio_add_interconnect(reg_system_io(r), interconnect_new(ICK_NVSWITCH, "nvswitch", 900000));
    var sp = reg_plan_sharding(r, 70000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp), SHARD_PIPELINE, "mixed kinds: no tensor parallel");
    assert_eq(_shards_fit(r, sp), 1, "mixed kinds: every shard fits");

    # Same kind but one small card: the slice must fit the smallest.
    var p2 = vec_new();
    vec_push(p2, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(p2, profile_cuda(0, 80 * BYTES_PER_GIB));
    vec_push(p2, profile_cuda(1, 80 * BYTES_PER_GIB));
    vec_push(p2, profile_cuda(2, 24 * BYTES_PER_GIB));
    var r2 = registry_from_profiles(p2);
    sio_add_interconnect(reg_system_io(r2), interconnect_new(ICK_NVSWITCH, "nvswitch", 900000));
    var sp2 = reg_plan_sharding(r2, 70000000000, QUANT_BF16);
    assert_eq(_shards_fit(r2, sp2), 1, "uneven CUDA: every shard fits");
    assert_eq(plan_strategy(sp2), SHARD_PIPELINE, "uneven CUDA: pipeline");

    # Slices that fit every card, but two vendors: still no tensor group.
    var p3 = vec_new();
    vec_push(p3, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(p3, profile_cuda(0, 80 * BYTES_PER_GIB));
    vec_push(p3, profile_cuda(1, 80 * BYTES_PER_GIB));
    vec_push(p3, profile_new(ACCEL_ROCM, 2, 80 * BYTES_PER_GIB));
    var r3 = registry_from_profiles(p3);
    sio_add_interconnect(reg_system_io(r3), interconnect_new(ICK_NVSWITCH, "nvswitch", 900000));
    var sp3 = reg_plan_sharding(r3, 70000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp3), SHARD_PIPELINE, "CUDA + ROCm: no tensor parallel");
    assert_eq(_shards_fit(r3, sp3), 1, "CUDA + ROCm: every shard fits");
    return 0;
}

fn test_plan_tpu_slice_fits_smallest_chip() {
    # v5e x4 (16 GiB chips) + v5p x1 (95 GiB), 70B BF16: an equal 33.6e9
    # slice per chip does not fit a v5e chip.
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_tpu(0, 4, TPU_V5E));
    vec_push(profiles, profile_tpu(1, 1, TPU_V5P));
    var r = registry_from_profiles(profiles);
    var sp = reg_plan_sharding(r, 70000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp), SHARD_PIPELINE, "mixed TPUs: pipeline");
    assert_eq(_shards_fit(r, sp), 1, "mixed TPUs: every shard fits");
    return 0;
}

fn test_plan_tpu_chips_bounded() {
    # A registry from JSON can claim any tpu_chips; 2.5.4 made one shard per
    # claimed chip (2,000,000 here).
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    var k = 0;
    while (k < 2) {
        var t = profile_new(ACCEL_TPU, k, 100 * BYTES_PER_GIB);
        profile_set_tpu_version(t, TPU_V5P);
        profile_set_tpu_chips(t, 1000000);
        vec_push(profiles, t);
        k = k + 1;
    }
    var r = registry_from_profiles(profiles);
    var sp = reg_plan_sharding(r, 70000000000, QUANT_BF16);
    assert(plan_num_shards(sp) <= PLAN_MAX_TPU_CHIPS, "claimed TPU chips are bounded");
    assert_eq(_shards_fit(r, sp), 1, "bounded TPU plan fits");

    # Counts whose sum wraps the i64 are capped per profile first.
    var p2 = vec_new();
    vec_push(p2, profile_cpu(64 * BYTES_PER_GIB));
    k = 0;
    while (k < 2) {
        var t2 = profile_new(ACCEL_TPU, k, 100 * BYTES_PER_GIB);
        profile_set_tpu_version(t2, TPU_V5P);
        profile_set_tpu_chips(t2, 4611686018427387904);
        vec_push(p2, t2);
        k = k + 1;
    }
    var sp2 = reg_plan_sharding(registry_from_profiles(p2), 70000000000, QUANT_BF16);
    assert(plan_strategy_count(sp2) > 0, "2 x 2^62 chips: a positive stage count");
    assert(plan_num_shards(sp2) > 0, "2 x 2^62 chips: shards placed");
    return 0;
}

fn test_plan_tps_scales_with_model_size() {
    # 2.5.4's multi-device estimates had no model-size term at all.
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    var gi = 0;
    while (gi < 8) {
        vec_push(profiles, profile_cuda(gi, 80 * BYTES_PER_GIB));
        gi = gi + 1;
    }
    var r = registry_from_profiles(profiles);
    sio_add_interconnect(reg_system_io(r), interconnect_new(ICK_NVSWITCH, "nvswitch", 900000));
    var a = reg_plan_sharding(r, 70000000000, QUANT_FP16);
    var b = reg_plan_sharding(r, 180000000000, QUANT_FP16);
    assert_eq(plan_strategy(a), SHARD_TENSOR, "70B TP");
    assert_eq(plan_strategy(b), SHARD_TENSOR, "180B TP");
    assert(plan_est_tps_x1000(b) < plan_est_tps_x1000(a), "180B TP slower than 70B TP");
    var p2 = vec_new();
    vec_push(p2, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(p2, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(p2, profile_cuda(1, 24 * BYTES_PER_GIB));
    var r2 = registry_from_profiles(p2);
    var big = reg_plan_sharding(r2, 70000000000, QUANT_INT4);
    var small = reg_plan_sharding(r2, 13000000000, QUANT_INT4);
    assert_eq(plan_strategy(big), SHARD_PIPELINE, "70B pipeline");
    assert_eq(plan_strategy(small), SHARD_NONE, "13B single");
    assert(plan_est_tps_x1000(big) < plan_est_tps_x1000(small), "70B PP slower than 13B single");
    # Multiply before dividing: 2.5.4 truncated 405B to 192 and > 1T to 0.
    assert_eq(estimate_tps_x1000(ACCEL_METAL, 12000, 405000000000, QUANT_INT4), 237, "405B INT4 Metal");
    assert(estimate_tps_x1000(ACCEL_CUDA, 20000, 1500000000000, QUANT_BF16) > 0, "1.5T nonzero");
    assert_eq(estimate_tps_x1000(ACCEL_CUDA, 20000, 0, QUANT_BF16), 0, "0 params");
    assert_eq(estimate_tps_x1000(ACCEL_CUDA, 20000, 0 - 5, QUANT_BF16), 0, "negative params");
    return 0;
}

fn test_plan_fits_flag() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    var gi = 0;
    while (gi < 8) {
        vec_push(profiles, profile_cuda(gi, 80 * BYTES_PER_GIB));
        gi = gi + 1;
    }
    var r = registry_from_profiles(profiles);
    # 405B BF16 = 972e9 > 8 x 80 GiB and > 64 GiB of RAM: the CPU fallback
    var sp = reg_plan_sharding(r, 405000000000, QUANT_BF16);
    assert_eq(plan_strategy(sp), SHARD_NONE, "no fit falls to CPU");
    assert_eq(shard_device_type(vec_get(plan_shards(sp), 0)), ACCEL_CPU, "CPU shard");
    assert_eq(plan_fits(sp), 0, "405B BF16 on 8x80 GiB + 64 GiB CPU does not fit");
    var sb = str_builder_new();
    plan_to_json(sb, sp);
    assert_eq(str_contains_cstr(str_builder_build(sb), "\"fits\":false"), 1, "plan JSON says fits false");
    # INT8 (486e9) pipelines across the 8 GPUs
    var sp8 = reg_plan_sharding(r, 405000000000, QUANT_INT8);
    assert_eq(plan_fits(sp8), 1, "INT8 PP fits");
    var sb8 = str_builder_new();
    plan_to_json(sb8, sp8);
    assert_eq(str_contains_cstr(str_builder_build(sb8), "\"fits\":true"), 1, "plan JSON says fits true");
    # A CPU fallback that does fit: 512 GiB RAM + one 24 GiB GPU, 70B FP16
    var p2 = vec_new();
    vec_push(p2, profile_cpu(512 * BYTES_PER_GIB));
    vec_push(p2, profile_cuda(0, 24 * BYTES_PER_GIB));
    var sp2 = reg_plan_sharding(registry_from_profiles(p2), 70000000000, QUANT_FP16);
    assert_eq(plan_strategy(sp2), SHARD_NONE, "fitting CPU fallback");
    assert_eq(plan_fits(sp2), 1, "CPU fallback that fits");
    # No device at all
    var sp3 = reg_plan_sharding(registry_from_profiles(vec_new()), 7000000000, QUANT_FP16);
    assert_eq(plan_fits(sp3), 0, "no device: does not fit");
    return 0;
}

# --- Quantization ---

fn test_quant_from_str_any_case() {
    assert_eq(quant_from_str("Int8"), QUANT_INT8, "Int8");
    assert_eq(quant_from_str("Bf16"), QUANT_BF16, "Bf16");
    assert_eq(quant_from_str("iNT4"), QUANT_INT4, "iNT4");
    assert_eq(quant_from_str("FP32"), QUANT_NONE, "FP32");
    assert_eq(quant_from_str("fp16"), QUANT_FP16, "fp16");
    assert_eq(quant_from_str("fp8"), 0 - 1, "fp8 unsupported");
    assert_eq(quant_from_str("int"), 0 - 1, "prefix no match");
    assert_eq(quant_from_str("int88"), 0 - 1, "longer no match");
    assert_eq(quant_from_str(0), 0 - 1, "NULL no match");
    return 0;
}

fn test_quant_model_bytes_no_wrap() {
    assert_eq(quant_model_bytes(7000000000, QUANT_FP16), 14000000000, "7B FP16");
    assert_eq(quant_model_bytes(7, QUANT_INT4), 3, "7 params INT4 rounds down");
    # 3e17 * 32 bits wrapped negative through 2.5.4
    assert_eq(quant_model_bytes(300000000000000000, QUANT_NONE), 1200000000000000000, "3e17 FP32");
    assert_eq(quant_model_bytes(HW_I64_MAX, QUANT_NONE), HW_I64_MAX, "saturates");
    assert_eq(quant_model_bytes_with_overhead(HW_I64_MAX, QUANT_NONE), HW_I64_MAX, "overhead saturates");
    assert_eq(quant_model_bytes_with_overhead(HW_I64_MAX, QUANT_INT4), 5534023222112865483,
      "INT4 of i64-max params, no wrap");
    assert_eq(quant_model_bytes(0, QUANT_BF16), 0, "0 params");
    assert_eq(quant_model_bytes(0 - 5, QUANT_BF16), 0, "negative params");
    assert_eq(quant_model_bytes_with_overhead(70000000000, QUANT_BF16), 168000000000, "70B BF16 + 20%");
    return 0;
}

# --- Training memory estimation ---

fn test_training_full_gpu() {
    # 7B model (7000M params) full fine-tune on GPU, mixed-precision AdamW:
    # 16 B/param before activations = 104.3 GiB. base ~= 7000 * 1863 / 1000
    # = 13041; total = 9x base = 117369 (2.5.4 said 52164).
    var est = estimate_training_memory(7000, TRAIN_FULL, TARGET_GPU);
    var total = est_total_x1000(est);
    assert(est_model_x1000(est) + est_optimizer_x1000(est) >= 104000, "full >= 16 B/param before activations");
    assert(total > 104000, "full > 104 GiB");
    assert(total < 130000, "full < 130 GiB");
    assert_eq(total, 117369, "7B full = 9x base");
    return 0;
}

fn test_training_trained_model_optimizer() {
    # DPO/RLHF train the policy beside a frozen reference; distillation a
    # half-size student beside a frozen teacher.
    var full = estimate_training_memory(7000, TRAIN_FULL, TARGET_GPU);
    var dpo = estimate_training_memory(7000, TRAIN_DPO, TARGET_GPU);
    var dist = estimate_training_memory(7000, TRAIN_DISTILL, TARGET_GPU);
    assert_eq(est_optimizer_x1000(dpo), est_optimizer_x1000(full), "DPO optimizer = one trained model");
    assert(est_total_x1000(dpo) > est_total_x1000(full), "DPO > full");
    assert_eq(est_optimizer_x1000(dist), est_optimizer_x1000(full) / 2, "distill optimizer = half-size student");
    var tpu = estimate_training_memory(7000, TRAIN_FULL, TARGET_TPU);
    var gaudi = estimate_training_memory(7000, TRAIN_FULL, TARGET_GAUDI);
    assert_eq(est_optimizer_x1000(tpu), est_optimizer_x1000(full), "TPU AdamW accounting");
    assert_eq(est_optimizer_x1000(gaudi), est_optimizer_x1000(full), "Gaudi AdamW accounting");
    var z = estimate_training_memory(0 - 7000, TRAIN_FULL, TARGET_GPU);
    assert_eq(est_total_x1000(z), 0, "negative params: zero estimate");
    return 0;
}

fn test_training_json_large_model() {
    # The largest size the CLI takes (1000T = 1e9 M params), DPO: total about
    # 1.96e10 GiB x1000, whose bytes (2.1e16) wrapped through 2.5.4.
    var est = estimate_training_memory(1000000000, TRAIN_DPO, TARGET_GPU);
    var sb = str_builder_new();
    training_to_json(sb, est);
    var json = str_builder_build(sb);
    assert_eq(str_contains_cstr(json, ":-"), 0, "no negative byte count");
    var v = est_total_x1000(est);
    var want = str_builder_new();
    str_builder_add_cstr(want, "\"total_bytes\":");
    str_builder_add_int(want, v / 1000 * BYTES_PER_GIB + v % 1000 * BYTES_PER_GIB / 1000);
    assert_eq(str_contains_cstr(json, str_data(str_builder_build(want))), 1, "total_bytes exact");
    # 7B LoRA, small enough for the direct product: same bytes either way
    var e2 = estimate_training_memory(7000, TRAIN_LORA, TARGET_GPU);
    var sb2 = str_builder_new();
    training_to_json(sb2, e2);
    var want2 = str_builder_new();
    str_builder_add_cstr(want2, "\"total_bytes\":");
    str_builder_add_int(want2, est_total_x1000(e2) * BYTES_PER_GIB / 1000);
    var json2 = str_builder_build(sb2);
    assert_eq(str_contains_cstr(json2, str_data(str_builder_build(want2))), 1, "7B LoRA bytes unchanged");
    return 0;
}

fn test_training_method_from_str_any_case() {
    assert_eq(training_method_from_str("LoRA"), TRAIN_LORA, "LoRA");
    assert_eq(training_method_from_str("QLoRA-4bit"), TRAIN_QLORA_4, "QLoRA-4bit");
    assert_eq(training_method_from_str("DPO"), TRAIN_DPO, "DPO");
    assert_eq(training_method_from_str("lora"), TRAIN_LORA, "lora");
    assert_eq(training_method_from_str("lor"), 0 - 1, "lor no match");
    assert_eq(training_method_from_str("bogus"), 0 - 1, "bogus");
    return 0;
}

fn test_training_lora_gpu() {
    var est = estimate_training_memory(7000, TRAIN_LORA, TARGET_GPU);
    var total = est_total_x1000(est);
    # LoRA: model + 0.1x optimizer + 0.1x activation = ~1.2x base
    # ~13.0 * 1.2 = ~15.6 GB
    assert(total > 12000, "lora > 12 GB");
    assert(total < 20000, "lora < 20 GB");
    return 0;
}

fn test_training_qlora_gpu() {
    var est4 = estimate_training_memory(7000, TRAIN_QLORA_4, TARGET_GPU);
    var est8 = estimate_training_memory(7000, TRAIN_QLORA_8, TARGET_GPU);
    # QLoRA 4-bit should use less memory than 8-bit
    assert(est_total_x1000(est4) < est_total_x1000(est8), "qlora4 < qlora8");
    # Both should be less than LoRA
    var est_lora = estimate_training_memory(7000, TRAIN_LORA, TARGET_GPU);
    assert(est_total_x1000(est4) < est_total_x1000(est_lora), "qlora4 < lora");
    return 0;
}

fn test_training_tpu() {
    var est_gpu = estimate_training_memory(7000, TRAIN_FULL, TARGET_GPU);
    var est_tpu = estimate_training_memory(7000, TRAIN_FULL, TARGET_TPU);
    # Same AdamW states; TPU's activation factor is smaller (0.8x base)
    assert(est_total_x1000(est_tpu) < est_total_x1000(est_gpu), "TPU < GPU for full");
    return 0;
}

fn test_training_method_names() {
    assert(streq(training_method_name(TRAIN_FULL), "full") == 1, "full name");
    assert(streq(training_method_name(TRAIN_LORA), "lora") == 1, "lora name");
    assert(streq(training_method_name(TRAIN_DPO), "dpo") == 1, "dpo name");
    assert(streq(training_method_name(TRAIN_RLHF), "rlhf") == 1, "rlhf name");
    assert(streq(training_method_name(TRAIN_DISTILL), "distillation") == 1, "distill name");
    return 0;
}

# --- Model compatibility ---

fn test_model_param_count() {
    var m = alloc(MODEL_PROFILE_SIZE);
    store64(m, "Test Model");
    store64(m + 8, "test");
    store64(m + 16, 7000);
    store64(m + 24, "bf16");

    assert_eq(model_param_count(m), 7000000000, "7B param count");
    return 0;
}

fn test_model_can_run() {
    var m = alloc(MODEL_PROFILE_SIZE);
    store64(m, "Test 7B");
    store64(m + 8, "test");
    store64(m + 16, 7000);
    store64(m + 24, "bf16");

    # 7B at FP16 needs ~16.8 GB
    assert_eq(model_can_run(m, QUANT_FP16, 24 * BYTES_PER_GIB), 1, "7B FP16 on 24GB");
    assert_eq(model_can_run(m, QUANT_FP16, 8 * BYTES_PER_GIB), 0, "7B FP16 on 8GB no");
    assert_eq(model_can_run(m, QUANT_INT4, 8 * BYTES_PER_GIB), 1, "7B INT4 on 8GB");
    return 0;
}

# --- Cost types ---

fn test_cloud_provider() {
    assert(streq(cloud_provider_str(CLOUD_AWS), "aws") == 1, "aws str");
    assert(streq(cloud_provider_str(CLOUD_GCP), "gcp") == 1, "gcp str");
    assert(streq(cloud_provider_str(CLOUD_AZURE), "azure") == 1, "azure str");
    return 0;
}

