        syscall(60, code);
    }
}

var _rsb = str_builder_new();
str_builder_add_cstr(_rsb, "/tmp/ai-hwaccel-accel-test-");
str_builder_add_int(_rsb, sys_getpid());
_t_root = str_data(str_builder_build(_rsb));
