}

# --- 2.5.5: shared parsers ---

fn test_hw_streq_ci() {
    assert_eq(hw_streq_ci("Int8", "INT8"), 1, "ci: Int8 == INT8");
    assert_eq(hw_streq_ci("lora", "LoRA"), 1, "ci: lora == LoRA");
    assert_eq(hw_streq_ci("bf16", "bf16"), 1, "ci: equal");
    assert_eq(hw_streq_ci("bf16", "bf1"), 0, "ci: prefix differs");
    assert_eq(hw_streq_ci("bf1", "bf16"), 0, "ci: longer differs");
    assert_eq(hw_streq_ci("", ""), 1, "ci: both empty");
    assert_eq(hw_streq_ci(0, "x"), 0, "ci: null a");
    assert_eq(hw_streq_ci("x", 0), 0, "ci: null b");
    # '@' (64) and '[' (91) sit next to the letters: not folded.
    assert_eq(hw_streq_ci("@", "`"), 0, "ci: @ is not a letter");
    assert_eq(hw_streq_ci("[", "{"), 0, "ci: [ is not a letter");
    return 0;
}

fn test_model_params_from_str() {
    assert_eq(model_params_from_str("70B"), 70000000000, "70B");
    assert_eq(model_params_from_str("70b"), 70000000000, "70b");
    assert_eq(model_params_from_str("70"), 70000000000, "70 means billions");
    assert_eq(model_params_from_str("1.5B"), 1500000000, "1.5B, not 15B");
    assert_eq(model_params_from_str("0.5B"), 500000000, "0.5B, not 5B");
    assert_eq(model_params_from_str("350M"), 350000000, "350M, not 350B");
    assert_eq(model_params_from_str("125m"), 125000000, "125m");
    assert_eq(model_params_from_str("1.2T"), 1200000000000, "1.2T");
    assert_eq(model_params_from_str("800K"), 800000, "800K");
    assert_eq(model_params_from_str("405B"), 405000000000, "405B");
    assert_eq(model_params_from_str("1.234567891B"), 1234567891, "9 fraction digits at B");
    assert_eq(model_params_from_str("1.2345M"), 1234500, "4 fraction digits at M");
    assert_eq(model_params_from_str("1.2345K"), 1234, "sub-parameter fraction dropped");
    assert_eq(model_params_from_str("1000T"), 1000000000000000, "the 1e15 ceiling itself");
    assert_eq(model_params_from_str("1001T"), 0 - 1, "past the ceiling");
    assert_eq(model_params_from_str("99999999999999999999B"), 0 - 1, "20 digits: no wrap");
    assert_eq(model_params_from_str(""), 0 - 1, "empty");
    assert_eq(model_params_from_str("B"), 0 - 1, "unit alone");
    assert_eq(model_params_from_str("8x7B"), 0 - 1, "8x7B rejected, not 87B");
    assert_eq(model_params_from_str("1.5.0B"), 0 - 1, "two points");
    assert_eq(model_params_from_str("70GB"), 0 - 1, "trailing text");
    assert_eq(model_params_from_str("-3B"), 0 - 1, "negative");
    assert_eq(model_params_from_str("7.B"), 0 - 1, "point with no fraction");
    assert_eq(model_params_from_str(".5B"), 0 - 1, "no whole part");
    assert_eq(model_params_from_str(0), 0 - 1, "null");
    return 0;
}

