# --- Error enum tests ---

fn test_error_codes() {
    assert_eq(HWA_ERR_NONE, 0, "HWA_ERR_NONE == 0");
    assert_eq(HWA_ERR_TOOL_NOT_FOUND, 1, "HWA_ERR_TOOL_NOT_FOUND == 1");
    assert_eq(HWA_ERR_TOOL_FAILED, 2, "HWA_ERR_TOOL_FAILED == 2");
    assert_eq(HWA_ERR_TIMEOUT, 3, "HWA_ERR_TIMEOUT == 3");
    assert_eq(HWA_ERR_PARSE, 4, "HWA_ERR_PARSE == 4");
    assert_eq(HWA_ERR_SYSFS_READ, 5, "HWA_ERR_SYSFS_READ == 5");
    return 0;
}

fn test_warning_struct() {
    var w = warning_tool_not_found("nvidia-smi");
    assert_eq(warning_code(w), HWA_ERR_TOOL_NOT_FOUND, "tool_not_found code");
    assert(streq(warning_tool(w), "nvidia-smi") == 1, "tool name");
    assert_eq(warning_message(w), 0, "no message");
    # bump allocator — no individual free

    var w2 = warning_tool_failed("hl-smi", 1, "device not found");
    assert_eq(warning_code(w2), HWA_ERR_TOOL_FAILED, "tool_failed code");
    assert_eq(warning_exit_code(w2), 1, "exit code");
    assert(streq(warning_message(w2), "device not found") == 1, "stderr msg");

    var w3 = warning_timeout("vulkaninfo", 5000);
    assert_eq(warning_code(w3), HWA_ERR_TIMEOUT, "timeout code");
    assert_eq(warning_timeout_ms(w3), 5000, "timeout ms");

    var w4 = warning_parse("cuda", "invalid CSV");
    assert_eq(warning_code(w4), HWA_ERR_PARSE, "parse code");
    assert(streq(warning_message(w4), "invalid CSV") == 1, "parse msg");

    var w5 = warning_sysfs("/sys/class/drm/card0", "permission denied");
    assert_eq(warning_code(w5), HWA_ERR_SYSFS_READ, "sysfs code");
    assert(streq(warning_message(w5), "permission denied") == 1, "sysfs msg");
    assert_eq(warning_exit_code(w5), 0 - 1, "no exit status but for a failed tool");
    return 0;
}

# The warning struct is derived (2.5.5): warning_new allocates sizeof(warning)
# and nothing else, and every field reads back what its setter stored.
fn test_warning_derived() {
    var u0 = alloc_used();
    var w = warning_new(HWA_ERR_TIMEOUT, "t");
    assert_eq(alloc_used() - u0, sizeof(warning), "warning_new allocates sizeof(warning)");
    assert_eq(WARNING_SIZE, sizeof(warning), "WARNING_SIZE is sizeof(warning)");
    warning_set_timeout_ms(w, 7);
    warning_set_exit_code(w, 9);
    warning_set_message(w, "m");
    assert_eq(warning_timeout_ms(w), 7, "timeout_ms round-trips");
    assert_eq(warning_exit_code(w), 9, "exit_code round-trips");
    assert_streq(warning_message(w), "m", "message round-trips");
    assert_eq(warning_code(w), HWA_ERR_TIMEOUT, "code kept");
    return 0;
}

# warning_describe, the text warning_print writes and the CLI logs (2.5.5).
# Through 2.5.4 -1 read as a signal and a status was shown twice.
fn test_warning_describe() {
    assert_streq(str_data(warning_describe(warning_tool_failed("dxgi", 0 - 1, "EnumAdapters1 failed"))),
      "dxgi: EnumAdapters1 failed", "describe: -1 is not a signal");
    assert_streq(str_data(warning_describe(warning_tool_failed("sh", 137, "killed by signal 9"))),
      "sh: killed by signal 9", "describe: a signal once");
    assert_streq(str_data(warning_describe(warning_tool_failed("nvidia-smi", 9, "exited with status 9"))),
      "nvidia-smi: exited with status 9", "describe: a status once");
    assert_streq(str_data(warning_describe(warning_tool_failed("x", 3, 0))),
      "x: exited with status 3", "describe: a status without a message");
    assert_streq(str_data(warning_describe(warning_tool_failed("x", 0 - 1, 0))),
      "x: failed", "describe: no status, no message");
    assert_streq(str_data(warning_describe(warning_timeout("hl-smi", 10000))),
      "hl-smi: timed out after 10s", "describe: timeout");
    assert_streq(str_data(warning_describe(warning_tool_not_found("gc-info"))),
      "gc-info: tool not found on $PATH", "describe: not found");
    assert_streq(str_data(warning_describe(warning_parse("cuda", "bad line"))),
      "cuda: parse error - bad line", "describe: parse");
    assert_streq(str_data(warning_describe(warning_sysfs("/sys/x", "unreadable"))),
      "sysfs /sys/x: unreadable", "describe: sysfs");
    return 0;
}

# --- Accelerator type tests ---

fn test_accel_family() {
    assert_eq(accel_family(ACCEL_CPU), FAMILY_CPU, "CPU family");
    assert_eq(accel_family(ACCEL_WIN_GPU), FAMILY_GPU, "Windows GPU family");
    assert_eq(accel_family(ACCEL_AGNOS_GPU), FAMILY_GPU, "AGNOS GPU family");
    assert_eq(accel_family(ACCEL_QUALCOMM), FAMILY_AI_ASIC, "Qualcomm family");
    assert_eq(accel_family(ACCEL_GRAPHCORE), FAMILY_AI_ASIC, "Graphcore family");
    # A type this build does not know is not the CPU (2.5.5).
    assert_eq(accel_family(ACCEL_TYPE_COUNT), FAMILY_UNKNOWN, "past the last type: Unknown family");
    assert_eq(accel_family(0 - 1), FAMILY_UNKNOWN, "negative type: Unknown family");
    assert_eq(accel_family(1000), FAMILY_UNKNOWN, "far past the last type: Unknown family");
    assert_eq(accel_family(ACCEL_CUDA), FAMILY_GPU, "CUDA family");
    assert_eq(accel_family(ACCEL_ROCM), FAMILY_GPU, "ROCm family");
    assert_eq(accel_family(ACCEL_METAL), FAMILY_GPU, "Metal family");
    assert_eq(accel_family(ACCEL_VULKAN), FAMILY_GPU, "Vulkan family");
    assert_eq(accel_family(ACCEL_INTEL_ONEAPI), FAMILY_GPU, "oneAPI family");
    assert_eq(accel_family(ACCEL_INTEL_NPU), FAMILY_NPU, "Intel NPU family");
    assert_eq(accel_family(ACCEL_APPLE_NPU), FAMILY_NPU, "Apple NPU family");
    assert_eq(accel_family(ACCEL_AMD_XDNA), FAMILY_NPU, "AMD XDNA family");
    assert_eq(accel_family(ACCEL_TPU), FAMILY_TPU, "TPU family");
    assert_eq(accel_family(ACCEL_GAUDI), FAMILY_AI_ASIC, "Gaudi family");
    assert_eq(accel_family(ACCEL_NEURON), FAMILY_AI_ASIC, "Neuron family");
    assert_eq(accel_family(ACCEL_CEREBRAS), FAMILY_AI_ASIC, "Cerebras family");
    assert_eq(accel_family(ACCEL_GROQ), FAMILY_AI_ASIC, "Groq family");
    assert_eq(accel_family(ACCEL_SAMSUNG_NPU), FAMILY_NPU, "Samsung family");
    assert_eq(accel_family(ACCEL_MEDIATEK_APU), FAMILY_NPU, "MediaTek family");
    return 0;
}

fn test_accel_is_gpu() {
    assert_eq(accel_is_gpu(ACCEL_CUDA), 1, "CUDA is GPU");
    assert_eq(accel_is_gpu(ACCEL_ROCM), 1, "ROCm is GPU");
    assert_eq(accel_is_gpu(ACCEL_METAL), 1, "Metal is GPU");
    assert_eq(accel_is_gpu(ACCEL_VULKAN), 1, "Vulkan is GPU");
    assert_eq(accel_is_gpu(ACCEL_INTEL_ONEAPI), 1, "oneAPI is GPU");
    assert_eq(accel_is_gpu(ACCEL_WIN_GPU), 1, "Windows GPU is GPU");
    assert_eq(accel_is_gpu(ACCEL_AGNOS_GPU), 1, "AGNOS GPU is GPU");
    assert_eq(accel_is_gpu(ACCEL_CPU), 0, "CPU not GPU");
    assert_eq(accel_is_gpu(ACCEL_TPU), 0, "TPU not GPU");
    assert_eq(accel_is_gpu(ACCEL_INTEL_NPU), 0, "NPU not GPU");
    return 0;
}

# Every type, 0 to ACCEL_TYPE_COUNT - 1, against one table of families: each
# has a name and a known family, and the family's predicate agrees with it.
# Nothing past the count has a name, so a type appended without moving
# ACCEL_TYPE_COUNT fails here (2.5.5).
fn _want_family(t) {
    if (t == ACCEL_CPU) { return FAMILY_CPU; }
    if (t == ACCEL_CUDA || t == ACCEL_ROCM || t == ACCEL_METAL || t == ACCEL_VULKAN) { return FAMILY_GPU; }
    if (t == ACCEL_INTEL_ONEAPI || t == ACCEL_WIN_GPU || t == ACCEL_AGNOS_GPU) { return FAMILY_GPU; }
    if (t == ACCEL_INTEL_NPU || t == ACCEL_AMD_XDNA || t == ACCEL_APPLE_NPU) { return FAMILY_NPU; }
    if (t == ACCEL_SAMSUNG_NPU || t == ACCEL_MEDIATEK_APU) { return FAMILY_NPU; }
    if (t == ACCEL_TPU) { return FAMILY_TPU; }
    if (t == ACCEL_GAUDI || t == ACCEL_NEURON || t == ACCEL_QUALCOMM) { return FAMILY_AI_ASIC; }
    if (t == ACCEL_CEREBRAS || t == ACCEL_GRAPHCORE || t == ACCEL_GROQ) { return FAMILY_AI_ASIC; }
    return FAMILY_UNKNOWN;
}

fn test_accel_type_table() {
    assert_eq(ACCEL_TYPE_COUNT, ACCEL_AGNOS_GPU + 1, "the count is one past the last type");
    var t = 0;
    var bad_family = 0;
    var unnamed = 0;
    var bad_pred = 0;
    while (t < ACCEL_TYPE_COUNT) {
        var f = _want_family(t);
        if (f == FAMILY_UNKNOWN || accel_family(t) != f) { bad_family = bad_family + 1; }
        if (streq(accel_name(t), "Unknown") == 1) { unnamed = unnamed + 1; }
        var gpu = 0;
        if (f == FAMILY_GPU) { gpu = 1; }
        var npu = 0;
        if (f == FAMILY_NPU) { npu = 1; }
        var asic = 0;
        if (f == FAMILY_AI_ASIC) { asic = 1; }
        var tpu = 0;
        if (f == FAMILY_TPU) { tpu = 1; }
        if (accel_is_gpu(t) != gpu || accel_is_npu(t) != npu) { bad_pred = bad_pred + 1; }
        if (accel_is_ai_asic(t) != asic || accel_is_tpu(t) != tpu) { bad_pred = bad_pred + 1; }
        t = t + 1;
    }
    assert_eq(bad_family, 0, "every type: its family");
    assert_eq(unnamed, 0, "every type: a name");
    assert_eq(bad_pred, 0, "every type: the family predicates agree");
    assert_streq(accel_name(ACCEL_TYPE_COUNT), "Unknown", "past the last type: no name");
    assert_streq(accel_name(0 - 1), "Unknown", "negative type: no name");
    assert_eq(accel_is_gpu(ACCEL_TYPE_COUNT), 0, "past the last type: not a GPU");
    return 0;
}

fn test_accel_training() {
    assert(accel_supports_training(ACCEL_CUDA) == 1, "CUDA trains");
    assert(accel_supports_training(ACCEL_ROCM) == 1, "ROCm trains");
    assert(accel_supports_training(ACCEL_INTEL_NPU) == 0, "Intel NPU no train");
    assert(accel_supports_training(ACCEL_APPLE_NPU) == 0, "Apple NPU no train");
    assert(accel_supports_training(ACCEL_QUALCOMM) == 0, "Qualcomm no train");
    assert(accel_supports_training(ACCEL_GROQ) == 0, "Groq no train");
    assert(accel_supports_training(ACCEL_CEREBRAS) == 1, "Cerebras trains");
    return 0;
}

# --- TPU/Gaudi/Neuron sub-type tests ---

fn test_tpu_versions() {
    assert(streq(tpu_version_name(TPU_V4), "v4") == 1, "TPU v4 name");
    assert(streq(tpu_version_name(TPU_V5E), "v5e") == 1, "TPU v5e name");
    assert(streq(tpu_version_name(TPU_V5P), "v5p") == 1, "TPU v5p name");

    # HBM checks (in GiB)
    assert_eq(tpu_hbm_per_chip(TPU_V4) / BYTES_PER_GIB, 32, "TPU v4 32 GiB");
    assert_eq(tpu_hbm_per_chip(TPU_V5E) / BYTES_PER_GIB, 16, "TPU v5e 16 GiB");
    assert_eq(tpu_hbm_per_chip(TPU_V5P) / BYTES_PER_GIB, 95, "TPU v5p 95 GiB");

    # Throughput ordering
    assert(tpu_throughput_x1000(TPU_V5P) > tpu_throughput_x1000(TPU_V4), "V5p > V4");
    assert(tpu_throughput_x1000(TPU_V4) > tpu_throughput_x1000(TPU_V5E), "V4 > V5e");

    # Rank ordering
    assert(tpu_rank(TPU_V5P) > tpu_rank(TPU_V4), "V5p rank > V4");
    assert(tpu_rank(TPU_V4) > tpu_rank(TPU_V5E), "V4 rank > V5e");
    return 0;
}

fn test_gaudi_generations() {
    assert(streq(gaudi_gen_name(GAUDI2), "Gaudi2") == 1, "Gaudi2 name");
    assert(streq(gaudi_gen_name(GAUDI3), "Gaudi3") == 1, "Gaudi3 name");

    assert_eq(gaudi_hbm_bytes(GAUDI2) / BYTES_PER_GIB, 96, "Gaudi2 96 GiB");
    assert_eq(gaudi_hbm_bytes(GAUDI3) / BYTES_PER_GIB, 128, "Gaudi3 128 GiB");

    assert(gaudi_throughput_x1000(GAUDI3) > gaudi_throughput_x1000(GAUDI2), "G3 > G2");
    assert(gaudi_rank(GAUDI3) > gaudi_rank(GAUDI2), "G3 rank > G2");
    return 0;
}

fn test_neuron_chips() {
    assert(streq(neuron_chip_name(NEURON_INFERENTIA), "Inferentia") == 1, "Inferentia name");
    assert(streq(neuron_chip_name(NEURON_TRAINIUM), "Trainium") == 1, "Trainium name");

    # inf2 and trn1 are both 32 GiB over 2 NeuronCores (2.5.5: Trainium was
    # 32 GiB a core, so a trn1 device read 64 GiB).
    assert_eq(neuron_hbm_per_core(NEURON_INFERENTIA) / BYTES_PER_GIB, 16, "Inf 16 GiB/core");
    assert_eq(neuron_hbm_per_core(NEURON_TRAINIUM) / BYTES_PER_GIB, 16, "Trn 16 GiB/core");

    # Trainium trains, Inferentia does not, and neither does an unknown chip
    # (2.5.5: it trained at Trainium's rate while its throughput was
    # Inferentia's).
    assert(neuron_training_x1000(NEURON_TRAINIUM, 2) > 0, "Trainium trains");
    assert_eq(neuron_training_x1000(NEURON_INFERENTIA, 2), 0, "Inferentia no train");
    var unknown = 0 - 1;
    assert_eq(neuron_training_x1000(unknown, 2), 0, "unknown chip no train");
    var inf = neuron_throughput_x1000(NEURON_INFERENTIA, 2);
    assert_eq(neuron_throughput_x1000(unknown, 2), inf, "unknown chip: Inferentia throughput");

    # Rank
    assert(neuron_rank(NEURON_TRAINIUM) > neuron_rank(NEURON_INFERENTIA), "Trn rank > Inf");
    return 0;
}

# --- Units tests ---

fn test_units() {
    assert_eq(BYTES_PER_GIB, 1073741824, "GiB constant");
    assert_eq(BYTES_PER_GB, 1000000000, "GB constant");
    assert_eq(BITS_PER_BYTE, 8, "bits/byte");
    assert_eq(PARAMS_PER_MILLION, 1000000, "params/M");
    assert_eq(FP16_BYTES_PER_PARAM, 2, "FP16 2 bytes");
    assert_eq(ACTIVATION_OVERHEAD_DIVISOR, 5, "20% overhead");
    assert_eq(PARAMS_PER_LAYER_ESTIMATE, 250000000, "250M/layer");
    assert_eq(SCHEMA_VERSION, 6, "schema v6");
    return 0;
}

# --- Types whose memory is system RAM (2.3.28) ---

# Exactly these types count as system RAM: the CPU, Apple Silicon's GPU and
# Neural Engine, and the client NPUs. Every other type has memory of its own.
fn test_uses_system_memory() {
    var t = 0;
    var wrong = 0;
    while (t < ACCEL_TYPE_COUNT) {
        var want = 0;
        if (t == ACCEL_CPU) { want = 1; }
        if (t == ACCEL_METAL) { want = 1; }
        if (t == ACCEL_APPLE_NPU) { want = 1; }
        if (t == ACCEL_INTEL_NPU) { want = 1; }
        if (t == ACCEL_AMD_XDNA) { want = 1; }
        if (t == ACCEL_SAMSUNG_NPU) { want = 1; }
        if (t == ACCEL_MEDIATEK_APU) { want = 1; }
        if (accel_uses_system_memory(t) != want) { wrong = wrong + 1; }
        t = t + 1;
    }
    assert_eq(wrong, 0, "system-memory types");
    var t2 = 0;
    var disagree = 0;
    while (t2 < ACCEL_TYPE_COUNT) {
        if (((ACCEL_SYSMEM_MASK >> t2) & 1) != accel_uses_system_memory(t2)) { disagree = disagree + 1; }
        t2 = t2 + 1;
    }
    assert_eq(disagree, 0, "ACCEL_SYSMEM_MASK matches accel_uses_system_memory");
    assert_eq(accel_uses_system_memory(ACCEL_QUALCOMM), 0, "cloud ai 100 has its own memory");
    return 0;
}

# --- Quantization tests ---

fn test_quant_bits() {
    assert_eq(quant_bits(QUANT_NONE), 32, "FP32 = 32 bits");
    assert_eq(quant_bits(QUANT_FP16), 16, "FP16 = 16 bits");
    assert_eq(quant_bits(QUANT_BF16), 16, "BF16 = 16 bits");
    assert_eq(quant_bits(QUANT_INT8), 8, "INT8 = 8 bits");
    assert_eq(quant_bits(QUANT_INT4), 4, "INT4 = 4 bits");
    return 0;
}

fn test_quant_reduction() {
    assert_eq(quant_reduction_x1000(QUANT_NONE), 1000, "FP32 = 1.0x");
    assert_eq(quant_reduction_x1000(QUANT_FP16), 2000, "FP16 = 2.0x");
    assert_eq(quant_reduction_x1000(QUANT_INT8), 4000, "INT8 = 4.0x");
    assert_eq(quant_reduction_x1000(QUANT_INT4), 8000, "INT4 = 8.0x");
    return 0;
}

fn test_quant_names() {
    assert(streq(quant_name(QUANT_NONE), "FP32") == 1, "FP32 name");
    assert(streq(quant_name(QUANT_FP16), "FP16") == 1, "FP16 name");
    assert(streq(quant_name(QUANT_BF16), "BF16") == 1, "BF16 name");
    assert(streq(quant_name(QUANT_INT8), "INT8") == 1, "INT8 name");
    assert(streq(quant_name(QUANT_INT4), "INT4") == 1, "INT4 name");
    return 0;
}

fn test_quant_from_bits() {
    assert_eq(quant_from_bits(32), QUANT_NONE, "32 -> NONE");
    assert_eq(quant_from_bits(16), QUANT_FP16, "16 -> FP16");
    assert_eq(quant_from_bits(8), QUANT_INT8, "8 -> INT8");
    assert_eq(quant_from_bits(4), QUANT_INT4, "4 -> INT4");
    assert_eq(quant_from_bits(7), 0 - 1, "7 -> invalid");
    return 0;
}

fn test_quant_from_str() {
    assert_eq(quant_from_str("fp32"), QUANT_NONE, "fp32 parse");
    assert_eq(quant_from_str("FP16"), QUANT_FP16, "FP16 parse");
    assert_eq(quant_from_str("bf16"), QUANT_BF16, "bf16 parse");
    assert_eq(quant_from_str("int8"), QUANT_INT8, "int8 parse");
    assert_eq(quant_from_str("INT4"), QUANT_INT4, "INT4 parse");
    assert_eq(quant_from_str("nope"), 0 - 1, "invalid parse");
    return 0;
}

fn test_quant_model_bytes() {
    # 7B params at FP16 = 7B * 16 / 8 = 14 GB
    var params_7b = 7000000000;
    var mem = quant_model_bytes(params_7b, QUANT_FP16);
    assert_eq(mem, 14000000000, "7B FP16 = 14GB");

    # 7B params at INT4 = 7B * 4 / 8 = 3.5 GB
    var mem4 = quant_model_bytes(params_7b, QUANT_INT4);
    assert_eq(mem4, 3500000000, "7B INT4 = 3.5GB");

    # With overhead: 14GB + 14GB/5 = 16.8GB
    var mem_oh = quant_model_bytes_with_overhead(params_7b, QUANT_FP16);
    assert_eq(mem_oh, 16800000000, "7B FP16 + overhead = 16.8GB");
    return 0;
}

