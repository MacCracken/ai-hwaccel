# --- Registry construction ---

fn test_registry_new() {
    var r = hw_registry_new();
    assert_eq(reg_num_profiles(r), 0, "empty registry");
    assert_eq(reg_num_warnings(r), 0, "no warnings");
    assert_eq(reg_schema(r), SCHEMA_VERSION, "schema v3");
    assert_eq(reg_has_accelerator(r), 0, "no accelerators");
    assert_eq(reg_total_memory(r), 0, "zero memory");
    return 0;
}

fn test_registry_from_profiles() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 24 * BYTES_PER_GIB));

    var r = registry_from_profiles(profiles);
    assert_eq(reg_num_profiles(r), 3, "3 profiles");
    assert_eq(reg_has_accelerator(r), 1, "has accelerator");

    # Total memory: 64 + 24 + 24 = 112 GiB
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 112, "112 GiB total");

    # Accelerator memory (excludes CPU): 24 + 24 = 48 GiB
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 48, "48 GiB accel");
    return 0;
}

fn test_registry_best_available() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 80 * BYTES_PER_GIB));
    vec_push(profiles, profile_tpu(0, 4, TPU_V5P));

    var r = registry_from_profiles(profiles);
    var best = reg_best_available(r);
    assert(best != 0, "best exists");
    # TPU V5p (rank 80) > CUDA (rank 60) > CPU (rank 10)
    assert_eq(profile_accel_type(best), ACCEL_TPU, "best = TPU V5p");
    return 0;
}

fn test_registry_by_family() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_rocm(0, 16 * BYTES_PER_GIB));

    var r = registry_from_profiles(profiles);
    assert_eq(reg_count_by_family(r, FAMILY_GPU), 3, "3 GPUs");
    assert_eq(reg_count_by_family(r, FAMILY_CPU), 1, "1 CPU");
    assert_eq(reg_count_by_family(r, FAMILY_TPU), 0, "0 TPUs");

    var gpus = reg_by_family(r, FAMILY_GPU);
    assert_eq(vec_len(gpus), 3, "3 GPU profiles");
    return 0;
}

# --- Builder bitmask ---

fn test_builder_all() {
    var mask = builder_all();
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 1, "cuda enabled");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm enabled");
    assert_eq(builder_is_enabled(mask, BACKEND_TPU), 1, "tpu enabled");
    assert_eq(builder_is_enabled(mask, BACKEND_MEDIATEK_APU), 1, "mediatek enabled");
    return 0;
}

fn test_builder_none() {
    var mask = builder_none();
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 0, "cuda disabled");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 0, "rocm disabled");
    return 0;
}

fn test_builder_selective() {
    var mask = builder_none();
    mask = builder_with(mask, BACKEND_CUDA);
    mask = builder_with(mask, BACKEND_ROCM);

    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 1, "cuda on");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm on");
    assert_eq(builder_is_enabled(mask, BACKEND_TPU), 0, "tpu off");
    assert_eq(builder_is_enabled(mask, BACKEND_VULKAN), 0, "vulkan off");

    # Disable CUDA
    mask = builder_without(mask, BACKEND_CUDA);
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 0, "cuda now off");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm still on");
    return 0;
}

# --- 2.2.5: no-exec contract ---

fn test_backend_uses_exec() {
    # Six backends shell out to vendor CLIs
    assert_eq(backend_uses_exec(BACKEND_CUDA), 1, "cuda exec");
    assert_eq(backend_uses_exec(BACKEND_GAUDI), 1, "gaudi exec");
    assert_eq(backend_uses_exec(BACKEND_NEURON), 1, "neuron exec");
    assert_eq(backend_uses_exec(BACKEND_INTEL_ONEAPI), 1, "intel-oneapi exec");
    assert_eq(backend_uses_exec(BACKEND_CEREBRAS), 1, "cerebras exec");
    assert_eq(backend_uses_exec(BACKEND_GRAPHCORE), 1, "graphcore exec");

    # Eleven backends spawn nothing (sysfs/syscall, DXGI on Windows, sysctl on
    # macOS). Vulkan's sysfs scan is native since 2.3.29; vulkaninfo runs only
    # with exec.
    assert_eq(backend_uses_exec(BACKEND_VULKAN), 0, "vulkan native (sysfs scan)");
    assert_eq(backend_uses_exec(BACKEND_WINDOWS), 0, "windows native (dxgi)");
    assert_eq(backend_uses_exec(BACKEND_APPLE), 0, "apple native (sysctl)");
    assert_eq(backend_uses_exec(BACKEND_ROCM), 0, "rocm sysfs");
    assert_eq(backend_uses_exec(BACKEND_INTEL_NPU), 0, "intel-npu sysfs");
    assert_eq(backend_uses_exec(BACKEND_AMD_XDNA), 0, "xdna sysfs");
    assert_eq(backend_uses_exec(BACKEND_TPU), 0, "tpu sysfs");
    assert_eq(backend_uses_exec(BACKEND_QUALCOMM), 0, "qualcomm sysfs");
    assert_eq(backend_uses_exec(BACKEND_GROQ), 0, "groq sysfs");
    assert_eq(backend_uses_exec(BACKEND_SAMSUNG_NPU), 0, "samsung sysfs");
    assert_eq(backend_uses_exec(BACKEND_MEDIATEK_APU), 0, "mediatek sysfs");
    return 0;
}

fn test_builder_no_exec_mask() {
    var mask = builder_no_exec();

    # Every native backend present; Windows GPUs must not be skipped in
    # registry_detect_no_exec() (DXGI spawns nothing)
    assert_eq(builder_is_enabled(mask, BACKEND_WINDOWS), 1, "windows in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_APPLE), 1, "apple in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_VULKAN), 1, "vulkan in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_INTEL_NPU), 1, "npu in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_AMD_XDNA), 1, "xdna in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_TPU), 1, "tpu in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_QUALCOMM), 1, "qualcomm in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_GROQ), 1, "groq in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_SAMSUNG_NPU), 1, "samsung in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_MEDIATEK_APU), 1, "mediatek in mask");

    # Every exec backend absent
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 0, "cuda excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_GAUDI), 0, "gaudi excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_NEURON), 0, "neuron excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_INTEL_ONEAPI), 0, "oneapi excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_CEREBRAS), 0, "cerebras excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_GRAPHCORE), 0, "graphcore excluded");
    return 0;
}

# Defense-in-depth: even when the caller forces an EXEC bit on,
# registry_detect_with_opts(mask, 0) must strip it before dispatch.
fn test_no_exec_strips_exec_bits() {
    var poisoned = builder_no_exec() | (1 << BACKEND_CUDA) | (1 << BACKEND_NEURON);
    var stripped = poisoned & builder_no_exec();
    assert_eq(builder_is_enabled(stripped, BACKEND_CUDA), 0, "cuda forced off");
    assert_eq(builder_is_enabled(stripped, BACKEND_NEURON), 0, "neuron forced off");
    assert_eq(builder_is_enabled(stripped, BACKEND_ROCM), 1, "rocm preserved");
    return 0;
}

# No-exec memory detection reads the same figure: on Linux allow_exec has no
# effect (only the Windows wmic fallback depends on it).
fn test_no_exec_memory() {
    var mem = detect_system_memory();
    assert_gt(mem, 0, "memory detected");
    assert_eq(detect_system_memory_opts(0), mem, "no-exec memory == memory");
    assert_eq(detect_system_memory_opts(1), mem, "exec memory == memory");
    return 0;
}

# --- Detection entry points (real detectors, this host) ---

# A registry from any entry point must hold only profiles in `profiles`, only
# warnings in `warnings`, and serialize. Through 2.3.24 the threaded and lazy
# entry points gave the system-I/O post-passes the registry instead of its
# system_io: storage structs landed in `warnings` (their first field, a name
# pointer, reads as an out-of-range warning code) and registry_to_json
# segfaulted.
fn check_registry_shape(r, label) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    assert_gt(n, 0, label);
    var bad = 0;
    var i = 0;
    while (i < n) {
        var t = profile_accel_type(vec_get(profs, i));
        if (t < ACCEL_CPU) { bad = bad + 1; }
        if (t > ACCEL_AGNOS_GPU) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    var warns = reg_warnings(r);
    var nw = vec_len(warns);
    bad = 0;
    i = 0;
    while (i < nw) {
        var c = warning_code(vec_get(warns, i));
        if (c < HWA_ERR_NONE) { bad = bad + 1; }
        if (c > HWA_ERR_SYSFS_READ) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    var js = registry_to_json(r);
    assert_eq(memeq(str_data(js), "{\"schema_version\":", 18), 1, label);
    assert_eq(load8(str_data(js) + str_len(js) - 1), 125, label);
    return 0;
}

# No-exec mode runs Vulkan's sysfs scan (2.3.29), which leaves amdgpu devices
# to ROCm, since ROCm reads the same nodes. On any host the scan with that rule
# reports exactly ROCm's devices fewer: the dev host's one APU, or none where
# no amdgpu device exists.
fn test_vulkan_sysfs_leaves_amdgpu() {
    var all = vec_new();
    _detect_vulkan_sysfs(all, 0);
    var left = vec_new();
    _detect_vulkan_sysfs(left, 1);
    var rocm = vec_new();
    detect_rocm(rocm, vec_new());
    assert_eq(vec_len(all) - vec_len(left), vec_len(rocm), "scan leaves exactly ROCm's devices");
    # registry_detect_no_exec() holds exactly those Vulkan profiles: no
    # vulkaninfo run, and no second profile for an AMD GPU.
    var profs = reg_profiles(registry_detect_no_exec());
    var vk = 0;
    var i = 0;
    while (i < vec_len(profs)) {
        if (profile_accel_type(vec_get(profs, i)) == ACCEL_VULKAN) { vk = vk + 1; }
        i = i + 1;
    }
    assert_eq(vk, vec_len(left), "no-exec: the scan's Vulkan profiles only");
    return 0;
}

fn test_detection_entry_points() {
    check_registry_shape(registry_detect(), "registry_detect");
    check_registry_shape(registry_detect_no_exec(), "registry_detect_no_exec");
    check_registry_shape(registry_detect_threaded(), "registry_detect_threaded");
    check_registry_shape(lazy_into_registry(lazy_new()), "lazy_into_registry");
    return 0;
}

# --- Totals count system RAM once (2.3.28) ---

fn _reg(a, b, c) {
    var v = vec_new();
    if (a != 0) { vec_push(v, a); }
    if (b != 0) { vec_push(v, b); }
    if (c != 0) { vec_push(v, c); }
    return registry_from_profiles(v);
}

# ecb, a 48 GB Apple M5 Pro: CPU 48, Metal 48 and Neural Engine 4 all draw on
# one 48 GiB pool. 2.3.27 reported 100 GiB total and 52 GiB accelerator.
fn test_totals_apple_unified() {
    var r = _reg(profile_cpu(48 * BYTES_PER_GIB),
      profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB),
      profile_new(ACCEL_APPLE_NPU, 0, 4 * BYTES_PER_GIB));
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 48, "mac total = RAM once");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 48, "mac accel = the unified pool");
    return 0;
}

# GH200: 96 GiB HBM of its own plus 480 GiB of Grace memory, which is also
# the CPU's. Total = 96 + 480, not 96 + 480 + 480.
fn test_totals_gh200() {
    var gpu = profile_cuda(0, 576 * BYTES_PER_GIB);
    profile_set_shared_mem(gpu, 480 * BYTES_PER_GIB);
    var r = _reg(profile_cpu(480 * BYTES_PER_GIB), gpu, 0);
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 576, "gh200 total");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 576, "gh200 accel");
    return 0;
}

# A laptop NPU has no memory of its own: its 2 GiB estimate is system RAM.
fn test_totals_npu_laptop() {
    var r = _reg(profile_cpu(32 * BYTES_PER_GIB), profile_new(ACCEL_INTEL_NPU, 0, 2 * BYTES_PER_GIB), 0);
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 32, "npu laptop total = RAM");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 2, "npu budget still counts as accel");
    return 0;
}

# A discrete GPU keeps adding its own memory next to a shared-memory NPU.
fn test_totals_mixed() {
    var r = _reg(profile_cpu(64 * BYTES_PER_GIB), profile_cuda(0, 24 * BYTES_PER_GIB),
      profile_new(ACCEL_INTEL_NPU, 0, 2 * BYTES_PER_GIB));
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 88, "mixed total = RAM + VRAM");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 26, "mixed accel = VRAM + npu budget");
    return 0;
}

# Without a CPU profile the pool still counts once; unavailable profiles
# count nowhere.
fn test_totals_no_cpu_and_unavailable() {
    var r = _reg(profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB),
      profile_new(ACCEL_APPLE_NPU, 0, 4 * BYTES_PER_GIB), 0);
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 48, "no cpu: pool once");
    var off = profile_new(ACCEL_METAL, 0, 96 * BYTES_PER_GIB);
    profile_set_available(off, 0);
    var r2 = _reg(profile_cpu(16 * BYTES_PER_GIB), off, 0);
    assert_eq(reg_total_memory(r2) / BYTES_PER_GIB, 16, "unavailable ignored");
    assert_eq(reg_total_accel_memory(r2), 0, "unavailable accel ignored");
    return 0;
}

# cass's Intel UHD 600 seen through Vulkan (the real vulkaninfo captures in
# tests/fixtures/vulkaninfo/, read from the repository root): its heap is half
# of cass's RAM and all of it system RAM, so the total is the RAM once. Through
# 2.3.28 the GPU's 4 GiB estimate was added on top.
fn _fixture(path) {
    var cap = 262144;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap - 1);
    assert_gt(n, 0, path);
    if (n <= 0) { return str_from(""); }
    store8(buf + n, 0);
    return str_new(buf, n);
}

fn test_totals_vulkan_igpu() {
    var v = vec_new();
    vec_push(v, profile_cpu(8405598208));
    var ids = vec_new();
    _parse_vulkaninfo_ids(_fixture("tests/fixtures/vulkaninfo/uhd600-windows-summary.txt"), v, ids);
    vulkan_size_shared(v, 1, ids, _fixture("tests/fixtures/vulkaninfo/uhd600-windows-full.txt"));
    var r = registry_from_profiles(v);
    assert_eq(reg_total_memory(r), 8405598208, "igpu: total is the RAM once");
    assert_eq(reg_total_accel_memory(r), 4202799104, "igpu: accel is its heap");
    return 0;
}

# A shared_mem outside [0, memory_bytes] (a foreign shared_memory_bytes, or a
# memory_bytes lowered after construction) is clamped as profile_shared_bytes
# clamps it: a negative part counts as 0, one past memory_bytes as all of it.
fn test_totals_clamped() {
    var neg = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_shared_mem(neg, 0 - 5 * BYTES_PER_GIB);
    var over = profile_cuda(1, 16 * BYTES_PER_GIB);
    profile_set_shared_mem(over, 99 * BYTES_PER_GIB);
    var v = vec_new();
    vec_push(v, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(v, neg);
    vec_push(v, over);
    vec_push(v, profile_new(ACCEL_INTEL_NPU, 0, 32 * BYTES_PER_GIB));
    var r = registry_from_profiles(v);
    # neg adds its 24; over is all shared; the pool is max(64, 16, 32).
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 88, "clamped total");
    # Without the CPU the pool is the NPU's 32.
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 56, "clamped accel");
    return 0;
}

# --- One physical device, one profile (2.4.0) ---

# A GPU profile of `atype` with a PCI id and name, for the dedup tests.
fn _gpu(atype, vendor, device, name, mem) {
    var p = profile_new(atype, 0, mem);
    profile_set_pci_id(p, pci_id_make(vendor, device));
    profile_set_device_name(p, name);
    return p;
}

fn test_placeholder_names() {
    assert_eq(profile_name_is_placeholder(0), 1, "no name");
    assert_eq(profile_name_is_placeholder(""), 1, "empty name");
    assert_eq(profile_name_is_placeholder("AMD Radeon (PCI 0x1002:0x1638)"), 1, "rocm fallback");
    assert_eq(profile_name_is_placeholder("AMD Radeon"), 1, "bare rocm fallback");
    assert_eq(profile_name_is_placeholder("Apple Silicon (Asahi Linux)"), 1, "asahi");
    assert_eq(profile_name_is_placeholder("Apple Silicon"), 1, "system_profiler default");
    assert_eq(profile_name_is_placeholder("AMD Radeon RX 7900 XTX"), 0, "a model");
    assert_eq(profile_name_is_placeholder("Apple M5 Pro"), 0, "a chip");
    return 0;
}

# The dev host: ROCm and Vulkan report its one APU. ROCm's profile survives,
# with RADV's name in place of its PCI-id fallback; the 8 GiB counts once.
fn test_dedup_rocm_vulkan() {
    var v = vec_new();
    vec_push(v, profile_cpu(58880188416));
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x1638, "AMD Radeon (PCI 0x1002:0x1638)", 8 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x1638, "AMD Radeon Graphics (RADV RENOIR)", 8 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 1, "apu: one dropped");
    assert_eq(vec_len(v), 2, "apu: cpu + one gpu");
    var g = vec_get(v, 1);
    assert_eq(profile_accel_type(g), ACCEL_ROCM, "apu: rocm survives");
    assert(streq(profile_device_name(g), "AMD Radeon Graphics (RADV RENOIR)") == 1, "apu: RADV's name kept");
    var r = registry_from_profiles(v);
    assert_eq(reg_total_accel_memory(r), 8 * BYTES_PER_GIB, "apu: 8 GiB once");
    assert_eq(reg_total_memory(r), 58880188416 + 8 * BYTES_PER_GIB, "apu: total");
    return 0;
}

# Two identical NVIDIA cards next to an Intel iGPU: both Vulkan views of the
# cards go, the iGPU (no dedicated backend) stays, and order is kept. The Rust
# releases dropped the iGPU too.
fn test_dedup_cuda_keeps_other_gpus() {
    var v = vec_new();
    vec_push(v, _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    var igpu = _gpu(ACCEL_VULKAN, 0x8086, 0x46a6, "Intel(R) Graphics (ADL GT2)", 4 * BYTES_PER_GIB);
    profile_set_shared_mem(igpu, 4 * BYTES_PER_GIB);
    vec_push(v, igpu);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 2, "two card views dropped");
    assert_eq(vec_len(v), 3, "two cards + the igpu");
    assert_eq(profile_accel_type(vec_get(v, 0)), ACCEL_CUDA, "order: cuda 0");
    assert_eq(profile_accel_type(vec_get(v, 1)), ACCEL_CUDA, "order: cuda 1");
    assert(vec_get(v, 2) == igpu, "order: the igpu last, kept");
    assert(streq(profile_device_name(vec_get(v, 0)), "NVIDIA GeForce RTX 4090") == 1, "a real name is not replaced");
    return 0;
}

# A GPU two Vulkan drivers list (RADV and AMDVLK) is still one device.
fn test_dedup_two_vulkan_drivers() {
    var v = vec_new();
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 2, "both driver views dropped");
    assert_eq(vec_len(v), 1, "the card once");
    assert(streq(profile_device_name(vec_get(v, 0)), "AMD Radeon RX 7900 XTX") == 1, "product name not replaced");
    return 0;
}

# Nothing matches on an unknown id, on a different id, or against another
# Vulkan profile; a lone Vulkan GPU stays.
fn test_dedup_no_false_matches() {
    var v = vec_new();
    vec_push(v, profile_new(ACCEL_CUDA, 0, 8 * BYTES_PER_GIB));
    vec_push(v, profile_new(ACCEL_VULKAN, 0, 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x73bf, "AMD Radeon RX 6800", 16 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 0, "nothing dropped");
    assert_eq(vec_len(v), 6, "all kept");
    return 0;
}

# Apple Silicon: MoltenVK (macOS) and Honeykrisp (Asahi) list the Metal GPU.
# An integrated Vulkan GPU on system RAM next to a Metal profile is the same
# device; Asahi's generic Metal name takes Honeykrisp's.
fn test_dedup_apple() {
    var mac = vec_new();
    var metal = profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB);
    profile_set_device_name(metal, "Apple M5 Pro");
    vec_push(mac, metal);
    var mvk = profile_new(ACCEL_VULKAN, 0, 36 * BYTES_PER_GIB);
    profile_set_device_name(mvk, "Apple M5 Pro");
    profile_set_shared_mem(mvk, 36 * BYTES_PER_GIB);
    vec_push(mac, mvk);
    assert_eq(profiles_dedup(mac), 1, "moltenvk dropped");
    assert(vec_get(mac, 0) == metal, "metal survives");
    var asahi = vec_new();
    var am = profile_new(ACCEL_METAL, 0, 32 * BYTES_PER_GIB);
    profile_set_device_name(am, "Apple Silicon (Asahi Linux)");
    vec_push(asahi, am);
    var hk = profile_new(ACCEL_VULKAN, 0, 16 * BYTES_PER_GIB);
    profile_set_device_name(hk, "Apple M1 Max (G13C C0)");
    profile_set_shared_mem(hk, 16 * BYTES_PER_GIB);
    vec_push(asahi, hk);
    assert_eq(profiles_dedup(asahi), 1, "honeykrisp dropped");
    assert(streq(profile_device_name(am), "Apple M1 Max (G13C C0)") == 1, "asahi takes the chip name");
    # A Vulkan GPU with memory of its own is not the SoC GPU.
    var egpu = vec_new();
    vec_push(egpu, profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB));
    vec_push(egpu, profile_new(ACCEL_VULKAN, 0, 8 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(egpu), 0, "dedicated vulkan gpu kept");
    return 0;
}

# Property test: 300 pseudo-random profile sets (a fixed LCG seed), up to 12
# profiles of CUDA / ROCm / Vulkan / Metal with PCI ids drawn from a few
# values (0 = unknown) and Vulkan GPUs shared or not. After profiles_dedup:
# no Vulkan profile with a twin is left, every other profile is, order is
# kept, and a second pass drops nothing.
var _lcg = 12345;

fn _rnd(n) {
    _lcg = (_lcg * 1103515245 + 12345) & 0x7FFFFFFF;
    return (_lcg >> 8) % n;
}

fn test_dedup_properties() {
    var bad = 0;
    var round = 0;
    while (round < 300) {
        round = round + 1;
        var v = vec_new();
        var n = _rnd(13);
        var k = 0;
        while (k < n) {
            var kind = _rnd(4);
            var atype = ACCEL_VULKAN;
            if (kind == 0) { atype = ACCEL_CUDA; }
            if (kind == 1) { atype = ACCEL_ROCM; }
            if (kind == 2) {
                if (_rnd(4) == 0) { atype = ACCEL_METAL; }
            }
            var p = profile_new(atype, k, BYTES_PER_GIB);
            var ids = _rnd(4);
            if (ids == 1) { profile_set_pci_id(p, pci_id_make(0x10DE, 0x2684)); }
            if (ids == 2) { profile_set_pci_id(p, pci_id_make(0x1002, 0x1638)); }
            if (ids == 3) { profile_set_pci_id(p, pci_id_make(0x8086, 0x46a6)); }
            if (atype == ACCEL_VULKAN) {
                if (_rnd(2) == 1) { profile_set_shared_mem(p, BYTES_PER_GIB); }
            }
            vec_push(v, p);
            k = k + 1;
        }
        var before = vec_new();
        var i = 0;
        while (i < n) {
            vec_push(before, vec_get(v, i));
            i = i + 1;
        }
        var dropped = profiles_dedup(v);
        if (vec_len(v) != n - dropped) { bad = bad + 1; }
        # Survivors, in order: walk `before`, matching `v` from the front.
        var j = 0;
        i = 0;
        while (i < n) {
            var q = vec_get(before, i);
            i = i + 1;
            var here = 0;
            if (j < vec_len(v)) {
                if (vec_get(v, j) == q) { here = 1; }
            }
            if (here == 1) {
                j = j + 1;
                if (profile_accel_type(q) == ACCEL_VULKAN) {
                    if (_dedup_twin(before, q) != 0) { bad = bad + 1; }
                }
            } else {
                # Only a Vulkan profile with a twin may be missing.
                if (profile_accel_type(q) != ACCEL_VULKAN) { bad = bad + 1; }
                elif (_dedup_twin(before, q) == 0) { bad = bad + 1; }
            }
        }
        if (j != vec_len(v)) { bad = bad + 1; }
        if (profiles_dedup(v) != 0) { bad = bad + 1; }
    }
    assert_eq(bad, 0, "dedup properties over 300 random sets");
    return 0;
}

# On any host, no entry point returns a Vulkan profile next to the CUDA or
# ROCm profile of the same device. On the dev host this is its APU.
fn _dupes(r) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var d = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_accel_type(p) == ACCEL_VULKAN) {
            if (_dedup_twin(profs, p) != 0) { d = d + 1; }
        }
    }
    return d;
}

fn test_dedup_entry_points() {
    assert_eq(_dupes(registry_detect()), 0, "registry_detect: one profile per device");
    assert_eq(_dupes(registry_detect_no_exec()), 0, "no_exec: one profile per device");
    assert_eq(_dupes(registry_detect_threaded()), 0, "threaded: one profile per device");
    assert_eq(_dupes(lazy_into_registry(lazy_new())), 0, "lazy: one profile per device");
    # The Vulkan scan without its no-exec rule does see the APU; dedup drops it.
    var scan = vec_new();
    detect_rocm(scan, vec_new());
    _detect_vulkan_sysfs(scan, 0);
    profiles_dedup(scan);
    var vk = 0;
    var i = 0;
    while (i < vec_len(scan)) {
        if (profile_accel_type(vec_get(scan, i)) == ACCEL_VULKAN) { vk = vk + 1; }
        i = i + 1;
    }
    var left = vec_new();
    _detect_vulkan_sysfs(left, 1);
    assert_eq(vk, vec_len(left), "the scan's AMD cards are ROCm's");
    return 0;
}

# --- Suggest quantization ---

fn test_suggest_quant_gpu_small() {
    # 7B model on 24 GiB GPU -> FP16 fits (14 GB + 20% = 16.8 GB < 24 GB)
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var q = reg_suggest_quant(r, 7000000000);
    assert_eq(q, QUANT_FP16, "7B on 24GB GPU -> FP16");
    return 0;
}

fn test_suggest_quant_gpu_large() {
    # 70B model on 24 GiB GPU -> FP16 won't fit (140 GB), INT8 won't fit (70 GB), INT4 fits (35 GB)
    # But 35 GB > 24 GB, so INT4 doesn't fit either -> fallback to CPU INT4
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var q = reg_suggest_quant(r, 70000000000);
    # CPU has 64 GB: FP16=168GB no, INT8=84GB no, INT4=42GB yes
    assert_eq(q, QUANT_INT4, "70B on 24GB GPU -> INT4");
    return 0;
}

fn test_suggest_quant_tpu() {
    # 7B on TPU -> BF16 preferred
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_tpu(0, 4, TPU_V5P));
    var r = registry_from_profiles(profiles);

    var q = reg_suggest_quant(r, 7000000000);
    assert_eq(q, QUANT_BF16, "7B on TPU -> BF16");
    return 0;
}

fn test_suggest_quant_cpu_only() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(16 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    # 7B on 16 GiB CPU: FP16=16.8GB < 17.18GB (16 GiB) -> fits
    var q = reg_suggest_quant(r, 7000000000);
    assert_eq(q, QUANT_FP16, "7B on 16GiB CPU -> FP16");

    # 13B on 16 GiB CPU: FP16=31.2GB no, INT8=15.6GB yes
    var profiles2 = vec_new();
    vec_push(profiles2, profile_cpu(16 * BYTES_PER_GIB));
    var r2 = registry_from_profiles(profiles2);
    var q2 = reg_suggest_quant(r2, 13000000000);
    assert_eq(q2, QUANT_INT8, "13B on 16GiB CPU -> INT8");
    return 0;
}

# --- Memory estimation ---

fn test_estimate_memory() {
    # 7B at FP16: 7B * 16 / 8 = 14 GB + 20% = 16.8 GB
    var est = reg_estimate_memory(7000000000, QUANT_FP16);
    assert_eq(est, 16800000000, "7B FP16 = 16.8 GB");

    # 70B at INT4: 70B * 4 / 8 = 35 GB + 20% = 42 GB
    var est2 = reg_estimate_memory(70000000000, QUANT_INT4);
    assert_eq(est2, 42000000000, "70B INT4 = 42 GB");
    return 0;
}

