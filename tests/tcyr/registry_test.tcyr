# --- Registry construction ---

fn test_registry_new() {
    var r = hw_registry_new();
    assert_eq(reg_num_profiles(r), 0, "empty registry");
    assert_eq(reg_num_warnings(r), 0, "no warnings");
    assert_eq(reg_schema(r), SCHEMA_VERSION, "schema v3");
    assert_eq(reg_has_accelerator(r), 0, "no accelerators");
    assert_eq(reg_total_memory(r), 0, "zero memory");
    return 0;
}

fn test_registry_from_profiles() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 24 * BYTES_PER_GIB));

    var r = registry_from_profiles(profiles);
    assert_eq(reg_num_profiles(r), 3, "3 profiles");
    assert_eq(reg_has_accelerator(r), 1, "has accelerator");

    # Total memory: 64 + 24 + 24 = 112 GiB
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 112, "112 GiB total");

    # Accelerator memory (excludes CPU): 24 + 24 = 48 GiB
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 48, "48 GiB accel");
    return 0;
}

fn test_registry_best_available() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 80 * BYTES_PER_GIB));
    vec_push(profiles, profile_tpu(0, 4, TPU_V5P));

    var r = registry_from_profiles(profiles);
    var best = reg_best_available(r);
    assert(best != 0, "best exists");
    # TPU V5p (rank 80) > CUDA (rank 60) > CPU (rank 10)
    assert_eq(profile_accel_type(best), ACCEL_TPU, "best = TPU V5p");
    return 0;
}

fn test_registry_by_family() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_rocm(0, 16 * BYTES_PER_GIB));

    var r = registry_from_profiles(profiles);
    assert_eq(reg_count_by_family(r, FAMILY_GPU), 3, "3 GPUs");
    assert_eq(reg_count_by_family(r, FAMILY_CPU), 1, "1 CPU");
    assert_eq(reg_count_by_family(r, FAMILY_TPU), 0, "0 TPUs");

    var gpus = reg_by_family(r, FAMILY_GPU);
    assert_eq(vec_len(gpus), 3, "3 GPU profiles");
    return 0;
}

# hw_registry_new and targ_new allocate sizeof their struct, plus the vecs
# and system_io they create (2.5.5; through 2.5.4, literals).
fn test_constructor_sizes() {
    var u = alloc_used();
    vec_new();
    var vec_bytes = alloc_used() - u;
    u = alloc_used();
    system_io_new();
    var sio_bytes = alloc_used() - u;
    u = alloc_used();
    hw_registry_new();
    assert_eq(alloc_used() - u, sizeof(reg) + 2 * vec_bytes + sio_bytes, "hw_registry_new: sizeof(reg)");
    assert_eq(REGISTRY_SIZE, sizeof(reg), "REGISTRY_SIZE is sizeof(reg)");
    u = alloc_used();
    targ_new(BACKEND_CUDA);
    assert_eq(alloc_used() - u, sizeof(targ) + 2 * vec_bytes, "targ_new: sizeof(targ)");
    return 0;
}

# An index outside the registry is 0, not vec_get's abort, which exits the
# calling thread (2.5.5).
fn test_reg_get_profile_bounds() {
    var v = vec_new();
    var cpu = profile_cpu(16 * BYTES_PER_GIB);
    vec_push(v, cpu);
    var r = registry_from_profiles(v);
    assert_eq(reg_get_profile(r, 0), cpu, "index 0: the profile");
    assert_eq(reg_get_profile(r, 1), 0, "index past the end: 0");
    assert_eq(reg_get_profile(r, 0 - 1), 0, "negative index: 0");
    assert_eq(reg_get_profile(hw_registry_new(), 0), 0, "empty registry: 0");
    return 0;
}

# A profile of a type this build does not know (a newer producer's JSON) is
# family Unknown (2.5.5): not counted with the CPU, not the CPU's memory for
# reg_suggest_quant, and still an accelerator. Through 2.5.4 it was a CPU to
# the family queries and an accelerator to the others.
fn test_foreign_type_in_registry() {
    var v = vec_new();
    vec_push(v, profile_cpu(8 * BYTES_PER_GIB));
    vec_push(v, profile_new(ACCEL_TYPE_COUNT, 0, 64 * BYTES_PER_GIB));
    var r = registry_from_profiles(v);
    assert_eq(reg_count_by_family(r, FAMILY_CPU), 1, "foreign: not counted as CPU");
    assert_eq(vec_len(reg_by_family(r, FAMILY_CPU)), 1, "foreign: not in the CPU family");
    assert_eq(reg_count_by_family(r, FAMILY_UNKNOWN), 1, "foreign: family Unknown");
    assert_eq(reg_has_accelerator(r), 1, "foreign: still an accelerator");
    # 13B: the CPU's 8 GiB holds INT4 only; the foreign 64 GiB is no CPU.
    assert_eq(reg_suggest_quant(r, 13000000000), QUANT_INT4, "foreign: not the CPU's memory");
    return 0;
}

# reg_by_family_into refills the caller's vec: once it has grown, repeat
# queries allocate nothing (2.5.5). reg_by_family allocates a vec per call,
# which the bump allocator never frees: 10 000 calls grew a long-lived
# consumer by 1.5 MB.
fn test_by_family_into_bounded() {
    var v = vec_new();
    vec_push(v, profile_cpu(16 * BYTES_PER_GIB));
    vec_push(v, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(v, profile_rocm(0, 16 * BYTES_PER_GIB));
    var r = registry_from_profiles(v);
    var out = vec_new();
    reg_by_family_into(r, FAMILY_GPU, out);
    assert_eq(vec_len(out), 2, "into: the two GPUs");
    var u0 = alloc_used();
    var i = 0;
    while (i < 1000) {
        reg_by_family_into(r, FAMILY_GPU, out);
        i = i + 1;
    }
    assert_eq(alloc_used() - u0, 0, "into: 1000 queries allocate nothing");
    assert_eq(vec_len(reg_by_family_into(r, FAMILY_CPU, out)), 1, "into: emptied first");
    if (vec_len(out) == 1) { assert_eq(vec_get(out, 0), vec_get(v, 0), "into: the CPU profile"); }
    return 0;
}

# --- Builder bitmask ---

fn test_builder_all() {
    var mask = builder_all();
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 1, "cuda enabled");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm enabled");
    assert_eq(builder_is_enabled(mask, BACKEND_TPU), 1, "tpu enabled");
    assert_eq(builder_is_enabled(mask, BACKEND_MEDIATEK_APU), 1, "mediatek enabled");
    return 0;
}

fn test_builder_none() {
    var mask = builder_none();
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 0, "cuda disabled");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 0, "rocm disabled");
    return 0;
}

fn test_builder_selective() {
    var mask = builder_none();
    mask = builder_with(mask, BACKEND_CUDA);
    mask = builder_with(mask, BACKEND_ROCM);

    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 1, "cuda on");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm on");
    assert_eq(builder_is_enabled(mask, BACKEND_TPU), 0, "tpu off");
    assert_eq(builder_is_enabled(mask, BACKEND_VULKAN), 0, "vulkan off");

    # Disable CUDA
    mask = builder_without(mask, BACKEND_CUDA);
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 0, "cuda now off");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm still on");
    return 0;
}

# --- 2.2.5: no-exec contract ---

fn test_backend_uses_exec() {
    # Six backends' vendor CLI is their source of record, as through 2.5.4,
    # so a mask holding one runs the tools.
    assert_eq(backend_uses_exec(BACKEND_CUDA), 1, "cuda exec");
    assert_eq(backend_uses_exec(BACKEND_INTEL_ONEAPI), 1, "intel-oneapi exec");
    assert_eq(backend_uses_exec(BACKEND_GAUDI), 1, "gaudi exec (hl-smi)");
    assert_eq(backend_uses_exec(BACKEND_NEURON), 1, "neuron exec (neuron-ls)");
    assert_eq(backend_uses_exec(BACKEND_CEREBRAS), 1, "cerebras exec (cerebras_cli)");
    assert_eq(backend_uses_exec(BACKEND_GRAPHCORE), 1, "graphcore exec (gc-info)");
    # Two of them find nothing without it; the other four fall back to their
    # device nodes with exec off (2.5.5).
    assert_eq(backend_needs_exec(BACKEND_CUDA), 1, "cuda needs exec");
    assert_eq(backend_needs_exec(BACKEND_INTEL_ONEAPI), 1, "intel-oneapi needs exec");
    assert_eq(backend_needs_exec(BACKEND_GAUDI), 0, "gaudi: accel nodes without exec");
    assert_eq(backend_needs_exec(BACKEND_NEURON), 0, "neuron: /dev nodes without exec");
    assert_eq(backend_needs_exec(BACKEND_CEREBRAS), 0, "cerebras: /dev nodes without exec");
    assert_eq(backend_needs_exec(BACKEND_GRAPHCORE), 0, "graphcore: /dev nodes without exec");
    var b = 0;
    var bad = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (backend_needs_exec(b) == 1 && backend_uses_exec(b) == 0) { bad = bad + 1; }
        b = b + 1;
    }
    assert_eq(bad, 0, "needs exec implies uses exec");

    # Eleven backends spawn nothing (sysfs/syscall, DXGI on Windows, sysctl on
    # macOS). Vulkan's sysfs scan is native since 2.3.29; vulkaninfo runs
    # only with exec.
    assert_eq(backend_uses_exec(BACKEND_VULKAN), 0, "vulkan native (sysfs scan)");
    assert_eq(backend_uses_exec(BACKEND_WINDOWS), 0, "windows native (dxgi)");
    assert_eq(backend_uses_exec(BACKEND_APPLE), 0, "apple native (sysctl)");
    assert_eq(backend_uses_exec(BACKEND_ROCM), 0, "rocm sysfs");
    assert_eq(backend_uses_exec(BACKEND_INTEL_NPU), 0, "intel-npu sysfs");
    assert_eq(backend_uses_exec(BACKEND_AMD_XDNA), 0, "xdna sysfs");
    assert_eq(backend_uses_exec(BACKEND_TPU), 0, "tpu sysfs");
    assert_eq(backend_uses_exec(BACKEND_QUALCOMM), 0, "qualcomm sysfs");
    assert_eq(backend_uses_exec(BACKEND_GROQ), 0, "groq sysfs");
    assert_eq(backend_uses_exec(BACKEND_SAMSUNG_NPU), 0, "samsung sysfs");
    assert_eq(backend_uses_exec(BACKEND_MEDIATEK_APU), 0, "mediatek sysfs");
    return 0;
}

fn test_builder_no_exec_mask() {
    var mask = builder_no_exec();

    # Every native backend present; Windows GPUs must not be skipped in
    # registry_detect_no_exec() (DXGI spawns nothing)
    assert_eq(builder_is_enabled(mask, BACKEND_WINDOWS), 1, "windows in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_APPLE), 1, "apple in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_VULKAN), 1, "vulkan in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_ROCM), 1, "rocm in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_INTEL_NPU), 1, "npu in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_AMD_XDNA), 1, "xdna in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_TPU), 1, "tpu in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_QUALCOMM), 1, "qualcomm in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_GROQ), 1, "groq in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_SAMSUNG_NPU), 1, "samsung in mask");
    assert_eq(builder_is_enabled(mask, BACKEND_MEDIATEK_APU), 1, "mediatek in mask");
    # Every exec backend absent, as through 2.5.4: a mask of them runs tools.
    assert_eq(builder_is_enabled(mask, BACKEND_CUDA), 0, "cuda excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_INTEL_ONEAPI), 0, "oneapi excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_GAUDI), 0, "gaudi excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_NEURON), 0, "neuron excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_CEREBRAS), 0, "cerebras excluded");
    assert_eq(builder_is_enabled(mask, BACKEND_GRAPHCORE), 0, "graphcore excluded");

    # 2.5.5: registry_detect_no_exec() runs builder_native(), which adds the
    # four with device-node fallbacks; only CUDA and oneAPI stay out.
    var nat = builder_native();
    assert_eq(nat & mask, mask, "native: every no_exec backend");
    assert_eq(builder_is_enabled(nat, BACKEND_GAUDI), 1, "native: gaudi");
    assert_eq(builder_is_enabled(nat, BACKEND_NEURON), 1, "native: neuron");
    assert_eq(builder_is_enabled(nat, BACKEND_CEREBRAS), 1, "native: cerebras");
    assert_eq(builder_is_enabled(nat, BACKEND_GRAPHCORE), 1, "native: graphcore");
    assert_eq(builder_is_enabled(nat, BACKEND_CUDA), 0, "native: cuda excluded");
    assert_eq(builder_is_enabled(nat, BACKEND_INTEL_ONEAPI), 0, "native: oneapi excluded");
    return 0;
}

# Defense-in-depth: even when the caller forces an EXEC bit on,
# registry_detect_with_opts(mask, 0) must strip it before dispatch.
fn test_no_exec_strips_exec_bits() {
    var poisoned = builder_native() | (1 << BACKEND_CUDA) | (1 << BACKEND_INTEL_ONEAPI);
    var stripped = poisoned & builder_native();
    assert_eq(builder_is_enabled(stripped, BACKEND_CUDA), 0, "cuda forced off");
    assert_eq(builder_is_enabled(stripped, BACKEND_INTEL_ONEAPI), 0, "oneapi forced off");
    assert_eq(builder_is_enabled(stripped, BACKEND_ROCM), 1, "rocm preserved");
    assert_eq(builder_is_enabled(stripped, BACKEND_GAUDI), 1, "gaudi preserved (accel nodes)");
    return 0;
}

# No-exec memory detection reads the same figure: on Linux allow_exec has no
# effect (only the Windows wmic fallback depends on it).
fn test_no_exec_memory() {
    var mem = detect_system_memory();
    assert_gt(mem, 0, "memory detected");
    assert_eq(detect_system_memory_opts(0), mem, "no-exec memory == memory");
    assert_eq(detect_system_memory_opts(1), mem, "exec memory == memory");
    return 0;
}

# --- Detection entry points (real detectors, this host) ---

# A registry from any entry point must hold only profiles in `profiles`, only
# warnings in `warnings`, and serialize. Through 2.3.24 the threaded and lazy
# entry points gave the system-I/O post-passes the registry instead of its
# system_io: storage structs landed in `warnings` (their first field, a name
# pointer, reads as an out-of-range warning code) and registry_to_json
# segfaulted.
fn check_registry_shape(r, label) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    assert_gt(n, 0, label);
    var bad = 0;
    var i = 0;
    while (i < n) {
        var t = profile_accel_type(vec_get(profs, i));
        if (t < ACCEL_CPU) { bad = bad + 1; }
        if (t >= ACCEL_TYPE_COUNT) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    var warns = reg_warnings(r);
    var nw = vec_len(warns);
    bad = 0;
    i = 0;
    while (i < nw) {
        var c = warning_code(vec_get(warns, i));
        if (c < HWA_ERR_NONE) { bad = bad + 1; }
        if (c > HWA_ERR_SYSFS_READ) { bad = bad + 1; }
        i = i + 1;
    }
    assert_eq(bad, 0, label);
    var js = registry_to_json(r);
    assert_eq(memeq(str_data(js), "{\"schema_version\":", 18), 1, label);
    assert_eq(load8(str_data(js) + str_len(js) - 1), 125, label);
    # And it parses: a real host's device names and warnings go into it
    # (2.5.5; through 2.5.4 nothing escaped them).
    assert(bayan_json_v_parse_buf(str_data(js), str_len(js)) != 0, label);
    return 0;
}

# No-exec mode runs Vulkan's sysfs scan (2.3.29), which leaves amdgpu devices
# to ROCm, since ROCm reads the same nodes. On any host the scan with that rule
# reports exactly ROCm's devices fewer: the dev host's one APU, or none where
# no amdgpu device exists.
fn test_vulkan_sysfs_leaves_amdgpu() {
    var all = vec_new();
    _detect_vulkan_sysfs(all, 0);
    var left = vec_new();
    _detect_vulkan_sysfs(left, 1);
    var rocm = vec_new();
    detect_rocm(rocm, vec_new());
    assert_eq(vec_len(all) - vec_len(left), vec_len(rocm), "scan leaves exactly ROCm's devices");
    # registry_detect_no_exec() holds exactly those Vulkan profiles: no
    # vulkaninfo run, and no second profile for an AMD GPU.
    var profs = reg_profiles(registry_detect_no_exec());
    var vk = 0;
    var i = 0;
    while (i < vec_len(profs)) {
        if (profile_accel_type(vec_get(profs, i)) == ACCEL_VULKAN) { vk = vk + 1; }
        i = i + 1;
    }
    assert_eq(vk, vec_len(left), "no-exec: the scan's Vulkan profiles only");
    return 0;
}

# --- A mask without an exec backend spawns nothing (2.5.1) ---

fn test_builder_uses_exec() {
    assert_eq(builder_uses_exec(builder_all()), 1, "all: uses exec");
    assert_eq(builder_uses_exec(builder_no_exec()), 0, "no_exec mask: no exec");
    assert_eq(builder_uses_exec(builder_none()), 0, "none: no exec");
    assert_eq(builder_uses_exec(builder_with(builder_none(), BACKEND_VULKAN)), 0, "vulkan alone: no exec");
    # A selective mask of Gaudi, Neuron, Cerebras or Graphcore runs their
    # tools, as through 2.5.4 (and vulkaninfo, system_profiler with them).
    assert_eq(builder_uses_exec(builder_with(builder_none(), BACKEND_GAUDI)), 1, "gaudi alone: exec");
    assert_eq(builder_uses_exec(builder_with(builder_none(), BACKEND_NEURON)), 1, "neuron alone: exec");
    assert_eq(builder_uses_exec(builder_with(builder_none(), BACKEND_CEREBRAS)), 1, "cerebras alone: exec");
    assert_eq(builder_uses_exec(builder_with(builder_none(), BACKEND_GRAPHCORE)), 1, "graphcore alone: exec");
    assert_eq(builder_uses_exec(builder_with(builder_none(), BACKEND_CUDA)), 1, "cuda: exec");
    assert_eq(builder_uses_exec(builder_with(builder_no_exec(), BACKEND_INTEL_ONEAPI)), 1, "no_exec + oneapi: exec");
    return 0;
}

# Warnings that mean detection tried to run a tool: not found, failed, or
# killed at the deadline.
fn _tool_warnings(r) {
    var warns = reg_warnings(r);
    var n = 0;
    var i = 0;
    while (i < vec_len(warns)) {
        var c = warning_code(vec_get(warns, i));
        if (c == HWA_ERR_TOOL_NOT_FOUND) { n = n + 1; }
        if (c == HWA_ERR_TOOL_FAILED) { n = n + 1; }
        if (c == HWA_ERR_TIMEOUT) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Through 2.5.0 the interconnect pass looked for `nvidia-smi` whatever the
# mask, and Vulkan ran `vulkaninfo`, so a host without them got tool warnings
# from an exec-free mask.
fn test_exec_free_masks_spawn_nothing() {
    assert_eq(_tool_warnings(registry_detect_with(builder_no_exec())), 0, "detect_with(no_exec): no tool run");
    assert_eq(_tool_warnings(registry_detect_with(builder_none())), 0, "detect_with(none): no tool run");
    assert_eq(_tool_warnings(registry_detect_threaded_with(builder_no_exec())), 0, "threaded(no_exec): no tool run");
    return 0;
}

# Warnings of `a` and `b` (registries) that differ by code and tool, plus
# profiles that differ by type and name.
fn _registry_diff(a, b) {
    var wa = reg_warnings(a);
    var wb = reg_warnings(b);
    var d = 0;
    if (vec_len(wa) != vec_len(wb)) { d = d + 1; }
    var i = 0;
    while (i < vec_len(wa)) {
        var w = vec_get(wa, i);
        if (_same_warnings(wa, w) != _same_warnings(wb, w)) { d = d + 1; }
        i = i + 1;
    }
    var pa = reg_profiles(a);
    var pb = reg_profiles(b);
    if (vec_len(pa) != vec_len(pb)) { return d + 1; }
    i = 0;
    while (i < vec_len(pa)) {
        var x = vec_get(pa, i);
        var y = vec_get(pb, i);
        if (profile_accel_type(x) != profile_accel_type(y)) { d = d + 1; }
        var nx = profile_device_name(x);
        var ny = profile_device_name(y);
        if (nx == 0 || ny == 0) {
            if (nx != ny) { d = d + 1; }
        } elif (streq(nx, ny) != 1) {
            d = d + 1;
        }
        i = i + 1;
    }
    return d;
}

# Any nonzero allow_exec is 1 (2.5.5). Through 2.5.4 a 2 kept the exec
# backends but ran Vulkan, Apple, Gaudi, Neuron and the interconnect pass as
# if exec were off.
fn test_allow_exec_normalised() {
    var one = registry_detect_with_opts(builder_all(), 1);
    var two = registry_detect_with_opts(builder_all(), 2);
    assert_eq(_registry_diff(one, two), 0, "allow_exec 2 detects as 1");
    var neg = registry_detect_with_opts(builder_all(), 0 - 1);
    assert_eq(_registry_diff(one, neg), 0, "allow_exec -1 detects as 1");
    return 0;
}

# Gaudi and Neuron run without exec (2.5.5): registry_detect_no_exec keeps
# them, and their tools run only with exec. A selective mask of them runs
# with exec, threaded or not, as through 2.5.4: detecting as
# registry_detect_with_opts(mask, 1) does.
fn test_gaudi_neuron_no_exec() {
    var p = vec_new();
    var w = vec_new();
    detect_gaudi_opts(p, w, 0);
    detect_neuron_opts(p, w, 0);
    assert_eq(vec_len(w), 0, "gaudi, neuron without exec: no tool looked for");
    var r = registry_detect_no_exec();
    assert_eq(_tool_warnings(r), 0, "no_exec: still no tool run");
    var only = builder_with(builder_with(builder_none(), BACKEND_GAUDI), BACKEND_NEURON);
    var with_exec = registry_detect_with_opts(only, 1);
    assert_eq(_registry_diff(registry_detect_with(only), with_exec), 0, "gaudi + neuron mask: tools run");
    assert_eq(_registry_diff(registry_detect_threaded_with(only), with_exec), 0,
      "threaded gaudi + neuron mask: tools run");
    assert_eq(_tool_warnings(registry_detect_with_opts(only, 0)), 0, "with_opts(gaudi + neuron, 0): no tool run");
    return 0;
}

# --- Each missing tool is reported once (2.5.1) ---

fn test_warnings_dedup_missing() {
    var w = vec_new();
    vec_push(w, warning_tool_not_found("nvidia-smi"));
    vec_push(w, warning_tool_not_found("hl-smi"));
    vec_push(w, warning_parse("cuda", "bad line"));
    vec_push(w, warning_tool_not_found("nvidia-smi"));
    vec_push(w, warning_parse("cuda", "bad line"));
    assert_eq(warnings_dedup_missing(w), 4, "the repeated not-found is dropped");
    assert_eq(vec_len(w), 4, "vec shortened");
    assert(streq(warning_tool(vec_get(w, 0)), "nvidia-smi") == 1, "first kept, in order");
    assert(streq(warning_tool(vec_get(w, 1)), "hl-smi") == 1, "order kept");
    assert_eq(warning_code(vec_get(w, 3)), HWA_ERR_PARSE, "a repeated parse warning stays");
    assert_eq(warnings_dedup_missing(vec_new()), 0, "empty vec");
    return 0;
}

# --- A failing tool is logged (2.5.5) ---

var _hook_lines = 0;
var _hook_levels = 0;

# A sakshi emit hook that keeps a copy of each message and its level.
fn _log_hook(ts, level, cat, msg, len, fields) {
    vec_push(_hook_lines, str_from_buf(msg, len));
    vec_push(_hook_levels, level);
    return 0;
}

# The lines warnings_log_parse emits for `w` from `from`, at log level `lvl`.
fn _logged(w, from, lvl) {
    _hook_lines = vec_new();
    _hook_levels = vec_new();
    var keep = sakshi_get_level();
    var keep_hw = hwlog_get_level();
    hwlog_set_process_level(lvl);
    sakshi_set_emit_hook(&_log_hook);
    warnings_log_parse(w, from);
    sakshi_clear_emit_hook();
    sakshi_set_level(keep);
    hwlog_set_level(keep_hw);
    return _hook_lines;
}

# Parse warnings and timeouts are logged at warn, a tool that ran and failed
# at info (-v), and a missing tool and a sysfs read not at all. Through 2.5.4
# only parse warnings were, so a tool that ran and failed (nvidia-smi
# without its driver, exit 9) looked, to a CLI or wheel user, the same as one
# not installed.
fn test_warnings_log() {
    var w = vec_new();
    vec_push(w, warning_tool_not_found("hl-smi"));
    vec_push(w, warning_parse("cuda", "bad line"));
    vec_push(w, warning_tool_failed("nvidia-smi", 9, "exited with status 9"));
    vec_push(w, warning_timeout("neuron-ls", 10000));
    vec_push(w, warning_sysfs("/sys/x", "unreadable"));
    vec_push(w, warning_tool_failed("dxgi", 0 - 1, "EnumAdapters1 failed"));
    var lines = _logged(w, 0, SK_INFO);
    assert_eq(vec_len(lines), 4, "log: parse, two failed tools and a timeout");
    if (vec_len(lines) == 4) {
        assert_eq(str_eq_cstr(vec_get(lines, 0), "cuda: bad line"), 1, "log: the parse line as before");
        var failed = str_eq_cstr(vec_get(lines, 1), "nvidia-smi: exited with status 9");
        assert_eq(failed, 1, "log: the failed tool's status");
        assert_eq(str_eq_cstr(vec_get(lines, 2), "neuron-ls: timed out after 10s"), 1, "log: the timeout");
        assert_eq(str_eq_cstr(vec_get(lines, 3), "dxgi: EnumAdapters1 failed"), 1, "log: a failure with no status");
        assert_eq(vec_get(_hook_levels, 0), SK_WARN, "log: parse at warn");
        assert_eq(vec_get(_hook_levels, 1), SK_INFO, "log: failed tool at info");
        assert_eq(vec_get(_hook_levels, 2), SK_WARN, "log: timeout at warn");
        assert_eq(vec_get(_hook_levels, 3), SK_INFO, "log: failure with no status at info");
    }
    # The default level: parse and timeout only, so a host whose vulkaninfo
    # exits 1 for want of a Vulkan GPU stays silent.
    var at_warn = _logged(w, 0, SK_WARN);
    assert_eq(vec_len(at_warn), 2, "log: at warn, parse and timeout");
    assert_eq(vec_len(_logged(w, 3, SK_INFO)), 2, "log: from an index on");
    assert_eq(vec_len(_logged(w, 3, SK_WARN)), 1, "log: from an index on, at warn");
    assert_eq(vec_len(_logged(w, 0, SK_ERROR)), 0, "log: nothing below the level");
    return 0;
}

# A registry lists each missing tool once, and off macOS never names
# `system_profiler`, which only macOS has.
fn check_tool_warnings_once(r, label) {
    var warns = reg_warnings(r);
    var n = vec_len(warns);
    var dupes = 0;
    var sp = 0;
    var i = 0;
    while (i < n) {
        var w = vec_get(warns, i);
        if (warning_code(w) == HWA_ERR_TOOL_NOT_FOUND) {
            if (streq(warning_tool(w), "system_profiler") == 1) { sp = sp + 1; }
            var j = i + 1;
            while (j < n) {
                var e = vec_get(warns, j);
                if (warning_code(e) == HWA_ERR_TOOL_NOT_FOUND) {
                    if (streq(warning_tool(e), warning_tool(w)) == 1) { dupes = dupes + 1; }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    assert_eq(dupes, 0, label);
    #ifndef CYRIUS_TARGET_MACOS
    assert_eq(sp, 0, label);
    #endif
    return 0;
}

fn test_tool_warnings_once() {
    check_tool_warnings_once(registry_detect(), "registry_detect: tools once");
    check_tool_warnings_once(registry_detect_threaded(), "registry_detect_threaded: tools once");
    check_tool_warnings_once(lazy_into_registry(lazy_new()), "lazy_into_registry: tools once");
    return 0;
}

# --- NVLink is probed only with an NVIDIA GPU (2.5.2) ---

fn test_profiles_have_nvidia_gpu() {
    var v = vec_new();
    assert_eq(profiles_have_nvidia_gpu(v), 0, "empty: no NVIDIA GPU");
    vec_push(v, profile_cpu(16 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x1638, "AMD Radeon", BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x8086, 0x3185, "Intel(R) UHD Graphics 600", BYTES_PER_GIB));
    assert_eq(profiles_have_nvidia_gpu(v), 0, "AMD, Intel and CPU: no NVIDIA GPU");
    var cuda = vec_new();
    vec_push(cuda, _gpu(ACCEL_CUDA, 0, 0, "NVIDIA H100", 80 * BYTES_PER_GIB));
    assert_eq(profiles_have_nvidia_gpu(cuda), 1, "a CUDA profile, even without a pci_id");
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2330, "NVIDIA H100", 80 * BYTES_PER_GIB));
    assert_eq(profiles_have_nvidia_gpu(v), 1, "a Vulkan view of an NVIDIA card");
    return 0;
}

fn _nvsmi_missing(warns) {
    var c = 0;
    var i = 0;
    while (i < vec_len(warns)) {
        var w = vec_get(warns, i);
        if (warning_code(w) == HWA_ERR_TOOL_NOT_FOUND && streq(warning_tool(w), "nvidia-smi") == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Through 2.5.1 the interconnect pass looked for `nvidia-smi` on every host
# without NVSwitch nodes. Without an NVIDIA GPU it does not now. Where
# nvidia-smi is missing and there are no NVSwitch nodes (the dev host, CI), an
# NVIDIA GPU still makes it look, so it reports the tool missing.
fn test_nvlink_probe_needs_nvidia_gpu() {
    var w = vec_new();
    var amd = vec_new();
    vec_push(amd, _gpu(ACCEL_ROCM, 0x1002, 0x1638, "AMD Radeon", BYTES_PER_GIB));
    detect_interconnects(system_io_new(), amd, w);
    assert_eq(_nvsmi_missing(w), 0, "no NVIDIA GPU: nvidia-smi not looked for");
    if (which("nvidia-smi") != 0) { return 0; }
    if (dir_exists("/sys/devices/virtual/nvidia-nvswitch") == 1) { return 0; }
    if (aihw_path_exists("/sys/bus/nvidia_nvswitch/devices") == 1) { return 0; }
    var cw = vec_new();
    var cuda = vec_new();
    vec_push(cuda, _gpu(ACCEL_CUDA, 0x10DE, 0x2330, "NVIDIA H100", 80 * BYTES_PER_GIB));
    detect_interconnects(system_io_new(), cuda, cw);
    assert_eq(_nvsmi_missing(cw), 1, "CUDA GPU: nvidia-smi looked for");
    var vw = vec_new();
    var vk = vec_new();
    vec_push(vk, _gpu(ACCEL_VULKAN, 0x10DE, 0x2330, "NVIDIA H100", 80 * BYTES_PER_GIB));
    detect_interconnects(system_io_new(), vk, vw);
    assert_eq(_nvsmi_missing(vw), 1, "Vulkan view of an NVIDIA GPU: nvidia-smi looked for");
    return 0;
}

# --- The lazy registry on this host (2.5.2) ---

# Warnings in `v` with the code and tool of warning `w`.
fn _same_warnings(v, w) {
    var c = 0;
    var i = 0;
    while (i < vec_len(v)) {
        var e = vec_get(v, i);
        if (warning_code(e) == warning_code(w) && streq(warning_tool(e), warning_tool(w)) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# lazy_into_registry reports what registry_detect reports: the same warnings,
# by code and tool, and the same profiles by type. Through 2.5.1 it had only
# the interconnect pass's warnings.
fn test_lazy_matches_full_detection() {
    var full = registry_detect();
    var lazy = lazy_into_registry(lazy_new());
    var fw = reg_warnings(full);
    var lw = reg_warnings(lazy);
    assert_eq(vec_len(lw), vec_len(fw), "lazy: as many warnings as registry_detect");
    var off = 0;
    var i = 0;
    while (i < vec_len(fw)) {
        var w = vec_get(fw, i);
        if (_same_warnings(lw, w) != _same_warnings(fw, w)) { off = off + 1; }
        i = i + 1;
    }
    assert_eq(off, 0, "lazy: the same warnings as registry_detect");
    var fp = reg_profiles(full);
    var lp = reg_profiles(lazy);
    assert_eq(vec_len(lp), vec_len(fp), "lazy: as many profiles as registry_detect");
    var types = 0;
    var t = 0;
    while (t < ACCEL_TYPE_COUNT) {
        var a = 0;
        var b = 0;
        i = 0;
        while (i < vec_len(fp)) { if (profile_accel_type(vec_get(fp, i)) == t) { a = a + 1; } i = i + 1; }
        i = 0;
        while (i < vec_len(lp)) { if (profile_accel_type(vec_get(lp, i)) == t) { b = b + 1; } i = i + 1; }
        if (a != b) { types = types + 1; }
        t = t + 1;
    }
    assert_eq(types, 0, "lazy: the same profiles by type as registry_detect");
    return 0;
}

# No AI-ASIC backend is NVIDIA's, so an AI-ASIC query never looks for
# `nvidia-smi`; through 2.5.1 its probe's interconnect pass did.
fn test_lazy_asic_query_no_nvidia_smi() {
    var lr = lazy_new();
    lazy_by_family(lr, FAMILY_AI_ASIC);
    assert_eq(_nvsmi_missing(lazy_warnings(lr)), 0, "asic query: nvidia-smi not looked for");
    lazy_by_family(lr, FAMILY_TPU);
    lazy_by_family(lr, FAMILY_NPU);
    assert_eq(_nvsmi_missing(lazy_warnings(lr)), 0, "tpu, npu queries: nvidia-smi not looked for");
    return 0;
}

# --- Cache TTL on any target's clock (2.5.1) ---

# Nothing here reads a Linux-only source: the clock is _monotonic_secs, which
# has a branch per target, and the checks hold on macOS and Windows as on
# Linux (cross-built and run on ecb and cass for 2.5.1). Through 2.3.21 the
# clock read an uninitialised stack slot on macOS and Windows, so a cache
# could be served for ever or never.
fn test_monotonic_clock() {
    var a = _monotonic_secs();
    assert(a >= 0, "clock reads");
    var b = _monotonic_secs();
    assert(b >= a, "clock does not go back");
    return 0;
}

fn test_cached_ttl() {
    var c = cached_registry_new(3600);
    assert_eq(cached_is_valid(c), 0, "empty cache is not valid");
    var r1 = cached_get(c);
    var r2 = cached_get(c);
    assert_eq(r1, r2, "within the TTL: the same registry");
    assert_eq(cached_is_valid(c), 1, "valid within the TTL");
    cached_invalidate(c);
    assert_eq(cached_is_valid(c), 0, "invalidated");
    var r3 = cached_get(c);
    assert(r3 != r1, "after invalidate: detected again");
    var z = cached_registry_new(0);
    var z1 = cached_get(z);
    var z2 = cached_get(z);
    assert(z1 != z2, "TTL 0: detects every time");
    assert_eq(cached_is_valid(z), 0, "TTL 0: never valid");
    return 0;
}

# The deprecated disk cache is an in-memory cache with no file (2.5.1).
fn test_disk_cached_in_memory() {
    var c = disk_cached_new(3600);
    assert_eq(disk_cached_cache_path(c), 0, "no cache file");
    var r1 = disk_cached_get(c);
    var r2 = disk_cached_get(c);
    assert_eq(r1, r2, "disk_cached: same registry within the TTL");
    disk_cached_invalidate(c);
    assert(disk_cached_get(c) != r1, "disk_cached: detected again after invalidate");
    return 0;
}

# Readers of a warm cache on several threads all get the one registry, and a
# reader after an invalidate gets a fresh one.
var _cr_cache = 0;
var _cr_want = 0;
var _cr_bad = 0;

fn _cache_reader(arg) {
    var i = 0;
    while (i < 200) {
        if (cached_get(_cr_cache) != _cr_want) { atomic_fetch_add(&_cr_bad, 1); }
        i = i + 1;
    }
    return 0;
}

fn test_cached_readers_concurrent() {
    _cr_cache = cached_registry_new(3600);
    _cr_want = cached_get(_cr_cache);
    _cr_bad = 0;
    var ts = vec_new();
    var k = 0;
    while (k < 4) {
        vec_push(ts, thread_create(&_cache_reader, 0));
        k = k + 1;
    }
    _cache_reader(0);
    k = 0;
    while (k < 4) {
        var t = vec_get(ts, k);
        if (t != 0) { thread_join(t); }
        k = k + 1;
    }
    assert_eq(_cr_bad, 0, "cache: concurrent readers share the registry");
    cached_invalidate(_cr_cache);
    assert(cached_get(_cr_cache) != _cr_want, "cache: a reader after an invalidate detects again");
    return 0;
}

# The threaded path's sync fallback (thread_create failed) is the thread
# entry run on the calling thread: it detects what registry_run_detectors
# does for that backend.
fn test_threaded_sync_fallback() {
    var ta = targ_new(BACKEND_VULKAN);
    _detect_thread_entry(ta);
    var p = vec_new();
    var w = vec_new();
    registry_run_detectors(p, w, builder_with(builder_none(), BACKEND_VULKAN), 1);
    assert_eq(vec_len(targ_profs(ta)), vec_len(p), "sync fallback: the backend's profiles");
    assert_eq(vec_len(targ_warns(ta)), vec_len(w), "sync fallback: the backend's warnings");
    return 0;
}

fn test_detection_entry_points() {
    check_registry_shape(registry_detect(), "registry_detect");
    check_registry_shape(registry_detect_no_exec(), "registry_detect_no_exec");
    check_registry_shape(registry_detect_threaded(), "registry_detect_threaded");
    check_registry_shape(lazy_into_registry(lazy_new()), "lazy_into_registry");
    return 0;
}

# --- Totals count system RAM once (2.3.28) ---

fn _reg(a, b, c) {
    var v = vec_new();
    if (a != 0) { vec_push(v, a); }
    if (b != 0) { vec_push(v, b); }
    if (c != 0) { vec_push(v, c); }
    return registry_from_profiles(v);
}

# ecb, a 48 GB Apple M5 Pro: CPU 48, Metal 48 and Neural Engine 4 all draw on
# one 48 GiB pool. 2.3.27 reported 100 GiB total and 52 GiB accelerator.
fn test_totals_apple_unified() {
    var r = _reg(profile_cpu(48 * BYTES_PER_GIB),
      profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB),
      profile_new(ACCEL_APPLE_NPU, 0, 4 * BYTES_PER_GIB));
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 48, "mac total = RAM once");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 48, "mac accel = the unified pool");
    return 0;
}

# GH200: 96 GiB HBM of its own plus 480 GiB of Grace memory, which is also
# the CPU's. Total = 96 + 480, not 96 + 480 + 480.
fn test_totals_gh200() {
    var gpu = profile_cuda(0, 576 * BYTES_PER_GIB);
    profile_set_shared_mem(gpu, 480 * BYTES_PER_GIB);
    var r = _reg(profile_cpu(480 * BYTES_PER_GIB), gpu, 0);
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 576, "gh200 total");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 576, "gh200 accel");
    return 0;
}

# A laptop NPU has no memory of its own: its 2 GiB estimate is system RAM.
fn test_totals_npu_laptop() {
    var r = _reg(profile_cpu(32 * BYTES_PER_GIB), profile_new(ACCEL_INTEL_NPU, 0, 2 * BYTES_PER_GIB), 0);
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 32, "npu laptop total = RAM");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 2, "npu budget still counts as accel");
    return 0;
}

# A discrete GPU keeps adding its own memory next to a shared-memory NPU.
fn test_totals_mixed() {
    var r = _reg(profile_cpu(64 * BYTES_PER_GIB), profile_cuda(0, 24 * BYTES_PER_GIB),
      profile_new(ACCEL_INTEL_NPU, 0, 2 * BYTES_PER_GIB));
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 88, "mixed total = RAM + VRAM");
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 26, "mixed accel = VRAM + npu budget");
    return 0;
}

# Without a CPU profile the pool still counts once; unavailable profiles
# count nowhere.
fn test_totals_no_cpu_and_unavailable() {
    var r = _reg(profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB),
      profile_new(ACCEL_APPLE_NPU, 0, 4 * BYTES_PER_GIB), 0);
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 48, "no cpu: pool once");
    var off = profile_new(ACCEL_METAL, 0, 96 * BYTES_PER_GIB);
    profile_set_available(off, 0);
    var r2 = _reg(profile_cpu(16 * BYTES_PER_GIB), off, 0);
    assert_eq(reg_total_memory(r2) / BYTES_PER_GIB, 16, "unavailable ignored");
    assert_eq(reg_total_accel_memory(r2), 0, "unavailable accel ignored");
    return 0;
}

# cass's Intel UHD 600 seen through Vulkan (the real vulkaninfo captures in
# tests/fixtures/vulkaninfo/, read from the repository root): its heap is half
# of cass's RAM and all of it system RAM, so the total is the RAM once. Through
# 2.3.28 the GPU's 4 GiB estimate was added on top.
fn _fixture(path) {
    var cap = 262144;
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap - 1);
    assert_gt(n, 0, path);
    if (n <= 0) { return str_from(""); }
    store8(buf + n, 0);
    return str_new(buf, n);
}

fn test_totals_vulkan_igpu() {
    var v = vec_new();
    vec_push(v, profile_cpu(8405598208));
    var ids = vec_new();
    _parse_vulkaninfo_ids(_fixture("tests/fixtures/vulkaninfo/uhd600-windows-summary.txt"), v, ids);
    vulkan_size_shared(v, 1, ids, _fixture("tests/fixtures/vulkaninfo/uhd600-windows-full.txt"));
    var r = registry_from_profiles(v);
    assert_eq(reg_total_memory(r), 8405598208, "igpu: total is the RAM once");
    assert_eq(reg_total_accel_memory(r), 4202799104, "igpu: accel is its heap");
    return 0;
}

# A shared_mem outside [0, memory_bytes] (a foreign shared_memory_bytes, or a
# memory_bytes lowered after construction) is clamped as profile_shared_bytes
# clamps it: a negative part counts as 0, one past memory_bytes as all of it.
fn test_totals_clamped() {
    var neg = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_shared_mem(neg, 0 - 5 * BYTES_PER_GIB);
    var over = profile_cuda(1, 16 * BYTES_PER_GIB);
    profile_set_shared_mem(over, 99 * BYTES_PER_GIB);
    var v = vec_new();
    vec_push(v, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(v, neg);
    vec_push(v, over);
    vec_push(v, profile_new(ACCEL_INTEL_NPU, 0, 32 * BYTES_PER_GIB));
    var r = registry_from_profiles(v);
    # neg adds its 24; over is all shared; the pool is max(64, 16, 32).
    assert_eq(reg_total_memory(r) / BYTES_PER_GIB, 88, "clamped total");
    # Without the CPU the pool is the NPU's 32.
    assert_eq(reg_total_accel_memory(r) / BYTES_PER_GIB, 56, "clamped accel");
    return 0;
}

# --- One physical device, one profile (2.4.0) ---

# A GPU profile of `atype` with a PCI id and name, for the dedup tests.
fn _gpu(atype, vendor, device, name, mem) {
    var p = profile_new(atype, 0, mem);
    profile_set_pci_id(p, pci_id_make(vendor, device));
    profile_set_device_name(p, name);
    return p;
}

fn test_placeholder_names() {
    assert_eq(profile_name_is_placeholder(0), 1, "no name");
    assert_eq(profile_name_is_placeholder(""), 1, "empty name");
    assert_eq(profile_name_is_placeholder("AMD Radeon (PCI 0x1002:0x1638)"), 1, "rocm fallback");
    assert_eq(profile_name_is_placeholder("AMD Radeon"), 1, "bare rocm fallback");
    assert_eq(profile_name_is_placeholder("Apple Silicon (Asahi Linux)"), 1, "asahi");
    assert_eq(profile_name_is_placeholder("Apple Silicon"), 1, "system_profiler default");
    assert_eq(profile_name_is_placeholder("AMD Radeon RX 7900 XTX"), 0, "a model");
    assert_eq(profile_name_is_placeholder("Apple M5 Pro"), 0, "a chip");
    # 2.5.4: the Vulkan sysfs scan's names say less than ROCm's placeholder.
    assert_eq(profile_name_is_placeholder("AMD GPU (Vulkan)"), 1, "vulkan scan: amd");
    assert_eq(profile_name_is_placeholder("NVIDIA GPU (Vulkan)"), 1, "vulkan scan: nvidia");
    assert_eq(profile_name_is_placeholder("Intel GPU (Vulkan)"), 1, "vulkan scan: intel");
    assert_eq(profile_name_is_placeholder("Unknown GPU"), 1, "vulkan scan: unknown");
    assert_eq(profile_name_is_placeholder("AMD Radeon Graphics (RADV RENOIR)"), 0, "a vulkaninfo name");
    assert_eq(profile_name_is_placeholder("Vulkan GPU (Vulkan) Pro"), 0, "the suffix only at the end");
    var v = vec_new();
    var rocm = _gpu(ACCEL_ROCM, 0x1002, 0x1638, "AMD Radeon (PCI 0x1002:0x1638)", 8 * BYTES_PER_GIB);
    vec_push(v, rocm);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x1638, "AMD GPU (Vulkan)", 8 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 1, "scan view dropped");
    assert_streq(profile_device_name(rocm), "AMD Radeon (PCI 0x1002:0x1638)",
      "rocm keeps its own name, not the scan's");
    return 0;
}

# The dev host: ROCm and Vulkan report its one APU. ROCm's profile survives,
# with RADV's name in place of its PCI-id fallback; the 8 GiB counts once.
fn test_dedup_rocm_vulkan() {
    var v = vec_new();
    vec_push(v, profile_cpu(58880188416));
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x1638, "AMD Radeon (PCI 0x1002:0x1638)", 8 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x1638, "AMD Radeon Graphics (RADV RENOIR)", 8 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 1, "apu: one dropped");
    assert_eq(vec_len(v), 2, "apu: cpu + one gpu");
    var g = vec_get(v, 1);
    assert_eq(profile_accel_type(g), ACCEL_ROCM, "apu: rocm survives");
    assert(streq(profile_device_name(g), "AMD Radeon Graphics (RADV RENOIR)") == 1, "apu: RADV's name kept");
    var r = registry_from_profiles(v);
    assert_eq(reg_total_accel_memory(r), 8 * BYTES_PER_GIB, "apu: 8 GiB once");
    assert_eq(reg_total_memory(r), 58880188416 + 8 * BYTES_PER_GIB, "apu: total");
    return 0;
}

# Two identical NVIDIA cards next to an Intel iGPU: both Vulkan views of the
# cards go, the iGPU (no dedicated backend) stays, and order is kept. The Rust
# releases dropped the iGPU too.
fn test_dedup_cuda_keeps_other_gpus() {
    var v = vec_new();
    vec_push(v, _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    var igpu = _gpu(ACCEL_VULKAN, 0x8086, 0x46a6, "Intel(R) Graphics (ADL GT2)", 4 * BYTES_PER_GIB);
    profile_set_shared_mem(igpu, 4 * BYTES_PER_GIB);
    vec_push(v, igpu);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 2, "two card views dropped");
    assert_eq(vec_len(v), 3, "two cards + the igpu");
    assert_eq(profile_accel_type(vec_get(v, 0)), ACCEL_CUDA, "order: cuda 0");
    assert_eq(profile_accel_type(vec_get(v, 1)), ACCEL_CUDA, "order: cuda 1");
    assert(vec_get(v, 2) == igpu, "order: the igpu last, kept");
    assert(streq(profile_device_name(vec_get(v, 0)), "NVIDIA GeForce RTX 4090") == 1, "a real name is not replaced");
    return 0;
}

# A GPU two Vulkan drivers list (RADV and AMDVLK) is still one device.
fn test_dedup_two_vulkan_drivers() {
    var v = vec_new();
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 2, "both driver views dropped");
    assert_eq(vec_len(v), 1, "the card once");
    assert(streq(profile_device_name(vec_get(v, 0)), "AMD Radeon RX 7900 XTX") == 1, "product name not replaced");
    return 0;
}

# Two identical cards whose sysfs has no product_name, usual for consumer
# Radeons: both views go and both cards take the model name (2.5.5). pci_id
# is the model ID, so through 2.5.4 both views paired with the first card and
# the second kept "AMD Radeon (PCI 0x1002:0x744c)".
fn test_dedup_identical_placeholder_cards() {
    var v = vec_new();
    vec_push(v, profile_cpu(64 * BYTES_PER_GIB));
    var a = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 24 * BYTES_PER_GIB);
    var b = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 24 * BYTES_PER_GIB);
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 24 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 24 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 2, "identical cards: both views dropped");
    assert_streq(profile_device_name(a), "AMD Radeon RX 7900 XTX (RADV NAVI31)", "identical cards: the first renamed");
    assert_streq(profile_device_name(b), "AMD Radeon RX 7900 XTX (RADV NAVI31)", "identical cards: the second renamed");
    return 0;
}

# A vendor profile with no memory figure takes its vulkaninfo view's heap
# (2.5.5), as a DXGI iGPU does; the sysfs scan's guess is not taken.
fn test_dedup_zero_memory_twin() {
    var v = vec_new();
    var gb10 = _gpu(ACCEL_CUDA, 0x10DE, 0x2E12, "NVIDIA GB10", 0);
    var heap = _gpu(ACCEL_VULKAN, 0x10DE, 0x2E12, "NVIDIA GB10", 119 * BYTES_PER_GIB);
    profile_set_shared_mem(heap, 119 * BYTES_PER_GIB);
    vec_push(v, gb10);
    vec_push(v, heap);
    assert_eq(profiles_dedup(v), 1, "gb10: the view dropped");
    assert_eq(profile_memory_bytes(gb10), 119 * BYTES_PER_GIB, "gb10: the heap taken");
    assert_eq(profile_shared_mem(gb10), 119 * BYTES_PER_GIB, "gb10: shared, as the view said");
    var w = vec_new();
    var zero = _gpu(ACCEL_CUDA, 0x10DE, 0x2E12, "NVIDIA GB10", 0);
    vec_push(w, zero);
    vec_push(w, _gpu(ACCEL_VULKAN, 0x10DE, 0x2E12, "NVIDIA GPU (Vulkan)", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(w), 1, "scan view: dropped");
    assert_eq(profile_memory_bytes(zero), 0, "scan view: its guess not taken");
    var x = vec_new();
    var sized = _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB);
    vec_push(x, sized);
    vec_push(x, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    profiles_dedup(x);
    assert_eq(profile_memory_bytes(sized), 24 * BYTES_PER_GIB, "sized card: its own memory kept");
    return 0;
}

# An unavailable vendor profile with no memory figure (nvidia-smi listed the
# GPU but could not read its memory) keeps its 0: the view's heap or estimate
# would read as memory the card was found to have.
fn test_dedup_unavailable_zero_memory_twin() {
    var v = vec_new();
    var h100 = _gpu(ACCEL_CUDA, 0x10DE, 0x2330, "NVIDIA H100 80GB HBM3", 0);
    profile_set_available(h100, 0);
    vec_push(v, h100);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2330, "NVIDIA H100 80GB HBM3", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 1, "unavailable twin: the view dropped");
    assert_eq(vec_len(v), 1, "unavailable twin: one profile");
    assert_eq(profile_accel_type(vec_get(v, 0)), ACCEL_CUDA, "unavailable twin: CUDA kept");
    assert_eq(profile_memory_bytes(h100), 0, "unavailable twin: the view's memory not taken");
    assert_eq(profile_shared_mem(h100), 0, "unavailable twin: no shared part either");
    return 0;
}

# Two SKUs with one PCI device ID (0x744C: RX 7900 XT, 20 GiB, and XTX,
# 24 GiB): the views pair with the cards by list order, so a name could land
# on the wrong card. Views that disagree leave both placeholders in place;
# memory is each card's own.
fn test_dedup_mixed_sku_same_device_id() {
    var v = vec_new();
    var xt = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 20 * BYTES_PER_GIB);
    var xtx = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 24 * BYTES_PER_GIB);
    vec_push(v, xt);
    vec_push(v, xtx);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XT (RADV NAVI31)", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 2, "mixed sku: both views dropped");
    assert_streq(profile_device_name(xt), "AMD Radeon (PCI 0x1002:0x744c)", "mixed sku: the 20 GiB card not named XTX");
    assert_streq(profile_device_name(xtx), "AMD Radeon (PCI 0x1002:0x744c)", "mixed sku: the 24 GiB card not named XT");
    assert_eq(profile_memory_bytes(xt), 20 * BYTES_PER_GIB, "mixed sku: memory kept");
    # One card of the ID: its views cannot be another card's, so a view's
    # name is taken even beside a second driver's wording.
    var w = vec_new();
    var one = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 24 * BYTES_PER_GIB);
    vec_push(w, one);
    vec_push(w, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 4 * BYTES_PER_GIB));
    vec_push(w, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(w), 2, "one card, two drivers: both views dropped");
    assert_streq(profile_device_name(one), "AMD Radeon RX 7900 XTX (RADV NAVI31)", "one card: renamed");
    # Two identical cards seen by RADV and AMDVLK: the views name one model
    # (RADV adds its driver suffix), so each card still takes a name.
    var z = vec_new();
    var c0 = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 24 * BYTES_PER_GIB);
    var c1 = _gpu(ACCEL_ROCM, 0x1002, 0x744c, "AMD Radeon (PCI 0x1002:0x744c)", 24 * BYTES_PER_GIB);
    vec_push(z, c0);
    vec_push(z, c1);
    vec_push(z, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 4 * BYTES_PER_GIB));
    vec_push(z, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX (RADV NAVI31)", 4 * BYTES_PER_GIB));
    vec_push(z, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    vec_push(z, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(z), 4, "two cards, two drivers: four views dropped");
    assert_eq(profile_name_is_placeholder(profile_device_name(c0)), 0, "two cards, two drivers: card 0 named");
    assert_eq(profile_name_is_placeholder(profile_device_name(c1)), 0, "two cards, two drivers: card 1 named");
    assert_eq(_dedup_model_eq("AMD Radeon RX 7900 XT (RADV NAVI31)", "AMD Radeon RX 7900 XTX"), 0, "XT is not XTX");
    assert_eq(_dedup_model_eq("AMD Radeon(TM) Graphics", "AMD Radeon(TM) Graphics"), 1, "no space before ( is no suffix");
    return 0;
}

# Nothing matches on an unknown id, on a different id, or against another
# Vulkan profile; a lone Vulkan GPU stays.
fn test_dedup_no_false_matches() {
    var v = vec_new();
    vec_push(v, profile_new(ACCEL_CUDA, 0, 8 * BYTES_PER_GIB));
    vec_push(v, profile_new(ACCEL_VULKAN, 0, 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_ROCM, 0x1002, 0x73bf, "AMD Radeon RX 6800", 16 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x744c, "AMD Radeon RX 7900 XTX", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(v), 0, "nothing dropped");
    assert_eq(vec_len(v), 6, "all kept");
    return 0;
}

# Apple Silicon: MoltenVK (macOS) and Honeykrisp (Asahi) list the Metal GPU.
# An integrated Vulkan GPU on system RAM next to a Metal profile is the same
# device; Asahi's generic Metal name takes Honeykrisp's.
fn test_dedup_apple() {
    var mac = vec_new();
    var metal = profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB);
    profile_set_device_name(metal, "Apple M5 Pro");
    vec_push(mac, metal);
    var mvk = profile_new(ACCEL_VULKAN, 0, 36 * BYTES_PER_GIB);
    profile_set_device_name(mvk, "Apple M5 Pro");
    profile_set_shared_mem(mvk, 36 * BYTES_PER_GIB);
    vec_push(mac, mvk);
    assert_eq(profiles_dedup(mac), 1, "moltenvk dropped");
    assert(vec_get(mac, 0) == metal, "metal survives");
    var asahi = vec_new();
    var am = profile_new(ACCEL_METAL, 0, 32 * BYTES_PER_GIB);
    profile_set_device_name(am, "Apple Silicon (Asahi Linux)");
    vec_push(asahi, am);
    var hk = profile_new(ACCEL_VULKAN, 0, 16 * BYTES_PER_GIB);
    profile_set_device_name(hk, "Apple M1 Max (G13C C0)");
    profile_set_shared_mem(hk, 16 * BYTES_PER_GIB);
    vec_push(asahi, hk);
    assert_eq(profiles_dedup(asahi), 1, "honeykrisp dropped");
    assert(streq(profile_device_name(am), "Apple M1 Max (G13C C0)") == 1, "asahi takes the chip name");
    # A Vulkan GPU with memory of its own is not the SoC GPU.
    var egpu = vec_new();
    vec_push(egpu, profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB));
    vec_push(egpu, profile_new(ACCEL_VULKAN, 0, 8 * BYTES_PER_GIB));
    assert_eq(profiles_dedup(egpu), 0, "dedicated vulkan gpu kept");
    return 0;
}

# Property test: 300 pseudo-random profile sets (a fixed LCG seed), up to 12
# profiles of CUDA / ROCm / Vulkan / Metal with PCI ids drawn from a few
# values (0 = unknown) and Vulkan GPUs shared or not. After profiles_dedup:
# no Vulkan profile with a twin is left, every other profile is, order is
# kept, and a second pass drops nothing.
var _lcg = 12345;

# --- Windows GPUs and oneAPI in the duplicate pass (2.5.3) ---

# The twin is the best-ranked view of the same pci_id: a vendor backend
# (CUDA, ROCm, oneAPI) over DXGI over Vulkan, whatever the list order.
fn test_dedup_twin_ranks() {
    var vk = _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "RTX 4090", 4 * BYTES_PER_GIB);
    var dx = _gpu(ACCEL_WIN_GPU, 0x10DE, 0x2684, "RTX 4090", 24 * BYTES_PER_GIB);
    var cu = _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "RTX 4090", 24 * BYTES_PER_GIB);
    var v = vec_new();
    vec_push(v, vk);
    vec_push(v, dx);
    assert(_dedup_twin(v, vk) == dx, "vulkan with dxgi: dxgi");
    assert_eq(_dedup_twin(v, dx), 0, "dxgi with vulkan only: none");
    vec_push(v, cu);
    assert(_dedup_twin(v, vk) == cu, "vulkan with dxgi then cuda: cuda");
    assert(_dedup_twin(v, dx) == cu, "dxgi with cuda: cuda");
    assert_eq(_dedup_twin(v, cu), 0, "cuda: never a view");
    var w = vec_new();
    var max = _gpu(ACCEL_INTEL_ONEAPI, 0x8086, 0x0BD5, "Max 1550", 128 * BYTES_PER_GIB);
    var wdx = _gpu(ACCEL_WIN_GPU, 0x8086, 0x0BD5, "Max 1550", 128 * BYTES_PER_GIB);
    vec_push(w, wdx);
    vec_push(w, max);
    assert(_dedup_twin(w, wdx) == max, "dxgi with oneapi: oneapi");
    assert_eq(_dedup_twin(w, profile_cpu(BYTES_PER_GIB)), 0, "cpu: never a view");
    return 0;
}

# cass end to end: DXGI's UHD 600 (8086:3185, its 128 MiB carve-out) and
# vulkaninfo's view of it, parsed from the captured --summary and sized from
# the captured full output, in the order registry_run_detectors pushes them.
# Through 2.5.2 both stayed and the GPU counted its 128 MiB as its own.
fn test_dedup_cass_uhd600() {
    var profs = vec_new();
    vec_push(profs, profile_cpu(8405598208));
    var ids = vec_new();
    _parse_vulkaninfo_ids(_fixture("tests/fixtures/vulkaninfo/uhd600-windows-summary.txt"), profs, ids);
    vulkan_size_shared(profs, 1, ids, _fixture("tests/fixtures/vulkaninfo/uhd600-windows-full.txt"));
    var dx = _gpu(ACCEL_WIN_GPU, 0x8086, 0x3185, "Intel(R) UHD Graphics 600", 134217728);
    vec_push(profs, dx);
    assert_eq(vec_len(profs), 3, "cpu, vulkan view, dxgi");
    assert_eq(profiles_dedup(profs), 1, "uhd600: the Vulkan view is dropped");
    assert_eq(vec_len(profs), 2, "uhd600: cpu and one gpu");
    assert(vec_get(profs, 1) == dx, "uhd600: the Windows GPU survives");
    assert_eq(profile_memory_bytes(dx), 4202799104, "uhd600: memory is the Vulkan heap");
    assert_eq(profile_shared_mem(dx), 4202799104, "uhd600: all of it shared");
    var r = registry_from_profiles(profs);
    assert_eq(reg_total_memory(r), 8405598208, "uhd600: system RAM counted once");
    assert_eq(reg_total_accel_memory(r), 4202799104, "uhd600: accelerator memory is the heap");
    return 0;
}

# A discrete card, and an AMD APU, whose Vulkan view is not on system RAM:
# DXGI's own figure stays (VRAM; the APU's carve-out, as ROCm reports it on
# Linux).
fn test_dedup_dxgi_keeps_own_memory() {
    var v = vec_new();
    var rx = _gpu(ACCEL_WIN_GPU, 0x1002, 0x73FF, "AMD Radeon RX 6600", 8 * BYTES_PER_GIB);
    var apu = _gpu(ACCEL_WIN_GPU, 0x1002, 0x1638, "AMD Radeon(TM) Graphics", 512 * 1024 * 1024);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x73FF, "AMD Radeon RX 6600", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_VULKAN, 0x1002, 0x1638, "AMD Radeon(TM) Graphics", 4 * BYTES_PER_GIB));
    vec_push(v, rx);
    vec_push(v, apu);
    assert_eq(profiles_dedup(v), 2, "both Vulkan views dropped");
    assert_eq(profile_memory_bytes(rx), 8 * BYTES_PER_GIB, "discrete: VRAM kept");
    assert_eq(profile_shared_mem(rx), 0, "discrete: nothing shared");
    assert_eq(profile_memory_bytes(apu), 512 * 1024 * 1024, "apu: carve-out kept");
    return 0;
}

# A Windows laptop with an NVIDIA card and an Intel iGPU, each listed by CUDA
# or DXGI and by Vulkan: CUDA's profile and the DXGI iGPU survive, and the
# iGPU takes its Vulkan view's shared heap.
fn test_dedup_cuda_over_dxgi() {
    var v = vec_new();
    var cuda = _gpu(ACCEL_CUDA, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB);
    var igpu = _gpu(ACCEL_WIN_GPU, 0x8086, 0xA780, "Intel(R) UHD Graphics 770", 128 * 1024 * 1024);
    var ivk = _gpu(ACCEL_VULKAN, 0x8086, 0xA780, "Intel(R) UHD Graphics 770", 16 * BYTES_PER_GIB);
    profile_set_shared_mem(ivk, 16 * BYTES_PER_GIB);
    vec_push(v, cuda);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 4 * BYTES_PER_GIB));
    vec_push(v, ivk);
    vec_push(v, _gpu(ACCEL_WIN_GPU, 0x10DE, 0x2684, "NVIDIA GeForce RTX 4090", 24 * BYTES_PER_GIB));
    vec_push(v, igpu);
    assert_eq(profiles_dedup(v), 3, "laptop: three views dropped");
    assert_eq(vec_len(v), 2, "laptop: two GPUs");
    assert(vec_get(v, 0) == cuda, "laptop: CUDA's profile first");
    assert(vec_get(v, 1) == igpu, "laptop: then the DXGI iGPU");
    assert_eq(profile_shared_mem(igpu), 16 * BYTES_PER_GIB, "laptop: iGPU heap, shared");
    assert_eq(profile_memory_bytes(cuda), 24 * BYTES_PER_GIB, "laptop: CUDA memory untouched");
    return 0;
}

# oneAPI outranks DXGI and Vulkan; a profile without a pci_id matches nothing.
fn test_dedup_oneapi_and_unknown_ids() {
    var v = vec_new();
    var max = _gpu(ACCEL_INTEL_ONEAPI, 0x8086, 0x0BD5, "Intel(R) Data Center GPU Max 1550", 128 * BYTES_PER_GIB);
    vec_push(v, _gpu(ACCEL_VULKAN, 0x8086, 0x0BD5, "Intel(R) Data Center GPU Max 1550", 4 * BYTES_PER_GIB));
    vec_push(v, _gpu(ACCEL_WIN_GPU, 0x8086, 0x0BD5, "Intel(R) Data Center GPU Max 1550", 128 * BYTES_PER_GIB));
    vec_push(v, max);
    assert_eq(profiles_dedup(v), 2, "oneapi: Vulkan and DXGI views dropped");
    assert(vec_get(v, 0) == max, "oneapi: its profile survives");
    var u = vec_new();
    vec_push(u, profile_new(ACCEL_WIN_GPU, 0, BYTES_PER_GIB));
    vec_push(u, profile_new(ACCEL_INTEL_ONEAPI, 0, BYTES_PER_GIB));
    vec_push(u, _gpu(ACCEL_VULKAN, 0x8086, 0x3185, "Intel(R) UHD Graphics 600", BYTES_PER_GIB));
    assert_eq(profiles_dedup(u), 0, "no pci_id: no match");
    return 0;
}

fn _rnd(n) {
    _lcg = (_lcg * 1103515245 + 12345) & 0x7FFFFFFF;
    return (_lcg >> 8) % n;
}

fn test_dedup_properties() {
    var bad = 0;
    var round = 0;
    while (round < 300) {
        round = round + 1;
        var v = vec_new();
        var n = _rnd(13);
        var k = 0;
        while (k < n) {
            var kind = _rnd(6);
            var atype = ACCEL_VULKAN;
            if (kind == 0) { atype = ACCEL_CUDA; }
            if (kind == 1) { atype = ACCEL_ROCM; }
            if (kind == 2) {
                if (_rnd(4) == 0) { atype = ACCEL_METAL; }
            }
            if (kind == 3) { atype = ACCEL_WIN_GPU; }
            if (kind == 4) {
                if (_rnd(2) == 0) { atype = ACCEL_INTEL_ONEAPI; }
            }
            var p = profile_new(atype, k, BYTES_PER_GIB);
            var ids = _rnd(4);
            if (ids == 1) { profile_set_pci_id(p, pci_id_make(0x10DE, 0x2684)); }
            if (ids == 2) { profile_set_pci_id(p, pci_id_make(0x1002, 0x1638)); }
            if (ids == 3) { profile_set_pci_id(p, pci_id_make(0x8086, 0x46a6)); }
            if (atype == ACCEL_VULKAN) {
                if (_rnd(2) == 1) { profile_set_shared_mem(p, BYTES_PER_GIB); }
            }
            vec_push(v, p);
            k = k + 1;
        }
        var before = vec_new();
        var i = 0;
        while (i < n) {
            vec_push(before, vec_get(v, i));
            i = i + 1;
        }
        var dropped = profiles_dedup(v);
        if (vec_len(v) != n - dropped) { bad = bad + 1; }
        # Survivors, in order: walk `before`, matching `v` from the front.
        var j = 0;
        i = 0;
        while (i < n) {
            var q = vec_get(before, i);
            i = i + 1;
            var here = 0;
            if (j < vec_len(v)) {
                if (vec_get(v, j) == q) { here = 1; }
            }
            var viewable = 0;
            if (profile_accel_type(q) == ACCEL_VULKAN) { viewable = 1; }
            if (profile_accel_type(q) == ACCEL_WIN_GPU) { viewable = 1; }
            if (here == 1) {
                j = j + 1;
                if (viewable == 1) {
                    if (_dedup_twin(before, q) != 0) { bad = bad + 1; }
                }
            } else {
                # Only a Vulkan or Windows GPU profile with a twin may be missing.
                if (viewable == 0) { bad = bad + 1; }
                elif (_dedup_twin(before, q) == 0) { bad = bad + 1; }
            }
        }
        if (j != vec_len(v)) { bad = bad + 1; }
        if (profiles_dedup(v) != 0) { bad = bad + 1; }
    }
    assert_eq(bad, 0, "dedup properties over 300 random sets");
    return 0;
}

# On any host, no entry point returns a Vulkan profile next to the CUDA or
# ROCm profile of the same device. On the dev host this is its APU.
fn _dupes(r) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var d = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        var t = profile_accel_type(p);
        if (t == ACCEL_VULKAN || t == ACCEL_WIN_GPU) {
            if (_dedup_twin(profs, p) != 0) { d = d + 1; }
        }
    }
    return d;
}

fn test_dedup_entry_points() {
    assert_eq(_dupes(registry_detect()), 0, "registry_detect: one profile per device");
    assert_eq(_dupes(registry_detect_no_exec()), 0, "no_exec: one profile per device");
    assert_eq(_dupes(registry_detect_threaded()), 0, "threaded: one profile per device");
    assert_eq(_dupes(lazy_into_registry(lazy_new())), 0, "lazy: one profile per device");
    # The Vulkan scan without its no-exec rule does see the APU; dedup drops it.
    var scan = vec_new();
    detect_rocm(scan, vec_new());
    _detect_vulkan_sysfs(scan, 0);
    profiles_dedup(scan);
    var vk = 0;
    var i = 0;
    while (i < vec_len(scan)) {
        if (profile_accel_type(vec_get(scan, i)) == ACCEL_VULKAN) { vk = vk + 1; }
        i = i + 1;
    }
    var left = vec_new();
    _detect_vulkan_sysfs(left, 1);
    assert_eq(vk, vec_len(left), "the scan's AMD cards are ROCm's");
    return 0;
}

# --- Suggest quantization ---

fn test_suggest_quant_gpu_small() {
    # 7B model on 24 GiB GPU -> FP16 fits (14 GB + 20% = 16.8 GB < 24 GB)
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var q = reg_suggest_quant(r, 7000000000);
    assert_eq(q, QUANT_FP16, "7B on 24GB GPU -> FP16");
    return 0;
}

fn test_suggest_quant_gpu_large() {
    # 70B model on 24 GiB GPU -> FP16 won't fit (140 GB), INT8 won't fit (70 GB), INT4 fits (35 GB)
    # But 35 GB > 24 GB, so INT4 doesn't fit either -> fallback to CPU INT4
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var q = reg_suggest_quant(r, 70000000000);
    # CPU has 64 GB: FP16=168GB no, INT8=84GB no, INT4=42GB yes
    assert_eq(q, QUANT_INT4, "70B on 24GB GPU -> INT4");
    return 0;
}

fn test_suggest_quant_tpu() {
    # 7B on TPU -> BF16 preferred
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_tpu(0, 4, TPU_V5P));
    var r = registry_from_profiles(profiles);

    var q = reg_suggest_quant(r, 7000000000);
    assert_eq(q, QUANT_BF16, "7B on TPU -> BF16");
    return 0;
}

fn test_suggest_quant_cpu_only() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(16 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    # 7B on 16 GiB CPU: FP16=16.8GB < 17.18GB (16 GiB) -> fits
    var q = reg_suggest_quant(r, 7000000000);
    assert_eq(q, QUANT_FP16, "7B on 16GiB CPU -> FP16");

    # 13B on 16 GiB CPU: FP16=31.2GB no, INT8=15.6GB yes
    var profiles2 = vec_new();
    vec_push(profiles2, profile_cpu(16 * BYTES_PER_GIB));
    var r2 = registry_from_profiles(profiles2);
    var q2 = reg_suggest_quant(r2, 13000000000);
    assert_eq(q2, QUANT_INT8, "13B on 16GiB CPU -> INT8");
    return 0;
}

# A registry of a CPU with `cpu_gib` and one device `p`.
fn _host(cpu_gib, p) {
    var v = vec_new();
    vec_push(v, profile_cpu(cpu_gib * BYTES_PER_GIB));
    vec_push(v, p);
    return registry_from_profiles(v);
}

# Every AI ASIC counts, at its preferred level or the next one down it
# supports (2.5.5). Through 2.5.4 only Gaudi did, and the rest were answered
# from host RAM: INT4 on Inferentia, which cannot run it.
fn test_suggest_quant_ai_asics() {
    # inf2.xlarge-like: 15 GiB host, Inferentia2 32 GiB; 7B BF16 is 16.8 GB.
    var inf = _host(15, profile_neuron(0, NEURON_INFERENTIA, 2));
    assert_eq(reg_suggest_quant(inf, 7000000000), QUANT_BF16, "7B on Inferentia2 -> BF16");
    assert_eq(reg_suggest_quant(inf, 20000000000), QUANT_INT8, "20B on Inferentia2 -> INT8");
    var trn = _host(512, profile_neuron(0, NEURON_TRAINIUM, 2));
    assert_eq(reg_suggest_quant(trn, 7000000000), QUANT_BF16, "7B on Trainium -> BF16, not FP16 from RAM");
    # Cloud AI 100, 32 GiB, on an 8 GiB host: 13B INT8 is 15.6 GB.
    var qc = _host(8, profile_new(ACCEL_QUALCOMM, 0, 32 * BYTES_PER_GIB));
    assert_eq(reg_suggest_quant(qc, 13000000000), QUANT_INT8, "13B on Cloud AI 100 -> INT8");
    # Cerebras 44 GiB on a 16 GiB host: 13B BF16 is 31.2 GB.
    var cs = _host(16, profile_new(ACCEL_CEREBRAS, 0, 44 * BYTES_PER_GIB));
    assert_eq(reg_suggest_quant(cs, 13000000000), QUANT_BF16, "13B on Cerebras -> BF16");
    # Graphcore 900 MiB: 0.5B FP16 is 1.2 GB, INT8 0.6 GB.
    var gc = _host(16, profile_new(ACCEL_GRAPHCORE, 0, 900 * 1024 * 1024));
    assert_eq(reg_suggest_quant(gc, 500000000), QUANT_INT8, "0.5B on Graphcore -> INT8");
    var g2 = _host(15, profile_gaudi(0, GAUDI2));
    assert_eq(reg_suggest_quant(g2, 7000000000), QUANT_BF16, "Gaudi2 unchanged: BF16");
    return 0;
}

# --- Memory estimation ---

fn test_estimate_memory() {
    # 7B at FP16: 7B * 16 / 8 = 14 GB + 20% = 16.8 GB
    var est = reg_estimate_memory(7000000000, QUANT_FP16);
    assert_eq(est, 16800000000, "7B FP16 = 16.8 GB");

    # 70B at INT4: 70B * 4 / 8 = 35 GB + 20% = 42 GB
    var est2 = reg_estimate_memory(70000000000, QUANT_INT4);
    assert_eq(est2, 42000000000, "70B INT4 = 42 GB");
    return 0;
}

