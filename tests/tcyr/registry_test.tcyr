test_detection_entry_points();
test_totals_apple_unified();
test_totals_gh200();
test_totals_npu_laptop();
test_totals_mixed();
test_totals_no_cpu_and_unavailable();
test_totals_clamped();
test_suggest_quant_gpu_small();
test_suggest_quant_gpu_large();
test_suggest_quant_tpu();
test_suggest_quant_cpu_only();
test_estimate_memory();

var fails = assert_summary();
syscall(60, fails);
