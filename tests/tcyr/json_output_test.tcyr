# --- String escaping (2.5.5) ---

# A cstr holding the bytes of every class _json_clean_len must flag.
var NASTY = "GPU \"Max\" C:\\x\ttab\r\x01end";

# Every string a profile carries is escaped, so the document parses and the
# name reads back as written. Through 2.5.4 the quote ended the string and
# the rest became JSON syntax.
fn test_profile_strings_escaped() {
    var p = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_device_name(p, NASTY);
    profile_set_driver_version(p, "550\\54");
    profile_set_compute_cap(p, "8.9\"");
    var sb = str_builder_new();
    profile_to_json(sb, p);
    var js = str_builder_build(sb);
    assert_eq(_valid(js), 1, "profile with quote/backslash/control bytes parses");
    var want = "\"device_name\":\"GPU \\\"Max\\\" C:\\\\x\\ttab\\r\\u0001end\"";
    assert(str_contains_cstr(js, want) == 1, "device_name escaped byte for byte");
    assert_eq(_is(_jget(js, "device_name"), NASTY), 1, "device_name reads back");
    assert_eq(_is(_jget(js, "driver_version"), "550\\54"), 1, "driver_version reads back");
    assert_eq(_is(_jget(js, "compute_capability"), "8.9\""), 1, "compute_capability reads back");
    # A clean name is copied as before.
    var c = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_device_name(c, "NVIDIA GeForce RTX 4090");
    var sb2 = str_builder_new();
    profile_to_json(sb2, c);
    var clean = str_builder_build(sb2);
    assert(str_contains_cstr(clean, "\"device_name\":\"NVIDIA GeForce RTX 4090\"}") == 1, "clean name byte-identical");
    return 0;
}

# A name shaped to close the string and add keys. Python keeps the last of a
# duplicate key, so through 2.5.4 it read memory_bytes 1 TiB and
# available false for this 24 GiB GPU.
fn test_profile_key_injection() {
    var p = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_device_name(p, "RTX\",\"memory_bytes\":1099511627776,\"available\":false,\"x\":\"");
    var sb = str_builder_new();
    profile_to_json(sb, p);
    var js = str_builder_build(sb);
    assert_eq(_valid(js), 1, "injection-shaped name parses as one string");
    var v = bayan_json_v_parse_buf(str_data(js), str_len(js));
    var mem = bayan_json_v_int(bayan_json_v_obj_get_by_cstr(v, "memory_bytes"));
    assert_eq(mem, 24 * BYTES_PER_GIB, "memory_bytes not overridden");
    assert_eq(bayan_json_v_obj_get_by_cstr(v, "x"), 0, "no injected key");
    return 0;
}

# The registry's other string fields: a warning's tool, interconnect and
# storage names (sysfs), the environment (DMI, the k8s namespace file).
fn test_registry_strings_escaped() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(16 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);
    vec_push(reg_warnings(r), warning_tool_not_found("odd\"tool"));
    var sio = reg_system_io(r);
    sio_add_interconnect(sio, interconnect_new(ICK_INFINIBAND, "mlx5\\0", 25000));
    sio_add_storage(sio, storage_new("nvme\t0", STK_NVME, 3500));
    var env = runtime_env_new();
    env_set_instance_type(env, "Standard \"PC\"");
    env_set_k8s_namespace(env, "ns\n");
    sio_set_environment(sio, env);
    var js = registry_to_json(r);
    assert_eq(_valid(js), 1, "registry with odd tool/ic/storage/env strings parses");
    assert(str_contains_cstr(js, "\"warnings\":[\"odd\\\"tool\"]") == 1, "warning tool escaped");
    assert(str_contains_cstr(js, "\"name\":\"mlx5\\\\0\"") == 1, "interconnect name escaped");
    assert(str_contains_cstr(js, "\"name\":\"nvme\\t0\"") == 1, "storage name escaped");
    assert(str_contains_cstr(js, "\"instance_type\":\"Standard \\\"PC\\\"\"") == 1, "instance_type escaped");
    return 0;
}

# The --cost argument is echoed as "model": the Python cost(model) passes the
# caller's string through. Through 2.5.4 '7B"x' or '7B\' broke json.loads.
fn test_cost_model_escaped() {
    var js = cost_to_json("7B\"x\\", QUANT_BF16);
    assert_eq(_valid(js), 1, "cost JSON with an odd model parses");
    assert_eq(_is(_jget(js, "model"), "7B\"x\\"), 1, "model reads back");
    var ok = cost_to_json("7B", QUANT_BF16);
    assert_eq(_valid(ok), 1, "cost JSON parses");
    assert(str_contains_cstr(ok, "{\"model\":\"7B\",\"quantization\":\"BF16\"") == 1, "clean model byte-identical");
    return 0;
}

# _json_clean_len at every alignment: the word-at-a-time scan must flag each
# escape class wherever it falls in a word, find the NUL at every offset,
# and pass the bytes next to '"' and '\' and the high half.
fn test_clean_len_alignment() {
    var buf = alloc(64);
    var bad = 0;
    var off = 0;
    while (off < 8) {
        var len = 0;
        while (len < 24) {
            memset(buf, 97, 64);
            store8(buf + off + len, 0);
            if (_json_clean_len(buf + off) != len) { bad = bad + 1; }
            var at = 0;
            while (at < len) {
                store8(buf + off + at, 34);
                if (_json_clean_len(buf + off) != 0 - 1) { bad = bad + 1; }
                store8(buf + off + at, 92);
                if (_json_clean_len(buf + off) != 0 - 1) { bad = bad + 1; }
                store8(buf + off + at, 1);
                if (_json_clean_len(buf + off) != 0 - 1) { bad = bad + 1; }
                store8(buf + off + at, 31);
                if (_json_clean_len(buf + off) != 0 - 1) { bad = bad + 1; }
                store8(buf + off + at, 97);
                at = at + 1;
            }
            len = len + 1;
        }
        off = off + 1;
    }
    assert_eq(bad, 0, "clean_len flags every escape byte at every offset");
    # Neighbours of the flagged values, DEL and UTF-8 bytes need no escape.
    memset(buf, 0, 64);
    var ok = "\x20!#[]\x7f\xc3\xa9\xff\x80 tail past one word";
    memcpy(buf + 3, ok, strlen(ok));
    assert_eq(_json_clean_len(buf + 3), strlen(ok), "neighbour and high bytes are clean");
    # A special byte after the NUL is past the string.
    memset(buf, 97, 64);
    store8(buf + 5, 0);
    store8(buf + 6, 34);
    assert_eq(_json_clean_len(buf), 5, "byte after NUL ignored");
    return 0;
}

