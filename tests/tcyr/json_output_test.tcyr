alloc_init();

test_post_passes_get_system_io();
test_profile_json();
test_registry_json();
test_summary_json();
test_shared_memory_json();
test_pci_id_not_serialized();
test_json_optional_fields();
test_json_with_warnings();
test_system_io_json();
test_system_io_null_env();
test_plan_json();
test_training_json();
test_profile_strings_escaped();
test_profile_key_injection();
test_registry_strings_escaped();
test_cost_model_escaped();
test_clean_len_alignment();

var fails = assert_summary();
syscall(60, fails);
