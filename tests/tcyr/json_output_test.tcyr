# 1 if Str `js` is one well-formed JSON document.
fn _valid(js) {
    if (bayan_json_v_parse_buf(str_data(js), str_len(js)) != 0) { return 1; }
    return 0;
}

# The string value under `key` in the JSON object Str `js`, as a Str, or 0.
fn _jget(js, key) {
    var v = bayan_json_v_parse_buf(str_data(js), str_len(js));
    if (v == 0) { return 0; }
    return bayan_json_v_str(bayan_json_v_obj_get_by_cstr(v, key));
}

# 1 if `s` (a Str or 0) holds exactly cstr `want`.
fn _is(s, want) {
    if (s == 0) { return 0; }
    return str_eq_cstr(s, want);
}

# --- Post-pass wiring ---

# registry_post_passes must hand the system-I/O passes the registry's
# system_io, never the registry itself (the threaded and lazy entry points
# passed `r` through 2.3.24). Without exec the interconnect pass still runs,
# told not to start its one tool (2.5.5; through 2.5.4 it was skipped).
fn test_post_passes_get_system_io() {
    var r = hw_registry_new();
    var sio = reg_system_io(r);
    _stub_ic_arg = 0;
    _stub_storage_arg = 0;
    _stub_env_arg = 0;
    registry_post_passes(r, 1);
    assert_eq(_stub_storage_arg, sio, "storage pass gets system_io");
    assert_eq(_stub_env_arg, sio, "environment pass gets system_io");
    assert_eq(_stub_ic_arg, sio, "interconnect pass gets system_io");
    assert_eq(_stub_ic_exec, 1, "interconnect pass may run its tool");
    _stub_ic_arg = 0;
    registry_post_passes(r, 0);
    assert_eq(_stub_ic_arg, sio, "interconnect pass runs without exec");
    assert_eq(_stub_ic_exec, 0, "but without its tool");
    return 0;
}

# --- JSON output tests ---

fn test_profile_json() {
    var p = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_device_name(p, "RTX 4090");
    profile_set_compute_cap(p, "8.9");

    var sb = str_builder_new();
    profile_to_json(sb, p);
    var json = str_builder_build(sb);

    # Should contain key fields
    assert(str_contains_cstr(json, "accelerator") == 1, "has accelerator");
    assert(str_contains_cstr(json, "CUDA GPU") == 1, "has CUDA GPU");
    assert(str_contains_cstr(json, "available") == 1, "has available");
    assert(str_contains_cstr(json, "true") == 1, "available true");
    assert(str_contains_cstr(json, "memory_bytes") == 1, "has memory");
    assert(str_contains_cstr(json, "RTX 4090") == 1, "has device name");
    assert(str_contains_cstr(json, "8.9") == 1, "has CC");
    assert_eq(_valid(json), 1, "profile JSON parses");
    return 0;
}

fn test_registry_json() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(16 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var json = registry_to_json(r);

    assert(str_contains_cstr(json, "schema_version") == 1, "has schema");
    assert(str_contains_cstr(json, "profiles") == 1, "has profiles");
    assert(str_contains_cstr(json, "CPU") == 1, "has CPU");
    assert(str_contains_cstr(json, "CUDA GPU") == 1, "has CUDA");
    assert_eq(_valid(json), 1, "registry JSON parses");
    return 0;
}

fn test_summary_json() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(64 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(0, 24 * BYTES_PER_GIB));
    vec_push(profiles, profile_cuda(1, 24 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    var json = registry_to_summary_json(r);

    assert(str_contains_cstr(json, "device_count") == 1, "has device_count");
    assert(str_contains_cstr(json, "has_accelerator") == 1, "has has_accel");
    assert(str_contains_cstr(json, "true") == 1, "accel true");
    assert(str_contains_cstr(json, "gpu_count") == 1, "has gpu_count");
    assert_eq(_valid(json), 1, "summary JSON parses");
    return 0;
}

# shared_memory_bytes appears on a shared-memory accelerator only, and the
# summary for ecb (48 GB M5 Pro) counts the unified 48 GiB once.
# pci_id is internal (2.4.0): the JSON (schema v6) is unchanged.
fn test_pci_id_not_serialized() {
    var p = profile_cuda(0, 24 * BYTES_PER_GIB);
    profile_set_pci_id(p, pci_id_make(0x10DE, 0x2684));
    var sb = str_builder_new();
    profile_to_json(sb, p);
    assert(str_contains_cstr(str_builder_build(sb), "pci") == 0, "no pci key");
    assert_eq(SCHEMA_VERSION, 6, "schema still v6");
    return 0;
}

fn test_shared_memory_json() {
    var sb = str_builder_new();
    profile_to_json(sb, profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB));
    var mj = str_builder_build(sb);
    assert(str_contains_cstr(mj, "\"shared_memory_bytes\":51539607552") == 1, "metal carries shared_memory_bytes");
    var sb2 = str_builder_new();
    profile_to_json(sb2, profile_cpu(48 * BYTES_PER_GIB));
    assert(str_contains_cstr(str_builder_build(sb2), "shared_memory_bytes") == 0, "cpu omits it");
    var sb3 = str_builder_new();
    profile_to_json(sb3, profile_cuda(0, 24 * BYTES_PER_GIB));
    assert(str_contains_cstr(str_builder_build(sb3), "shared_memory_bytes") == 0, "discrete omits it");
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(48 * BYTES_PER_GIB));
    vec_push(profiles, profile_new(ACCEL_METAL, 0, 48 * BYTES_PER_GIB));
    vec_push(profiles, profile_new(ACCEL_APPLE_NPU, 0, 4 * BYTES_PER_GIB));
    var js = registry_to_summary_json(registry_from_profiles(profiles));
    assert(str_contains_cstr(js, "\"total_memory_bytes\":51539607552") == 1, "summary total = 48 GiB");
    assert(str_contains_cstr(js, "\"accelerator_memory_bytes\":51539607552") == 1, "summary accel = 48 GiB");
    assert_eq(_valid(mj), 1, "metal profile JSON parses");
    return 0;
}

fn test_json_optional_fields() {
    # CPU profile — no optional fields set
    var p = profile_cpu(16 * BYTES_PER_GIB);
    var sb = str_builder_new();
    profile_to_json(sb, p);
    var json = str_builder_build(sb);

    # Should NOT contain optional fields
    assert(str_contains_cstr(json, "device_name") == 0, "no device_name for CPU");
    assert(str_contains_cstr(json, "temperature_c") == 0, "no temp for CPU");
    assert(str_contains_cstr(json, "numa_node") == 0, "no numa for CPU");
    return 0;
}

fn test_json_with_warnings() {
    var profiles = vec_new();
    vec_push(profiles, profile_cpu(16 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);

    # Add a warning
    var warns = reg_warnings(r);
    vec_push(warns, warning_tool_not_found("nvidia-smi"));

    var json = registry_to_json(r);

    assert(str_contains_cstr(json, "warnings") == 1, "has warnings");
    assert(str_contains_cstr(json, "nvidia-smi") == 1, "warning content");
    assert_eq(_valid(json), 1, "registry JSON with warnings parses");
    return 0;
}

# --- schema v4 surface (2.3.1) ---

fn test_system_io_json() {
    var profiles = vec_new();
    vec_push(profiles, profile_cuda(0, 80 * BYTES_PER_GIB));
    var r = registry_from_profiles(profiles);
    var sio = reg_system_io(r);
    sio_add_interconnect(sio, interconnect_new(ICK_NVLINK, str_cstr(str_from("nvlink0")), 50000));
    sio_add_storage(sio, storage_new(str_cstr(str_from("nvme0n1")), STK_NVME, 3500));
    var env = runtime_env_new();
    env_set_is_docker(env, 1);
    sio_set_environment(sio, env);

    var json = registry_to_json(r);
    assert(str_contains_cstr(json, "system_io") == 1, "has system_io");
    assert(str_contains_cstr(json, "interconnects") == 1, "has interconnects");
    assert(str_contains_cstr(json, "NVLink") == 1, "has NVLink kind");
    assert(str_contains_cstr(json, "bandwidth_bytes_per_sec") == 1, "has bw");
    assert(str_contains_cstr(json, "NVMe") == 1, "has NVMe storage");
    assert(str_contains_cstr(json, "is_docker") == 1, "has env is_docker");
    assert_eq(_valid(json), 1, "system_io JSON parses");
    return 0;
}

fn test_system_io_null_env() {
