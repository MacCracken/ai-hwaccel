# The system-I/O stubs record their first argument, so
# test_post_passes_get_system_io can check registry_post_passes' wiring.
var _stub_ic_arg = 0;
var _stub_storage_arg = 0;
var _stub_env_arg = 0;
var _stub_ic_exec = 0 - 1;
fn detect_interconnects_opts(s, p, w, x) {
    _stub_ic_arg = s;
    _stub_ic_exec = x;
    return 0;
}
fn detect_storage(s) { _stub_storage_arg = s; return 0; }
fn detect_environment(s) { _stub_env_arg = s; return 0; }
