# --- Fixtures ---

var _fx_seq = 0;

# A fresh directory /tmp/ai-hwaccel-io-<pid>-<n>, as a cstr.
fn _fx_dir() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/ai-hwaccel-io-");
    str_builder_add_int(sb, sys_getpid());
    str_builder_putc(sb, '-');
    str_builder_add_int(sb, _fx_seq);
    _fx_seq = _fx_seq + 1;
    var d = str_data(str_builder_build(sb));
    sys_mkdir(d, 0x1ED);
    return d;
}

# Write cstr `text` to `dir`/`name` and give it mode `mode`. Returns the path.
fn _fx_file(dir, name, text, mode) {
    var p = sysfs_path(dir, name, 0);
    file_write_all(p, text, strlen(text));
    sys_chmod(p, mode);
    return p;
}

fn _fx_rm(dir) {
    run_tool2("rm", "-rf", dir, 0);
    return 0;
}

# Monotonic milliseconds (Linux clock_gettime).
fn _now_ms() {
    var ts[16];
    syscall(228, 1, &ts);
    return load64(&ts) * 1000 + load64(&ts + 8) / 1000000;
}

# --- which() tests ---

fn test_which_echo() {
    var path = which("echo");
    assert(path != 0, "which(echo) found");
    # Should be an absolute path starting with /
    assert_eq(load8(path), 47, "echo path starts with /");
    return 0;
}

fn test_which_missing() {
    var path = which("nonexistent_tool_xyz_12345");
    assert_eq(path, 0, "which(missing) returns 0");
    return 0;
}

# which() takes the first regular file it may execute (2.5.5). Through 2.5.4
# it took the first path that opened read-only: the 0644 file or the directory
# below shadowed the real tool, which then failed with status 127, and the
# exec-only (0111) tool was never found.
fn test_which_in_executables_only() {
    var t = _fx_dir();
    var d1 = sysfs_path(t, "d1", 0);
    var d2 = sysfs_path(t, "d2", 0);
    var d3 = sysfs_path(t, "d3", 0);
    var d4 = sysfs_path(t, "d4", 0);
    sys_mkdir(d1, 0x1ED);
    sys_mkdir(d2, 0x1ED);
    sys_mkdir(d3, 0x1ED);
    sys_mkdir(d4, 0x1ED);
    _fx_file(d1, "tool", "#!/bin/sh\n", 0x1A4);
    sys_mkdir(sysfs_path(d2, "tool", 0), 0x1ED);
    var exec_only = _fx_file(d3, "tool", "#!/bin/sh\n", 0x49);
    var runnable = _fx_file(d4, "tool", "#!/bin/sh\n", 0x1ED);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, d1);
    str_builder_putc(sb, ':');
    str_builder_add_cstr(sb, d2);
    str_builder_putc(sb, ':');
    str_builder_add_cstr(sb, d4);
    var path = str_data(str_builder_build(sb));
    var got = which_in(path, "tool");
    assert(got != 0, "which: a tool behind a 0644 file and a directory is found");
    if (got != 0) { assert_streq(got, runnable, "which: the executable one"); }
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, d3);
    str_builder_putc(sb2, ':');
    str_builder_add_cstr(sb2, d4);
    var got2 = which_in(str_data(str_builder_build(sb2)), "tool");
    assert(got2 != 0, "which: an exec-only (0111) tool is found");
    if (got2 != 0) { assert_streq(got2, exec_only, "which: the exec-only one, first on PATH"); }
    var sb3 = str_builder_new();
    str_builder_add_cstr(sb3, d1);
    str_builder_putc(sb3, ':');
    str_builder_add_cstr(sb3, d2);
    assert_eq(which_in(str_data(str_builder_build(sb3)), "tool"), 0, "which: no executable, no tool");
    assert_eq(which_in(0, "tool"), 0, "which: no PATH");
    _fx_rm(t);
    return 0;
}

# --- PATH lookup on POSIX and Windows (2.5.3) ---

# 1 if vec `v` holds exactly the cstrs `want` (a vec of cstrs), in order.
fn _same_paths(v, want) {
    if (vec_len(v) != vec_len(want)) { return 0; }
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), vec_get(want, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Empty and relative entries are skipped; through 2.5.2 the empty one gave
# "/nvidia-smi" and the relative one "bin/nvidia-smi", a file in the current
# directory.
fn test_which_candidates_posix() {
    var c = which_candidates("/usr/bin::bin:/opt/nv/:./x", "nvidia-smi", 0);
    var want = vec_new();
    vec_push(want, "/usr/bin/nvidia-smi");
    vec_push(want, "/opt/nv/nvidia-smi");
    assert_eq(_same_paths(c, want), 1, "posix: absolute entries only, in order");
    assert_eq(vec_len(which_candidates("", "sh", 0)), 0, "posix: empty PATH");
    return 0;
}

# Windows splits on ';', appends ".exe" once, drops a directory's quotes, and
# skips empty, relative and drive-relative ("C:tools") entries. Through 2.5.2
# which() split this on ':' too, so no tool was ever found on Windows.
fn test_which_candidates_windows() {
    var path = "C:\\WINDOWS\\system32;;.\\bin;C:tools;\"C:\\Program Files\\NVIDIA Corporation\\NVSMI\";D:/sdk/;\\\\srv\\share\\bin";
    var c = which_candidates(path, "nvidia-smi", 1);
    var want = vec_new();
    vec_push(want, "C:\\WINDOWS\\system32\\nvidia-smi.exe");
    vec_push(want, "C:\\Program Files\\NVIDIA Corporation\\NVSMI\\nvidia-smi.exe");
    vec_push(want, "D:/sdk/nvidia-smi.exe");
    vec_push(want, "\\\\srv\\share\\bin\\nvidia-smi.exe");
    assert_eq(_same_paths(c, want), 1, "windows: absolute entries, .exe added");
    var e = which_candidates("C:\\WINDOWS\\System32\\wbem", "wmic.EXE", 1);
    assert_streq(vec_get(e, 0), "C:\\WINDOWS\\System32\\wbem\\wmic.EXE", "windows: .exe not added twice");
    assert_eq(vec_len(which_candidates("C:\\a\"b;\"C:\\x", "t", 1)), 0, "windows: an entry with a stray quote is skipped");
    assert_streq(vec_get(which_candidates("c:/x", "t", 1), 0), "c:/x\\t.exe", "windows: a lower-case drive letter");
    var posix_on_win = which_candidates("/usr/bin:/bin", "sh", 1);
    assert_eq(vec_len(posix_on_win), 0, "windows: a POSIX PATH finds nothing");
    return 0;
}

# A path with a blank is quoted as a Windows command line's first token.
# Unquoted, CreateProcessW starts the first space-delimited prefix that exists:
# on cass, with vulkaninfo.exe under "dir with space" first on PATH and a
# dir.exe planted beside it, the unquoted line ran dir.exe (2.5.3).
fn test_cmd_win_program_token() {
    assert_streq(cmd_win_program_token("C:\\WINDOWS\\system32\\vulkaninfo.exe"), "C:\\WINDOWS\\system32\\vulkaninfo.exe", "no blank: unchanged");
    assert_streq(cmd_win_program_token("C:\\Program Files\\NVIDIA Corporation\\NVSMI\\nvidia-smi.exe"), "\"C:\\Program Files\\NVIDIA Corporation\\NVSMI\\nvidia-smi.exe\"", "blank: quoted");
    assert_streq(cmd_win_program_token("C:\\a\tb.exe"), "\"C:\\a\tb.exe\"", "tab: quoted");
    return 0;
}

# --- run_tool tests ---

fn test_run_echo() {
    var warnings = vec_new();
    var args = vec_new();
    vec_push(args, "hello");
    var result = run_tool("echo", args, warnings);
    assert(result != 0, "echo returns output");
    assert_eq(vec_len(warnings), 0, "no warnings");
    # Output should contain "hello"
    var sdata = str_data(result);
    assert(memeq(sdata, "hello", 5) == 1, "echo output");
    return 0;
}

# A run keeps what the tool printed, not its 1 MiB capture buffer (2.5.5):
# through 2.5.4 each run kept 1 052 000 bytes of heap for good.
fn test_run_tool_keeps_only_output() {
    var w = vec_new();
    run_tool1("echo", "warm", w);
    var a0 = alloc_used();
    var i = 0;
    var ok = 1;
    while (i < 4) {
        var o = run_tool1("echo", "hi", w);
        if (o == 0) { ok = 0; }
        elif (str_len(o) != 3 || memeq(str_data(o), "hi\n", 3) != 1 || load8(str_data(o) + 3) != 0) { ok = 0; }
        i = i + 1;
    }
    assert((alloc_used() - a0) / 4 < 65536, "run_tool: the 1 MiB capture buffer is not kept");
    assert_eq(ok, 1, "run_tool: output intact and NUL-terminated");
    var e = run_tool("true", vec_new(), w);
    assert(e != 0 && str_len(e) == 0, "true: an empty Str");
    if (e != 0) { assert_eq(load8(str_data(e)), 0, "true: NUL-terminated"); }
    assert_eq(vec_len(w), 0, "run_tool keeps output: no warnings");
    return 0;
}

# --- A tool's exit status (2.5.4) ---

fn test_tool_exit_warning() {
    assert_eq(tool_exit_warning("t", 0, 0), 0, "status 0: no warning");
    assert_eq(tool_exit_warning("t", 0 - 1, 0), 0, "unknown status: no warning");
    assert_eq(tool_exit_warning("t", 0 - 2, 0), 0, "deadline: its own warning, not this one");
    var w = tool_exit_warning("nvidia-smi", 9, 0);
    assert_eq(warning_code(w), HWA_ERR_TOOL_FAILED, "status 9: a tool-failed warning");
    assert_eq(warning_exit_code(w), 9, "status 9 kept");
    assert_streq(warning_tool(w), "nvidia-smi", "tool named");
    assert_streq(warning_message(w), "exited with status 9", "status message");
    assert_streq(warning_message(tool_exit_warning("t", 137, 1)), "killed by signal 9", "signal 9");
    assert_streq(warning_message(tool_exit_warning("t", 137, 0)), "exited with status 137", "exit(137) is not a signal");
    assert_streq(warning_message(tool_exit_warning("t", 3221225477, 0)), "exited with status 0xC0000005", "a Windows crash, in hex");
    return 0;
}

# A tool that fails is reported, and what it printed is still returned.
# Through 2.5.3 both of these returned their output with no warning.
fn test_run_tool_exit_status() {
    var w = vec_new();
    var args = vec_new();
    vec_push(args, "-c");
    vec_push(args, "echo partial; exit 3");
    var out = run_tool("sh", args, w);
    assert(out != 0, "exit 3: output returned");
    assert(memeq(str_data(out), "partial", 7) == 1, "exit 3: what it printed");
    assert_eq(vec_len(w), 1, "exit 3: one warning");
    assert_eq(warning_exit_code(vec_get(w, 0)), 3, "exit 3: status in the warning");
    var w2 = vec_new();
    var args2 = vec_new();
    vec_push(args2, "-c");
    vec_push(args2, "kill -9 $$");
    run_tool("sh", args2, w2);
    assert_eq(vec_len(w2), 1, "signal: one warning");
    assert_streq(warning_message(vec_get(w2, 0)), "killed by signal 9", "signal: named");
    var w3 = vec_new();
    var st[16];
    var o3 = run_tool_status("sh", args, w3, &st);
    assert(o3 != 0, "run_tool_status: output returned");
    assert_eq(vec_len(w3), 0, "run_tool_status: the caller judges the status");
    assert_eq(load64(&st), 3, "run_tool_status: status handed over");
    var w4 = vec_new();
    run_tool("true", vec_new(), w4);
    assert_eq(vec_len(w4), 0, "exit 0: no warning");
    # Output that fills the buffer: the tool dies of SIGPIPE when the read
    # stops, and only the cut is reported (test_run_tool_output_cap).
    var cut = str_new(alloc(CMD_MAX_STDOUT), CMD_MAX_STDOUT - 1);
    var sp[16];
    store64(&sp, 141);
    store64(&sp + 8, 1);
    assert_eq(tool_run_warning("head", cut, &sp), 0, "cut short: SIGPIPE not reported");
    assert(tool_run_warning("head", str_from("x"), &sp) != 0, "not cut: SIGPIPE reported");
    return 0;
}

fn test_run_missing_tool() {
    var warnings = vec_new();
    var args = vec_new();
    var result = run_tool("nonexistent_tool_xyz", args, warnings);
    assert_eq(result, 0, "missing tool returns 0");
    assert_eq(vec_len(warnings), 1, "1 warning");
    var w = vec_get(warnings, 0);
    assert_eq(warning_code(w), HWA_ERR_TOOL_NOT_FOUND, "tool not found warning");
    return 0;
}

# --- tool deadline and output cap (2.5.1) ---

# A tool silent past the deadline is killed and reported, and the caller's own
# deadline (0, unbounded) is back once no tool is in flight. A 300 ms bound
# keeps the test quick; the tool would sleep 5 s.
fn test_run_tool_deadline() {
    var saved = CMD_DEFAULT_TIMEOUT_MS;
    CMD_DEFAULT_TIMEOUT_MS = 300;
    var warnings = vec_new();
    var args = vec_new();
    vec_push(args, "-c");
    vec_push(args, "exec sleep 5");
    var t0 = _now_ms();
    var result = run_tool("sh", args, warnings);
    var elapsed = _now_ms() - t0;
    CMD_DEFAULT_TIMEOUT_MS = saved;
    assert_eq(result, 0, "silent tool past the deadline returns 0");
    # What a hung tool costs on POSIX (command.cyr's header): the idle cut,
    # a second deadline's wait, then TERM, which sleep honours at once.
    assert(elapsed >= 2 * 300, "deadline: the read cut and the wait both ran");
    assert(elapsed < 3 * 300 + 500, "deadline: about twice the bound for a tool that honours TERM");
    assert_eq(vec_len(warnings), 1, "deadline: 1 warning");
    if (vec_len(warnings) > 0) {
        var w = vec_get(warnings, 0);
        assert_eq(warning_code(w), HWA_ERR_TIMEOUT, "timeout warning");
        assert_eq(warning_timeout_ms(w), 300, "timeout warning carries the bound");
    }
    assert_eq(proc_timeout_ms(), 0, "caller's deadline restored");
    return 0;
}

# Output past the 1 MiB buffer is cut one byte short of it (room for the NUL)
# and still returned, with a warning that it was cut.
fn test_run_tool_output_cap() {
    var warnings = vec_new();
    var args = vec_new();
    vec_push(args, "-c");
    vec_push(args, "head -c 2000000 /dev/zero");
    var result = run_tool("sh", args, warnings);
    assert(result != 0, "oversized output is still returned");
    if (result != 0) {
        assert_eq(str_len(result), CMD_MAX_STDOUT - 1, "cut one byte short of the buffer");
    }
    assert_eq(vec_len(warnings), 1, "output cap: 1 warning");
    if (vec_len(warnings) > 0) {
        assert_eq(warning_code(vec_get(warnings, 0)), HWA_ERR_PARSE, "cut-short warning");
    }
    return 0;
}

# --- Captures on several threads (2.5.5) ---
# lib/process.cyr's capture state is shared between threads (cmd_capture), so
# captures take turns. Through 2.5.4 these two failed on every run: the
# healthy tool beside a hung one was reported as a timeout and its output
# dropped, and a tool started during another thread's capture held that
# capture's pipe.

fn _t_hung_entry(warns) {
    run_tool2("sh", "-c", "exec sleep 5", warns);
    return 0;
}

fn test_run_tool_threaded_cut() {
    var saved = CMD_DEFAULT_TIMEOUT_MS;
    CMD_DEFAULT_TIMEOUT_MS = 300;
    var bw = vec_new();
    var t = thread_create(&_t_hung_entry, bw);
    var w = vec_new();
    var out = run_tool2("sh", "-c", "for i in 1 2 3 4 5 6 7 8; do echo x; sleep 0.1; done", w);
    if (t != 0) { thread_join(t); }
    CMD_DEFAULT_TIMEOUT_MS = saved;
    assert(t != 0, "threaded cut: thread started");
    assert(out != 0, "threaded cut: the healthy tool's output is kept");
    if (out != 0) { assert_eq(str_len(out), 16, "threaded cut: all of it"); }
    assert_eq(vec_len(w), 0, "threaded cut: the healthy tool has no warning");
    assert_eq(vec_len(bw), 1, "threaded cut: the hung tool is reported");
    if (vec_len(bw) > 0) {
        assert_eq(warning_code(vec_get(bw, 0)), HWA_ERR_TIMEOUT, "threaded cut: as a timeout");
    }
    assert_eq(proc_timeout_ms(), 0, "threaded cut: the caller's deadline restored");
    return 0;
}

fn _t_hold_capture(arg) {
    run_tool1("sleep", "1", 0);
    return 0;
}

# How many "pipe:" fd links an `ls -l /proc/self/fd` listing shows.
fn _t_count_pipes(out) {
    if (out == 0) { return 0 - 1; }
    var d = str_data(out);
    var n = str_len(out);
    var c = 0;
    var i = 0;
    while (i + 5 <= n) {
        if (memeq(d + i, "pipe:", 5) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

fn test_capture_pipe_not_inherited() {
    var base = _t_count_pipes(run_tool2("ls", "-l", "/proc/self/fd", 0));
    assert(base >= 1, "ls sees its own capture pipe");
    var t = thread_create(&_t_hold_capture, 0);
    syscall(7, 0, 0, 200);   # the other thread's capture (sleep 1) is in flight
    var during = _t_count_pipes(run_tool2("ls", "-l", "/proc/self/fd", 0));
    if (t != 0) { thread_join(t); }
    assert_eq(during, base, "a tool does not hold another thread's capture pipe");
    return 0;
}

# --- CSV parsing tests ---

fn test_parse_csv_line() {
    var line = str_from("0, 81920, 512, 81408, 8.9, 550.54, RTX 4090");
    var fields = parse_csv_line(line, 6);
    assert(fields != 0, "parsed CSV");
    assert_eq(vec_len(fields), 7, "7 fields");
    # First field — parse as int since Str is not null-terminated
    var f0 = vec_get(fields, 0);
    assert_eq(str_to_int(f0), 0, "field 0 = 0");
    # Second field
    var f1 = vec_get(fields, 1);
    assert_eq(str_to_int(f1), 81920, "field 1 = 81920");
    # Check str equality with Str
    var expected = str_from("81920");
    assert_eq(str_eq(f1, expected), 1, "field 1 str eq");
    return 0;
}

fn test_parse_csv_too_few() {
    var line = str_from("one, two");
    var fields = parse_csv_line(line, 5);
    assert_eq(fields, 0, "too few fields returns 0");
    return 0;
}

# --- Validation tests ---

fn test_validate_device_id() {
    var s0 = str_from("0");
    assert_eq(validate_device_id(s0), 0, "id 0 valid");

    var s7 = str_from("7");
    assert_eq(validate_device_id(s7), 7, "id 7 valid");

    var s9999 = str_from("9999");
    assert_eq(validate_device_id(s9999), 0 - 1, "id 9999 invalid");
    return 0;
}

fn test_validate_memory_mb() {
    var s1024 = str_from("81920");
    assert_eq(validate_memory_mb(s1024), 81920, "81920 MB valid");

    var huge = str_from("999999999");
    assert_eq(validate_memory_mb(huge), 0 - 1, "huge mem invalid");
    return 0;
}

# 2.5.5: parse_field_int is strict, where str_to_int gathers every digit.
fn test_parse_field_int() {
    assert_eq(parse_field_int(str_from("0")), 0, "field 0");
    assert_eq(parse_field_int(str_from("81920")), 81920, "field 81920");
    assert_eq(parse_field_int(str_from("999999999999999999")), 999999999999999999, "18 digits");
    assert_eq(parse_field_int(str_from("1000000000000000000")), 0 - 1, "19 digits");
    assert_eq(parse_field_int(str_from("")), 0 - 1, "empty field");
    assert_eq(parse_field_int(str_from("[N/A]")), 0 - 1, "[N/A], not 0");
    assert_eq(parse_field_int(str_from("1.5")), 0 - 1, "1.5, not 15");
    assert_eq(parse_field_int(str_from("-3")), 0 - 1, "negative");
    assert_eq(parse_field_int(str_from("0x10")), 0 - 1, "hex");
    assert_eq(parse_field_int(0), 0 - 1, "null field");
    return 0;
}

fn test_parse_decimal_x1000() {
    assert_eq(parse_decimal_x1000(str_from("64.67")), 64670, "64.67");
    assert_eq(parse_decimal_x1000(str_from("4.32")), 4320, "4.32");
    assert_eq(parse_decimal_x1000(str_from("120.5")), 120500, "120.5");
    assert_eq(parse_decimal_x1000(str_from("450")), 450000, "450");
    assert_eq(parse_decimal_x1000(str_from("1.23456")), 1234, "fraction past 3 digits dropped");
    assert_eq(parse_decimal_x1000(str_from("70.")), 70000, "trailing point");
    assert_eq(parse_decimal_x1000(str_from("0.00")), 0, "zero");
    assert_eq(parse_decimal_x1000(str_from(" 2.5 GT/s PCIe")), 2500, "leading blank, unit after");
    assert_eq(parse_decimal_x1000(str_from("\t26.562 GB/s")), 26562, "leading tab");
    assert_eq(parse_decimal_x1000(str_from("[N/A]")), 0 - 1, "[N/A]");
    assert_eq(parse_decimal_x1000(str_from("<inactive>")), 0 - 1, "<inactive>");
    assert_eq(parse_decimal_x1000(str_from(".5")), 0 - 1, "no whole part");
    assert_eq(parse_decimal_x1000(str_from("")), 0 - 1, "empty");
    assert_eq(parse_decimal_x1000(str_from("   ")), 0 - 1, "blanks only");
    assert_eq(parse_decimal_x1000(str_from("99999999999999")), 0 - 1, "past 1e12");
    assert_eq(parse_decimal_x1000(0), 0 - 1, "null");
    return 0;
}

fn test_str_leading_uint() {
    assert_eq(str_leading_uint(str_from(" 42 W")), 42, "leading blank");
    assert_eq(str_leading_uint(str_from("7")), 7, "single digit");
    assert_eq(str_leading_uint(str_from("2.5")), 2, "stops at the point");
    assert_eq(str_leading_uint(str_from("0x10")), 0, "stops at x");
    assert_eq(str_leading_uint(str_from("[N/A]")), 0 - 1, "[N/A]");
    assert_eq(str_leading_uint(str_from("")), 0 - 1, "empty");
    assert_eq(str_leading_uint(str_from("1234567890123456789")), 0 - 1, "19 digits");
    assert_eq(str_leading_uint(0), 0 - 1, "null");
    return 0;
}

# --- sysfs tests ---

fn test_sysfs_read_proc() {
    # /proc/sys/kernel/pid_max should exist and be readable
    var s = sysfs_read("/proc/sys/kernel/pid_max");
    assert(s != 0, "pid_max readable");
    var val = str_to_int(s);
    assert(val > 0, "pid_max > 0");
    return 0;
}

fn test_sysfs_read_int() {
    var val = sysfs_read_int("/proc/sys/kernel/pid_max");
    assert(val > 0, "pid_max int > 0");
    return 0;
}

fn test_sysfs_read_missing() {
    var s = sysfs_read("/sys/nonexistent/path/xyz");
    assert_eq(s, 0, "missing path returns 0");
    return 0;
}

# A file longer than the buffer reads one byte short of it, so the NUL fits
# (2.5.1; a 4 KiB read used to put it one byte past).
fn test_sysfs_read_cap() {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/ai-hwaccel-io-test-");
    str_builder_add_int(sb, sys_getpid());
    var path = str_data(str_builder_build(sb));
    var n = SYSFS_MAX_READ + 100;
    var buf = alloc(n);
    var i = 0;
    while (i < n) {
        store8(buf + i, 65);
        i = i + 1;
    }
    assert(file_write_all(path, buf, n) == n, "temp file written");
    var s = sysfs_read(path);
    assert(s != 0, "long file readable");
    if (s != 0) {
        assert_eq(str_len(s), SYSFS_MAX_READ - 1, "read stops one byte short of the buffer");
    }
    sys_unlink(path);
    return 0;
}

# A read keeps only its bytes (2.5.5): through 2.5.4 each one kept a 4 KiB
# buffer, a missing file's included.
fn test_sysfs_read_right_sized() {
    var t = _fx_dir();
    var p = _fx_file(t, "ostype", "Linux\n", 0x1A4);
    var miss = sysfs_path(t, "absent", 0);
    var a0 = alloc_used();
    var i = 0;
    var ok = 1;
    while (i < 8) {
        var s = sysfs_read(p);
        if (s == 0) { ok = 0; }
        elif (str_len(s) != 5 || memeq(str_data(s), "Linux", 5) != 1 || load8(str_data(s) + 5) != 0) { ok = 0; }
        if (sysfs_read(miss) != 0) { ok = 0; }
        i = i + 1;
    }
    assert((alloc_used() - a0) / 8 < 256, "sysfs_read: a read keeps only its bytes");
    assert_eq(ok, 1, "sysfs_read: newline trimmed, NUL-terminated, missing file 0");
    _fx_rm(t);
    return 0;
}

fn test_path_exists() {
    assert_eq(aihw_path_exists("/proc/self/status"), 1, "/proc/self/status exists");
    assert_eq(aihw_path_exists("/nonexistent_xyz"), 0, "nonexistent path");
    return 0;
}

# --- System memory ---

fn test_detect_system_memory() {
    var mem = detect_system_memory();
    assert(mem > 0, "system memory > 0");
    # Should be at least 512 MB
    assert(mem > 512 * 1024 * 1024, "system memory > 512 MB");
    return 0;
}

# MemTotal from a /proc/meminfo image, and the cgroup limit that caps it
# inside a container (2.5.5). Through 2.5.4 a pod limited to 512 MiB on a
# 64 GB host reported 64 GB.
fn test_meminfo_total_bytes() {
    var mi = "MemTotal:       62661168 kB\nMemFree:         1000 kB\n";
    assert_eq(meminfo_total_bytes(mi, strlen(mi)), 62661168 * 1024, "meminfo: MemTotal");
    var mi2 = "MemFree: 5 kB\nMemTotal: 2048 kB\n";
    assert_eq(meminfo_total_bytes(mi2, strlen(mi2)), 2048 * 1024, "meminfo: MemTotal not first");
    var mi3 = "MemFree: 5 kB\n";
    assert_eq(meminfo_total_bytes(mi3, strlen(mi3)), 0, "meminfo: no MemTotal");
    var mi4 = "MemTot";
    assert_eq(meminfo_total_bytes(mi4, strlen(mi4)), 0, "meminfo: cut inside the key");
    return 0;
}

fn test_cgroup_limit_parse() {
    assert_eq(cgroup_limit_parse("max\n", 4), 0, "cgroup v2 max: no limit");
    assert_eq(cgroup_limit_parse("536870912\n", 10), 536870912, "cgroup v2: 512 MiB");
    assert_eq(cgroup_limit_parse("9223372036854771712\n", 20), 0, "cgroup v1 unlimited");
    assert_eq(cgroup_limit_parse("99999999999999999999999\n", 24), 0, "overflow: no limit");
    assert_eq(cgroup_limit_parse("", 0), 0, "empty: no limit");
    assert_eq(cgroup_limit_parse("12x", 3), 12, "stops at a non-digit");
    return 0;
}

fn test_cgroup_mem_limit_bytes() {
    var v2 = _fx_dir();
    _fx_file(v2, "memory.max", "536870912\n", 0x1A4);
    assert_eq(cgroup_mem_limit_bytes(v2), 536870912, "cgroup v2 memory.max");
    var v2max = _fx_dir();
    _fx_file(v2max, "memory.max", "max\n", 0x1A4);
    assert_eq(cgroup_mem_limit_bytes(v2max), 0, "cgroup v2 max: no limit");
    var v1 = _fx_dir();
    sys_mkdir(sysfs_path(v1, "memory", 0), 0x1ED);
    _fx_file(v1, "memory/memory.limit_in_bytes", "1073741824\n", 0x1A4);
    assert_eq(cgroup_mem_limit_bytes(v1), 1073741824, "cgroup v1 limit");
    var v1u = _fx_dir();
    sys_mkdir(sysfs_path(v1u, "memory", 0), 0x1ED);
    _fx_file(v1u, "memory/memory.limit_in_bytes", "9223372036854771712\n", 0x1A4);
    assert_eq(cgroup_mem_limit_bytes(v1u), 0, "cgroup v1 unlimited");
    assert_eq(cgroup_mem_limit_bytes("/nonexistent-aihw-cgroup"), 0, "no cgroup fs: no limit");
    _fx_rm(v2);
    _fx_rm(v2max);
    _fx_rm(v1);
    _fx_rm(v1u);
    return 0;
}

# --- /dev scans (2.5.5) ---

fn _dev_id(name, prefix) {
    return dev_entry_id(name, strlen(name), prefix);
}

fn test_dev_entry_id() {
    assert_eq(_dev_id("ipu0", "ipu"), 0, "dev id: ipu0");
    assert_eq(_dev_id("ipu12", "ipu"), 12, "dev id: ipu12");
    assert_eq(_dev_id("neuron3", "neuron"), 3, "dev id: neuron3");
    assert_eq(_dev_id("neuron1023", "neuron"), 1023, "dev id: 4 digits");
    assert_eq(_dev_id("ipu-psys0", "ipu"), 0 - 1, "dev id: the Intel IPU6 camera node");
    assert_eq(_dev_id("ipu7-psys0", "ipu"), 0 - 1, "dev id: the IPU7 camera node");
    assert_eq(_dev_id("ipu0_ex", "ipu"), 0 - 1, "dev id: a Graphcore companion node");
    assert_eq(_dev_id("neuron", "neuron"), 0 - 1, "dev id: bare prefix");
    assert_eq(_dev_id("neuron_x", "neuron"), 0 - 1, "dev id: non-digit suffix");
    assert_eq(_dev_id("neuron12345", "neuron"), 0 - 1, "dev id: 5 digits");
    assert_eq(_dev_id("nvme0", "ipu"), 0 - 1, "dev id: other prefix");
    return 0;
}

# 1 if vec `ids` holds `id`.
fn _has_id(ids, id) {
    var i = 0;
    while (i < vec_len(ids)) {
        if (vec_get(ids, i) == id) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn test_dev_dir_scan() {
    var t = _fx_dir();
    var names = vec_new();
    vec_push(names, "ipu0");
    vec_push(names, "ipu1");
    vec_push(names, "ipu-psys0");
    vec_push(names, "ipu7-psys0");
    vec_push(names, "ipu");
    vec_push(names, "video0");
    vec_push(names, "qaic_aic100_0");
    vec_push(names, "neuron_x");
    vec_push(names, "neuron3");
    var i = 0;
    while (i < vec_len(names)) {
        _fx_file(t, vec_get(names, i), "", 0x1A4);
        i = i + 1;
    }
    var ids = vec_new();
    assert_eq(dev_dir_scan(t, "ipu", ids), 2, "dev scan: an IPU6 camera node is no Graphcore IPU");
    assert_eq(_has_id(ids, 0) + _has_id(ids, 1), 2, "dev scan: ipu0 and ipu1");
    var nids = vec_new();
    assert_eq(dev_dir_scan(t, "neuron", nids), 1, "dev scan: neuron3, not neuron_x");
    assert_eq(dev_dir_scan(t, "qaic_", 0), 1, "dev presence: qaic_aic100_0 (any suffix)");
    assert_eq(dev_dir_scan(t, "qaic_", vec_new()), 0, "dev scan: qaic_aic100_0 has no bare id");
    assert_eq(dev_dir_scan(t, "groq", 0), 0, "dev presence: none");
    assert_eq(dev_dir_scan("/nonexistent-aihw-dev", "ipu", 0), 0, "dev scan: no directory");
    var a0 = alloc_used();
    dev_dir_scan(t, "zzz", 0);
    assert(alloc_used() - a0 < 64, "dev scan: the listing is not kept on the heap");
    _fx_rm(t);
    # A directory past the stack buffers' 2048 entries is still scanned whole.
    var big = _fx_dir();
    var j = 0;
    while (j < 2100) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "n");
        str_builder_add_int(sb, j);
        _fx_file(big, str_data(str_builder_build(sb)), "", 0x1A4);
        j = j + 1;
    }
    assert_eq(dev_dir_scan(big, "n", vec_new()), 2100, "dev scan: 2100 entries, through dir_list");
    _fx_rm(big);
    return 0;
}

# --- Data directory (2.5.5) ---

fn test_data_dir_set() {
    data_dir_set("/opt/aihw");
    assert_streq(data_file_path("VERSION"), "/opt/aihw/VERSION", "data_dir_set: the dir it was given");
    data_dir_set(0);
    if (cmd_getenv("AI_HWACCEL_DATA_DIR") == 0) {
        assert_streq(data_file_path("VERSION"), "VERSION", "no dir set: cwd-relative");
    }
    return 0;
}

# --- sysfs path building ---

fn test_sysfs_path() {
    var p = sysfs_path("/sys/class/drm", "card0", "device/vendor");
    assert(streq(p, "/sys/class/drm/card0/device/vendor") == 1, "sysfs path");

    var p2 = sysfs_path("/sys/class/misc", "intel_npu", 0);
    assert(streq(p2, "/sys/class/misc/intel_npu") == 1, "sysfs path no suffix");

    var p3 = sysfs_path("/dev", 0, 0);
    assert(streq(p3, "/dev/") == 1, "sysfs path base only");
    return 0;
}

# --- parse_value_with_suffix ---

fn test_parse_value_suffix() {
    var s1 = str_from("44 GB");
    assert_eq(parse_value_with_suffix(s1), 44, "44 GB");

    var s2 = str_from("  81920  ");
    assert_eq(parse_value_with_suffix(s2), 81920, "81920 trimmed");

    var s3 = str_from("900MB");
    assert_eq(parse_value_with_suffix(s3), 900, "900MB");
    return 0;
}

