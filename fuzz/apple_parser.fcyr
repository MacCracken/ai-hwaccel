# Fuzz: Apple system_profiler parser
# Exercises _parse_apple_macos with valid, empty, and edge-case inputs

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/fs.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"

include "src/units.cyr"
include "src/error.cyr"
include "src/types.cyr"
include "src/quantization.cyr"
include "src/profile.cyr"
include "src/system_io.cyr"
include "src/detect/platform.cyr"
include "src/detect/command.cyr"
include "src/detect/apple.cyr"

alloc_init();

# Valid M4 Pro
var p1 = vec_new();
var hw1 = str_from("Hardware Overview:\n  Chip: Apple M4 Pro\n  Memory: 36 GB\n  Cores: 14\n");
_parse_apple_macos(hw1, p1);

# M2
var p2 = vec_new();
var hw2 = str_from("  Chip: Apple M2\n  Memory: 16 GB\n");
_parse_apple_macos(hw2, p2);

# Empty — no `Chip:` line, so nothing (2.5.1; it assumed Apple Silicon)
var p3 = vec_new();
_parse_apple_macos(str_from(""), p3);
if (vec_len(p3) != 0) { syscall(60, 3); }

# No chip line
var p4 = vec_new();
_parse_apple_macos(str_from("Memory: 32 GB\n"), p4);
if (vec_len(p4) != 0) { syscall(60, 4); }

# No memory line
var p5 = vec_new();
_parse_apple_macos(str_from("Chip: Apple M3\n"), p5);

# The Neural Engine table matches a generation as a word (2.5.5): every name,
# however odd, gets one of the three figures, and an M10 is not an M1.
var names = "M1\0M10\0 M2\0M2M1\0Apple M1\0Apple M5 Max\0\0M\0";
var ni = 0;
while (ni < 33) {
    var ane = _apple_ane_bytes(str_from(names + ni));
    if (ane != 4 * BYTES_PER_GIB && ane != 6 * BYTES_PER_GIB && ane != 8 * BYTES_PER_GIB) { syscall(60, 6); }
    ni = ni + 1;
}
if (_apple_ane_bytes(str_from("Apple M10")) != 8 * BYTES_PER_GIB) { syscall(60, 7); }
var asahi = _asahi_ane_bytes(str_new("apple,j293\0apple,t8103\0", 23));
if (asahi != 4 * BYTES_PER_GIB) { syscall(60, 8); }
if (_asahi_ane_bytes(str_from("")) != 8 * BYTES_PER_GIB) { syscall(60, 8); }

syscall(60, 0);
