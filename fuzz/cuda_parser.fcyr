# Fuzz: CUDA nvidia-smi CSV parser
# Exercises parse_cuda_output with valid, empty, malformed, and edge-case inputs

include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/fs.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"

include "lib/sakshi.cyr"
include "src/log.cyr"
include "src/units.cyr"
include "src/error.cyr"
include "src/types.cyr"
include "src/quantization.cyr"
include "src/profile.cyr"
include "src/system_io.cyr"
include "src/detect/platform.cyr"
include "src/detect/command.cyr"
include "src/detect/bandwidth.cyr"
include "src/detect/cuda.cyr"

alloc_init();

# Valid single GPU line
var p1 = vec_new();
var w1 = vec_new();
var csv1 = str_from("0, 24576, 1024, 23552, 8.9, 550.54, NVIDIA GeForce RTX 4090, 45, 120.5, 30, 1325");
parse_cuda_output(csv1, p1, w1);
if (vec_len(p1) != 1) { syscall(60, 1); }
# power.draw "120.5" is 120.5 W (2.5.5: str_to_int made it 1205 W).
if (profile_power_x1000(vec_get(p1, 0)) != 120500) { syscall(60, 1); }

# Multi-GPU
var p2 = vec_new();
var w2 = vec_new();
var csv2 = str_from("0, 81920, 0, 81920, 8.0, 535.104.05, A100-SXM4-80GB, 35, 60, 0, 1593\n1, 81920, 512, 81408, 8.0, 535.104.05, A100-SXM4-80GB, 36, 62, 5, 1593");
parse_cuda_output(csv2, p2, w2);
if (vec_len(p2) != 2) { syscall(60, 2); }

# Empty input — should not crash
var p3 = vec_new();
var w3 = vec_new();
parse_cuda_output(str_from(""), p3, w3);
if (vec_len(p3) != 0) { syscall(60, 3); }

# Garbage input — should not crash
var p4 = vec_new();
var w4 = vec_new();
parse_cuda_output(str_from("garbage data with no commas"), p4, w4);

# Newlines only
var p5 = vec_new();
var w5 = vec_new();
parse_cuda_output(str_from("\n\n\n"), p5, w5);

# Partial fields (fewer than expected)
var p6 = vec_new();
var w6 = vec_new();
parse_cuda_output(str_from("0, 24576"), p6, w6);

# Very long input
var sb = str_builder_new();
var li = 0;
while (li < 100) {
    str_builder_add_cstr(sb, "0, 8192, 0, 8192, 7.0, 450, GPU-");
    str_builder_add_int(sb, li);
    str_builder_add_cstr(sb, ", 40, 70, 0, 1250\n");
    li = li + 1;
}
var p7 = vec_new();
var w7 = vec_new();
parse_cuda_output(str_builder_build(sb), p7, w7);
if (vec_len(p7) != 100) { syscall(60, 7); }

# pci.device_id (field 11, 2.4.0): valid, missing, malformed. Every line
# still yields its profile; only a valid id sets pci_id.
var ids = vec_new();
vec_push(ids, "0x268410DE");
vec_push(ids, "[N/A]");
vec_push(ids, "0x");
vec_push(ids, "0xZZZZ10DE");
vec_push(ids, "0x1234567890ABCDEF0");
vec_push(ids, "");
vec_push(ids, "0x0");
vec_push(ids, "10DE2684");
var ii = 0;
while (ii < vec_len(ids)) {
    var sb8 = str_builder_new();
    str_builder_add_cstr(sb8, "0, 8192, 0, 8192, 7.0, 450, GPU, 40, 70, 0, 1250, ");
    str_builder_add_cstr(sb8, vec_get(ids, ii));
    var p8 = vec_new();
    var w8 = vec_new();
    parse_cuda_output(str_builder_build(sb8), p8, w8);
    if (vec_len(p8) != 1) { syscall(60, 8); }
    var pid = profile_pci_id(vec_get(p8, 0));
    if (ii == 0) {
        if (pid != pci_id_make(0x10DE, 0x2684)) { syscall(60, 9); }
    } else {
        if (pid != 0) { syscall(60, 10); }
    }
    ii = ii + 1;
}

# pci.bus_id (field 12, 2.5.5): valid, missing, malformed. Every line still
# yields its profile; only a valid address sets pci_bdf, and it is never a
# path.
var bus = vec_new();
vec_push(bus, "00000000:3B:00.0");
vec_push(bus, "[N/A]");
vec_push(bus, "");
vec_push(bus, "../../../etc/passwd");
vec_push(bus, "00000000:3B:00");
vec_push(bus, "000000000:3B:00.0");
vec_push(bus, "0000000G:3B:00.0");
vec_push(bus, "00000000:3B/00.0");
vec_push(bus, "00000000:3B:00.0/x");
var bi = 0;
while (bi < vec_len(bus)) {
    var sb12 = str_builder_new();
    str_builder_add_cstr(sb12, "0, 8192, 0, 8192, 7.0, 535.104.05, GPU, 40, 70, 0, 1250, 0x1DB410DE, ");
    str_builder_add_cstr(sb12, vec_get(bus, bi));
    var p12 = vec_new();
    parse_cuda_output(str_builder_build(sb12), p12, vec_new());
    if (vec_len(p12) != 1) { syscall(60, 12); }
    var bdf = profile_pci_bdf(vec_get(p12, 0));
    if (bi == 0) {
        if (bdf == 0) { syscall(60, 13); }
        if (streq(bdf, "0000:3b:00.0") != 1) { syscall(60, 13); }
    } else {
        if (bdf != 0) { syscall(60, 14); }
    }
    bi = bi + 1;
}

# Every field of a full row replaced in turn by what nvidia-smi prints for a
# field it cannot read, parsed with and without a warnings vec and as the
# query without compute_cap: nothing crashes, memory is never below 0, and a
# row is skipped only for its index or memory.
var row = vec_new();
vec_push(row, "0");
vec_push(row, "81559");
vec_push(row, "0");
vec_push(row, "81559");
vec_push(row, "9.0");
vec_push(row, "550.54");
vec_push(row, "NVIDIA H100");
vec_push(row, "30");
vec_push(row, "70.24");
vec_push(row, "0");
vec_push(row, "2619");
vec_push(row, "0x233010DE");
vec_push(row, "00000000:3B:00.0");
var bad = vec_new();
vec_push(bad, "[N/A]");
vec_push(bad, "[Not Supported]");
vec_push(bad, "[Unknown Error]");
vec_push(bad, "");
vec_push(bad, "-1");
vec_push(bad, "1.5.5");
vec_push(bad, "99999999999999999999999");
var fi = 0;
while (fi < vec_len(row)) {
    var bj = 0;
    while (bj < vec_len(bad)) {
        var sb13 = str_builder_new();
        var k = 0;
        while (k < vec_len(row)) {
            if (k > 0) { str_builder_add_cstr(sb13, ", "); }
            if (k == fi) { str_builder_add_cstr(sb13, vec_get(bad, bj)); } else { str_builder_add_cstr(sb13, vec_get(row, k)); }
            k = k + 1;
        }
        var line13 = str_builder_build(sb13);
        var p13 = vec_new();
        var w13 = vec_new();
        parse_cuda_output(line13, p13, w13);
        parse_cuda_output(line13, p13, 0);
        parse_cuda_output_cc(line13, p13, 0, 0);
        var m = 0;
        while (m < vec_len(p13)) {
            if (profile_memory_bytes(vec_get(p13, m)) < 0) { syscall(60, 15); }
            m = m + 1;
        }
        if (fi > 1 && vec_len(w13) != 0) { syscall(60, 16); }
        if (fi > 1 && vec_len(p13) < 2) { syscall(60, 16); }
        bj = bj + 1;
    }
    fi = fi + 1;
}

syscall(60, 0);
