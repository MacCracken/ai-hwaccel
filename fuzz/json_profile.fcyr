# Fuzz: profile_from_json_str, the untrusted-JSON entry point (threat model).
# Feeds it fixed adversarial documents, then a seeded flip / overwrite /
# truncate loop over five valid profile documents. A document it accepts
# must hold values inside profile_from_json's ranges, must re-serialize to
# JSON bayan parses, and must read back as the same profile. Added 2.5.5;
# a distinct exit code names the check that failed.

include "lib/string.cyr"
include "lib/alloc.cyr"
