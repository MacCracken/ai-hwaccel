# log.cyr — structured logging shim over sakshi (2.3.8).
#
# ai-hwaccel previously logged nothing: detectors shelled out to
# nvidia-smi / wmic / rocm-smi and silently swallowed failures into the
# warnings vec (surfaced only in JSON output). This wires the AGNOS
# `sakshi` structured logger through the pipeline so the binary is
# observable in the field.
#
# Contract:
#   - All logs go to **stderr (fd 2)** via sakshi's default output. stdout
#     stays byte-clean for the JSON that consumers (hoosh, daimon, …) parse.
#   - Default level is **WARN**: quiet on success, visible on failure.
#     ai-hwaccel keeps a threshold of its own (_hwlog_level, WARN until set),
#     and one of its lines goes out only when both that threshold and
#     sakshi's level allow it. sakshi's level is the host program's:
#     including this module leaves it alone, so a library consumer keeps
#     sakshi's INFO default for its own lines while ai-hwaccel's INFO lines
#     (a "detect: profiles=N" per detection) stay off. Through 2.5.4 those
#     followed sakshi's level alone and reached such a consumer's stderr. A
#     consumer raises ai-hwaccel's threshold with hwlog_set_level.
#   - The CLI owns its process, so it sets both levels
#     (hwlog_set_process_level): hwlog_init reads the `AI_HWACCEL_LOG` env
#     var (off|fatal|error|warn|info|debug|trace, any letter case), then the
#     `--log-level <name>` / `-v` (debug) / `-vv` (trace) / `-q` (off) CLI
#     flags apply. env is read first; a CLI flag wins. An unknown env name
#     warns once the flags are applied (hwlog_report_env), so -q silences it.
#   - Hot-path rule: a below-threshold log call still **evaluates its
#     arguments**. Static-message helpers (hwlog_warn etc.) only cost two
#     level compares, but any helper that *builds* a message (hwlog_*_n) is
#     guarded by hwlog_enabled() so no str_builder runs when the level is
#     suppressed. Never log inside a per-iteration parse loop — log per
#     operation (one detector, one plan), at dispatch sites.
#   - Every emitter goes through sakshi's public per-level functions, so a
#     consumer's `-D SAKSHI_DISABLE_<LEVEL>` or `#define SAKSHI_LEVEL <n>`
#     removes the hwlog_*_n lines as it does the static ones.

# ai-hwaccel's own threshold (above). A constant initializer: nothing runs
# when a program includes this module.
var _hwlog_level = SK_WARN;

# An AI_HWACCEL_LOG value hwlog_init could not read (a cstr), held for
# hwlog_report_env; 0 when none.
var _hwlog_bad_env = 0;

# Set ai-hwaccel's threshold to `lv` (an SK_* level, or -1 for off). sakshi's
# level, the host's, is left alone; a line still needs both.
fn hwlog_set_level(lv): i64 {
    _hwlog_level = lv;
    return 0;
}

# ai-hwaccel's threshold.
fn hwlog_get_level(): i64 {
    return _hwlog_level;
}

# Set ai-hwaccel's threshold and sakshi's to `lv`: for a program that owns
# its process's logging, as the CLI does.
fn hwlog_set_process_level(lv): i64 {
    _hwlog_level = lv;
    sakshi_set_level(lv);
    return 0;
}

# Map a level name (cstring, any letter case) to a sakshi SK_* level. "off"
# returns a below-FATAL sentinel (-1) so even fatals are suppressed; an
# unknown name, or 0, returns -100 so the caller can leave the level
# untouched.
fn hwlog_level_from_name(name): i64 {
    if (hw_streq_ci(name, "off") == 1) { return 0 - 1; }
    if (hw_streq_ci(name, "fatal") == 1) { return SK_FATAL; }
    if (hw_streq_ci(name, "error") == 1) { return SK_ERROR; }
    if (hw_streq_ci(name, "warn") == 1) { return SK_WARN; }
    if (hw_streq_ci(name, "info") == 1) { return SK_INFO; }
    if (hw_streq_ci(name, "debug") == 1) { return SK_DEBUG; }
    if (hw_streq_ci(name, "trace") == 1) { return SK_TRACE; }
    return 0 - 100;
}

# Warn that `src` (the env var or the flag) named no level. Through 2.5.4
# "AI_HWACCEL_LOG=verbose" was dropped without a word.
fn _hwlog_unknown_level(src, name): i64 {
    if (hwlog_enabled(SK_WARN) == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, src);
    str_builder_add_cstr(sb, ": unknown log level '");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "', ignored (off|fatal|error|warn|info|debug|trace)");
    var m = str_builder_build(sb);
    sakshi_warn(str_data(m), str_len(m));
    return 0;
}

# Initialize logging for a program that owns its process (the CLI): both
# levels to WARN, or to AI_HWACCEL_LOG's level. Call once at startup, after
# alloc_init() (the env read + any built message allocates). sakshi already
# defaults to stderr, so this only sets the levels and tags the process for
# log correlation. An unknown AI_HWACCEL_LOG is kept for hwlog_report_env.
fn hwlog_init(): i64 {
    hwlog_set_process_level(SK_WARN);
    _hwlog_bad_env = 0;
    var ev = getenv("AI_HWACCEL_LOG");
    # Set but empty reads as unset.
    if (ev != 0 && load8(ev) != 0) {
        var lv = hwlog_level_from_name(ev);
        if (lv != (0 - 100)) { hwlog_set_process_level(lv); }
        else { _hwlog_bad_env = ev; }
    }
    sakshi_trace_set(getpid());
    return 0;
}

# Warn, once, about the unknown AI_HWACCEL_LOG value hwlog_init kept, at the
# level the program settled on: main.cyr calls this after its level flags,
# so -q or --log-level error silences it.
fn hwlog_report_env(): i64 {
    if (_hwlog_bad_env != 0) { _hwlog_unknown_level("AI_HWACCEL_LOG", _hwlog_bad_env); }
    _hwlog_bad_env = 0;
    return 0;
}

# Apply a `--log-level <name>` value (cstring, or 0 if the flag was
# absent) to both levels, as hwlog_init does. An unknown name warns and
# leaves the env/default level; the CLI refuses one before it gets here.
fn hwlog_apply_level_name(val): i64 {
    if (val == 0) { return 0; }
    var lv = hwlog_level_from_name(val);
    if (lv != (0 - 100)) { hwlog_set_process_level(lv); }
    else { _hwlog_unknown_level("--log-level", val); }
    return 0;
}

# True if a message at `level` would be emitted: at or above both
# ai-hwaccel's threshold and sakshi's level. Guard expensive (allocating)
# message construction with this.
fn hwlog_enabled(level): i64 {
    if (level > _hwlog_level) { return 0; }
    if (level > sakshi_get_level()) { return 0; }
    return 1;
}

# --- Static-message emitters (cstring literal) ---
#
# Each checks ai-hwaccel's threshold, then sakshi's per-level function
# checks sakshi's.

fn hwlog_fatal(msg): i64 {
    if (hwlog_enabled(SK_FATAL) == 1) { sakshi_fatal(msg, strlen(msg)); }
    return 0;
}

fn hwlog_error(msg): i64 {
    if (hwlog_enabled(SK_ERROR) == 1) { sakshi_error(msg, strlen(msg)); }
    return 0;
}

fn hwlog_warn(msg): i64 {
    if (hwlog_enabled(SK_WARN) == 1) { sakshi_warn(msg, strlen(msg)); }
    return 0;
}

fn hwlog_info(msg): i64 {
    if (hwlog_enabled(SK_INFO) == 1) { sakshi_info(msg, strlen(msg)); }
    return 0;
}

fn hwlog_debug(msg): i64 {
    if (hwlog_enabled(SK_DEBUG) == 1) { sakshi_debug(msg, strlen(msg)); }
    return 0;
}

fn hwlog_trace(msg): i64 {
    if (hwlog_enabled(SK_TRACE) == 1) { sakshi_trace(msg, strlen(msg)); }
    return 0;
}

# --- Message + integer emitter ("prefix" + n) ---
#
# Guarded so the str_builder never runs when the level is suppressed. The
# line goes out through the level's sakshi_* function, not sakshi's private
# _sk_log (through 2.5.4), which skipped the compile-time gates.
fn hwlog_emit_n(level, prefix, n): i64 {
    if (hwlog_enabled(level) == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, n);
    var m = str_builder_build(sb);
    var d = str_data(m);
    var len = str_len(m);
    if (level == SK_FATAL) { sakshi_fatal(d, len); }
    elif (level == SK_ERROR) { sakshi_error(d, len); }
    elif (level == SK_WARN) { sakshi_warn(d, len); }
    elif (level == SK_INFO) { sakshi_info(d, len); }
    elif (level == SK_DEBUG) { sakshi_debug(d, len); }
    else { sakshi_trace(d, len); }
    return 0;
}

fn hwlog_warn_n(prefix, n): i64 { return hwlog_emit_n(SK_WARN, prefix, n); }

fn hwlog_info_n(prefix, n): i64 { return hwlog_emit_n(SK_INFO, prefix, n); }

fn hwlog_debug_n(prefix, n): i64 { return hwlog_emit_n(SK_DEBUG, prefix, n); }

# --- Span wrappers (cstring name) ---
#
# Spans are a debug+ feature. sakshi emits span enter/exit
# unconditionally (they are not level-gated internally), so we gate here:
# at WARN default a successful run produces no span noise. enter and exit
# read the same fixed post-init level, so the sakshi span stack stays
# balanced (both gated out together, or both run).

fn hwlog_span_enter(name): i64 {
    if (hwlog_enabled(SK_DEBUG) == 0) { return 0; }
    sakshi_span_enter(name, strlen(name));
    return 0;
}

fn hwlog_span_exit(): i64 {
    if (hwlog_enabled(SK_DEBUG) == 0) { return 0; }
    sakshi_span_exit();
    return 0;
}
