# registry.cyr — accelerator registry: detect, query, plan
#
# Registry — profiles + warnings + system_io + schema_version.
# Struct named `reg` to match the `reg_*` accessor convention;
# constructor is `hw_registry_new` (renamed from `registry_new` to
# avoid the bote-core `registry_new` symbol collision — fns/enum
# members are global in Cyrius, last-def-wins; see
# docs/development/issues/2026-06-11-registry-new-collision.md).
# No `registry_new` alias: an alias by that name would reintroduce
# the exact collision. 2.1.5: hand-rolled accessors
# replaced with #derive(accessors); the internal `load64(r)` /
# `load64(r + N)` shortcuts in helpers below switched to the
# derived `reg_*` getters for consistency with the rest of the file.

#derive(accessors)
struct reg {
    profiles;
    warnings;
    system_io;
    schema;
}

var REGISTRY_SIZE = 32;

fn hw_registry_new() {
    var r = alloc(REGISTRY_SIZE);
    reg_set_profiles(r, vec_new());
    reg_set_warnings(r, vec_new());
    reg_set_system_io(r, system_io_new());
    reg_set_schema(r, SCHEMA_VERSION);
    return r;
}

fn reg_add_profile(r, p) {
    vec_push(reg_profiles(r), p);
    return 0;
}

# --- Query methods ---

fn reg_num_profiles(r) {
    return vec_len(reg_profiles(r));
}

fn reg_get_profile(r, idx) {
    return vec_get(reg_profiles(r), idx);
}

fn reg_num_warnings(r) {
    return vec_len(reg_warnings(r));
}

# Total memory across all available devices, counting system RAM once.
#
# A profile's `shared_mem` part is system RAM (see src/profile.cyr): all of the
# CPU's memory, all of a unified-memory device's (Apple Silicon's GPU and
# Neural Engine, the client NPUs), GH200's 480 GiB of Grace memory. Summing
# memory_bytes counted that RAM once per profile: a 48 GB M5 Pro totalled
# 100 GiB in 2.3.27 (CPU 48 + GPU 48 + Neural Engine 4). So the shared parts
# fold into one pool, the largest of them, and only the rest adds up. With no
# shared-memory device the pool is the CPU's RAM and the result is the plain
# sum, as before. One host per registry: the pool is a max, not a sum.
fn reg_total_memory(r) {
    var profs = reg_profiles(r);
    var total = 0;
    var pool = 0;
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) == 1) {
            # profile_shared_bytes, inlined: a call per profile cost +70% on
            # total_memory_13dev. A device that shares nothing adds its memory
            # as before, for one extra load and compare.
            if (profile_shared_mem(p) == 0) {
                total = total + profile_memory_bytes(p);
            } else {
                var part = profile_shared_mem(p);
                if (part > profile_memory_bytes(p)) { part = profile_memory_bytes(p); }
                if (part < 0) { part = 0; }
                if (part > pool) { pool = part; }
                total = total + profile_memory_bytes(p) - part;
            }
        }
    }
    return total + pool;
}

# Total accelerator memory (excludes CPU), counting shared system RAM once:
# dedicated accelerator memory plus the largest shared part any accelerator
# can address (48 GiB on that M5 Pro, not GPU 48 + Neural Engine 4).
fn reg_total_accel_memory(r) {
    var profs = reg_profiles(r);
    var total = 0;
    var pool = 0;
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_accel_type(p) == ACCEL_CPU) { continue; }
        if (profile_shared_mem(p) == 0) {
            total = total + profile_memory_bytes(p);
            continue;
        }
        var part = profile_shared_mem(p);
        if (part > profile_memory_bytes(p)) { part = profile_memory_bytes(p); }
        if (part < 0) { part = 0; }
        if (part > pool) { pool = part; }
        total = total + profile_memory_bytes(p) - part;
    }
    return total + pool;
}

# Whether any non-CPU accelerator is available
fn reg_has_accelerator(r) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_accel_type(p) != ACCEL_CPU) { return 1; }
    }
    return 0;
}

# Best available device (highest rank)
fn reg_best_available(r) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var best = 0;
    var best_rank = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        var rank = profile_rank(p);
        if (rank > best_rank) {
            best_rank = rank;
            best = p;
        }
    }
    return best;
}

# Count profiles by family
fn reg_count_by_family(r, family) {
    var profs = reg_profiles(r);
    var count = 0;
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_family(p) == family) { count = count + 1; }
    }
    return count;
}

# Collect available profiles by family into a vec
fn reg_by_family(r, family) {
    var profs = reg_profiles(r);
    var result = vec_new();
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_family(p) == family) { vec_push(result, p); }
    }
    return result;
}

# Estimate memory for model_params at given quantization
fn reg_estimate_memory(model_params, quant) {
    return quant_model_bytes_with_overhead(model_params, quant);
}

# Suggest quantization level based on available hardware
fn reg_suggest_quant(r, model_params) {
    var best_tpu = 0;
    var best_gaudi = 0;
    var best_gpu = 0;
    var best_npu = 0;
    var best_cpu = 0;

    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        var mem = profile_memory_bytes(p);
        var fam = profile_family(p);
        if (fam == FAMILY_TPU) { if (mem > best_tpu) { best_tpu = mem; } }
        elif (fam == FAMILY_GPU) { if (mem > best_gpu) { best_gpu = mem; } }
        elif (fam == FAMILY_NPU) { if (mem > best_npu) { best_npu = mem; } }
        elif (fam == FAMILY_CPU) { if (mem > best_cpu) { best_cpu = mem; } }
        elif (fam == FAMILY_AI_ASIC) {
            if (profile_accel_type(p) == ACCEL_GAUDI) {
                if (mem > best_gaudi) { best_gaudi = mem; }
            }
        }
    }

    var est_bf16 = reg_estimate_memory(model_params, QUANT_BF16);
    var est_fp16 = reg_estimate_memory(model_params, QUANT_FP16);
    var est_int8 = reg_estimate_memory(model_params, QUANT_INT8);
    var est_int4 = reg_estimate_memory(model_params, QUANT_INT4);

    # TPU -> BF16
    if (best_tpu > 0) {
        if (est_bf16 <= best_tpu) { return QUANT_BF16; }
        if (est_int8 <= best_tpu) { return QUANT_INT8; }
    }
    # Gaudi -> BF16
    if (best_gaudi > 0) {
        if (est_bf16 <= best_gaudi) { return QUANT_BF16; }
        if (est_int8 <= best_gaudi) { return QUANT_INT8; }
    }
    # GPU -> FP16
    if (best_gpu > 0) {
        if (est_fp16 <= best_gpu) { return QUANT_FP16; }
        if (est_int8 <= best_gpu) { return QUANT_INT8; }
        if (est_int4 <= best_gpu) { return QUANT_INT4; }
    }
    # NPU -> INT8/INT4
    if (best_npu > 0) {
        if (est_int8 <= best_npu) { return QUANT_INT8; }
        if (est_int4 <= best_npu) { return QUANT_INT4; }
    }
    # CPU fallback
    var cpu_mem = best_cpu;
    if (cpu_mem == 0) { cpu_mem = 16 * BYTES_PER_GIB; }
    if (est_fp16 <= cpu_mem) { return QUANT_FP16; }
    if (est_int8 <= cpu_mem) { return QUANT_INT8; }
    return QUANT_INT4;
}

# --- Detection builder (bitmask) ---

# All backends enabled
fn builder_all() { return (1 << AIHW_BACKEND_COUNT) - 1; }

# No backends enabled
fn builder_none() { return 0; }

# Enable/disable a backend
fn builder_with(mask, backend) { return mask | (1 << backend); }
fn builder_without(mask, backend) { return mask & (~(1 << backend)); }
fn builder_is_enabled(mask, backend) { return (mask >> backend) & 1; }

# Mask of backends whose detectors are pure sysfs/syscall reads — no
# subprocess spawning. Library consumers with a no-exec contract
# (mihi's probe surface) call this then registry_detect_with(builder_no_exec()),
# or use the convenience registry_detect_no_exec() entry point.
fn builder_no_exec() {
    var mask = 0;
    var b = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (backend_uses_exec(b) == 0) {
            mask = mask | (1 << b);
        }
        b = b + 1;
    }
    return mask;
}

# --- One physical device, one profile (2.4.0) ---

# 1 if `name` (a cstr, or 0) is a backend's stand-in rather than a model name:
# missing, ROCm's sysfs fallback ("AMD Radeon (PCI 0x1002:0x1638)", or "AMD
# Radeon"), or the Apple backend's "Apple Silicon" / "Apple Silicon (Asahi
# Linux)". Pure.
fn profile_name_is_placeholder(name) {
    if (name == 0) { return 1; }
    var n = strlen(name);
    if (n == 0) { return 1; }
    if (streq(name, "AMD Radeon") == 1) { return 1; }
    if (n >= 16) {
        if (memeq(name, "AMD Radeon (PCI ", 16) == 1) { return 1; }
    }
    if (streq(name, "Apple Silicon") == 1) { return 1; }
    if (streq(name, "Apple Silicon (Asahi Linux)") == 1) { return 1; }
    return 0;
}

# The profile that Vulkan profile `vk` is another view of, or 0: a CUDA or ROCm
# profile with the same nonzero pci_id, or, when `vk` is an integrated GPU on
# system RAM and `profiles` holds an Apple Metal profile, that one. Pure.
fn _dedup_twin(profiles, vk) {
    var pid = profile_pci_id(vk);
    var on_ram = 0;
    if (profile_shared_bytes(vk) > 0) { on_ram = 1; }
    var n = vec_len(profiles);
    var i = 0;
    while (i < n) {
        var q = vec_get(profiles, i);
        i = i + 1;
        var t = profile_accel_type(q);
        if (t == ACCEL_CUDA || t == ACCEL_ROCM) {
            if (pid != 0 && profile_pci_id(q) == pid) { return q; }
        }
        if (t == ACCEL_METAL && on_ram == 1) { return q; }
    }
    return 0;
}

# Log (at debug) that Vulkan profile `vk` was dropped as a view of `twin`,
# and (`renamed` 1) that `twin` takes its name. Call before renaming.
fn _dedup_log(vk, twin, renamed) {
    if (hwlog_enabled(SK_DEBUG) == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "dedup: Vulkan GPU ");
    if (profile_device_name(vk) != 0) { str_builder_add_cstr(sb, profile_device_name(vk)); }
    str_builder_add_cstr(sb, " is the ");
    str_builder_add_cstr(sb, accel_name(profile_accel_type(twin)));
    str_builder_add_cstr(sb, " ");
    if (profile_device_name(twin) != 0) { str_builder_add_cstr(sb, profile_device_name(twin)); }
    str_builder_add_cstr(sb, "; dropped");
    if (renamed == 1) { str_builder_add_cstr(sb, ", its name kept"); }
    var m = str_builder_build(sb);
    _sk_log(SK_DEBUG, str_data(m), str_len(m));
    return 0;
}

# Several backends can report one GPU. Vulkan sees the cards CUDA and ROCm see,
# and on Apple Silicon the GPU the Apple backend reports. The dedicated
# backend's profile survives, with its own memory figure and fields; the
# Vulkan one is dropped:
#   - a Vulkan profile whose pci_id (PCI vendor and device ID) matches a CUDA
#     or ROCm profile's. Every such Vulkan profile goes, so a GPU listed by two
#     Vulkan drivers (RADV and AMDVLK) goes twice. A device no dedicated
#     backend reports, such as an Intel iGPU next to an NVIDIA card, stays.
#     The Rust releases dropped every Vulkan GPU whenever any CUDA or ROCm GPU
#     was found, that iGPU included.
#   - an integrated Vulkan GPU on system RAM when an Apple Metal profile exists:
#     MoltenVK (macOS) and Honeykrisp (Asahi Linux) list the same SoC GPU.
# A survivor whose name is a placeholder (profile_name_is_placeholder) takes
# the dropped profile's name, which has the model: on the dev host, ROCm's
# "AMD Radeon (PCI 0x1002:0x1638)" becomes RADV's "AMD Radeon Graphics (RADV
# RENOIR)". Order is kept; `profiles` is compacted in place. Returns the number
# of profiles dropped. Through 2.3.29 nothing was dropped: the dev host listed
# its one iGPU twice and counted its 8 GiB twice.
fn profiles_dedup(profiles) {
    var n = vec_len(profiles);
    if (n < 2) { return 0; }
    var drop = alloc(n);
    var i = 0;
    while (i < n) {
        store8(drop + i, 0);
        var p = vec_get(profiles, i);
        if (profile_accel_type(p) == ACCEL_VULKAN) {
            var twin = _dedup_twin(profiles, p);
            if (twin != 0) {
                store8(drop + i, 1);
                var rename = 0;
                if (profile_name_is_placeholder(profile_device_name(twin)) == 1) {
                    if (profile_name_is_placeholder(profile_device_name(p)) == 0) { rename = 1; }
                }
                _dedup_log(p, twin, rename);
                if (rename == 1) { profile_set_device_name(twin, profile_device_name(p)); }
            }
        }
        i = i + 1;
    }
    var kept = 0;
    i = 0;
    while (i < n) {
        if (load8(drop + i) == 0) {
            vec_set(profiles, kept, vec_get(profiles, i));
            kept = kept + 1;
        }
        i = i + 1;
    }
    vec_truncate(profiles, kept);
    return n - kept;
}

# --- Full detection orchestration ---

# Post-passes shared by every detection entry point (registry_detect_with_opts,
# registry_detect_threaded_with, lazy_into_registry): drop duplicate views of
# one device (profiles_dedup, 2.4.0), enrich the profiles, then fill the
# registry's system I/O. The three system-I/O passes take the
# registry's system_io, NOT the registry — through 2.3.24 the threaded and lazy
# paths passed `r`, which pushed interconnects into profiles and storage into
# warnings and replaced system_io with the environment struct, so serializing
# that registry segfaulted. detect_interconnects shells out to ibstat /
# nvidia-smi topo, so it runs only when `allow_exec` is 1.
fn registry_post_passes(r, allow_exec) {
    var profs = reg_profiles(r);
    var sio = reg_system_io(r);
    # First, so enrichment runs once per physical device.
    profiles_dedup(profs);
    enrich_bandwidth(profs);
    enrich_pcie(profs);
    enrich_numa(profs);
    if (allow_exec == 1) {
        detect_interconnects(sio, profs, reg_warnings(r));
    }
    detect_storage(sio);
    detect_environment(sio);
    return 0;
}

fn registry_detect() {
    return registry_detect_with_opts(builder_all(), 1);
}

fn registry_detect_with(builder_mask) {
    return registry_detect_with_opts(builder_mask, 1);
}

# No-subprocess detection — masks off exec-shelling backends (defense
# in depth: even if the caller's mask had them set) and skips the only
# exec-shaped post-pass (detect_interconnects, which calls ibstat /
# nvidia-smi for fabric topology). Safe to call from contexts that
# forbid process spawning, e.g. mihi probes. See backend_uses_exec()
# in types.cyr for the per-backend classification.
fn registry_detect_no_exec() {
    return registry_detect_with_opts(builder_no_exec(), 0);
}

fn registry_detect_with_opts(builder_mask, allow_exec) {
    # When exec is forbidden, force-strip any exec backends the caller
    # may have enabled. backend_uses_exec() is the source of truth.
    if (allow_exec == 0) {
        builder_mask = builder_mask & builder_no_exec();
    }

    hwlog_span_enter("detect");
    hwlog_debug_n("detect: builder_mask=", builder_mask);

    var r = hw_registry_new();
    var profs = reg_profiles(r);
    var warns = reg_warnings(r);

    # Always add CPU profile
    var sys_mem = detect_system_memory_opts(allow_exec);
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    reg_add_profile(r, profile_cpu(sys_mem));

    # Run enabled detectors
    if (builder_is_enabled(builder_mask, BACKEND_CUDA) == 1) { detect_cuda(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_ROCM) == 1) { detect_rocm(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_APPLE) == 1) {
        detect_apple_opts(profs, warns, allow_exec);
    }
    if (builder_is_enabled(builder_mask, BACKEND_VULKAN) == 1) {
        # vulkaninfo only with exec; otherwise the sysfs scan. With exec off it
        # leaves amdgpu devices to ROCm when ROCm runs too, so no-exec mode
        # gains the Intel and NVIDIA GPUs it lacked without a second AMD
        # profile.
        var leave_amd = 0;
        if (allow_exec == 0) { leave_amd = builder_is_enabled(builder_mask, BACKEND_ROCM); }
        detect_vulkan_opts(profs, warns, allow_exec, leave_amd);
    }
    if (builder_is_enabled(builder_mask, BACKEND_INTEL_NPU) == 1) {
        detect_intel_npu(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_AMD_XDNA) == 1) {
        detect_amd_xdna(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_TPU) == 1) { detect_tpu(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_GAUDI) == 1) { detect_gaudi(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_NEURON) == 1) { detect_neuron(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_INTEL_ONEAPI) == 1) {
        detect_intel_oneapi(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_QUALCOMM) == 1) {
        detect_qualcomm(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_CEREBRAS) == 1) {
        detect_cerebras(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_GRAPHCORE) == 1) {
        detect_graphcore(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_GROQ) == 1) {
        detect_groq(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_SAMSUNG_NPU) == 1) {
        detect_samsung_npu(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_MEDIATEK_APU) == 1) {
        detect_mediatek_apu(profs, warns);
    }
    #ifdef CYRIUS_TARGET_WIN
    # Windows-native GPU detection: DXGI adapter enumeration, which spawns
    # nothing, so it runs with allow_exec 0 too; only its wmic fallback
    # (DXGI unavailable) needs allow_exec. detect_windows_opts exists only on
    # PE builds, so both the symbol and call are gated.
    if (builder_is_enabled(builder_mask, BACKEND_WINDOWS) == 1) {
        detect_windows_opts(profs, warns, allow_exec);
    }
    #endif

    # Post-passes: enrich profiles, then system I/O (interconnects only with
    # allow_exec).
    registry_post_passes(r, allow_exec);

    # One summary line per detection pass (info), plus a warn when a
    # detector pushed diagnostics. Counts are cheap (vec_len); the
    # messages are guarded inside hwlog_*_n so nothing builds when
    # suppressed.
    var nwarn = vec_len(warns);
    warnings_log_parse(warns, 0);
    if (nwarn > 0) { hwlog_info_n("detect: warnings=", nwarn); }
    hwlog_info_n("detect: profiles=", vec_len(profs));
    hwlog_span_exit();

    return r;
}

# Build a registry from a list of profiles (for testing)
fn registry_from_profiles(profile_vec) {
    var r = hw_registry_new();
    var n = vec_len(profile_vec);
    var i = 0;
    while (i < n) {
        reg_add_profile(r, vec_get(profile_vec, i));
        i = i + 1;
    }
    return r;
}
