# cache.cyr — detection result caching with configurable TTL
# Avoids redundant hardware detection for apps that poll frequently.
#
# Usage:
#   var c = cached_registry_new(60);  # 60 second TTL
#   var r = cached_get(c);            # first call: detects
#   var r = cached_get(c);            # within TTL: returns cached
#   cached_invalidate(c);             # force re-detect on next get

# Monotonic clock → whole seconds. Used only for TTL expiry, so second
# resolution is enough and a monotonic-since-boot source is fine.
#
# 2.3.21: this was a bare `syscall(228, 1, &ts); return load64(&ts);` with NO
# target guard, and the Linux assumption baked into it holds on exactly one
# target. cyrius `lib/chrono.cyr` documents the divergence, and this mirrors
# its branches rather than re-deriving them:
#
#   Linux   — 228 fills the timespec at &ts; CLOCK_MONOTONIC is 1.
#   macOS   — arm64 routes 228 to libSystem `_clock_gettime_nsec_np(clock_id)`,
#             which RETURNS the ns count and does NOT touch &ts; and Darwin's
#             CLOCK_MONOTONIC is **6**, not 1. (x86-macOS does not route 228 at
#             all — that arch is held upstream; it falls through to 0, i.e.
#             "no clock", which makes the TTL always-expired rather than
#             arbitrary.)
#   Windows — 228 routes to kernel32!GetTickCount64, which RETURNS ms since
#             boot and does NOT touch &ts.
#   AGNOS   — no 228; `sys_uptime_ms()` is the peer.
#
# Unguarded, the two return-value targets returned `load64(&ts)` on a timespec
# nothing had written — an uninitialised stack read, so TTL expiry was
# undefined on both. Issue 2026-09-07-monotonic-secs-unguarded-on-macos-windows.
fn _monotonic_secs() {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_uptime_ms() / 1000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ts[16];
    #ifdef CYRIUS_TARGET_MACOS
    return syscall(228, 6, &ts) / 1000000000;
    #endif
    #ifdef CYRIUS_TARGET_WIN
    return syscall(228, 1, &ts) / 1000;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    syscall(228, 1, &ts);
    return load64(&ts);
    #endif
    #endif
    #endif
}

# CachedRegistry — in-memory cache with TTL + mutex.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `cached` matches the existing `cached_*` accessor
# convention; constructor stays `cached_registry_new`. Param `c`
# is unambiguous across src/.

#derive(accessors)
struct cached {
    registry;
    last_detect_secs;
    ttl_secs;
    mutex;
}

fn cached_registry_new(ttl_secs) {
    var c = alloc(32);
    cached_set_registry(c, 0);
    cached_set_last_detect_secs(c, 0);
    cached_set_ttl_secs(c, ttl_secs);
    cached_set_mutex(c, mutex_new());
    return c;
}

fn cached_get(c) {
    var mtx = cached_mutex(c);
    mutex_lock(mtx);

    var reg = cached_registry(c);
    var last = cached_last_detect_secs(c);
    var ttl = cached_ttl_secs(c);
    var now = _monotonic_secs();

    # Cache hit: registry exists and within TTL
    if (reg != 0 && now - last < ttl) {
        mutex_unlock(mtx);
        hwlog_debug("cache: hit (in-memory)");
        return reg;
    }

    mutex_unlock(mtx);

    # Cache miss: run detection (outside lock)
    hwlog_debug("cache: miss -> detecting");
    var new_reg = registry_detect();

    # Store result
    mutex_lock(mtx);
    cached_set_registry(c, new_reg);
    cached_set_last_detect_secs(c, _monotonic_secs());
    mutex_unlock(mtx);

    return new_reg;
}

fn cached_invalidate(c) {
    var mtx = cached_mutex(c);
    mutex_lock(mtx);
    cached_set_registry(c, 0);
    cached_set_last_detect_secs(c, 0);
    mutex_unlock(mtx);
    return 0;
}

fn cached_ttl(c) {
    return cached_ttl_secs(c);
}

fn cached_is_valid(c) {
    var reg = cached_registry(c);
    if (reg == 0) { return 0; }
    var last = cached_last_detect_secs(c);
    var ttl = cached_ttl_secs(c);
    var now = _monotonic_secs();
    return now - last < ttl;
}

# --- Disk-backed cache ---
# Reads/writes JSON to ~/.cache/ai-hwaccel/registry.json

fn _disk_cache_path() {
    var home = cmd_getenv("HOME");
    if (home == 0) { return "/tmp/ai-hwaccel-cache.json"; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, home);
    str_builder_add_cstr(sb, "/.cache/ai-hwaccel/registry.json");
    return str_data(str_builder_build(sb));
}

# DiskCachedRegistry — extends CachedRegistry with disk fallback.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `disk_cached` matches the `disk_cached_*` accessor
# convention; constructor stays `disk_cached_new`. Param `c` is
# shared with `cached` above — both files use it (same file here),
# and the field-count bound check on each struct keeps offsets
# within the registered ranges.

#derive(accessors)
struct disk_cached {
    registry;
    last_detect_secs;
    ttl_secs;
    mutex;
    cache_path;
}

fn disk_cached_new(ttl_secs) {
    var c = alloc(40);
    disk_cached_set_registry(c, 0);
    disk_cached_set_last_detect_secs(c, 0);
    disk_cached_set_ttl_secs(c, ttl_secs);
    disk_cached_set_mutex(c, mutex_new());
    disk_cached_set_cache_path(c, _disk_cache_path());
    return c;
}

fn disk_cached_get(c) {
    var mtx = disk_cached_mutex(c);
    mutex_lock(mtx);

    var reg = disk_cached_registry(c);
    var last = disk_cached_last_detect_secs(c);
    var ttl = disk_cached_ttl_secs(c);
    var now = _monotonic_secs();

    # Memory cache hit
    if (reg != 0 && now - last < ttl) {
        mutex_unlock(mtx);
        hwlog_debug("disk_cache: hit (in-memory)");
        return reg;
    }

    # Try disk cache
    var path = disk_cached_cache_path(c);
    var dbuf = alloc(65536);
    var dn = file_read_all(path, dbuf, 65536);
    if (dn > 0) {
        # Check file age via stat
        # For simplicity, trust memory TTL — disk is fallback for cold start
        store8(dbuf + dn, 0);
        # TODO: parse JSON registry from disk (requires from_json)
        # For now, fall through to fresh detection
    }

    mutex_unlock(mtx);

    # Cache miss: detect
    hwlog_debug("disk_cache: miss -> detecting");
    var new_reg = registry_detect();

    # Write to disk (best effort)
    var json = registry_to_json(new_reg);
    var jdata = str_data(json);
    var jlen = str_len(json);
    # Ensure directory exists
    var dir_sb = str_builder_new();
    var home = cmd_getenv("HOME");
    if (home != 0) {
        str_builder_add_cstr(dir_sb, home);
        str_builder_add_cstr(dir_sb, "/.cache/ai-hwaccel");
        var dir_s = str_builder_build(dir_sb);
        # 2.3.21: was `syscall(83, ..., 493)` — the x86_64 SYS_MKDIR number,
        # unguarded. ELF-aarch64 has no mkdir syscall at all (only mkdirat 34),
        # and cyrius does not remap 83, so on that target this returned -9
        # (EBADF) and the cache directory was never created — measured under
        # qemu-aarch64. Same class as the readlink defect in detect/platform.cyr:
        # take the number AND the arity from the stdlib peer that owns both.
        # AGNOS's sys_mkdir takes an explicit pathlen.
        #ifdef CYRIUS_TARGET_AGNOS
        sys_mkdir(str_data(dir_s), str_len(dir_s));
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        sys_mkdir(str_data(dir_s), 493);  # 0o755
        #endif
    }
    if (file_write_all(path, jdata, jlen) < 0) {
        hwlog_warn("disk_cache: write failed");
    }

    # Store in memory
    mutex_lock(mtx);
    disk_cached_set_registry(c, new_reg);
    disk_cached_set_last_detect_secs(c, _monotonic_secs());
    mutex_unlock(mtx);

    return new_reg;
}

fn disk_cached_invalidate(c) {
    var mtx = disk_cached_mutex(c);
    mutex_lock(mtx);
    disk_cached_set_registry(c, 0);
    disk_cached_set_last_detect_secs(c, 0);
    mutex_unlock(mtx);
    # Remove disk cache
    var path = disk_cached_cache_path(c);
    # 2.3.21: was `syscall(87, path)` — the x86_64 SYS_UNLINK number. On
    # ELF-aarch64 that is not unlink (only unlinkat 35 exists) and it returned
    # -14 (EFAULT), so the cache file was never removed. See the mkdir note.
    #ifdef CYRIUS_TARGET_AGNOS
    sys_unlink(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    sys_unlink(path);
    #endif
    return 0;
}
