# async_detect.cyr — threaded concurrent hardware detection
# Runs the backends that can start a vendor tool (nvidia-smi, hl-smi,
# neuron-ls, vulkaninfo, xpu-smi, system_profiler, cerebras_cli, gc-info) on
# threads of their own, and the rest (sysfs reads, OS calls, DXGI) on the
# calling thread, then merges the results into the registry. The tools
# themselves run one at a time (cmd_capture, src/detect/command.cyr, 2.5.5):
# lib/process.cyr's capture state is not thread-safe, so what overlaps is
# everything around them, not the tools.
#
# Usage:
#   var r = registry_detect_threaded();
#
# Requires: lib/thread.cyr, lib/fnptr.cyr

# A detector thread's argument: its own profiles and warnings vecs, merged
# into the registry after the join, and the backend it runs.
#derive(accessors)
struct targ {
    profs;
    warns;
    backend;
}

fn targ_new(backend) {
    var ta = alloc(sizeof(targ));
    targ_set_profs(ta, vec_new());
    targ_set_warns(ta, vec_new());
    targ_set_backend(ta, backend);
    return ta;
}

# Thread entry: one backend into the thread's own vecs, through the same
# dispatch every other entry point uses, with exec allowed.
fn _detect_thread_entry(ta) {
    registry_run_detectors(targ_profs(ta), targ_warns(ta), 1 << targ_backend(ta), 1);
    return 0;
}

# The backends of `builder_mask` that run on a thread of their own: every one
# that can start a vendor tool (backend_may_exec). Through 2.5.4 the list was
# written out three times, and Cerebras and Graphcore ran their tools on the
# calling thread, under a "no subprocess" comment.
fn _threaded_mask(builder_mask) {
    var m = 0;
    var b = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (backend_may_exec(b) == 1) { m = m | (1 << b); }
        b = b + 1;
    }
    return builder_mask & m;
}

# Merge thread results into main registry vecs
fn _merge_results(main_profs, main_warns, ta) {
    var tp = targ_profs(ta);
    var tw = targ_warns(ta);
    var np = vec_len(tp);
    var nw = vec_len(tw);
    var i = 0;
    while (i < np) {
        vec_push(main_profs, vec_get(tp, i));
        i = i + 1;
    }
    i = 0;
    while (i < nw) {
        vec_push(main_warns, vec_get(tw, i));
        i = i + 1;
    }
    return 0;
}

# Threaded detection: CLI backends run in parallel threads
fn registry_detect_threaded() {
    return registry_detect_threaded_with(builder_all());
}

fn registry_detect_threaded_with(builder_mask) {
    # A mask without an exec backend spawns nothing, as in registry_detect_with
    # (2.5.1), and with no tool to wait for there is nothing to run in parallel.
    if (builder_uses_exec(builder_mask) == 0) {
        return registry_detect_with_opts(builder_mask, 0);
    }
    hwlog_span_enter("detect_threaded");
    var r = hw_registry_new();
    var profs = reg_profiles(r);
    var warns = reg_warnings(r);

    # CPU profile (always)
    var sys_mem = detect_system_memory();
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    reg_add_profile(r, profile_cpu(sys_mem));

    # Load lib/io.cyr's environment cache on this thread before a detector
    # thread can reach which() (2.5.5). _env_load marks the cache loaded,
    # empty, before it reads /proc/self/environ (macOS: before it copies
    # envp), so a getenv on another thread in that window answers 0, PATH
    # reads as unset, and the tool as not found. A library consumer whose
    # first getenv was this call lost its vendor tools, nearly always once
    # the environment passed about 32 KB. Nothing on Windows or AGNOS, where
    # getenv keeps no cache. Issue 2026-10-29-cyrius-env-load-first-getenv-race.
    env_block(0);

    # Spawn a thread per threaded backend, in backend order
    var tmask = _threaded_mask(builder_mask);
    var threads = vec_new();
    var targs = vec_new();
    var bid = 0;
    while (bid < AIHW_BACKEND_COUNT) {
        if (builder_is_enabled(tmask, bid) == 1) {
            var ta = targ_new(bid);
            var t = thread_create(&_detect_thread_entry, ta);
            if (t == 0) {
                # Thread creation failed — run synchronously
                hwlog_warn_n("detect_threaded: thread_create failed, sync fallback for backend ", bid);
                _detect_thread_entry(ta);
            }
            vec_push(threads, t);
            vec_push(targs, ta);
        }
        bid = bid + 1;
    }

    # While they run, every other enabled backend on this thread (on Windows
    # that includes DXGI, and its wmic fallback).
    registry_run_detectors(profs, warns, builder_mask & (~tmask), 1);

    # Join all threads and merge results
    var nt = vec_len(threads);
    var i = 0;
    while (i < nt) {
        var th = vec_get(threads, i);
        if (th != 0) { thread_join(th); }
        _merge_results(profs, warns, vec_get(targs, i));
        i = i + 1;
    }

    # Post-passes: enrich profiles, then system I/O.
    registry_post_passes(r, 1);

    # Main thread, after every join+merge — see warnings_log_parse in
    # src/error.cyr for why the detector threads no longer log directly.
    var nwarn = vec_len(warns);
    warnings_log_parse(warns, 0);
    if (nwarn > 0) { hwlog_info_n("detect_threaded: warnings=", nwarn); }
    hwlog_info_n("detect_threaded: profiles=", vec_len(profs));
    hwlog_span_exit();

    return r;
}
