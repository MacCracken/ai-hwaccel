# model.cyr — model compatibility database
# Reads data/models.json at runtime for model profiles.

# ModelProfile — name + family + params_billions (x1000 fixed-point,
# e.g. 70000 = 70B) + default dtype string.
# 2.1.5: hand-rolled accessors replaced with #derive(accessors). Param
# `m` is shared with the `meta` struct in model_format.cyr — both go
# through the field-count bound check in CI rather than the cross-file
# specific-struct guard.

#derive(accessors)
struct model {
    name;
    family;
    params_b_x1000;
    dtype;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var MODEL_PROFILE_SIZE = sizeof(model);

# Total parameter count (not billions)
fn model_param_count(m) {
    return model_params_b_x1000(m) * 1000000;
}

# Estimate memory at given quantization (bytes)
fn model_memory_bytes(m, quant) {
    return reg_estimate_memory(model_param_count(m), quant);
}

# Check if model fits in available memory
fn model_can_run(m, quant, avail_bytes) {
    return model_memory_bytes(m, quant) <= avail_bytes;
}

# Load model catalogue from JSON.
#
# 2.3.22 — four defects fixed here at once
# (issue 2026-07-30-load-models-misparses-its-own-data-file):
#
#  1. WRONG PATH. It read a bare cwd-relative "data/models.json" while its
#     sibling loader (`cost.cyr:79`) already went through `data_file_path()`.
#     Invoked from anywhere but the repo root — a pip-installed wheel, say —
#     it read nothing and returned an empty vec.
#  2. THE WRAPPER. The scanner finds the first `{`, brace-matches to its close,
#     and resumes past it. That is correct for a TOP-LEVEL ARRAY of objects,
#     but `data/models.json` ships as `{"models":[ … ]}` — so the first `{`
#     was the WRAPPER, brace-matching ran to the last byte of the document,
#     and the whole file became one "object". `_parse_model_field_str` then
#     matched model one's `"name"`, pushed a single profile, and `pos` was
#     already at EOF. **26 models in the file, 1 returned, no error.** Fixed by
#     starting the scan just past the `[` that follows a `"models"` key when
#     one is present; a top-level array still starts at 0, so BOTH shapes now
#     parse and no shipped artifact had to change.
#  3. OFF-BY-ONE. `alloc(32768)` + `file_read_all(..., 32768)` + `store8(buf +
#     n, 0)` writes the NUL one byte past the allocation on an exactly-full
#     read. Now reads at most `MODELS_BUF - 1`.
#  4. SILENT TRUNCATION. `file_read_all` stops at the cap and reports the
#     count with no error, so a catalogue over the cap quietly loses models —
#     the same failure shape as (2): fewer models, no signal. Now warns.
#
# The function has no callers inside ai-hwaccel, which is why the suite stayed
# green through all four: it is shipped API exercised only downstream (hoosh
# hit (2) and vendors an unwrapped copy to work around it).
#
# 2.5.5 — the scan goes through cost.cyr's string-aware `_js_*` helpers,
# shared with load_cloud_instances (which had kept defect (2) until then).
# A key is matched only as a key, and a null or missing field stays unset
# instead of taking the next key's text. The file is read on every call:
# load it once and keep the vec.
var MODELS_BUF = 32768;

fn load_models() {
    var buf = alloc(MODELS_BUF);
    var n = file_read_all(data_file_path("data/models.json"), buf, MODELS_BUF - 1);
    if (n <= 0) { return vec_new(); }
    store8(buf + n, 0);
    if (n >= MODELS_BUF - 1) {
        hwlog_warn("load_models: models.json filled the read buffer — catalogue may be truncated");
    }
    return models_parse(buf, n);
}

# Model profiles in [buf, buf + n): a `{"models": [...]}` wrapper or a bare
# array of objects. Entries without a name are skipped.
fn models_parse(buf, n) {
    var models = vec_new();
    var pos = _js_array_start(buf, n, "models");
    while (pos < n) {
        var c = load8(buf + pos);
        if (c == 93) { break; }
        if (c != 123) {
            pos = pos + 1;
            continue;
        }
        var obj_end = _js_object_end(buf, n, pos);
        var od = buf + pos;
        var ol = obj_end - pos;
        var name = _js_str(od, ol, "name");
        if (name != 0) {
            var m = alloc(sizeof(model));
            model_set_name(m, name);
            model_set_family(m, _js_str(od, ol, "family"));
            # params_billions as x1000 (70.0 -> 70000)
            var pb = _js_fixed(od, ol, "params_billions", 3);
            if (pb < 0) { pb = 0; }
            model_set_params_b_x1000(m, pb);
            model_set_dtype(m, _js_str(od, ol, "default_dtype"));
            vec_push(models, m);
        }
        pos = obj_end;
    }
    return models;
}

# Find all models that fit in available memory at given quantization
fn compatible_models(models, quant, avail_bytes) {
    var result = vec_new();
    var nm = vec_len(models);
    var i = 0;
    while (i < nm) {
        var m = vec_get(models, i);
        i = i + 1;
        if (model_can_run(m, quant, avail_bytes) == 1) {
            vec_push(result, m);
        }
    }
    return result;
}

# Find a model by name (substring match)
fn find_model(models, name) {
    var nm = vec_len(models);
    var name_str = str_from(name);
    var i = 0;
    while (i < nm) {
        var m = vec_get(models, i);
        i = i + 1;
        var mn = model_name(m);
        if (mn != 0) {
            var mn_str = str_from(mn);
            if (str_contains(mn_str, name_str) == 1) { return m; }
        }
    }
    return 0;
}

# Find models by family (case-sensitive match)
fn models_by_family(models, family) {
    var result = vec_new();
    var nm = vec_len(models);
    var i = 0;
    while (i < nm) {
        var m = vec_get(models, i);
        i = i + 1;
        var mf = model_family(m);
        if (mf != 0) {
            if (streq(mf, family) == 1) {
                vec_push(result, m);
            }
        }
    }
    return result;
}

# Headroom percentage (x100 fixed-point, e.g., 2500 = 25.00%)
# Returns how much spare memory is available after loading the model
fn model_headroom_x100(m, quant, avail_bytes) {
    var needed = model_memory_bytes(m, quant);
    if (avail_bytes == 0) { return 0; }
    if (needed > avail_bytes) { return 0; }
    return (avail_bytes - needed) * 10000 / avail_bytes;
}

# Compatible models with headroom, using registry total accel memory
fn compatible_with_registry(models, r, quant) {
    var avail = reg_total_accel_memory(r);
    return compatible_models(models, quant, avail);
}
