# plan.cyr — sharding and workload planning logic
# Strategy selection: single device -> tensor parallel -> pipeline parallel

# Largest TPU slice a plan tensor-parallelises over: a full Ironwood pod
# (9216 chips; a v5p pod is 8960). Case 2 makes one shard per chip, and a
# registry rebuilt from JSON can claim any tpu_chips.
enum PlanLimits {
    PLAN_MAX_TPU_CHIPS = 9216;
}

# Estimate tokens/sec for a single device
# Returns x1000 fixed-point. `accel_type` is unused; the signature is public.
fn estimate_tps_x1000(accel_type, tput_x1000, model_params, quant) {
    if (model_params <= 0) { return 0; }
    # tok/s = (1B / model_params) * throughput multiplier * quant speedup,
    # multiplied out before the one division so a large model keeps its
    # precision (through 2.5.4, 405B on Metal lost 19% and > 1T gave 0).
    # 1e6 * tput * quant (<= 8000) stays in i64 for tput <= 1e9; only a
    # hand-built profile claims more.
    var t = tput_x1000;
    if (t > 1000000000) { t = 1000000000; }
    var quant_x1000 = quant_reduction_x1000(quant);
    return TOKENS_PER_SEC_BASE / 1000 * t * quant_x1000 / model_params;
}

# Layers of `per_layer` bytes that device `d` holds, at most `est_layers`.
fn _pp_layer_cap(d, per_layer, est_layers) {
    var c = profile_memory_bytes(d) / per_layer;
    if (c < 0) { return 0; }
    if (c > est_layers) { return est_layers; }
    return c;
}

# Pipeline parallel over `devs`: layers in proportion to each device's
# memory and never more than it holds, each shard reporting the memory of
# its own layers. Through 2.5.4 every stage got needed/n bytes and the last
# one the whole layer remainder, so a small card (an 8 GiB dGPU beside a
# shared-memory iGPU) was handed more than it has. 0 when whole layers
# cannot be placed.
fn _plan_pipeline(devs, needed, model_params, quant, max_bw) {
    var n = vec_len(devs);
    var est_layers = model_params / PARAMS_PER_LAYER_ESTIMATE;
    if (est_layers < 1) { est_layers = 1; }
    # No more layers than the largest model the CLI takes, so the split's
    # layers * capacity product stays in i64.
    var max_layers = MODEL_PARAMS_MAX / PARAMS_PER_LAYER_ESTIMATE;
    if (est_layers > max_layers) { est_layers = max_layers; }
    var per_layer = needed / est_layers;
    if (needed > per_layer * est_layers) { per_layer = per_layer + 1; }

    # Each device's capacity at caps[2i] and its floor share at caps[2i+1],
    # worked out once: recomputing both per loop cost 33 more divisions on
    # plan_70B_bf16_4gpu's 11 devices.
    var caps = alloc(n * 16);
    var sum_cap = 0;
    var i = 0;
    while (i < n) {
        var c0 = _pp_layer_cap(vec_get(devs, i), per_layer, est_layers);
        store64(caps + i * 16, c0);
        sum_cap = sum_cap + c0;
        i = i + 1;
    }
    if (sum_cap < est_layers) { return 0; }

    # Floor shares leave fewer than n layers over. Every device with room
    # has a share below its capacity unless the pool is exactly full, so one
    # extra layer each to the first devices with room places all of them.
    var assigned = 0;
    i = 0;
    while (i < n) {
        var sh = est_layers * load64(caps + i * 16) / sum_cap;
        store64(caps + i * 16 + 8, sh);
        assigned = assigned + sh;
        i = i + 1;
    }
    var rem = est_layers - assigned;

    var sp = sharding_plan_new(SHARD_PIPELINE, 0);
    var stages = 0;
    var lnext = 0;
    var slowest = 999999000;
    i = 0;
    while (i < n) {
        var d = vec_get(devs, i);
        var cap = load64(caps + i * 16);
        var lc = load64(caps + i * 16 + 8);
        i = i + 1;
        if (rem > 0 && lc < cap) {
            lc = lc + 1;
            rem = rem - 1;
        }
        if (lc == 0) { continue; }
        var ms = model_shard_new(stages, lnext, lnext + lc - 1,
          profile_accel_type(d), profile_device_id(d), lc * per_layer);
        plan_add_shard(sp, ms);
        lnext = lnext + lc;
        stages = stages + 1;
        var st = profile_throughput_x1000(d);
        if (st < slowest) { slowest = st; }
    }
    plan_set_strategy_count(sp, stages);
    plan_set_total_memory(sp, needed);

    # Steady state: each stage runs at the slowest stage's per-device rate.
    var ic_eff = PP_PCIE_ONLY_EFFICIENCY_X1000;
    if (max_bw > 0) { ic_eff = PP_HIGH_BW_EFFICIENCY_X1000; }
    var per_stage = estimate_tps_x1000(
      profile_accel_type(vec_get(devs, 0)), slowest, model_params, quant);
    plan_set_est_tps_x1000(sp, per_stage * ic_eff / 1000 * stages);
    return sp;
}

# Generate a sharding plan for a model
fn reg_plan_sharding(r, model_params, quant) {
    var needed = reg_estimate_memory(model_params, quant);
    var sio = reg_system_io(r);
    var profs = reg_profiles(r);
    hwlog_debug_n("plan: model_params=", model_params);

    # Find best available device
    var best = reg_best_available(r);
    if (best == 0) {
        hwlog_warn("plan: no available accelerator, defaulting to data-parallel");
        var sp0 = sharding_plan_new(SHARD_DATA, 0);
        plan_set_fits(sp0, 0);
        return sp0;
    }

    # Case 1: fits on single best device
    if (needed <= profile_memory_bytes(best)) {
        var sp = sharding_plan_new(SHARD_NONE, 1);
        var at = profile_accel_type(best);
        var did = profile_device_id(best);
        var ms = model_shard_new(0, 0, 0, at, did, needed);
        plan_add_shard(sp, ms);
        plan_set_total_memory(sp, needed);
        var tps = estimate_tps_x1000(
          at, profile_throughput_x1000(best), model_params, quant);
        plan_set_est_tps_x1000(sp, tps);
        return sp;
    }

    # Collect TPU and GPU/ASIC devices
    var tpu_devs = vec_new();
    var tpu_mem = 0;
    var tpu_chips = 0;
    var tpu_chip_mem = HW_I64_MAX;
    var tpu_min_tput = 999999000;
    var gpu_devs = vec_new();
    var gpu_mem = 0;

    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        var at = profile_accel_type(p);

        if (at == ACCEL_TPU) {
            # An unknown chip count is one chip; an absurd one is a pod.
            var chips = profile_tpu_chips(p);
            if (chips < 1) { chips = 1; }
            if (chips > PLAN_MAX_TPU_CHIPS) { chips = PLAN_MAX_TPU_CHIPS; }
            vec_push(tpu_devs, p);
            tpu_mem = tpu_mem + profile_memory_bytes(p);
            tpu_chips = tpu_chips + chips;
            var cm = profile_memory_bytes(p) / chips;
            if (cm < tpu_chip_mem) { tpu_chip_mem = cm; }
            var tt = profile_throughput_x1000(p);
            if (tt < tpu_min_tput) { tpu_min_tput = tt; }
        }
        if (accel_is_gpu(at) == 1 || accel_is_ai_asic(at) == 1 || at == ACCEL_TPU) {
            vec_push(gpu_devs, p);
            gpu_mem = gpu_mem + profile_memory_bytes(p);
        }
    }
    if (tpu_chips > PLAN_MAX_TPU_CHIPS) { tpu_chips = PLAN_MAX_TPU_CHIPS; }

    # Case 2: TPU tensor parallel. Every chip holds an equal slice, so the
    # slice has to fit the smallest chip, not only the pooled memory.
    if (vec_len(tpu_devs) > 0 && tpu_mem >= needed) {
        var per_chip = needed / tpu_chips;
        if (needed > per_chip * tpu_chips) { per_chip = per_chip + 1; }
        if (per_chip <= tpu_chip_mem) {
            var sp = sharding_plan_new(SHARD_TENSOR, tpu_chips);
            var ci = 0;
            while (ci < tpu_chips) {
                var ms = model_shard_new(ci, 0, 0, ACCEL_TPU, ci, per_chip);
                plan_add_shard(sp, ms);
                ci = ci + 1;
            }
            plan_set_total_memory(sp, needed);
            var per_tpu = estimate_tps_x1000(ACCEL_TPU, tpu_min_tput, model_params, quant);
            plan_set_est_tps_x1000(sp, per_tpu * TPU_TP_ICI_BONUS_X1000 / 1000 * tpu_chips);
            return sp;
        }
    }

    # Case 3: GPU/ASIC multi-device
    if (vec_len(gpu_devs) > 0 && gpu_mem >= needed) {
        var has_nvsw = sio_has_nvswitch(sio);
        var max_bw = sio_max_ic_bw_x1000(sio);
        var num_devs = vec_len(gpu_devs);

        # Decide tensor vs pipeline parallel
        var use_tp = 0;
        var tp_bw_ok = max_bw > TP_MIN_INTERCONNECT_BW * 1000;
        var tp_devs_ok = num_devs <= TP_MAX_DEVICES_WITHOUT_NVSWITCH;
        if (has_nvsw == 1) { use_tp = 1; }
        elif (tp_bw_ok == 1 && tp_devs_ok == 1) {
            use_tp = 1;
        }

        # Tensor parallel puts an equal slice on every device: it needs one
        # kind of device, and the slice has to fit the smallest of them
        # (2.5.4 put 56 GB of a 70B model on a 24 GiB iGPU beside two H100s).
        var per_dev = needed / num_devs;
        if (needed > per_dev * num_devs) { per_dev = per_dev + 1; }
        var t0 = profile_accel_type(vec_get(gpu_devs, 0));
        if (use_tp == 1) {
            var ti = 0;
            while (ti < num_devs) {
                var tq = vec_get(gpu_devs, ti);
                if (profile_accel_type(tq) != t0 || per_dev > profile_memory_bytes(tq)) { use_tp = 0; }
                ti = ti + 1;
            }
        }

        if (use_tp == 1) {
            var sp = sharding_plan_new(SHARD_TENSOR, num_devs);
            var di = 0;
            while (di < num_devs) {
                var gp = vec_get(gpu_devs, di);
                var gat = profile_accel_type(gp);
                var gdid = profile_device_id(gp);
                var ms = model_shard_new(di, 0, 0, gat, gdid, per_dev);
                plan_add_shard(sp, ms);
                di = di + 1;
            }
            plan_set_total_memory(sp, needed);

            # Throughput: slowest device's rate * num_devices * IC bonus
            var slowest = 999999000;
            di = 0;
            while (di < num_devs) {
                var gt = profile_throughput_x1000(vec_get(gpu_devs, di));
                if (gt < slowest) { slowest = gt; }
                di = di + 1;
            }
            var ic_bonus = 1000;
            if (has_nvsw == 1) { ic_bonus = NVSWITCH_TP_BONUS_X1000; }
            else {
                ic_bonus = 1000 + max_bw / TP_INTERCONNECT_BW_DIVISOR;
                var ic_max = 1000 + MAX_NON_NVSWITCH_TP_BONUS_X1000;
                if (ic_bonus > ic_max) { ic_bonus = ic_max; }
            }
            var per_gpu = estimate_tps_x1000(t0, slowest, model_params, quant);
            plan_set_est_tps_x1000(sp, per_gpu * ic_bonus / 1000 * num_devs);
            return sp;
        }

        var spp = _plan_pipeline(gpu_devs, needed, model_params, quant, max_bw);
        if (spp != 0) { return spp; }
    }

    # Case 4: CPU fallback. It fits only when the largest available CPU
    # profile holds the whole model; otherwise the plan says so (through
    # 2.5.4 it looked exactly like a plan that fits).
    var cpu_mem = 0;
    i = 0;
    while (i < n) {
        var cp = vec_get(profs, i);
        i = i + 1;
        if (profile_available(cp) != 1) { continue; }
        if (profile_accel_type(cp) != ACCEL_CPU) { continue; }
        if (profile_memory_bytes(cp) > cpu_mem) { cpu_mem = profile_memory_bytes(cp); }
    }
    var sp = sharding_plan_new(SHARD_NONE, 1);
    if (needed > cpu_mem) {
        hwlog_warn("plan: the model does not fit in accelerator or CPU memory");
        plan_set_fits(sp, 0);
    }
    var ms = model_shard_new(0, 0, 0, ACCEL_CPU, 0, needed);
    plan_add_shard(sp, ms);
    plan_set_total_memory(sp, needed);
    var cpu_tps = estimate_tps_x1000(ACCEL_CPU, 1000, model_params, quant);
    plan_set_est_tps_x1000(sp, cpu_tps);
    return sp;
}
