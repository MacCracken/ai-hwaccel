# command.cyr — safe subprocess execution for hardware detection
# Wraps lib/process.cyr with:
#   - PATH resolution (absolute path to a regular executable file)
#   - An empty environment on POSIX (lib/process.cyr), so LD_PRELOAD and the
#     like never reach the tool; a Windows tool inherits the caller's
#   - Output size limits (1 MiB stdout)
#   - A deadline on a silent tool (2.5.1; see below for what it costs)
#   - One capture at a time (2.5.5; see cmd_capture)
#   - CSV parsing helpers
#   - Device ID validation

var CMD_MAX_STDOUT = 1048576;
var CMD_DEFAULT_TIMEOUT_MS = 10000;
var CMD_MAX_DEVICE_ID = 1024;

# --- Tool deadline (2.5.1) ---
# Through 2.5.0 every tool ran without a time limit, so a hung `nvidia-smi`
# blocked detection for ever. What a hung tool costs now, per tool:
#   - POSIX: the read is cut after CMD_DEFAULT_TIMEOUT_MS of silence (a tool
#     still printing is never cut), then lib/process.cyr waits a second
#     CMD_DEFAULT_TIMEOUT_MS for it to exit before it sends TERM, gives it up
#     to 5 s of grace and sends KILL: about 2x the deadline, plus up to 5 s
#     for a tool that ignores TERM. The reap after KILL does not time out, so
#     a tool stuck in the kernel (D state, a wedged driver) is not bounded.
#   - Windows: the bound is wall-clock over the whole run, so a tool still
#     printing when it passes is killed too.
#   - AGNOS: none (process_agnos.cyr has no proc_set_timeout_ms).
# The capture then reports -2 and run_tool_status drops what it read. The
# bound is a process-wide value (proc_set_timeout_ms). The first capture in
# flight sets it and the last one out restores the caller's own value, under a
# mutex, so an embedding program's subprocesses keep their deadline outside
# detection. AGNOS has no deadline, so there the helpers do nothing.
var _cmd_dl_mtx = 0;
var _cmd_dl_inflight = 0;
var _cmd_dl_saved = 0;

# The deadline mutex, created on first use. Two threads may race to create
# it; the CAS keeps one, and the loser's 8-byte cell is never freed.
fn _cmd_dl_mutex() {
    var m = atomic_load(&_cmd_dl_mtx);
    if (m != 0) { return m; }
    var fresh = mutex_new();
    if (atomic_cas(&_cmd_dl_mtx, 0, fresh) == 1) { return fresh; }
    return atomic_load(&_cmd_dl_mtx);
}

fn _cmd_dl_enter() {
    #ifndef CYRIUS_TARGET_AGNOS
    var m = _cmd_dl_mutex();
    mutex_lock(m);
    if (_cmd_dl_inflight == 0) { _cmd_dl_saved = proc_set_timeout_ms(CMD_DEFAULT_TIMEOUT_MS); }
    _cmd_dl_inflight = _cmd_dl_inflight + 1;
    mutex_unlock(m);
    #endif
    return 0;
}

fn _cmd_dl_exit() {
    #ifndef CYRIUS_TARGET_AGNOS
    var m = _cmd_dl_mutex();
    mutex_lock(m);
    _cmd_dl_inflight = _cmd_dl_inflight - 1;
    if (_cmd_dl_inflight == 0) { proc_set_timeout_ms(_cmd_dl_saved); }
    mutex_unlock(m);
    #endif
    return 0;
}

# --- One capture at a time (2.5.5) ---
# lib/process.cyr (cyrius 6.7.18) keeps a capture's state where another
# thread's capture can reach it, and registry_detect_threaded runs detectors
# on several threads:
#   - the idle cut is a global (_proc_read_cut): a capture still reading when
#     another thread's tool was cut read the cut as its own, and a healthy
#     tool was reported as a timeout, its output dropped;
#   - the capture pipe is not close-on-exec (Windows: an inheritable pipe and
#     bInheritHandles), so a tool another thread started mid-capture held the
#     pipe open, and the capture saw EOF only when that tool exited: one hung
#     tool made every capture beside it a deadline kill;
#   - a deadline kill snapshots the tool's descendants into one shared buffer
#     (_proc_tree), and Windows keeps its job table unlocked.
# So captures take turns, under their own mutex (the deadline helpers take
# _cmd_dl_mtx inside it, never the other way round). Detector threads still
# overlap their parsing, sysfs reads and DXGI calls; their tools run one
# after another. Issue 2026-10-29-cyrius-process-capture-state-not-thread-safe.
var _cmd_cap_mtx = 0;

# The capture mutex, created on first use (the same CAS as _cmd_dl_mutex).
fn _cmd_cap_mutex() {
    var m = atomic_load(&_cmd_cap_mtx);
    if (m != 0) { return m; }
    var fresh = mutex_new();
    if (atomic_cas(&_cmd_cap_mtx, 0, fresh) == 1) { return fresh; }
    return atomic_load(&_cmd_cap_mtx);
}

# exec_capture_status under the tool deadline: bytes read (-1 if nothing
# ran), with the end in `st` (two i64 slots; slot 0 is -2 when the deadline
# killed the tool). Every subprocess detection starts goes through here, one
# at a time.
fn cmd_capture(args, buf, buflen, st) {
    var m = _cmd_cap_mutex();
    mutex_lock(m);
    _cmd_dl_enter();
    var n = exec_capture_status(args, buf, buflen, st);
    _cmd_dl_exit();
    mutex_unlock(m);
    return n;
}

# Read an environment variable. Returns a null-terminated string, or 0 if
# unset.
#
# 2.3.21: this was a local /proc/self/environ reader, added long ago to work
# around an io.cyr getenv bug (variable re-declaration in a loop). That bug is
# gone, and cyrius 6.6.0 made the stdlib `getenv` correct on every target
# ai-hwaccel ships to — it derives envp from the init stack on macOS
# (`_macho_argv_base`) and calls the PE `GetEnvironmentVariableA` reroute
# (0xF015) on Windows, alongside the existing /proc and AGNOS paths.
#
# The local reader had the same /proc assumption the stdlib just shed, so it
# returned 0 for EVERY name on macOS and Windows. That made AI_HWACCEL_DATA_DIR
# a silent no-op on both (issue 2026-09-07-cmd-getenv-proc-only), and also
# broke `which()`'s $PATH lookup and NVIDIA_VISIBLE_DEVICES there.
#
# Kept as a named wrapper rather than replacing the four call sites: the name
# documents intent at the call site, and a single seam is the right place to
# put any future per-target quirk. Windows has one (2.5.5, below).
fn cmd_getenv(name) {
    #ifdef CYRIUS_TARGET_WIN
    return _cmd_getenv_win(name);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return getenv(name);
    #endif
}

#ifdef CYRIUS_TARGET_WIN
# A variable's value as a heap cstr of its own size, or 0 when it is unset or
# empty. The stdlib getenv reads into a fixed 4096-byte buffer and answers 0
# for a longer value (lib/io.cyr, cyrius 6.7.18), so a Windows PATH of 4096
# or more characters, which the CUDA toolkit, Visual Studio, conda and oneAPI
# reach between them, made which() find no tool at all. GetEnvironmentVariableA
# (the 0xF015 reroute) returns the length it wrote, NUL excluded, or, when the
# buffer is short, the size it needs, NUL included. A value under 512 bytes
# is read on the stack and copied; a longer one is read again into a buffer of
# the size asked for, a third time if the variable grew in between. Issue
# 2026-10-29-cyrius-pe-getenv-4096-cap.
fn _cmd_getenv_win(name) {
    alloc_init();
    var small[512];
    var n = syscall(0xF015, name, &small, 512);
    if (n <= 0) { return 0; }
    if (n < 512) {
        var v = alloc(n + 1);
        if (v == 0) { return 0; }
        memcpy(v, &small, n);
        store8(v + n, 0);
        return v;
    }
    var cap = n;
    var tries = 0;
    while (tries < 2) {
        var buf = alloc(cap);
        if (buf == 0) { return 0; }
        var got = syscall(0xF015, name, buf, cap);
        if (got <= 0) { return 0; }
        if (got < cap) {
            store8(buf + got, 0);
            return buf;
        }
        cap = got;
        tries = tries + 1;
    }
    return 0;
}
#endif

# --- Data directory (2.5.5) ---
# The directory data_file_path reads data/*.json from, as the embedding
# program set it (data_dir_set), or 0.
var _cmd_data_dir = 0;

# Point data_file_path at directory `dir` (a cstr; 0 clears it). The CLI
# passes its --data-dir value here at startup. A library build never reads
# the process argv: through 2.5.4 data_file_path scanned it for --data-dir,
# and in a consumer binary that argv is the host's, whose own --data-dir flag
# (meaning something else there) silently moved load_cloud_instances and
# load_models to <its dir>/data/.
fn data_dir_set(dir) {
    _cmd_data_dir = dir;
    return 0;
}

# Scan argv for `--data-dir <path>`, returning the path cstr or 0.
#
# Self-contained (argv/argc/streq, no dependency on main.cyr's parser) so
# it works on PE: argv is populated from GetCommandLineW/CommandLineToArgvW
# (cyrius PE reroutes 0xF006/0xF010). Nothing calls it since 2.5.5: in a
# library build the argv it reads belongs to the host program. Removed in
# 2.6.0.
#deprecated("reads the host program's argv in a library build; the CLI hands --data-dir to data_dir_set")
fn cmd_data_dir_arg() {
    var n = argc();
    var i = 1;
    while (i < n) {
        var a = argv(i);
        if (a != 0) {
            if (streq(a, "--data-dir") == 1) {
                if (i + 1 < n) { return argv(i + 1); }
                return 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Resolve a data-file path. The binary reads data/cloud_pricing.json
# (--cost) and data/models.json at runtime; invoked from outside the project
# root (e.g. a pip-installed wheel) those are not cwd-relative. --version is
# compiled in (CYRIUS_PKG_VERSION) since 2.5.5 and reads no file.
# Resolution precedence:
#   1. data_dir_set(<path>): the CLI's `--data-dir <path>` flag, on EVERY
#      platform including Windows PE, because argv is readable there. This
#      is the portable channel a consumer of the CLI (the Python _runner now,
#      agnos later) should use. A library consumer calls data_dir_set itself.
#   2. AI_HWACCEL_DATA_DIR env var — honoured on **every target** as of
#      2.3.21. It was a silent no-op on macOS and Windows through 2.3.21
#      because `cmd_getenv` read /proc/self/environ, which neither has; it
#      now delegates to the stdlib `getenv` (on PE to _cmd_getenv_win, since
#      2.5.5). The flag still supersedes it where both are present.
#   3. cwd-relative <rel> — the original fallback.
# See roadmap 2.3.3 (env var) and 2.3.12 (the --data-dir flag for PE).
fn data_file_path(rel) {
    var dir = _cmd_data_dir;
    if (dir == 0) { dir = cmd_getenv("AI_HWACCEL_DATA_DIR"); }
    if (dir == 0) { return rel; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_putc(sb, '/');
    str_builder_add_cstr(sb, rel);
    return str_data(str_builder_build(sb));
}

# 1 if the PATH entry `d` (a Str) is an absolute directory: "/..." on POSIX
# (`win` 0); on Windows (`win` 1) drive-rooted ("C:\..." or "C:/...") or UNC
# ("\\server\share"). Pure.
fn _which_dir_is_absolute(d, win) {
    var n = str_len(d);
    if (n == 0) { return 0; }
    var c0 = load8(str_data(d));
    if (win == 0) { return c0 == '/'; }
    if (n >= 3) {
        var c1 = load8(str_data(d) + 1);
        var c2 = load8(str_data(d) + 2);
        var letter = 0;
        if (c0 >= 'A' && c0 <= 'Z') { letter = 1; }
        if (c0 >= 'a' && c0 <= 'z') { letter = 1; }
        if (letter == 1 && c1 == ':' && (c2 == 92 || c2 == '/')) { return 1; }
    }
    if (n >= 2) {
        if (c0 == 92 && load8(str_data(d) + 1) == 92) { return 1; }
    }
    return 0;
}

# 1 if cstr `name` ends in ".exe", in any case. Pure.
fn _which_has_exe(name) {
    var n = strlen(name);
    if (n < 4) { return 0; }
    var i = 0;
    var ext = ".exe";
    while (i < 4) {
        var c = load8(name + n - 4 + i);
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        if (c != load8(ext + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The paths which() tries for tool `name` (a cstr) in the PATH value
# `path_val` (a cstr), in order, as a vec of cstrs (2.5.3). Pure.
#   - POSIX (`win` 0): PATH splits on ':', and a candidate is "<dir>/<name>".
#   - Windows (`win` 1): PATH splits on ';', a directory may be wrapped in
#     double quotes (they are dropped), and a candidate is "<dir>\<name>.exe"
#     (".exe" is not added twice).
# An empty or relative entry is skipped on both. POSIX reads an empty entry as
# the current directory, so a tool found through one is whatever file of that
# name the current directory holds. A Windows entry with a `"` left in it is
# skipped too: a path with a quote cannot be quoted on a command line
# (cmd_win_program_token). Through 2.5.2 which() split on ':' on every target,
# so on Windows no tool was ever found, and an empty POSIX entry became
# "/<name>".
fn which_candidates(path_val, name, win) {
    var out = vec_new();
    var sep = ':';
    var slash = '/';
    if (win == 1) {
        sep = ';';
        slash = 92;
    }
    var dirs = str_split(str_from(path_val), sep);
    var nd = vec_len(dirs);
    var di = 0;
    while (di < nd) {
        var dir = vec_get(dirs, di);
        di = di + 1;
        if (win == 1) {
            dir = str_trim(dir);
            var dl = str_len(dir);
            if (dl >= 2) {
                if (load8(str_data(dir)) == 34 && load8(str_data(dir) + dl - 1) == 34) {
                    dir = str_new(str_data(dir) + 1, dl - 2);
                }
            }
            if (str_index_of(dir, 34) >= 0) { continue; }
        }
        if (_which_dir_is_absolute(dir, win) == 0) { continue; }
        var sb = str_builder_new();
        str_builder_add(sb, dir);
        var last = load8(str_data(dir) + str_len(dir) - 1);
        var ends = 0;
        if (last == '/') { ends = 1; }
        if (win == 1 && last == 92) { ends = 1; }
        if (ends == 0) { str_builder_putc(sb, slash); }
        str_builder_add_cstr(sb, name);
        if (win == 1 && _which_has_exe(name) == 0) { str_builder_add_cstr(sb, ".exe"); }
        vec_push(out, str_cstr(str_builder_build(sb)));
    }
    return out;
}

# 1 if candidate `path` (a cstr) is a tool which() may return. POSIX: a
# regular file this process may execute, asked of stat(2) and access(X_OK)
# (2.5.5). Through 2.5.4 it was any path that opened read-only, so a
# directory or a file without the x bit earlier on PATH shadowed the real
# tool (it then failed with status 127), a tool this process may run but not
# read (another user's 0711) was never found, and a FIFO blocked the open,
# outside any deadline. stat opens nothing. Windows and AGNOS keep the open test: CreateFileW does not open a
# directory, and AGNOS has no access(2).
fn _which_runnable(path) {
    #ifdef CYRIUS_TARGET_WIN
    return file_exists(path);
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    return file_exists(path);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    var st[256];
    if (sys_stat(path, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x8000) { return 0; }   # S_IFREG
    if (sys_access(path, 1) != 0) { return 0; }                        # X_OK
    return 1;
    #endif
    #endif
}

# The first of which_candidates(`path_val`, `name`) that _which_runnable
# accepts, as a heap cstr, or 0. `path_val` is a PATH value (a cstr, or 0).
fn which_in(path_val, name) {
    if (path_val == 0) { return 0; }
    var win = 0;
    #ifdef CYRIUS_TARGET_WIN
    win = 1;
    #endif
    var cands = which_candidates(path_val, name, win);
    var n = vec_len(cands);
    var i = 0;
    while (i < n) {
        var c = vec_get(cands, i);
        if (_which_runnable(c) == 1) { return c; }
        i = i + 1;
    }
    return 0;
}

# Resolve tool name to an absolute path through $PATH (which_in). Returns a
# heap cstr, or 0 if not found.
fn which(name) {
    return which_in(cmd_getenv("PATH"), name);
}

# `path` as the first token of a Windows command line (2.5.3): wrapped in
# double quotes when it holds a blank, as "C:\Program Files\..." does.
# lib/process_win.cyr joins a command's arguments with spaces and quotes
# none of them. CreateProcessW reads an unquoted first token one blank at a
# time and starts the first prefix that exists: "C:\Program.exe", then
# "C:\Program Files\NVIDIA.exe", and so on, so a file planted at one of them
# runs instead of the tool. Measured on cass: with "...\dir with space\" first
# on PATH and a dir.exe planted next to it, the unquoted line ran dir.exe. A
# path from which() has no `"` in it. Pure.
fn cmd_win_program_token(path) {
    var n = strlen(path);
    var blank = 0;
    var i = 0;
    while (i < n) {
        var c = load8(path + i);
        if (c == ' ' || c == 9) { blank = 1; }
        i = i + 1;
    }
    if (blank == 0) { return path; }
    var q = alloc(n + 3);
    store8(q, 34);
    memcpy(q + 1, path, n);
    store8(q + n + 1, 34);
    store8(q + n + 2, 0);
    return q;
}

# The warning for a tool that ran and ended with exit status `code` (slot 0 of
# exec_capture_status's status) and signal flag `sig` (slot 1), or 0 when the
# status is not a failure (0) or not known (below 0; the deadline's -2 has its
# own warning). The message says "exited with status N", or "killed by signal
# N" (code 128 + N with the flag set); a Windows exit code past 255, such as
# 0xC0000005 for a crash, is shown in hex (2.5.4). Pure.
fn tool_exit_warning(tool, code, sig) {
    if (code <= 0) { return 0; }
    var sb = str_builder_new();
    if (sig == 1 && code > 128) {
        str_builder_add_cstr(sb, "killed by signal ");
        str_builder_add_int(sb, code - 128);
    } elif (code > 255) {
        str_builder_add_cstr(sb, "exited with status 0x");
        var digits = "0123456789ABCDEF";
        var shift = 28;
        var started = 0;
        while (shift >= 0) {
            var nib = (code >> shift) & 15;
            if (nib != 0 || started == 1 || shift == 0) {
                str_builder_putc(sb, load8(digits + nib));
                started = 1;
            }
            shift = shift - 4;
        }
    } else {
        str_builder_add_cstr(sb, "exited with status ");
        str_builder_add_int(sb, code);
    }
    return warning_tool_failed(tool, code, str_data(str_builder_build(sb)));
}

# The exit-status warning for a run that returned `out` with status `st`
# (exec_capture_status's two slots), or 0. A run whose output filled the
# buffer ends with the tool killed by SIGPIPE, which this side caused when it
# stopped reading; the cut is reported already, so the status is not.
fn tool_run_warning(tool, out, st) {
    if (out != 0) {
        if (str_len(out) >= CMD_MAX_STDOUT - 1) { return 0; }
    }
    return tool_exit_warning(tool, load64(st), load64(st + 8));
}

# run_tool without the exit-status check (2.5.4): the tool's status goes to
# `st_out` (exec_capture_status's two i64 slots, or 0), and a caller that
# asks for it decides what a non-zero one means. The other warnings are the
# same: not found, failed to start, the deadline, and output cut short.
fn run_tool_status(tool, args, warnings, st_out) {
    if (st_out != 0) {
        store64(st_out, 0 - 1);
        store64(st_out + 8, 0);
    }
    var abs_path = which(tool);
    if (abs_path == 0) {
        if (warnings != 0) { vec_push(warnings, warning_tool_not_found(tool)); }
        return 0;
    }

    # Build exec args vec
    var exec_args = vec_new();
    #ifdef CYRIUS_TARGET_WIN
    vec_push(exec_args, cmd_win_program_token(abs_path));
    #endif
    #ifndef CYRIUS_TARGET_WIN
    vec_push(exec_args, abs_path);
    #endif
    var ai = 0;
    var nargs = vec_len(args);
    while (ai < nargs) {
        vec_push(exec_args, vec_get(args, ai));
        ai = ai + 1;
    }

    # Capture stdout into a 1 MiB scratch buffer: fl_alloc maps a block this
    # size on its own, and fl_free unmaps it. One byte short of the buffer, so
    # the result's NUL always fits: through 2.5.0 a full read wrote it one byte
    # past. Through 2.5.4 the result pointed into a fresh alloc(CMD_MAX_STDOUT),
    # so every tool run kept 1 MiB for good, and each cached_get re-detection
    # grew a long-lived consumer by about that much per tool (2.5.5).
    var buf = fl_alloc(CMD_MAX_STDOUT);
    if (buf == 0) {
        if (warnings != 0) { vec_push(warnings, warning_tool_failed(tool, 0 - 1, "exec failed")); }
        return 0;
    }
    var st[16];
    var n = cmd_capture(exec_args, buf, CMD_MAX_STDOUT - 1, &st);
    if (st_out != 0) {
        store64(st_out, load64(&st));
        store64(st_out + 8, load64(&st + 8));
    }

    if (load64(&st) == 0 - 2) {
        fl_free(buf);
        if (warnings != 0) { vec_push(warnings, warning_timeout(tool, CMD_DEFAULT_TIMEOUT_MS)); }
        return 0;
    }
    if (n < 0) {
        fl_free(buf);
        if (warnings != 0) { vec_push(warnings, warning_tool_failed(tool, 0 - 1, "exec failed")); }
        return 0;
    }
    if (n >= CMD_MAX_STDOUT - 1) {
        if (warnings != 0) {
            vec_push(warnings, warning_parse(tool, "output filled the 1 MiB buffer and was cut short"));
        }
    }

    # Keep what the tool printed, NUL-terminated, in a buffer of its size.
    # Copied before the scratch goes back: parsers keep str_sub views of it.
    var out = str_from_buf(buf, n);
    fl_free(buf);
    return out;
}

# Run a tool with the args in vec `args` (cstrs). Returns Str with stdout, or
# 0 on error.
# Pushes a warning to the warnings vec on failure: not found, failed to run,
# killed at the deadline (warning_timeout), output that filled the buffer and
# was cut short (a parse warning; the truncated output is still returned), or
# a non-zero exit status (tool_exit_warning, 2.5.4; the output is still
# returned, so a detector parses whatever the tool printed). Through 2.5.3 the
# exit status was ignored, and a tool that failed with its error on stderr,
# which Linux and macOS do not capture, left no trace.
fn run_tool(tool, args, warnings) {
    var st[16];
    var out = run_tool_status(tool, args, warnings, &st);
    var w = tool_run_warning(tool, out, &st);
    if (w != 0 && warnings != 0) { vec_push(warnings, w); }
    return out;
}

# Convenience: run_tool with 1 to 3 cstr args
fn run_tool1(tool, arg1, warnings) {
    var args = vec_new();
    vec_push(args, arg1);
    return run_tool(tool, args, warnings);
}

fn run_tool2(tool, arg1, arg2, warnings) {
    var args = vec_new();
    vec_push(args, arg1);
    vec_push(args, arg2);
    return run_tool(tool, args, warnings);
}

fn run_tool3(tool, arg1, arg2, arg3, warnings) {
    var args = vec_new();
    vec_push(args, arg1);
    vec_push(args, arg2);
    vec_push(args, arg3);
    return run_tool(tool, args, warnings);
}

# --- CSV parsing helpers ---

# Split a line by commas into a vec of trimmed Str values.
# Returns vec, or 0 if fewer than min_fields.
fn parse_csv_line(line, min_fields) {
    var parts = str_split(line, 44);
    if (vec_len(parts) < min_fields) { return 0; }
    # Trim each field
    var trimmed = vec_new();
    var ci = 0;
    var nparts = vec_len(parts);
    while (ci < nparts) {
        vec_push(trimmed, str_trim(vec_get(parts, ci)));
        ci = ci + 1;
    }
    return trimmed;
}

# A "0x…" hex field (a Str, or 0) as an int, or -1: vulkaninfo's
# "vendorID = 0x8086", sysfs's "0x8086", nvidia-smi's "0x268410DE". Leading
# blanks and anything after the digits are ignored. At most 15 digits. Pure.
# (vulkan.cyr's _vk_hex until 2.4.0; CUDA needs it too, and cuda.cyr comes
# first.)
fn parse_hex_field(s) {
    if (s == 0) { return 0 - 1; }
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    if (i + 2 >= n) { return 0 - 1; }
    if (load8(d + i) != 48) { return 0 - 1; }
    var x = load8(d + i + 1);
    if (x != 120 && x != 88) { return 0 - 1; }
    i = i + 2;
    var v = 0;
    var digits = 0;
    while (i < n) {
        var h = load8(d + i);
        var dv = 0 - 1;
        if (h >= 48 && h <= 57) { dv = h - 48; }
        elif (h >= 97 && h <= 102) { dv = h - 87; }
        elif (h >= 65 && h <= 70) { dv = h - 55; }
        if (dv < 0) { break; }
        if (digits >= 15) { return 0 - 1; }
        v = v * 16 + dv;
        digits = digits + 1;
        i = i + 1;
    }
    if (digits == 0) { return 0 - 1; }
    return v;
}

# A field (a Str, already trimmed) that is all decimal digits, 1 to 18 of
# them, as an int; -1 otherwise: 0, "", "[N/A]", "1.5", "-3", 19+ digits.
# str_to_int skips non-digits, so it reads "[N/A]" as 0 and "1.5" as 15. Pure.
fn parse_field_int(field) {
    if (field == 0) { return 0 - 1; }
    var d = str_data(field);
    var n = str_len(field);
    if (n == 0 || n > 18) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    return v;
}

# Validate device ID is in sane range (0-1024). The field must be all digits
# (parse_field_int, 2.5.5): through 2.5.4 str_to_int read nvidia-smi's
# "[GPU is lost]" as device 0.
fn validate_device_id(raw_str) {
    var id = parse_field_int(raw_str);
    if (id < 0) { return 0 - 1; }
    if (id > CMD_MAX_DEVICE_ID) { return 0 - 1; }
    return id;
}

# Validate memory in MB (0 to 16 TiB). The field must be all digits, as for
# validate_device_id: "[N/A]" was 0 MB, "1.5" 15 MB, and 20 digits wrapped.
fn validate_memory_mb(raw_str) {
    var mb = parse_field_int(raw_str);
    if (mb < 0) { return 0 - 1; }
    if (mb > 16 * 1024 * 1024) { return 0 - 1; }
    return mb;
}
