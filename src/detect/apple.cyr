# apple.cyr — Apple Metal GPU + Neural Engine detection
#
# macOS: sysctl, no subprocess. machdep.cpu.brand_string names the chip
#   ("Apple M5 Pro") and hw.memsize sizes its unified memory, the same two
#   facts `system_profiler SPHardwareDataType` prints as "Chip:" / "Memory:".
#   Because nothing is spawned, registry_detect_no_exec() finds Apple Silicon
#   too (through 2.3.26 it returned the CPU alone on a Mac). system_profiler
#   is kept as the fallback for when sysctl cannot name an Apple Silicon chip,
#   and runs only when exec is allowed.
# Linux (Asahi): /proc/device-tree/compatible check, no subprocess.

# 1 if `chip` (a Str) names generation `gen` (a cstr, "M1") as a word: not
# right after a letter or digit, and not followed by a digit, so "Apple M10"
# is not an M1. Pure.
fn _apple_names_gen(chip, gen) {
    var d = str_data(chip);
    var n = str_len(chip);
    var gl = strlen(gen);
    var i = 0;
    while (i + gl <= n) {
        if (memeq(d + i, gen, gl) == 1) {
            var before = 32;
            if (i > 0) { before = load8(d + i - 1); }
            var after = 32;
            if (i + gl < n) { after = load8(d + i + gl); }
            var word = 1;
            if (before >= 48 && before <= 57) { word = 0; }
            if (before >= 65 && before <= 90) { word = 0; }
            if (before >= 97 && before <= 122) { word = 0; }
            if (after >= 48 && after <= 57) { word = 0; }
            if (word == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Neural Engine memory estimate by chip generation: M1 4 GiB, M2 6 GiB, and
# 8 GiB for M3, M4 and every chip past the table (the M5 Pro on ecb). Through
# 2.5.4 a chip past the table got the M1's 4 GiB, below an M2. `chip` is a
# Str. Pure.
fn _apple_ane_bytes(chip) {
    if (_apple_names_gen(chip, "M1") == 1) { return 4 * BYTES_PER_GIB; }
    if (_apple_names_gen(chip, "M2") == 1) { return 6 * BYTES_PER_GIB; }
    return 8 * BYTES_PER_GIB;
}

# The Neural Engine estimate for an Asahi device tree, whose `compatible` (a
# Str, NUL-separated strings) names the SoC: the M1 family is t8103 and t600x,
# the M2 family t8112 and t602x (Asahi's device trees); a later SoC takes
# _apple_ane_bytes' newest figure. Through 2.5.4 every Asahi Mac got 4 GiB.
# Pure.
fn _asahi_ane_bytes(compat) {
    if (str_contains_cstr(compat, "apple,t8103") == 1) { return 4 * BYTES_PER_GIB; }
    if (str_contains_cstr(compat, "apple,t600") == 1) { return 4 * BYTES_PER_GIB; }
    if (str_contains_cstr(compat, "apple,t8112") == 1) { return 6 * BYTES_PER_GIB; }
    if (str_contains_cstr(compat, "apple,t602") == 1) { return 6 * BYTES_PER_GIB; }
    return 8 * BYTES_PER_GIB;
}

# 1 if `brand` (a cstr from machdep.cpu.brand_string) names an Apple-designed
# CPU: "Apple M1" … "Apple M5 Pro", or "Apple M1 (Virtual)" in a VM. An Intel
# Mac reports "Intel(R) Core(TM) …". Pure.
fn apple_is_silicon_brand(brand) {
    if (brand == 0) { return 0; }
    if (strlen(brand) < 7) { return 0; }
    if (memeq(brand, "Apple ", 6) == 1) { return 1; }
    return 0;
}

# Push the Metal GPU (named `chip`, a cstr, with `mem` bytes of unified
# memory) and the Neural Engine for an Apple Silicon chip. Pure.
fn apple_emit_silicon(profiles, chip, mem) {
    var gpu = profile_new(ACCEL_METAL, 0, mem);
    profile_set_device_name(gpu, chip);
    vec_push(profiles, gpu);
    var ane = profile_new(ACCEL_APPLE_NPU, 0, _apple_ane_bytes(str_from(chip)));
    profile_set_device_name(ane, "Apple Neural Engine");
    vec_push(profiles, ane);
    return 0;
}

#ifdef CYRIUS_TARGET_MACOS
# A string sysctl looked up by name (e.g. "machdep.cpu.brand_string"), as a
# fresh cstr, or 0. A name without a fixed MIB is resolved through name2oid
# ({0, 3}, with the name as `newp`) first, as lib/sys.cyr does for
# vm.page_free_count. Darwin fails a read whose `oldlenp` is too short rather
# than truncating it, so the buffer is generous; the returned length includes
# the NUL.
fn _mac_sysctl_string(name) {
    var qmib[8];
    store32(&qmib, 0);
    store32(&qmib + 4, 3);
    var oid[64];
    var oidlen = 64;
    var r = syscall(SYS_SYSCTL, &qmib, 2, &oid, &oidlen, name, strlen(name));
    if (r < 0) { return 0; }
    var cap = 256;
    var buf = alloc(cap + 1);
    var len = cap;
    var r2 = syscall(SYS_SYSCTL, &oid, oidlen / 4, buf, &len, 0, 0);
    if (r2 < 0) { return 0; }
    if (len <= 0) { return 0; }
    if (len > cap) { len = cap; }
    store8(buf + len, 0);
    return buf;
}
#endif

# Detect Apple Silicon's Metal GPU and Neural Engine. On macOS, sysctl names
# the chip and sizes its unified memory without a subprocess, so this runs in
# registry_detect_no_exec() too; the system_profiler fallback runs only when
# `allow_exec` is 1. On Linux the Asahi device-tree check needs no subprocess.
#
# 2.5.1: the system_profiler fallback runs on macOS only. Through 2.5.0 it ran
# on every target, so every Linux and Windows run listed `system_profiler` in
# its warnings, a tool that cannot exist there.
fn detect_apple_opts(profiles, warnings, allow_exec) {
    #ifdef CYRIUS_TARGET_MACOS
    var brand = _mac_sysctl_string("machdep.cpu.brand_string");
    if (apple_is_silicon_brand(brand) == 1) {
        var mem = mac_total_phys_bytes();
        if (mem > 0) {
            apple_emit_silicon(profiles, brand, mem);
            return 0;
        }
    }
    if (allow_exec == 1) {
        var hw = run_tool1("system_profiler", "SPHardwareDataType", warnings);
        if (hw != 0) {
            if (str_len(hw) > 0) {
                _parse_apple_macos(hw, profiles);
                return 0;
            }
        }
    }
    #endif

    # Linux Asahi fallback
    var compat = sysfs_read("/proc/device-tree/compatible");
    if (compat != 0) {
        if (str_contains_cstr(compat, "apple") == 1) {
            # Detect system memory for Metal GPU
            var sys_mem = detect_system_memory();
            if (sys_mem == 0) { sys_mem = 8 * BYTES_PER_GIB; }
            var p = profile_new(ACCEL_METAL, 0, sys_mem);
            profile_set_device_name(p, "Apple Silicon (Asahi Linux)");
            vec_push(profiles, p);

            # Apple Neural Engine (ANE)
            var ane = profile_new(ACCEL_APPLE_NPU, 0, _asahi_ane_bytes(compat));
            profile_set_device_name(ane, "Apple Neural Engine");
            vec_push(profiles, ane);
        }
    }
    return 0;
}

# detect_apple_opts with exec allowed (the system_profiler fallback may run).
fn detect_apple(profiles, warnings) {
    return detect_apple_opts(profiles, warnings, 1);
}

# Parse `system_profiler SPHardwareDataType` output: "Chip: Apple M4 Pro" and
# "Memory: 36 GB". Only the fallback uses it now; see detect_apple_opts.
#
# 2.5.1: emits nothing without a `Chip:` line. An Intel Mac prints
# "Processor Name:" instead, and through 2.5.0 it got a Metal GPU and a Neural
# Engine named "Apple Silicon" and sized by its RAM.
fn _parse_apple_macos(hw_output, profiles) {
    var lines = str_split(hw_output, 10);
    var nlines = vec_len(lines);
    var chip_name = 0;
    var have_chip = 0;
    var mem_bytes = 8 * BYTES_PER_GIB;

    var li = 0;
    while (li < nlines) {
        var line = vec_get(lines, li);
        li = li + 1;

        # Chip name: "Chip: Apple M4 Pro"
        if (str_contains_cstr(line, "Chip:") == 1) {
            var col = str_index_of(line, 58);
            if (col >= 0) {
                var cn = str_trim(str_sub(line, col + 1, str_len(line) - col - 1));
                if (str_len(cn) > 0) {
                    chip_name = str_cstr(cn);
                    have_chip = 1;
                }
            }
        }

        # Memory: "Memory: 36 GB"
        if (str_contains_cstr(line, "Memory:") == 1) {
            var mcol = str_index_of(line, 58);
            if (mcol >= 0) {
                var mval = str_trim(str_sub(line, mcol + 1, str_len(line) - mcol - 1));
                var val = parse_value_with_suffix(mval);
                if (val > 0) { mem_bytes = val * BYTES_PER_GIB; }
            }
        }
    }

    if (have_chip == 0) { return 0; }
    apple_emit_silicon(profiles, chip_name, mem_bytes);
    return 0;
}
