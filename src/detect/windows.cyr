# windows.cyr — Windows-side accelerator detection (DXGI adapter enumeration).
#
# `detect_windows` is compiled in only when the target is Win64 PE
# (CYRIUS_TARGET_WIN, predefined by `cyrius build --win`). On Linux / macOS
# it is preprocessed out, so registry_detect_with's call to it is also gated.
#
# Mechanism: GPUs come straight from DXGI — CreateDXGIFactory1 ->
# IDXGIFactory1::EnumAdapters1(i) until DXGI_ERROR_NOT_FOUND ->
# IDXGIAdapter1::GetDesc1 — one ACCEL_WIN_GPU profile per hardware adapter,
# named from DXGI_ADAPTER_DESC1.Description, sized from DedicatedVideoMemory.
# Software adapters (the Microsoft Basic Render Driver, which cass lists
# last) are skipped. No subprocess: the factory is the
# 0xF012 PE reroute (dxgi.dll) and its methods are COM vtable slots called
# through `callptr`. So it runs in every detection entry point, including
# registry_detect_no_exec(); only the wmic fallback depends on the caller
# allowing exec (see win_gpu_use_wmic_fallback).
#
# Through 2.3.24 detection spawned `wmic path win32_VideoController` to CREATE
# the profiles and DXGI only enriched their VRAM. Windows 11 24H2+ removes
# `wmic` by default, so on such a host (cass, build 26200) the Windows backend
# found no GPU at all, and detect_system_memory's `wmic computersystem` spawn
# failed too (16 GiB fallback). wmic is now only the fallback for a host where
# DXGI itself is unavailable (no factory, or the first EnumAdapters1 fails
# with anything other than DXGI_ERROR_NOT_FOUND). A host where DXGI works but
# lists only software adapters has no GPU, and wmic is not consulted.
# Total RAM comes from kernel32!GlobalMemoryStatusEx (platform.cyr).
#
# Integrated GPUs report their dedicated carve-out (the Intel UHD 600 on cass:
# 128 MiB). The wmic-era figure was the driver's AdapterRAM (1 GiB there),
# which DXGI does not expose. Neither figure is the shared system memory the
# adapter can also draw on (DXGI's SharedSystemMemory: half of RAM on cass).
#
# The descriptor readers (win_dxgi_desc_*, win_utf16_to_cstr) and the wmic
# parser (win_parse_videocontrollers) are ungated and pure, so the Linux-hosted
# fixture test (tests/tcyr/windows_test.tcyr) exercises them without a Windows
# host. Only the COM walk and the wmic spawn are CYRIUS_TARGET_WIN-only
# (callptr into Win64 COM and syscall 0xF012 exist only on PE).

# DXGI_ADAPTER_DESC1 (x64) field offsets, plus the adapter IDs and HRESULTs
# the enumeration needs. sizeof(DXGI_ADAPTER_DESC1) is 312; the buffer is 320.
enum WinDxgi {
    WIN_DXGI_DESC_NAME = 0;             # WCHAR Description[128]
    WIN_DXGI_DESC_NAME_WCHARS = 128;
    WIN_DXGI_DESC_VENDOR = 256;         # UINT VendorId
    WIN_DXGI_DESC_DEVICE = 260;         # UINT DeviceId
    WIN_DXGI_DESC_DEDICATED_VIDEO = 272;    # SIZE_T DedicatedVideoMemory
    WIN_DXGI_DESC_DEDICATED_SYSTEM = 280;   # SIZE_T DedicatedSystemMemory
    WIN_DXGI_DESC_FLAGS = 304;          # UINT Flags
    WIN_DXGI_DESC_BUF = 320;
    WIN_DXGI_FLAG_SOFTWARE = 0x2;       # DXGI_ADAPTER_FLAG_SOFTWARE
    WIN_DXGI_VENDOR_MICROSOFT = 0x1414;
    WIN_DXGI_DEVICE_BASIC_RENDER = 0x8C;    # Microsoft Basic Render Driver
    WIN_DXGI_ERROR_NOT_FOUND = 0x887A0002;  # EnumAdapters1 past the last adapter
    WIN_DXGI_MAX_ADAPTERS = 64;             # loop bound only; NOT_FOUND ends it
}

# Convert UTF-16LE text at `w` (at most `max_units` code units, stopping at a
# NUL) into a fresh NUL-terminated UTF-8 cstr. Bounded on the input side
# because DXGI's Description is a fixed WCHAR[128] with no guarantee of a
# terminator. Surrogate pairs decode to 4-byte UTF-8; a lone surrogate becomes
# U+FFFD rather than invalid UTF-8. Pure.
fn win_utf16_to_cstr(w, max_units) {
    # <= 3 bytes per code unit (a 2-unit surrogate pair encodes to 4) + NUL.
    var buf = alloc(max_units * 3 + 1);
    var i = 0;
    var o = 0;
    while (i < max_units) {
        var cu = load8(w + i * 2) | (load8(w + i * 2 + 1) << 8);
        if (cu == 0) { break; }
        i = i + 1;
        var cp = cu;
        if (cu >= 0xD800) {
            if (cu <= 0xDFFF) {
                cp = 0xFFFD;
                if (cu <= 0xDBFF) {
                    if (i < max_units) {
                        var cu2 = load8(w + i * 2) | (load8(w + i * 2 + 1) << 8);
                        if (cu2 >= 0xDC00) {
                            if (cu2 <= 0xDFFF) {
                                cp = 0x10000 + ((cu - 0xD800) << 10) + (cu2 - 0xDC00);
                                i = i + 1;
                            }
                        }
                    }
                }
            }
        }
        if (cp < 0x80) {
            store8(buf + o, cp);
            o = o + 1;
        } elif (cp < 0x800) {
            store8(buf + o, 0xC0 | (cp >> 6));
            store8(buf + o + 1, 0x80 | (cp & 0x3F));
            o = o + 2;
        } elif (cp < 0x10000) {
            store8(buf + o, 0xE0 | (cp >> 12));
            store8(buf + o + 1, 0x80 | ((cp >> 6) & 0x3F));
            store8(buf + o + 2, 0x80 | (cp & 0x3F));
            o = o + 3;
        } else {
            store8(buf + o, 0xF0 | (cp >> 18));
            store8(buf + o + 1, 0x80 | ((cp >> 12) & 0x3F));
            store8(buf + o + 2, 0x80 | ((cp >> 6) & 0x3F));
            store8(buf + o + 3, 0x80 | (cp & 0x3F));
            o = o + 4;
        }
    }
    store8(buf + o, 0);
    return buf;
}

# 1 if a DXGI_ADAPTER_DESC1 describes a software adapter: the
# DXGI_ADAPTER_FLAG_SOFTWARE bit, or the Microsoft Basic Render Driver's
# 1414:008C IDs, a second check that does not rely on the flag. Pure.
fn win_dxgi_desc_is_software(desc) {
    if ((load32(desc + WIN_DXGI_DESC_FLAGS) & WIN_DXGI_FLAG_SOFTWARE) != 0) { return 1; }
    if (load32(desc + WIN_DXGI_DESC_VENDOR) == WIN_DXGI_VENDOR_MICROSOFT) {
        if (load32(desc + WIN_DXGI_DESC_DEVICE) == WIN_DXGI_DEVICE_BASIC_RENDER) { return 1; }
    }
    return 0;
}

# Memory (bytes) to report for a DXGI adapter: DedicatedVideoMemory, or
# DedicatedSystemMemory when a driver books its boot-time carve-out there
# instead (both are memory the CPU does not share). 0 when neither is set.
# SharedSystemMemory is deliberately not used. Pure.
fn win_dxgi_desc_vram(desc) {
    var v = load64(desc + WIN_DXGI_DESC_DEDICATED_VIDEO);
    if (v > 0) { return v; }
    var s = load64(desc + WIN_DXGI_DESC_DEDICATED_SYSTEM);
    if (s > 0) { return s; }
    return 0;
}

# Push an ACCEL_WIN_GPU profile (device `dev_id`) for one DXGI_ADAPTER_DESC1
# unless it is a software adapter. Returns 1 if a profile was pushed, else 0.
# Pure — the COM walk that fills `desc` is win_dxgi_enum_adapters.
fn win_dxgi_desc_emit(desc, dev_id, profiles) {
    if (win_dxgi_desc_is_software(desc) == 1) { return 0; }
    var p = profile_new(ACCEL_WIN_GPU, dev_id, win_dxgi_desc_vram(desc));
    var name = win_utf16_to_cstr(desc + WIN_DXGI_DESC_NAME, WIN_DXGI_DESC_NAME_WCHARS);
    if (load8(name) != 0) { profile_set_device_name(p, name); }
    vec_push(profiles, p);
    return 1;
}

# 1 if detect_windows_opts should fall back to wmic: only when DXGI itself
# is unavailable (`dxgi_count` < 0) and the caller allows spawning a process.
# DXGI answering 0 hardware adapters is an answer, not a failure. Pure.
fn win_gpu_use_wmic_fallback(dxgi_count, allow_exec) {
    if (dxgi_count >= 0) { return 0; }
    if (allow_exec == 1) { return 1; }
    return 0;
}

# Push an ACCEL_WIN_GPU profile (name copied to a NUL-terminated cstr).
fn win_emit_gpu(profiles, dev_id, name, ram) {
    var mem = ram;
    if (mem < 0) { mem = 0; }
    var p = profile_new(ACCEL_WIN_GPU, dev_id, mem);
    var sb = str_builder_new();
    str_builder_add(sb, name);
    profile_set_device_name(p, str_data(str_builder_build(sb)));
    vec_push(profiles, p);
}

# Parse `wmic ... win32_VideoController get Name,AdapterRAM /format:list`
# output into ACCEL_WIN_GPU profiles. Each controller is a block of
# `Key=Value` lines (AdapterRAM= and Name=, any order) separated by blank
# lines. Returns the count of GPUs pushed. Pure — no I/O. Only reached when
# DXGI is unavailable (see detect_windows).
fn win_parse_videocontrollers(out, profiles) {
    var lines = str_split(out, 10);
    var nl = vec_len(lines);
    var i = 0;
    var dev_id = 0;
    var have_name = 0;
    var cur_name = 0;
    var cur_ram = 0;
    var count = 0;
    while (i < nl) {
        var line = str_trim(vec_get(lines, i));
        var ld = str_data(line);
        var ll = str_len(line);
        if (ll == 0) {
            if (have_name == 1) {
                win_emit_gpu(profiles, dev_id, cur_name, cur_ram);
                dev_id = dev_id + 1;
                count = count + 1;
                have_name = 0;
                cur_ram = 0;
            }
        } else {
            if (ll >= 11) {
                if (memeq(ld, "AdapterRAM=", 11) == 1) {
                    cur_ram = str_to_int(str_new(ld + 11, ll - 11));
                }
            }
            if (ll >= 5) {
                if (memeq(ld, "Name=", 5) == 1) {
                    cur_name = str_new(ld + 5, ll - 5);
                    have_name = 1;
                }
            }
        }
        i = i + 1;
    }
    if (have_name == 1) {
        win_emit_gpu(profiles, dev_id, cur_name, cur_ram);
        count = count + 1;
    }
    return count;
}

#ifdef CYRIUS_TARGET_WIN

# --- DXGI adapter enumeration (PE only) --------------------------------------
# Walks the COM vtable through `callptr` as cyrius's reference lib/dxgi.cyr
# does (GPU-verified on cass). Each method N lives at load64(vtbl + N*8):
# IUnknown::Release @2, IDXGIFactory1::EnumAdapters1 @12,
# IDXGIAdapter1::GetDesc1 @10. HRESULTs are 32-bit, so they are masked before
# being compared with a specific code.

# Fill `dst` (>=16 bytes) with IID_IDXGIFactory1
# {770aae78-f26f-4dba-a829-253c83d1b387} in COM's little-endian-Data1..3 +
# big-endian-Data4 byte order.
fn win_dxgi_iid_factory1(dst) {
    store8(dst + 0, 0x78);  store8(dst + 1, 0xAE);  store8(dst + 2, 0x0A);  store8(dst + 3, 0x77);
    store8(dst + 4, 0x6F);  store8(dst + 5, 0xF2);  store8(dst + 6, 0xBA);  store8(dst + 7, 0x4D);
    store8(dst + 8, 0xA8);  store8(dst + 9, 0x29);  store8(dst + 10, 0x25); store8(dst + 11, 0x3C);
    store8(dst + 12, 0x83); store8(dst + 13, 0xD1); store8(dst + 14, 0xB3); store8(dst + 15, 0x87);
}

# IUnknown::Release(obj) @ vtable slot 2. No-op on NULL. (callptr is an
# expression-only builtin, so its discarded refcount return is bound to a
# local.)
fn win_dxgi_release(obj) {
    if (obj == 0) { return 0; }
    var vtbl = load64(obj);
    var rc = callptr(load64(vtbl + 2 * 8), obj);
    return 0;
}

# Push one ACCEL_WIN_GPU profile per hardware DXGI adapter, in enumeration
# order, with device ids 0,1,2… over the adapters kept. Returns the number
# pushed (0 is a real answer: DXGI works and lists only software adapters),
# or -1 when DXGI is unavailable — no factory, or EnumAdapters1(0) fails with
# anything but DXGI_ERROR_NOT_FOUND. A later index that fails, or an adapter
# whose GetDesc1 fails, is reported in `warnings` (once per kind) and
# enumeration carries on, so one bad adapter never hides the ones after it.
fn win_dxgi_enum_adapters(profiles, warnings) {
    var iid[16];
    win_dxgi_iid_factory1(&iid);
    var pFactory = 0;
    var hr = syscall(0xF012, &iid, &pFactory);     # CreateDXGIFactory1
    if ((hr & 0xFFFFFFFF) != 0) { return 0 - 1; }
    if (pFactory == 0) { return 0 - 1; }
    var fvtbl = load64(pFactory);
    var count = 0;
    var idx = 0;
    var unavailable = 0;
    var warned_enum = 0;
    var warned_desc = 0;
    while (idx < WIN_DXGI_MAX_ADAPTERS) {
        var pAdapter = 0;
        # EnumAdapters1(this, index, &pAdapter) @ IDXGIFactory1 slot 12.
        var hr2 = callptr(load64(fvtbl + 12 * 8), pFactory, idx, &pAdapter);
        hr2 = hr2 & 0xFFFFFFFF;
        if (hr2 == WIN_DXGI_ERROR_NOT_FOUND) { break; }
        var failed = 0;
        if (hr2 != 0) { failed = 1; }
        if (pAdapter == 0) { failed = 1; }
        if (failed == 1) {
            if (idx == 0) {
                unavailable = 1;
                break;
            }
            hwlog_debug_n("windows: dxgi EnumAdapters1 failed at index ", idx);
            if (warnings != 0) {
                if (warned_enum == 0) {
                    vec_push(warnings, warning_tool_failed("dxgi", 0 - 1, "EnumAdapters1 failed for an adapter"));
                    warned_enum = 1;
                }
            }
            idx = idx + 1;
            continue;
        }
        var avtbl = load64(pAdapter);
        var desc[WIN_DXGI_DESC_BUF];                   # DXGI_ADAPTER_DESC1
        # GetDesc1(this, &desc) @ IDXGIAdapter1 slot 10.
        var hr3 = callptr(load64(avtbl + 10 * 8), pAdapter, &desc);
        if ((hr3 & 0xFFFFFFFF) == 0) {
            count = count + win_dxgi_desc_emit(&desc, count, profiles);
        } else {
            hwlog_debug_n("windows: dxgi GetDesc1 failed at index ", idx);
            if (warnings != 0) {
                if (warned_desc == 0) {
                    vec_push(warnings, warning_tool_failed("dxgi", 0 - 1, "GetDesc1 failed for an adapter"));
                    warned_desc = 1;
                }
            }
        }
        var r1 = win_dxgi_release(pAdapter);
        idx = idx + 1;
    }
    var r2 = win_dxgi_release(pFactory);
    if (unavailable == 1) { return 0 - 1; }
    return count;
}

# Detect Windows-visible GPUs. DXGI always runs (no subprocess). Only when
# DXGI is unavailable, and only if `allow_exec` is 1, does it fall back to
# wmic; CreateProcessW resolves `wmic` from System32\wbem on PATH, so the
# fallback needs no which()/PATH lookup of its own. DXGI being unavailable is
# always reported in `warnings`, so a missing GPU list is never silent.
fn detect_windows_opts(profiles, warnings, allow_exec) {
    var n = win_dxgi_enum_adapters(profiles, warnings);
    if (n >= 0) {
        hwlog_debug_n("windows: dxgi hardware adapters=", n);
        return n;
    }
    if (warnings != 0) {
        vec_push(warnings, warning_tool_failed("dxgi", 0 - 1, "DXGI adapter enumeration unavailable"));
    }
    if (win_gpu_use_wmic_fallback(n, allow_exec) == 0) {
        hwlog_debug("windows: dxgi unavailable, wmic fallback not allowed (no-exec)");
        return 0;
    }
    hwlog_debug("windows: dxgi unavailable, falling back to wmic");
    var args = vec_new();
    vec_push(args, "wmic");
    vec_push(args, "path");
    vec_push(args, "win32_VideoController");
    vec_push(args, "get");
    vec_push(args, "Name,AdapterRAM");
    vec_push(args, "/format:list");
    var buf = alloc(CMD_MAX_STDOUT);
    # One byte short of the buffer, so the NUL below always fits.
    var got = exec_capture(args, buf, CMD_MAX_STDOUT - 1);
    if (got <= 0) {
        if (warnings != 0) {
            vec_push(warnings, warning_tool_failed("wmic", 0 - 1, "win32_VideoController query failed"));
        }
        return 0;
    }
    store8(buf + got, 0);
    return win_parse_videocontrollers(str_new(buf, got), profiles);
}

# detect_windows_opts with exec allowed (the wmic fallback may run).
fn detect_windows(profiles, warnings) {
    return detect_windows_opts(profiles, warnings, 1);
}

#endif
