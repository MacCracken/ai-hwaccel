include "src/json_out.cyr"

include "src/cli.cyr"

# --- CLI arguments (src/cli.cyr) ---

# argv without the program name, set once at startup.
var _args = 0;

fn _argv_vec() {
    var v = vec_new();
    var n = argc();
    var i = 1;
    while (i < n) {
        vec_push(v, argv(i));
        i = i + 1;
    }
    return v;
}

fn _has_flag(flag) {
    return cli_has_flag(_args, flag);
}

fn _get_val(flag) {
    return cli_get_val(_args, flag);
}

# Print "ai-hwaccel: <reason> (see --help)" on stderr and exit 2: a usage
# error, which the Python wrapper raises as CommandError. Written straight
# to fd 2 so -q cannot hide why the run stopped.
fn _usage_die(reason) {
    syscall(1, 2, "ai-hwaccel: ", 12);
    syscall(1, 2, reason, strlen(reason));
    syscall(1, 2, " (see --help)\n", 14);
    syscall(60, 2);
    return 0;
}

# The --quant value as a Quantization, BF16 when absent. cli_check_args has
# refused an unknown name.
fn _quant_arg() {
    var qs = _get_val("--quant");
    if (qs == 0) { return QUANT_BF16; }
    return quant_from_str(qs);
}

# --- Output helpers ---

fn _print_str(s) {
    syscall(1, 1, str_data(s), str_len(s));
    return 0;
}

fn _print_line(s) {
    _print_str(s);
    syscall(1, 1, "\n", 1);
    return 0;
}

fn _println_cstr(s) {
    syscall(1, 1, s, strlen(s));
    syscall(1, 1, "\n", 1);
    return 0;
}

# --- Table output ---

# "<n> GiB" for `bytes`, as a cstr.
fn _gib_cstr(bytes) {
    var sb = str_builder_new();
    str_builder_add_int(sb, bytes / BYTES_PER_GIB);
    str_builder_add_cstr(sb, " GiB");
    return str_data(str_builder_build(sb));
}

fn _print_table(r) {
    _println_cstr("ID     Device                                Memory     Free       Family   Status");
    _println_cstr("-----  ------------------------------------  ---------  ---------  -------  ------");
    var profs = reg_profiles(r);
    var np = vec_len(profs);
    var i = 0;
    while (i < np) {
        var p = vec_get(profs, i);
        i = i + 1;
        var sb = str_builder_new();
        var id = str_builder_new();
        str_builder_add_int(id, profile_device_id(p));
        cli_table_cell(sb, str_data(str_builder_build(id)), 5);
        var dn = profile_device_name(p);
        if (dn == 0) { dn = accel_name(profile_accel_type(p)); }
        cli_table_cell(sb, dn, 36);
        cli_table_cell(sb, _gib_cstr(profile_memory_bytes(p)), 9);
        var mem_free = profile_mem_free(p);
        if (mem_free != PROFILE_NONE) { cli_table_cell(sb, _gib_cstr(mem_free), 9); }
        else { cli_table_cell(sb, "-", 9); }
        cli_table_cell(sb, family_name(profile_family(p)), 7);
        if (profile_available(p) == 1) { str_builder_add_cstr(sb, "OK"); }
        else { str_builder_add_cstr(sb, "N/A"); }
        _print_line(str_builder_build(sb));
    }
    return 0;
}

# --- Cost mode ---

# 1 when the --cost pricing catalogue has rows, else 0 after a warning that
# names the file. Without one every list is empty, which through 2.5.4 read
# as "nothing fits" (the JSON's "recommendations":[]) with nothing on stderr.
fn _catalogue_ok() {
    if (vec_len(_cloud_instances_cached()) > 0) { return 1; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "--cost: no cloud pricing rows in ");
    str_builder_add_cstr(sb, data_file_path("data/cloud_pricing.json"));
    str_builder_add_cstr(sb, " (pass --data-dir <dir> or set AI_HWACCEL_DATA_DIR)");
    hwlog_warn(str_data(str_builder_build(sb)));
    return 0;
}

fn _handle_cost(model_str) {
    var quant = _quant_arg();
    var params = model_params_from_str(model_str);
    var needed = quant_model_bytes_with_overhead(params, quant);
    # Rounded up, as the instance check is: "640 GiB" never sits next to a
    # list that leaves out the 640 GB instances.
    var needed_gib = needed / BYTES_PER_GIB;
    if (needed % BYTES_PER_GIB != 0) { needed_gib = needed_gib + 1; }
    var have = _catalogue_ok();

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Model: ");
    str_builder_add_cstr(sb, model_str);
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "Quantization: ");
    str_builder_add_cstr(sb, quant_name(quant));
    str_builder_add_cstr(sb, "\nMemory required: ");
    str_builder_add_int(sb, needed_gib);
    str_builder_add_cstr(sb, " GiB\n");

    # Recommend cloud instances
    var recs = recommend_instances(params, quant, 0 - 1);
    var nr = vec_len(recs);
    if (nr > 0) {
        str_builder_add_cstr(sb, "\nRecommended instances (cheapest first):\n");
        var ri = 0;
        var limit = nr;
        if (limit > 5) { limit = 5; }
        while (ri < limit) {
            var rec = vec_get(recs, ri);
            var inst = rec_instance(rec);
            str_builder_add_cstr(sb, "  ");
            str_builder_add_cstr(sb, cloud_inst_name(inst));
            str_builder_add_cstr(sb, " (");
            str_builder_add_cstr(sb, cloud_inst_provider(inst));
            str_builder_add_cstr(sb, ") — ");
            str_builder_add_int(sb, cloud_inst_gpu_count(inst));
            str_builder_add_cstr(sb, "x ");
            str_builder_add_cstr(sb, cloud_inst_gpu(inst));
            str_builder_add_cstr(sb, ", ");
            str_builder_add_int(sb, cloud_inst_total_mem_gb(inst));
            str_builder_add_cstr(sb, " GB, $");
            str_builder_add_int(sb, cloud_inst_price_x100(inst) / 100);
            str_builder_add_cstr(sb, ".");
            var cents = cloud_inst_price_x100(inst) - (cloud_inst_price_x100(inst) / 100) * 100;
            if (cents < 10) { str_builder_add_cstr(sb, "0"); }
            str_builder_add_int(sb, cents);
            str_builder_add_cstr(sb, "/hr\n");
            ri = ri + 1;
        }
    } elif (have == 1) {
        str_builder_add_cstr(sb, "\nNo instance in the pricing catalogue holds the model.\n");
    } else {
        str_builder_add_cstr(sb, "\nNo pricing catalogue was read (see the warning above).\n");
    }

    _print_str(str_builder_build(sb));
    return 0;
}

# --- Training memory mode (--train) ---

# The estimate is for a GPU target (TARGET_GPU): bf16 weights, or the 4- and
# 8-bit ones a QLoRA method picks. It works in whole millions of parameters;
# cli_check_args has refused a size under 1M, which would truncate to 0.
fn _handle_train(model_str) {
    var method = TRAIN_FULL;
    var ms = _get_val("--method");
    if (ms != 0) { method = training_method_from_str(ms); }
    var params_m = model_params_from_str(model_str) / PARAMS_PER_MILLION;
    var est = estimate_training_memory(params_m, method, TARGET_GPU);
    var sb = str_builder_new();
    training_to_json(sb, est);
    _print_line(str_builder_build(sb));
    return 0;
}

# --- Sharding plan mode (--plan) ---

fn _handle_plan(registry, model_str) {
    var plan = reg_plan_sharding(registry, model_params_from_str(model_str), _quant_arg());
    var sb = str_builder_new();
    plan_to_json(sb, plan);
    _print_line(str_builder_build(sb));
    return 0;
}

# --- Main ---

args_init();
alloc_init();
_args = _argv_vec();

# A command line that would run with a silent default is refused before any
# detection or tool run (cli_check_args).
var bad_args = cli_check_args(_args);
if (bad_args != 0) { _usage_die(bad_args); }

# Logging: stderr, WARN+ by default. env (read in hwlog_init) sets the
# floor; CLI flags below override it. The CLI owns its process, so each sets
# sakshi's level as well as ai-hwaccel's. stdout stays clean for JSON.
hwlog_init();
hwlog_apply_level_name(_get_val("--log-level"));
if (_has_flag("-v") == 1) { hwlog_set_process_level(SK_DEBUG); }
if (_has_flag("-vv") == 1) { hwlog_set_process_level(SK_TRACE); }
if (_has_flag("-q") == 1) { hwlog_set_process_level(0 - 1); }
# An unknown AI_HWACCEL_LOG warns at the level the flags settled on: under
# -q, nothing.
hwlog_report_env();

# --data-dir: where data_file_path reads data/ from (--cost). The library
# never reads argv itself (2.5.5), so the CLI hands it over.
data_dir_set(_get_val("--data-dir"));

if (_has_flag("--version") == 1) {
    _println_cstr(cli_version());
    syscall(60, 0);
}

if (_has_flag("--help") == 1) {
    var help = cli_help();
    syscall(1, 1, help, strlen(help));
    syscall(60, 0);
}

var cost_val = _get_val("--cost");
if (cost_val != 0) {
    if (_has_flag("--json") == 1) {
        _catalogue_ok();
        _print_line(cost_to_json(cost_val, _quant_arg()));
    } else {
        _handle_cost(cost_val);
    }
    syscall(60, 0);
}

var train_val = _get_val("--train");
if (train_val != 0) {
    _handle_train(train_val);
    syscall(60, 0);
}

# Detect hardware. --threaded (2.5.4) runs the detectors on threads of their
# own, registry_detect_threaded; the vendor tools themselves run one at a
# time (2.5.5). The registry holds the same profiles and warnings, in another
# order. CI's smoke jobs run both on macOS and Windows.
var registry = 0;
if (_has_flag("--threaded") == 1) {
    registry = registry_detect_threaded();
} else {
    registry = registry_detect();
}

var plan_val = _get_val("--plan");
if (plan_val != 0) {
    _handle_plan(registry, plan_val);
    syscall(60, 0);
}

if (_has_flag("--table") == 1) {
    _print_table(registry);
} elif (_has_flag("--summary") == 1) {
    _print_line(registry_to_summary_json(registry));
} else {
    # Default: full JSON
    _print_line(registry_to_json(registry));
}

syscall(60, 0);
