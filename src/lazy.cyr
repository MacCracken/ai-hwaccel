# lazy.cyr — lazy per-family detection
# Defers backend probing until a specific family is queried.
# Avoids spawning nvidia-smi when only TPU info is needed.
#
# Usage:
#   var lr = lazy_new();
#   var gpus = lazy_by_family(lr, FAMILY_GPU);  # probes GPU backends only
#   var all = lazy_into_registry(lr);           # probe everything

# LazyRegistry — deferred per-family detection.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `lazy` matches the existing `lazy_*` accessor
# convention; constructor stays `lazy_new`. The `probed` field is
# an i64 bitmask (bit 0 = CPU probed, 1 = GPU, 2 = NPU, 3 = TPU,
# 4 = AI_ASIC) — getter returns the raw mask, bit-manipulation
# helpers below use `lazy_probed` + `lazy_set_probed` plus a small
# inline mask compute. `backends` (2.3.26) is a builder mask of the
# backends already run, so a backend whose profiles span two families
# runs once however the families are queried. `warnings` (2.5.2) holds
# the probes' diagnostics, which lazy_into_registry hands to its
# registry; read it with lazy_warnings(lr) after lazy_by_family.

#derive(accessors)
struct lazy {
    profiles;
    probed;
    mutex;
    backends;
    warnings;
}

fn lazy_new() {
    var lr = alloc(40);
    var profs = vec_new();
    # Always include CPU
    var sys_mem = detect_system_memory();
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    vec_push(profs, profile_cpu(sys_mem));
    lazy_set_profiles(lr, profs);
    lazy_set_probed(lr, 1);  # bit 0 = CPU probed
    lazy_set_mutex(lr, mutex_new());
    lazy_set_backends(lr, 0);
    lazy_set_warnings(lr, vec_new());
    return lr;
}

# Check if family has been probed
fn _lazy_is_probed(lr, family) {
    var mask = lazy_probed(lr);
    var bit = 1;
    var i = 0;
    while (i < family) { bit = bit * 2; i = i + 1; }
    return (mask & bit) != 0;
}

# Mark family as probed
fn _lazy_mark_probed(lr, family) {
    var mask = lazy_probed(lr);
    var bit = 1;
    var i = 0;
    while (i < family) { bit = bit * 2; i = i + 1; }
    lazy_set_probed(lr, mask | bit);
    return 0;
}

# Build a builder mask of the backends that can emit profiles of `family`.
# A backend sits in the mask of every family its profiles belong to: Apple
# emits the Metal GPU and the Neural Engine, so it is in the GPU and NPU
# masks; _lazy_ensure's `backends` tracking still runs it only once. Through
# 2.3.25 Apple was in the GPU mask only, so a lazy NPU query found the Neural
# Engine only if GPUs had been queried first. Intel oneAPI and Windows (DXGI)
# emit GPU profiles; through 2.3.24 oneAPI sat in the AI_ASIC mask and
# Windows in none, so lazy_by_family(lr, FAMILY_GPU) never probed either.
fn _family_builder_mask(family) {
    var mask = 0;
    if (family == FAMILY_GPU) {
        mask = builder_with(mask, BACKEND_CUDA);
        mask = builder_with(mask, BACKEND_ROCM);
        mask = builder_with(mask, BACKEND_VULKAN);
        mask = builder_with(mask, BACKEND_APPLE);
        mask = builder_with(mask, BACKEND_INTEL_ONEAPI);
        mask = builder_with(mask, BACKEND_WINDOWS);
        return mask;
    }
    if (family == FAMILY_NPU) {
        mask = builder_with(mask, BACKEND_APPLE);
        mask = builder_with(mask, BACKEND_INTEL_NPU);
        mask = builder_with(mask, BACKEND_AMD_XDNA);
        mask = builder_with(mask, BACKEND_SAMSUNG_NPU);
        mask = builder_with(mask, BACKEND_MEDIATEK_APU);
        return mask;
    }
    if (family == FAMILY_TPU) {
        mask = builder_with(mask, BACKEND_TPU);
        return mask;
    }
    if (family == FAMILY_AI_ASIC) {
        mask = builder_with(mask, BACKEND_GAUDI);
        mask = builder_with(mask, BACKEND_NEURON);
        mask = builder_with(mask, BACKEND_QUALCOMM);
        mask = builder_with(mask, BACKEND_CEREBRAS);
        mask = builder_with(mask, BACKEND_GRAPHCORE);
        mask = builder_with(mask, BACKEND_GROQ);
        return mask;
    }
    return mask;
}

# Ensure a family is probed, run detection if not. Only backends that no
# earlier probe has run are detected: one that spans two families (Apple)
# delivered all its profiles the first time, so running it again would
# push them twice.
#
# 2.5.2: a probe runs the family's detectors and the profile passes on what
# they found (dedup, sysfs enrichment), nothing else; the system passes
# (interconnects, storage, environment) wait for lazy_into_registry. Through
# 2.5.1 each probe was a registry_detect_with(mask): it re-read system memory
# for a CPU profile it then dropped, ran every post-pass, `nvidia-smi nvlink
# -s` included, and threw its warnings away. The detectors run with exec
# allowed, as in registry_detect: the family's own backends are all that run,
# and Apple, the one backend in two families, must not run without its
# system_profiler fallback because the NPU family happened to be asked first.
fn _lazy_ensure(lr, family) {
    if (family == FAMILY_CPU) { return 0; }
    if (_lazy_is_probed(lr, family) == 1) { return 0; }
    _lazy_mark_probed(lr, family);

    var mask = _family_builder_mask(family) & (~lazy_backends(lr));
    if (mask == 0) { return 0; }
    lazy_set_backends(lr, lazy_backends(lr) | mask);
    hwlog_span_enter("lazy");
    hwlog_debug_n("lazy: builder_mask=", mask);
    var warns = lazy_warnings(lr);
    var w0 = vec_len(warns);
    var found = vec_new();
    registry_run_detectors(found, warns, mask, 1);
    registry_profile_passes(found);
    var main_profs = lazy_profiles(lr);
    var nf = vec_len(found);
    var i = 0;
    while (i < nf) {
        vec_push(main_profs, vec_get(found, i));
        i = i + 1;
    }
    # `found` is already deduplicated; this catches one device seen by two
    # families' probes, such as the Metal GPU from an NPU query (Apple) and
    # its MoltenVK view from a later GPU query (Vulkan).
    profiles_dedup(main_profs);
    warnings_log_parse(warns, w0);
    hwlog_info_n("lazy: profiles=", vec_len(main_profs));
    hwlog_span_exit();
    return 0;
}

# Query profiles by family (probes on first access)
fn lazy_by_family(lr, family) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, family);
    var profs = lazy_profiles(lr);
    var result = vec_new();
    var np = vec_len(profs);
    var i = 0;
    while (i < np) {
        var p = vec_get(profs, i);
        if (profile_available(p) == 1) {
            if (accel_family(profile_accel_type(p)) == family) {
                vec_push(result, p);
            }
        }
        i = i + 1;
    }
    mutex_unlock(mtx);
    return result;
}

# Get all profiles detected so far (no new detection)
fn lazy_probed_profiles(lr) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    var profs = lazy_profiles(lr);
    mutex_unlock(mtx);
    return profs;
}

# Probe all families and return a full registry: the probes' profiles and
# warnings, and the system passes, run here once (2.5.2). Through 2.5.1 the
# registry had no detector warnings, and every post-pass ran twice.
fn lazy_into_registry(lr) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, FAMILY_GPU);
    _lazy_ensure(lr, FAMILY_NPU);
    _lazy_ensure(lr, FAMILY_TPU);
    _lazy_ensure(lr, FAMILY_AI_ASIC);
    var r = hw_registry_new();
    var rp = reg_profiles(r);
    var profs = lazy_profiles(lr);
    var np = vec_len(profs);
    var i = 0;
    while (i < np) {
        vec_push(rp, vec_get(profs, i));
        i = i + 1;
    }
    var rw = reg_warnings(r);
    var warns = lazy_warnings(lr);
    var nw = vec_len(warns);
    i = 0;
    while (i < nw) {
        vec_push(rw, vec_get(warns, i));
        i = i + 1;
    }
    mutex_unlock(mtx);

    registry_system_passes(r, 1);
    return r;
}
