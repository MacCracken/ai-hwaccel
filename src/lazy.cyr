# lazy.cyr — lazy per-family detection
# Defers backend probing until a specific family is queried.
# Avoids spawning nvidia-smi when only TPU info is needed.
#
# Usage:
#   var lr = lazy_new();
#   var gpus = lazy_by_family(lr, FAMILY_GPU);  # probes GPU backends only
#   var all = lazy_into_registry(lr);           # probe everything

# LazyRegistry — deferred per-family detection.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `lazy` matches the existing `lazy_*` accessor
# convention; constructor stays `lazy_new`. The `probed` field is
# an i64 bitmask (bit 0 = CPU probed, 1 = GPU, 2 = NPU, 3 = TPU,
# 4 = AI_ASIC) — getter returns the raw mask, bit-manipulation
# helpers below use `lazy_probed` + `lazy_set_probed` plus a shift.
# `backends` (2.3.26) is a builder mask of the backends already run, so a
# backend whose profiles span two families runs once however the families
# are queried. `warns` (2.5.2; `warnings` through 2.5.4, renamed so that
# lazy_warnings can be the locked copy) holds the probes' diagnostics, which
# lazy_into_registry hands to its registry; read them with lazy_warnings(lr)
# after lazy_by_family.
#
# A lazy registry may be shared between threads: every call below takes its
# mutex, and what it hands out is a copy (2.5.5). The derived lazy_profiles
# and lazy_warns getters are the live vecs, which a probe grows and then
# compacts in place (profiles_dedup); they are for this file. Through 2.5.4
# lazy_probed_profiles and lazy_warnings returned those vecs, so a reader on
# another thread could index past a probe's vec_truncate, and vec_get's
# abort exited its thread. The profiles themselves are shared: a later probe
# may still rename one or set its memory (profiles_dedup), each an 8-byte
# store.

#derive(accessors)
struct lazy {
    profiles;
    probed;
    mutex;
    backends;
    warns;
}

fn lazy_new() {
    var lr = alloc(sizeof(lazy));
    var profs = vec_new();
    # Always include CPU
    var sys_mem = detect_system_memory();
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    vec_push(profs, profile_cpu(sys_mem));
    lazy_set_profiles(lr, profs);
    lazy_set_probed(lr, 1);  # bit 0 = CPU probed
    lazy_set_mutex(lr, mutex_new());
    lazy_set_backends(lr, 0);
    lazy_set_warns(lr, vec_new());
    return lr;
}

# Append every element of vec `src` to vec `dst`.
fn _lazy_append(dst, src) {
    var n = vec_len(src);
    var i = 0;
    while (i < n) {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return 0;
}

# Check if family has been probed. A family outside the mask's 64 bits never
# is: an unguarded `1 << 70` wraps the count on x86 and reads bit 6 (2.5.5;
# through 2.5.4 a doubling loop ran `family` times, and overflowed to 0).
fn _lazy_is_probed(lr, family) {
    if (family < 0 || family > 63) { return 0; }
    return (lazy_probed(lr) >> family) & 1;
}

# Mark family as probed (nothing for a family outside the mask).
fn _lazy_mark_probed(lr, family) {
    if (family < 0 || family > 63) { return 0; }
    lazy_set_probed(lr, lazy_probed(lr) | (1 << family));
    return 0;
}

# Build a builder mask of the backends that can emit profiles of `family`.
# A backend sits in the mask of every family its profiles belong to: Apple
# emits the Metal GPU and the Neural Engine, so it is in the GPU and NPU
# masks; _lazy_ensure's `backends` tracking still runs it only once. Through
# 2.3.25 Apple was in the GPU mask only, so a lazy NPU query found the Neural
# Engine only if GPUs had been queried first. Intel oneAPI and Windows (DXGI)
# emit GPU profiles; through 2.3.24 oneAPI sat in the AI_ASIC mask and
# Windows in none, so lazy_by_family(lr, FAMILY_GPU) never probed either.
fn _family_builder_mask(family) {
    var mask = 0;
    if (family == FAMILY_GPU) {
        mask = builder_with(mask, BACKEND_CUDA);
        mask = builder_with(mask, BACKEND_ROCM);
        mask = builder_with(mask, BACKEND_VULKAN);
        mask = builder_with(mask, BACKEND_APPLE);
        mask = builder_with(mask, BACKEND_INTEL_ONEAPI);
        mask = builder_with(mask, BACKEND_WINDOWS);
        return mask;
    }
    if (family == FAMILY_NPU) {
        mask = builder_with(mask, BACKEND_APPLE);
        mask = builder_with(mask, BACKEND_INTEL_NPU);
        mask = builder_with(mask, BACKEND_AMD_XDNA);
        mask = builder_with(mask, BACKEND_SAMSUNG_NPU);
        mask = builder_with(mask, BACKEND_MEDIATEK_APU);
        return mask;
    }
    if (family == FAMILY_TPU) {
        mask = builder_with(mask, BACKEND_TPU);
        return mask;
    }
    if (family == FAMILY_AI_ASIC) {
        mask = builder_with(mask, BACKEND_GAUDI);
        mask = builder_with(mask, BACKEND_NEURON);
        mask = builder_with(mask, BACKEND_QUALCOMM);
        mask = builder_with(mask, BACKEND_CEREBRAS);
        mask = builder_with(mask, BACKEND_GRAPHCORE);
        mask = builder_with(mask, BACKEND_GROQ);
        return mask;
    }
    return mask;
}

# Ensure a family is probed, run detection if not. Only backends that no
# earlier probe has run are detected: one that spans two families (Apple)
# delivered all its profiles the first time, so running it again would
# push them twice.
#
# 2.5.2: a probe runs the family's detectors and the profile passes on what
# they found (dedup, sysfs enrichment), nothing else; the system passes
# (interconnects, storage, environment) wait for lazy_into_registry. Through
# 2.5.1 each probe was a registry_detect_with(mask): it re-read system memory
# for a CPU profile it then dropped, ran every post-pass, `nvidia-smi nvlink
# -s` included, and threw its warnings away. The detectors run with exec
# allowed, as in registry_detect: the family's own backends are all that run,
# and Apple, the one backend in two families, must not run without its
# system_profiler fallback because the NPU family happened to be asked first.
fn _lazy_ensure(lr, family) {
    if (family == FAMILY_CPU) { return 0; }
    if (_lazy_is_probed(lr, family) == 1) { return 0; }
    _lazy_mark_probed(lr, family);

    var mask = _family_builder_mask(family) & (~lazy_backends(lr));
    if (mask == 0) { return 0; }
    lazy_set_backends(lr, lazy_backends(lr) | mask);
    hwlog_span_enter("lazy");
    hwlog_debug_n("lazy: builder_mask=", mask);
    var warns = lazy_warns(lr);
    var w0 = vec_len(warns);
    var found = vec_new();
    registry_run_detectors(found, warns, mask, 1);
    registry_profile_passes(found);
    var main_profs = lazy_profiles(lr);
    _lazy_append(main_profs, found);
    # `found` is already deduplicated; this catches one device seen by two
    # families' probes, such as the Metal GPU from an NPU query (Apple) and
    # its MoltenVK view from a later GPU query (Vulkan).
    profiles_dedup(main_profs);
    warnings_log_parse(warns, w0);
    hwlog_info_n("lazy: profiles=", vec_len(main_profs));
    hwlog_span_exit();
    return 0;
}

# The available profiles of `family` (probed on first access), into the
# caller's vec `out` (emptied first), which is returned: reg_by_family_into's
# filter, under the lock. A reused `out` keeps its buffer, so a long-lived
# consumer that queries per request stops allocating (2.5.5).
fn lazy_by_family_into(lr, family, out) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, family);
    _profiles_by_family_into(lazy_profiles(lr), family, out);
    mutex_unlock(mtx);
    return out;
}

# Query profiles by family (probes on first access), in a new vec. Allocates
# a vec per call; repeat queries use lazy_by_family_into.
fn lazy_by_family(lr, family) {
    return lazy_by_family_into(lr, family, vec_new());
}

# How many available profiles of `family` there are (probed on first
# access), allocating nothing once probed.
fn lazy_count_by_family(lr, family) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, family);
    var count = _profiles_count_by_family(lazy_profiles(lr), family);
    mutex_unlock(mtx);
    return count;
}

# All profiles detected so far (no new detection), copied under the lock
# into the caller's vec `out` (emptied first), which is returned. A reused
# `out` keeps its buffer, so a consumer that polls per request stops
# allocating once it has grown (2.5.5).
fn lazy_probed_profiles_into(lr, out) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    vec_truncate(out, 0);
    _lazy_append(out, lazy_profiles(lr));
    mutex_unlock(mtx);
    return out;
}

# All profiles detected so far, in a new vec. Allocates a vec per call;
# repeat calls use lazy_probed_profiles_into.
fn lazy_probed_profiles(lr) {
    return lazy_probed_profiles_into(lr, vec_new());
}

# The probes' warnings so far, copied under the lock into the caller's vec
# `out` (emptied first), which is returned, as lazy_probed_profiles_into.
fn lazy_warnings_into(lr, out) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    vec_truncate(out, 0);
    _lazy_append(out, lazy_warns(lr));
    mutex_unlock(mtx);
    return out;
}

# The probes' warnings so far, in a new vec. Allocates a vec per call;
# repeat calls use lazy_warnings_into.
fn lazy_warnings(lr) {
    return lazy_warnings_into(lr, vec_new());
}

# Probe all families and return a full registry: the probes' profiles and
# warnings, and the system passes, run here once (2.5.2). Through 2.5.1 the
# registry had no detector warnings, and every post-pass ran twice. The
# probes logged their own warnings; the system pass's (a hung `nvidia-smi
# nvlink -s`) are logged here, as registry_detect logs them (2.5.5), under
# the lock, as each probe's are: sakshi is single-threaded. The pass keeps
# the probes' warnings in place: each names a tool of its own backend, so
# warnings_dedup_missing drops none of them.
fn lazy_into_registry(lr) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, FAMILY_GPU);
    _lazy_ensure(lr, FAMILY_NPU);
    _lazy_ensure(lr, FAMILY_TPU);
    _lazy_ensure(lr, FAMILY_AI_ASIC);
    var r = hw_registry_new();
    _lazy_append(reg_profiles(r), lazy_profiles(lr));
    _lazy_append(reg_warnings(r), lazy_warns(lr));
    var w0 = vec_len(reg_warnings(r));
    mutex_unlock(mtx);

    registry_system_passes(r, 1);
    mutex_lock(mtx);
    warnings_log_parse(reg_warnings(r), w0);
    mutex_unlock(mtx);
    return r;
}
