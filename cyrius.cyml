[package]
name = "ai-hwaccel"
version = "${file:VERSION}"
description = "Hardware accelerator detection and planning for AI workloads"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.6"
repository = "https://github.com/MacCracken/ai-hwaccel"

[build]
entry = "src/main.cyr"
output = "ai-hwaccel"

# Concatenated by `cyrius distlib` into dist/ai-hwaccel.cyr, the bundle that
# library consumers pull via `[deps.ai-hwaccel]`. Every module except
# src/main.cyr (CLI only), in src/main.cyr's include order: the compiler is
# single-pass, so a module may only reference modules listed above it.
[lib]
modules = [
    "src/log.cyr",
    "src/units.cyr",
    "src/error.cyr",
    "src/types.cyr",
    "src/quantization.cyr",
    "src/profile.cyr",
    "src/system_io.cyr",
    "src/detect/platform.cyr",
    "src/detect/command.cyr",
    "src/detect/cuda.cyr",
    "src/detect/rocm.cyr",
    "src/detect/tpu.cyr",
    "src/detect/gaudi.cyr",
    "src/detect/neuron.cyr",
    "src/detect/vulkan.cyr",
    "src/detect/apple.cyr",
    "src/detect/intel.cyr",
    "src/detect/amd_xdna.cyr",
    "src/detect/edge.cyr",
    "src/detect/cloud_asic.cyr",
    "src/detect/bandwidth.cyr",
    "src/detect/pcie.cyr",
    "src/detect/numa.cyr",
    "src/detect/interconnect.cyr",
    "src/detect/disk.cyr",
    "src/detect/environment.cyr",
    "src/detect/windows.cyr",
    "src/registry.cyr",
    "src/plan.cyr",
    "src/training.cyr",
    "src/cost.cyr",
    "src/model.cyr",
    "src/model_format.cyr",
    "src/requirement.cyr",
    "src/async_detect.cyr",
    "src/cache.cyr",
    "src/lazy.cyr",
    "src/json_out.cyr",
]

[deps]
stdlib = ["string", "alloc", "vec", "str", "fmt", "io", "syscalls", "fs", "tagged", "process", "args", "fnptr", "thread", "assert", "bench", "freelist", "hashmap", "sakshi"]

# bayan's focused JSON sublib, used only by `profile_from_json_str`. Optional:
# `[features] default` enables it for this repo's own builds, and features
# resolve from the root manifest only, so downstream consumers skip it. A
# consumer that calls `profile_from_json_str` supplies bayan itself.
[deps.bayan]
optional = true
git = "https://github.com/MacCracken/bayan.git"
tag = "1.5.6"
modules = ["dist/bayan-json.cyr"]

[features]
default = ["bayan"]
