# units.cyr — named constants for unit conversions and hardware math
# All values are integer where possible. Float constants use x1000 fixed-point
# or actual integer equivalents.

# --- Byte / bit conversions ---

var BITS_PER_BYTE = 8;
var BYTES_PER_GIB = 1073741824;
var BYTES_PER_MIB = 1048576;
var BYTES_PER_GB = 1000000000;
var MHZ_PER_GHZ = 1000;

# --- DDR memory ---

var DDR_MULTIPLIER = 2;

# --- PCIe encoding overhead (x1000 fixed-point) ---
# Gen3+: 128/130 = 984 (0.984x)
# Gen1/2: 8/10 = 800 (0.800x)

var PCIE_GEN3_PLUS_ENCODING_X1000 = 984;
var PCIE_GEN1_GEN2_ENCODING_X1000 = 800;
var PCIE_GEN3_SPEED_GTS = 8;

# --- Model parameter conversions ---

var PARAMS_PER_MILLION = 1000000;
var FP16_BYTES_PER_PARAM = 2;
var FP32_BITS = 32;

# --- Memory estimation heuristics ---

# Activation / KV-cache overhead (raw + raw / 5 = 20% overhead)
var ACTIVATION_OVERHEAD_DIVISOR = 5;

# ~250M parameters per transformer layer
var PARAMS_PER_LAYER_ESTIMATE = 250000000;

# Baseline: 1B params -> 1 tok/s
var TOKENS_PER_SEC_BASE = 1000000000;

# --- Sharding planner thresholds (x1000 fixed-point) ---

# NVSwitch tensor-parallel bonus: 1.8x
var NVSWITCH_TP_BONUS_X1000 = 1800;

# Max non-NVSwitch tensor-parallel bonus: 0.8x
var MAX_NON_NVSWITCH_TP_BONUS_X1000 = 800;

# Interconnect BW divisor for bonus calculation: 200 GB/s
var TP_INTERCONNECT_BW_DIVISOR = 200;

# Pipeline-parallel efficiency with high-BW interconnect: 0.85x
var PP_HIGH_BW_EFFICIENCY_X1000 = 850;

# Pipeline-parallel efficiency with PCIe-only: 0.65x
var PP_PCIE_ONLY_EFFICIENCY_X1000 = 650;

# Minimum interconnect BW for tensor-parallel (GB/s)
var TP_MIN_INTERCONNECT_BW = 100;

# Max GPU count for tensor-parallel without NVSwitch
var TP_MAX_DEVICES_WITHOUT_NVSWITCH = 8;

# TPU ICI bonus: 2.0x
var TPU_TP_ICI_BONUS_X1000 = 2000;

# Gb/s to GB/s divisor
var GBITS_PER_GBYTE = 8;

# --- JSON schema version ---
# v4 (2.3.1): registry_to_json gained the "system_io" object
# (interconnects / storage / runtime environment).
# v5 (2.3.15): lossless profiles (accel_type_id + the accelerator fields).
# v6 (2.3.28): profiles carry "shared_memory_bytes", the part of their memory
# that is system RAM, and the summary totals count that RAM once.

var SCHEMA_VERSION = 6;

# --- Text helpers ---

# 1 when C strings `a` and `b` are equal ignoring ASCII case ("Int8" and
# "INT8"), 0 otherwise or when either is 0. No allocation. It lives here,
# the first module every unit includes, so the name parsers (quant, training
# method, log level) can use it whatever else a unit includes.
fn hw_streq_ci(a, b) {
    if (a == 0 || b == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca >= 65 && ca <= 90) { ca = ca + 32; }
        if (cb >= 65 && cb <= 90) { cb = cb + 32; }
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- error.cyr ---

# error.cyr — detection error codes
# Non-fatal errors collected as warnings during hardware detection.
# Each error carries a code + tool/path name + optional message.

enum DetectionError {
    HWA_ERR_NONE = 0;
    HWA_ERR_TOOL_NOT_FOUND = 1;
    HWA_ERR_TOOL_FAILED = 2;
    HWA_ERR_TIMEOUT = 3;
    HWA_ERR_PARSE = 4;
    HWA_ERR_SYSFS_READ = 5;
}

# Warning — one non-fatal detection error. 2.5.5: hand-rolled raw-offset
# accessors replaced with #derive(accessors), under the same names (the CI
# raw-offset guard covers it now). Fields:
#   code       — DetectionError enum value
#   tool       — tool name or sysfs path (cstr)
#   message    — detail (cstr), 0 if none
#   exit_code  — for HWA_ERR_TOOL_FAILED: the exit status (128 + N, with the
#                message "killed by signal N", for a signal), or -1 when the
#                tool could not be started or the failure has no status (DXGI,
#                wmic); -1 for every other code
#   timeout_ms — for HWA_ERR_TIMEOUT, the deadline in milliseconds

#derive(accessors)
struct warning {
    code;
    tool;
    message;
    exit_code;
    timeout_ms;
}

# sizeof, not a literal (2.5.5), as for every derived struct.
var WARNING_SIZE = sizeof(warning);

fn warning_new(code, tool) {
    var w = alloc(sizeof(warning));
    warning_set_code(w, code);
    warning_set_tool(w, tool);
    warning_set_message(w, 0);
    warning_set_exit_code(w, 0 - 1);
    warning_set_timeout_ms(w, 0);
    return w;
}

fn warning_tool_not_found(tool) {
    return warning_new(HWA_ERR_TOOL_NOT_FOUND, tool);
}

fn warning_tool_failed(tool, exit_code, stderr_msg) {
    var w = warning_new(HWA_ERR_TOOL_FAILED, tool);
    warning_set_exit_code(w, exit_code);
    warning_set_message(w, stderr_msg);
    return w;
}

fn warning_timeout(tool, timeout_ms) {
    var w = warning_new(HWA_ERR_TIMEOUT, tool);
    warning_set_timeout_ms(w, timeout_ms);
    return w;
}

fn warning_parse(backend, msg) {
    var w = warning_new(HWA_ERR_PARSE, backend);
    warning_set_message(w, msg);
    return w;
}

fn warning_sysfs(path, msg) {
    var w = warning_new(HWA_ERR_SYSFS_READ, path);
    warning_set_message(w, msg);
    return w;
}

# Drop each tool-not-found warning that repeats an earlier one for the same
# tool, keeping the order (2.5.1). `nvidia-smi` is run by the CUDA backend and
# again by the interconnect pass, and through 2.5.0 a host without it listed
# it twice. Other warnings stay as they are: two failures of one tool can say
# different things. Returns the new length.
fn warnings_dedup_missing(warns) {
    var n = vec_len(warns);
    var out = 0;
    var i = 0;
    while (i < n) {
        var w = vec_get(warns, i);
        var keep = 1;
        if (warning_code(w) == HWA_ERR_TOOL_NOT_FOUND) {
            var j = 0;
            while (j < out) {
                var e = vec_get(warns, j);
                if (warning_code(e) == HWA_ERR_TOOL_NOT_FOUND) {
                    if (streq(warning_tool(e), warning_tool(w)) == 1) { keep = 0; }
                }
                j = j + 1;
            }
        }
        if (keep == 1) {
            vec_set(warns, out, w);
            out = out + 1;
        }
        i = i + 1;
    }
    vec_truncate(warns, out);
    return out;
}

# The text of warning `w`, without a newline: "<tool>: <what happened>". A
# failed tool shows its message ("nvidia-smi: exited with status 9",
# "sh: killed by signal 9"), else its status, else "failed". Through 2.5.4
# warning_print took an exit code of -1 for a signal, which it has not meant
# since 2.5.4 encoded a signal as 128 + N, and printed a status twice
# ("exited with code 9 - exited with status 9"). Pure.
fn warning_describe(w) {
    var sb = str_builder_new();
    var code = warning_code(w);
    var tool = warning_tool(w);
    var msg = warning_message(w);
    if (code == HWA_ERR_SYSFS_READ) {
        str_builder_add_cstr(sb, "sysfs ");
    }
    if (tool != 0) { str_builder_add_cstr(sb, tool); }
    if (code == HWA_ERR_TOOL_NOT_FOUND) {
        str_builder_add_cstr(sb, ": tool not found on $PATH");
    } elif (code == HWA_ERR_TOOL_FAILED) {
        str_builder_add_cstr(sb, ": ");
        var ec = warning_exit_code(w);
        if (msg != 0) {
            str_builder_add_cstr(sb, msg);
        } elif (ec >= 0) {
            str_builder_add_cstr(sb, "exited with status ");
            str_builder_add_int(sb, ec);
        } else {
            str_builder_add_cstr(sb, "failed");
        }
    } elif (code == HWA_ERR_TIMEOUT) {
        str_builder_add_cstr(sb, ": timed out after ");
        str_builder_add_int(sb, warning_timeout_ms(w) / 1000);
        str_builder_add_cstr(sb, "s");
    } elif (code == HWA_ERR_PARSE) {
        str_builder_add_cstr(sb, ": parse error");
        if (msg != 0) {
            str_builder_add_cstr(sb, " - ");
            str_builder_add_cstr(sb, msg);
        }
    } elif (code == HWA_ERR_SYSFS_READ) {
        str_builder_add_cstr(sb, ": ");
        if (msg != 0) { str_builder_add_cstr(sb, msg); }
    }
    return str_builder_build(sb);
}

# Print a warning to stderr: warning_describe's text and a newline.
fn warning_print(w) {
    var sb = str_builder_new();
    str_builder_add(sb, warning_describe(w));
    str_builder_add_cstr(sb, "\n");
    var result = str_builder_build(sb);
    syscall(1, 2, str_data(result), str_len(result));
    return 0;
}

# --- types.cyr ---

# types.cyr — hardware accelerator type definitions
# Enums for device families, accelerator types, backends,
# and hardware-specific generations/versions.

# --- Accelerator family (broad category) ---

enum AcceleratorFamily {
    FAMILY_CPU = 0;
    FAMILY_GPU = 1;
    FAMILY_NPU = 2;
    FAMILY_TPU = 3;
    FAMILY_AI_ASIC = 4;
    # An accel_type this build does not know (2.5.5): a profile parsed from a
    # newer producer's JSON, or a corrupt one. Through 2.5.4 such a type was
    # family CPU, and counted with the CPU, while reg_has_accelerator counted
    # it as an accelerator. No detector emits it.
    FAMILY_UNKNOWN = 5;
}

fn family_name(f) {
    if (f == FAMILY_CPU) { return "CPU"; }
    if (f == FAMILY_GPU) { return "GPU"; }
    if (f == FAMILY_NPU) { return "NPU"; }
    if (f == FAMILY_TPU) { return "TPU"; }
    if (f == FAMILY_AI_ASIC) { return "AI ASIC"; }
    return "Unknown";
}

# --- Accelerator type (specific device kind) ---
# In Cyrius, device_id is stored on the profile, not on the type enum.

enum AcceleratorType {
    ACCEL_CPU = 0;
    ACCEL_CUDA = 1;
    ACCEL_ROCM = 2;
    ACCEL_METAL = 3;
    ACCEL_VULKAN = 4;
    ACCEL_INTEL_NPU = 5;
    ACCEL_AMD_XDNA = 6;
    ACCEL_APPLE_NPU = 7;
    ACCEL_TPU = 8;
    ACCEL_GAUDI = 9;
    ACCEL_NEURON = 10;
    ACCEL_QUALCOMM = 11;
    ACCEL_INTEL_ONEAPI = 12;
    ACCEL_CEREBRAS = 13;
    ACCEL_GRAPHCORE = 14;
    ACCEL_GROQ = 15;
    ACCEL_SAMSUNG_NPU = 16;
    ACCEL_MEDIATEK_APU = 17;
    ACCEL_WIN_GPU = 18;
    ACCEL_AGNOS_GPU = 19;
    # One past the last type, the bound of every loop over the types (2.5.5).
    # Ids are append-only: a new type goes above AGNOS_GPU and moves this.
    ACCEL_TYPE_COUNT = 20;
}

fn accel_name(a) {
    if (a == ACCEL_CPU) { return "CPU"; }
    if (a == ACCEL_CUDA) { return "CUDA GPU"; }
    if (a == ACCEL_ROCM) { return "ROCm GPU"; }
    if (a == ACCEL_METAL) { return "Metal GPU"; }
    if (a == ACCEL_VULKAN) { return "Vulkan GPU"; }
    if (a == ACCEL_INTEL_NPU) { return "Intel NPU"; }
    if (a == ACCEL_AMD_XDNA) { return "AMD XDNA NPU"; }
    if (a == ACCEL_APPLE_NPU) { return "Apple Neural Engine"; }
    if (a == ACCEL_TPU) { return "TPU"; }
    if (a == ACCEL_GAUDI) { return "Intel Gaudi"; }
    if (a == ACCEL_NEURON) { return "AWS Neuron"; }
    if (a == ACCEL_QUALCOMM) { return "Qualcomm Cloud AI 100"; }
    if (a == ACCEL_INTEL_ONEAPI) { return "Intel oneAPI GPU"; }
    if (a == ACCEL_CEREBRAS) { return "Cerebras WSE"; }
    if (a == ACCEL_GRAPHCORE) { return "Graphcore IPU"; }
    if (a == ACCEL_GROQ) { return "Groq LPU"; }
    if (a == ACCEL_SAMSUNG_NPU) { return "Samsung NPU"; }
    if (a == ACCEL_MEDIATEK_APU) { return "MediaTek APU"; }
    if (a == ACCEL_WIN_GPU) { return "Windows GPU"; }
    if (a == ACCEL_AGNOS_GPU) { return "AGNOS GPU"; }
    return "Unknown";
}

# --- Family classification ---

fn accel_is_gpu(a) {
    if (a == ACCEL_CUDA) { return 1; }
    if (a == ACCEL_ROCM) { return 1; }
    if (a == ACCEL_METAL) { return 1; }
    if (a == ACCEL_VULKAN) { return 1; }
    if (a == ACCEL_INTEL_ONEAPI) { return 1; }
    if (a == ACCEL_WIN_GPU) { return 1; }
    if (a == ACCEL_AGNOS_GPU) { return 1; }
    return 0;
}

fn accel_is_npu(a) {
    if (a == ACCEL_INTEL_NPU) { return 1; }
    if (a == ACCEL_APPLE_NPU) { return 1; }
    if (a == ACCEL_AMD_XDNA) { return 1; }
    if (a == ACCEL_SAMSUNG_NPU) { return 1; }
    if (a == ACCEL_MEDIATEK_APU) { return 1; }
    return 0;
}

fn accel_is_tpu(a) {
    return a == ACCEL_TPU;
}

fn accel_is_ai_asic(a) {
    if (a == ACCEL_GAUDI) { return 1; }
    if (a == ACCEL_NEURON) { return 1; }
    if (a == ACCEL_QUALCOMM) { return 1; }
    if (a == ACCEL_CEREBRAS) { return 1; }
    if (a == ACCEL_GRAPHCORE) { return 1; }
    if (a == ACCEL_GROQ) { return 1; }
    return 0;
}

# accel_uses_system_memory() as a bitmask (bit i set for type i), for
# profile_new, which runs once per detected device. foundation_test checks
# the two agree. CPU 0, METAL 3, INTEL_NPU 5, AMD_XDNA 6, APPLE_NPU 7,
# SAMSUNG_NPU 16, MEDIATEK_APU 17.
enum AccelSysMem {
    ACCEL_SYSMEM_MASK = 0x300E9;
}

# 1 if every byte a device of this type reports is system RAM, the same pool
# the CPU profile counts: the CPU itself, Apple Silicon's GPU and Neural
# Engine (unified memory), and the client NPUs, which have no memory of their
# own (Intel NPU, AMD XDNA, Samsung NPU, MediaTek APU). profile_new starts
# such a profile with all of its memory marked shared. Qualcomm Cloud AI 100
# is a card with its own LPDDR, so it is not listed.
fn accel_uses_system_memory(a) {
    if (a == ACCEL_CPU) { return 1; }
    if (a == ACCEL_METAL) { return 1; }
    if (a == ACCEL_APPLE_NPU) { return 1; }
    if (a == ACCEL_INTEL_NPU) { return 1; }
    if (a == ACCEL_AMD_XDNA) { return 1; }
    if (a == ACCEL_SAMSUNG_NPU) { return 1; }
    if (a == ACCEL_MEDIATEK_APU) { return 1; }
    return 0;
}

fn accel_family(a) {
    if (a == ACCEL_CPU) { return FAMILY_CPU; }
    if (accel_is_gpu(a) == 1) { return FAMILY_GPU; }
    if (accel_is_npu(a) == 1) { return FAMILY_NPU; }
    if (accel_is_tpu(a) == 1) { return FAMILY_TPU; }
    if (accel_is_ai_asic(a) == 1) { return FAMILY_AI_ASIC; }
    return FAMILY_UNKNOWN;
}

# --- TPU version ---

enum TpuVersion {
    TPU_V4 = 0;
    TPU_V5E = 1;
    TPU_V5P = 2;
}

fn tpu_version_name(v) {
    if (v == TPU_V4) { return "v4"; }
    if (v == TPU_V5E) { return "v5e"; }
    if (v == TPU_V5P) { return "v5p"; }
    return "unknown";
}

# HBM per chip in bytes
fn tpu_hbm_per_chip(v) {
    if (v == TPU_V4) { return 32 * 1024 * 1024 * 1024; }
    if (v == TPU_V5E) { return 16 * 1024 * 1024 * 1024; }
    if (v == TPU_V5P) { return 95 * 1024 * 1024 * 1024; }
    return 0;
}

# --- Gaudi generation ---

enum GaudiGeneration {
    GAUDI2 = 0;
    GAUDI3 = 1;
}

fn gaudi_gen_name(g) {
    if (g == GAUDI2) { return "Gaudi2"; }
    if (g == GAUDI3) { return "Gaudi3"; }
    return "unknown";
}

# HBM per device in bytes
fn gaudi_hbm_bytes(g) {
    if (g == GAUDI2) { return 96 * 1024 * 1024 * 1024; }
    if (g == GAUDI3) { return 128 * 1024 * 1024 * 1024; }
    return 0;
}

# --- Neuron chip type ---

enum NeuronChipType {
    NEURON_INFERENTIA = 0;
    NEURON_TRAINIUM = 1;
}

fn neuron_chip_name(c) {
    if (c == NEURON_INFERENTIA) { return "Inferentia"; }
    if (c == NEURON_TRAINIUM) { return "Trainium"; }
    return "unknown";
}

# HBM per NeuronCore in bytes: a device's HBM over its cores. inf2 and trn1
# are 32 GiB over 2 NeuronCore-v2. Through 2.5.4 Trainium was 32 GiB a core,
# so a trn1 device came out at 64 GiB (data/cloud_pricing.json: 32 GB).
fn neuron_hbm_per_core(c) {
    if (c == NEURON_INFERENTIA) { return 16 * 1024 * 1024 * 1024; }
    if (c == NEURON_TRAINIUM) { return 16 * 1024 * 1024 * 1024; }
    return 0;
}

# --- Throughput multiplier (inference, relative to CPU = 1.0x) ---
# Returns multiplier * 1000 (fixed-point) to avoid float
# e.g., CUDA = 20000 means 20.0x

fn accel_throughput_x1000(a) {
    if (a == ACCEL_CPU) { return 1000; }
    if (a == ACCEL_CUDA) { return 20000; }
    if (a == ACCEL_ROCM) { return 15000; }
    if (a == ACCEL_METAL) { return 12000; }
    if (a == ACCEL_VULKAN) { return 10000; }
    if (a == ACCEL_INTEL_NPU) { return 8000; }
    if (a == ACCEL_APPLE_NPU) { return 10000; }
    if (a == ACCEL_AMD_XDNA) { return 7000; }
    if (a == ACCEL_QUALCOMM) { return 14000; }
    if (a == ACCEL_INTEL_ONEAPI) { return 13000; }
    if (a == ACCEL_CEREBRAS) { return 50000; }
    if (a == ACCEL_GRAPHCORE) { return 16000; }
    if (a == ACCEL_GROQ) { return 30000; }
    if (a == ACCEL_SAMSUNG_NPU) { return 6000; }
    if (a == ACCEL_MEDIATEK_APU) { return 5000; }
    if (a == ACCEL_WIN_GPU) { return 10000; }
    # AGNOS GPU: the kernel drives the silicon directly — no ROCm, no
    # Vulkan, no vendor runtime. The compute surface it offers ring 3 is
    # the gpu_dispatch / gpu_shader_op band, narrower than a full vendor
    # stack, so this sits below Vulkan (10.0x) rather than beside ROCm.
    if (a == ACCEL_AGNOS_GPU) { return 8000; }
    # TPU and Gaudi/Neuron need version/gen — use profile-level functions
    return 1000;
}

# TPU throughput (version-aware), returns x1000
fn tpu_throughput_x1000(version) {
    if (version == TPU_V4) { return 25000; }
    if (version == TPU_V5E) { return 18000; }
    if (version == TPU_V5P) { return 35000; }
    return 1000;
}

# Gaudi throughput (generation-aware), returns x1000
fn gaudi_throughput_x1000(gen) {
    if (gen == GAUDI2) { return 22000; }
    if (gen == GAUDI3) { return 30000; }
    return 1000;
}

# Neuron throughput (chip+core-aware), returns x1000. Anything but Trainium,
# an unknown chip too, gets Inferentia's base.
fn neuron_throughput_x1000(chip_type, core_count) {
    var base = 15000;
    if (chip_type == NEURON_TRAINIUM) { base = 24000; }
    # base * (core_count / 2).max(1)
    var scale = core_count / 2;
    if (scale < 1) { scale = 1; }
    return base * scale;
}

# --- Training multiplier (relative to CPU = 1.0x), returns x1000 ---
# 0 = does not support training

fn accel_training_x1000(a) {
    if (a == ACCEL_CPU) { return 1000; }
    if (a == ACCEL_CUDA) { return 20000; }
    if (a == ACCEL_ROCM) { return 15000; }
    if (a == ACCEL_METAL) { return 10000; }
    if (a == ACCEL_VULKAN) { return 6000; }
    if (a == ACCEL_WIN_GPU) { return 6000; }
    # Training is possible — the f64 dispatch path is real — but there is
    # no autograd runtime on the device, so gradients come back through
    # the host. Below Vulkan deliberately.
    if (a == ACCEL_AGNOS_GPU) { return 5000; }
    # NPUs: inference only
    if (a == ACCEL_INTEL_NPU) { return 0; }
    if (a == ACCEL_APPLE_NPU) { return 0; }
    if (a == ACCEL_AMD_XDNA) { return 0; }
    if (a == ACCEL_SAMSUNG_NPU) { return 0; }
    if (a == ACCEL_MEDIATEK_APU) { return 0; }
    if (a == ACCEL_QUALCOMM) { return 0; }
    if (a == ACCEL_GROQ) { return 0; }
    if (a == ACCEL_INTEL_ONEAPI) { return 10000; }
    if (a == ACCEL_CEREBRAS) { return 60000; }
    if (a == ACCEL_GRAPHCORE) { return 18000; }
    # TPU/Gaudi/Neuron need version — use specific functions
    return 1000;
}

fn tpu_training_x1000(version) {
    if (version == TPU_V4) { return 28000; }
    if (version == TPU_V5E) { return 20000; }
    if (version == TPU_V5P) { return 40000; }
    return 1000;
}

fn gaudi_training_x1000(gen) {
    if (gen == GAUDI2) { return 25000; }
    if (gen == GAUDI3) { return 35000; }
    return 1000;
}

# Only Trainium trains. An unknown chip (PROFILE_NONE: a profile read from JSON
# without neuron_chip) is inference-only, as neuron_throughput_x1000 treats it;
# through 2.5.4 it trained at Trainium's rate.
fn neuron_training_x1000(chip_type, core_count) {
    if (chip_type != NEURON_TRAINIUM) { return 0; }
    var scale = core_count / 2;
    if (scale < 1) { scale = 1; }
    return 26000 * scale;
}

fn accel_supports_training(a) {
    return accel_training_x1000(a) > 0;
}

# --- Priority rank (higher = preferred for best_available) ---

fn accel_rank(a) {
    if (a == ACCEL_CEREBRAS) { return 85; }
    if (a == ACCEL_CUDA) { return 60; }
    if (a == ACCEL_ROCM) { return 50; }
    if (a == ACCEL_GRAPHCORE) { return 48; }
    if (a == ACCEL_INTEL_ONEAPI) { return 42; }
    if (a == ACCEL_METAL) { return 40; }
    if (a == ACCEL_QUALCOMM) { return 38; }
    if (a == ACCEL_VULKAN) { return 35; }
    if (a == ACCEL_WIN_GPU) { return 34; }
    if (a == ACCEL_AGNOS_GPU) { return 33; }
    if (a == ACCEL_APPLE_NPU) { return 30; }
    if (a == ACCEL_AMD_XDNA) { return 25; }
    if (a == ACCEL_INTEL_NPU) { return 20; }
    if (a == ACCEL_SAMSUNG_NPU) { return 18; }
    if (a == ACCEL_MEDIATEK_APU) { return 15; }
    if (a == ACCEL_CPU) { return 10; }
    # TPU/Gaudi/Neuron need version — use profile_rank; Groq is fixed at
    # groq_rank()
    return 10;
}

fn tpu_rank(version) {
    if (version == TPU_V5P) { return 80; }
    if (version == TPU_V4) { return 70; }
    if (version == TPU_V5E) { return 55; }
    return 50;
}

fn gaudi_rank(gen) {
    if (gen == GAUDI3) { return 75; }
    if (gen == GAUDI2) { return 65; }
    return 50;
}

fn neuron_rank(chip_type) {
    if (chip_type == NEURON_TRAINIUM) { return 58; }
    if (chip_type == NEURON_INFERENTIA) { return 45; }
    return 40;
}

fn groq_rank() { return 55; }

# --- Detection backends ---

enum AiHwBackend {
    BACKEND_CUDA = 0;
    BACKEND_ROCM = 1;
    BACKEND_APPLE = 2;
    BACKEND_VULKAN = 3;
    BACKEND_INTEL_NPU = 4;
    BACKEND_AMD_XDNA = 5;
    BACKEND_TPU = 6;
    BACKEND_GAUDI = 7;
    BACKEND_NEURON = 8;
    BACKEND_INTEL_ONEAPI = 9;
    BACKEND_QUALCOMM = 10;
    BACKEND_CEREBRAS = 11;
    BACKEND_GRAPHCORE = 12;
    BACKEND_GROQ = 13;
    BACKEND_SAMSUNG_NPU = 14;
    BACKEND_MEDIATEK_APU = 15;
    BACKEND_WINDOWS = 16;
    BACKEND_AGNOS_GPU = 17;
}
var AIHW_BACKEND_COUNT = 18;

fn backend_name(b) {
    if (b == BACKEND_CUDA) { return "cuda"; }
    if (b == BACKEND_ROCM) { return "rocm"; }
    if (b == BACKEND_APPLE) { return "apple"; }
    if (b == BACKEND_VULKAN) { return "vulkan"; }
    if (b == BACKEND_INTEL_NPU) { return "intel-npu"; }
    if (b == BACKEND_AMD_XDNA) { return "amd-xdna"; }
    if (b == BACKEND_TPU) { return "tpu"; }
    if (b == BACKEND_GAUDI) { return "gaudi"; }
    if (b == BACKEND_NEURON) { return "neuron"; }
    if (b == BACKEND_INTEL_ONEAPI) { return "intel-oneapi"; }
    if (b == BACKEND_QUALCOMM) { return "qualcomm"; }
    if (b == BACKEND_CEREBRAS) { return "cerebras"; }
    if (b == BACKEND_GRAPHCORE) { return "graphcore"; }
    if (b == BACKEND_GROQ) { return "groq"; }
    if (b == BACKEND_SAMSUNG_NPU) { return "samsung-npu"; }
    if (b == BACKEND_MEDIATEK_APU) { return "mediatek-apu"; }
    if (b == BACKEND_WINDOWS) { return "windows"; }
    if (b == BACKEND_AGNOS_GPU) { return "agnos-gpu"; }
    return "unknown";
}

# Classifies whether a backend's detector needs a subprocess (vendor CLI:
# nvidia-smi, xpu-smi) to find anything. Library
# consumers with a no-exec contract (e.g. mihi's probe surface) use
# builder_no_exec() / the registry_detect_no_exec() entry point, which honors
# this predicate.
# BACKEND_WINDOWS, BACKEND_APPLE, BACKEND_VULKAN, BACKEND_GAUDI,
# BACKEND_NEURON, BACKEND_CEREBRAS and BACKEND_GRAPHCORE are native: DXGI
# adapter enumeration, macOS sysctl (the Asahi device tree on Linux), Vulkan's
# sysfs scan of the DRM cards, the habanalabs accel nodes, /dev/neuron<N>,
# /dev/cerebras* and /dev/ipu<N> spawn nothing. Their wmic / system_profiler /
# vulkaninfo / hl-smi / neuron-ls / cerebras_cli / gc-info runs happen only
# when registry_detect_with_opts' allow_exec is 1. Through 2.3.28 Vulkan was
# exec, so registry_detect_no_exec() found no Intel or NVIDIA GPU on Linux;
# through 2.5.4 Gaudi, Neuron, Cerebras and Graphcore were, so it found none
# of them.
fn backend_uses_exec(b) {
    if (b == BACKEND_CUDA) { return 1; }
    if (b == BACKEND_INTEL_ONEAPI) { return 1; }
    return 0;
}

# 1 when a backend's detector can start a vendor tool once exec is allowed:
# the exec backends, and the native ones that run a tool before their
# fallback (vulkaninfo, system_profiler, hl-smi, neuron-ls, cerebras_cli,
# gc-info). registry_detect_threaded gives each of these a thread.
fn backend_may_exec(b) {
    if (backend_uses_exec(b) == 1) { return 1; }
    if (b == BACKEND_VULKAN || b == BACKEND_APPLE) { return 1; }
    if (b == BACKEND_GAUDI || b == BACKEND_NEURON) { return 1; }
    if (b == BACKEND_CEREBRAS || b == BACKEND_GRAPHCORE) { return 1; }
    return 0;
}

# --- quantization.cyr ---

# quantization.cyr — model weight quantization levels

enum QuantizationLevel {
    QUANT_NONE = 0;
    QUANT_FP16 = 1;
    QUANT_BF16 = 2;
    QUANT_INT8 = 3;
    QUANT_INT4 = 4;
}

# Bits per parameter for each quantization level
fn quant_bits(q) {
    if (q == QUANT_NONE) { return 32; }
    if (q == QUANT_FP16) { return 16; }
    if (q == QUANT_BF16) { return 16; }
    if (q == QUANT_INT8) { return 8; }
    if (q == QUANT_INT4) { return 4; }
    return 32;
}

# Memory reduction factor vs FP32, returns x1000 fixed-point
# e.g., INT8 = 4000 (4.0x reduction)
fn quant_reduction_x1000(q) {
    var bits = quant_bits(q);
    if (bits == 0) { return 1000; }
    return 32 * 1000 / bits;
}

# Display name
fn quant_name(q) {
    if (q == QUANT_NONE) { return "FP32"; }
    if (q == QUANT_FP16) { return "FP16"; }
    if (q == QUANT_BF16) { return "BF16"; }
    if (q == QUANT_INT8) { return "INT8"; }
    if (q == QUANT_INT4) { return "INT4"; }
    return "Unknown";
}

# Parse from bit width (32 -> QUANT_NONE, 16 -> QUANT_FP16, etc.)
# Returns -1 on invalid input
fn quant_from_bits(bits) {
    if (bits == 32) { return QUANT_NONE; }
    if (bits == 16) { return QUANT_FP16; }
    if (bits == 8) { return QUANT_INT8; }
    if (bits == 4) { return QUANT_INT4; }
    return 0 - 1;
}

# Parse from string name ("fp32", "fp16", "bf16", "int8", "int4") in any
# letter case ("Int8" and "BF16" too; through 2.5.4 only all-lower or
# all-upper matched, and the CLI silently planned BF16 for the rest).
# Returns -1 on no match.
fn quant_from_str(s) {
    if (hw_streq_ci(s, "fp32") == 1) { return QUANT_NONE; }
    if (hw_streq_ci(s, "fp16") == 1) { return QUANT_FP16; }
    if (hw_streq_ci(s, "bf16") == 1) { return QUANT_BF16; }
    if (hw_streq_ci(s, "int8") == 1) { return QUANT_INT8; }
    if (hw_streq_ci(s, "int4") == 1) { return QUANT_INT4; }
    return 0 - 1;
}

# Largest i64. Byte counts saturate here rather than wrap negative.
enum HwLimits {
    HW_I64_MAX = 0x7FFFFFFFFFFFFFFF;
}

# Largest model size model_params_from_str accepts: 1e15 parameters (1000T),
# which keeps params * 32 bits, and the 20% overhead on top, inside an i64.
var MODEL_PARAMS_MAX = 1000000000000000;

# Parameter count of a model-size string: digits, an optional fraction and an
# optional unit, with nothing after it. "70B", "1.5B", "0.5b", "350M", "125m",
# "1.2T", "800K"; no unit means billions ("70" is 70B). -1 for anything else:
# "", "B", "8x7B", "1.5.0B", "70GB", "-3B", or past MODEL_PARAMS_MAX. Fraction
# digits finer than one parameter are dropped. Pure; `s` is a C string.
fn model_params_from_str(s) {
    if (s == 0) { return 0 - 1; }
    var i = 0;
    var whole = 0;
    var nd = 0;
    var c = load8(s);
    while (c >= 48 && c <= 57) {
        if (whole > MODEL_PARAMS_MAX) { return 0 - 1; }
        whole = whole * 10 + c - 48;
        nd = nd + 1;
        i = i + 1;
        c = load8(s + i);
    }
    if (nd == 0) { return 0 - 1; }
    var frac = 0;
    var fd = 0;
    if (c == 46) {
        i = i + 1;
        c = load8(s + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        while (c >= 48 && c <= 57) {
            # Keep 12 fraction digits, enough for one parameter at "T".
            if (fd < 12) {
                frac = frac * 10 + c - 48;
                fd = fd + 1;
            }
            i = i + 1;
            c = load8(s + i);
        }
    }
    var unit = 1000000000;
    if (c == 66 || c == 98) { unit = 1000000000; i = i + 1; }
    elif (c == 77 || c == 109) { unit = 1000000; i = i + 1; }
    elif (c == 75 || c == 107) { unit = 1000; i = i + 1; }
    elif (c == 84 || c == 116) { unit = 1000000000000; i = i + 1; }
    elif (c != 0) { return 0 - 1; }
    if (load8(s + i) != 0) { return 0 - 1; }
    if (whole > MODEL_PARAMS_MAX / unit) { return 0 - 1; }
    var params = whole * unit;
    # frac / 10^fd of one unit, without overflowing: unit and 10^fd are both
    # powers of ten, so divide the larger by the smaller first.
    var scale = 1;
    var k = 0;
    while (k < fd) { scale = scale * 10; k = k + 1; }
    if (unit >= scale) { params = params + frac * (unit / scale); }
    else { params = params + frac / (scale / unit); }
    if (params > MODEL_PARAMS_MAX) { return 0 - 1; }
    return params;
}

# Calculate model memory in bytes given param count and quant level.
# Divides before it multiplies, so no count wraps the i64 (through 2.5.4,
# 3e17 params at FP32 came out negative and "fitted" everywhere); a count
# whose bytes pass the i64 saturates at HW_I64_MAX. 0 for a count <= 0.
fn quant_model_bytes(param_count, quant) {
    if (param_count <= 0) { return 0; }
    var bits = quant_bits(quant);
    var whole = param_count / BITS_PER_BYTE;
    if (whole > (HW_I64_MAX - bits) / bits) { return HW_I64_MAX; }
    return whole * bits + (param_count % BITS_PER_BYTE) * bits / BITS_PER_BYTE;
}

# Calculate model memory with activation overhead (20%), saturating like
# quant_model_bytes.
fn quant_model_bytes_with_overhead(param_count, quant) {
    var raw = quant_model_bytes(param_count, quant);
    var extra = raw / ACTIVATION_OVERHEAD_DIVISOR;
    if (raw > HW_I64_MAX - extra) { return HW_I64_MAX; }
    return raw + extra;
}

# --- profile.cyr ---

# profile.cyr — accelerator capability profile.
# 23-field heap-allocated descriptor with typed accessors. The biggest
# single struct in the codebase (184 bytes / 23 fields), most-called
# accessor surface (every detect/* backend, registry helpers, json_out,
# sharding, training, cost).
#
# 2.1.6: 20 hand-rolled getters + 17 setters replaced with
# #derive(accessors). Param `p` is canonical across the codebase but
# only as a `profile` pointer — verified unambiguous, so this struct
# uses the libro-style cross-file `check_struct` CI guard rather than
# the field-count bound check. The 4 raw cross-file writes that existed
# at 2.1.5 (in gaudi.cyr / vulkan.cyr / cuda.cyr / rocm.cyr — all
# adjusting memory_bytes after hardware-specific detection) were
# converted to `profile_set_memory_bytes(p, …)` in this slot.
#
# Sentinel: PROFILE_NONE (=-1) marks "field not reported by this
# backend" for the numeric optional fields (memory bandwidth, mem
# used/free, temperature, power, gpu util, tpu/gaudi/neuron versions).
# 0 marks "not applicable" for tpu_chip_count and neuron_cores. String
# fields (compute_cap, driver_version, device_name) use 0 as the
# null-cstr sentinel.

#derive(accessors)
struct profile {
    accel_type;
    device_id;
    available;
    memory_bytes;
    compute_cap;
    driver_version;
    device_name;
    mem_bw_x1000;
    mem_used;
    mem_free;
    pcie_bw_x1000;
    numa_node;
    temp_c;
    power_x1000;
    gpu_util;
    tpu_version;
    tpu_chips;
    gaudi_gen;
    neuron_chip;
    neuron_cores;
    shared_mem;
    pci_id;
    pci_bdf;
}

# shared_mem (2.3.28): how many of memory_bytes are system RAM, i.e. the pool
# the CPU profile already counts. All of it for the CPU and for types where
# accel_uses_system_memory() holds; 480 GiB for a GH200 (its Grace LPDDR5X,
# cuda.cyr); 0 for a device with memory of its own. Registry totals count
# system RAM once from it (reg_total_memory). Detectors of shared-memory types
# set memory_bytes when they construct the profile; profile_new derives this
# field from it, so a later profile_set_memory_bytes would leave it stale.

# pci_id (2.4.0): the device's PCI vendor and device ID, as
# pci_id_make(vendor, device), or 0 when unknown. The CUDA (nvidia-smi
# pci.device_id), ROCm and Vulkan backends set it; profiles_dedup
# (registry.cyr) matches on it to report one profile per physical device. It is
# not serialized.

# pci_bdf (2.5.5): the device's PCI address as sysfs names it, "0000:3b:00.0",
# as a cstr, or 0 when unknown. The CUDA (nvidia-smi pci.bus_id) and ROCm (the
# DRM card's device link) backends set it; enrich_pcie and enrich_numa read
# /sys/bus/pci/devices/<pci_bdf>. Through 2.5.4 those passes took the
# device_id-th entry of the driver's sysfs directory, which lists devices in
# name-hash order, so on a multi-GPU host a GPU got another's NUMA node and
# link. It is not serialized.

# sizeof, not a literal (2.5.5): a field added without a bump of a hand-kept
# size would have its setter write past the allocation. PROFILE_SIZE stays
# for consumers; the constructor allocates sizeof(profile) itself.
var PROFILE_SIZE = sizeof(profile);
var PROFILE_NONE = 0 - 1;

fn profile_new(atype, dev_id, mem_bytes) {
    var p = alloc(sizeof(profile));
    profile_set_accel_type(p, atype);
    profile_set_device_id(p, dev_id);
    profile_set_available(p, 1);
    profile_set_memory_bytes(p, mem_bytes);
    profile_set_compute_cap(p, 0);
    profile_set_driver_version(p, 0);
    profile_set_device_name(p, 0);
    profile_set_mem_bw_x1000(p, PROFILE_NONE);
    profile_set_mem_used(p, PROFILE_NONE);
    profile_set_mem_free(p, PROFILE_NONE);
    profile_set_pcie_bw_x1000(p, PROFILE_NONE);
    profile_set_numa_node(p, PROFILE_NONE);
    profile_set_temp_c(p, PROFILE_NONE);
    profile_set_power_x1000(p, PROFILE_NONE);
    profile_set_gpu_util(p, PROFILE_NONE);
    profile_set_tpu_version(p, PROFILE_NONE);
    profile_set_tpu_chips(p, 0);
    profile_set_gaudi_gen(p, PROFILE_NONE);
    profile_set_neuron_chip(p, PROFILE_NONE);
    profile_set_neuron_cores(p, 0);
    # accel_uses_system_memory(atype), as its bitmask (no call per device).
    # The range check keeps a foreign accel_type_id (profile_from_json) from
    # wrapping the shift: 64 would read the CPU's bit.
    var sh = 0;
    if (atype >= 0) {
        if (atype < 64) {
            if (((ACCEL_SYSMEM_MASK >> atype) & 1) == 1) { sh = mem_bytes; }
        }
    }
    profile_set_shared_mem(p, sh);
    profile_set_pci_id(p, 0);
    profile_set_pci_bdf(p, 0);
    return p;
}

# A profile's pci_id from a PCI vendor and device ID: (vendor << 16) | device,
# or 0 unless both are 16-bit IDs. Pure.
fn pci_id_make(vendor, device) {
    if (vendor <= 0 || vendor > 0xFFFF) { return 0; }
    if (device < 0 || device > 0xFFFF) { return 0; }
    return (vendor << 16) | device;
}

# --- Convenience constructors ---

fn profile_cpu(mem_bytes) {
    return profile_new(ACCEL_CPU, 0, mem_bytes);
}

fn profile_cuda(dev_id, vram_bytes) {
    return profile_new(ACCEL_CUDA, dev_id, vram_bytes);
}

fn profile_rocm(dev_id, vram_bytes) {
    return profile_new(ACCEL_ROCM, dev_id, vram_bytes);
}

fn profile_tpu(dev_id, chip_count, version) {
    var hbm = tpu_hbm_per_chip(version) * chip_count;
    var p = profile_new(ACCEL_TPU, dev_id, hbm);
    profile_set_tpu_version(p, version);
    profile_set_tpu_chips(p, chip_count);
    return p;
}

fn profile_gaudi(dev_id, gen) {
    var p = profile_new(ACCEL_GAUDI, dev_id, gaudi_hbm_bytes(gen));
    profile_set_gaudi_gen(p, gen);
    return p;
}

fn profile_neuron(dev_id, chip_type, core_count) {
    var mem = neuron_hbm_per_core(chip_type) * core_count;
    var p = profile_new(ACCEL_NEURON, dev_id, mem);
    profile_set_neuron_chip(p, chip_type);
    profile_set_neuron_cores(p, core_count);
    return p;
}

# --- Derived queries ---

# The part of this profile's memory that is system RAM, clamped to
# [0, memory_bytes]. See shared_mem above.
fn profile_shared_bytes(p) {
    var s = profile_shared_mem(p);
    if (s < 0) { return 0; }
    var m = profile_memory_bytes(p);
    if (s > m) { return m; }
    return s;
}

# Get the accelerator family for this profile
fn profile_family(p) {
    return accel_family(profile_accel_type(p));
}

# Get throughput multiplier (x1000) for this profile
fn profile_throughput_x1000(p) {
    var at = profile_accel_type(p);
    if (at == ACCEL_TPU) { return tpu_throughput_x1000(profile_tpu_version(p)); }
    if (at == ACCEL_GAUDI) { return gaudi_throughput_x1000(profile_gaudi_gen(p)); }
    if (at == ACCEL_NEURON) {
        return neuron_throughput_x1000(
          profile_neuron_chip(p), profile_neuron_cores(p));
    }
    return accel_throughput_x1000(at);
}

# Get training multiplier (x1000) for this profile
fn profile_training_x1000(p) {
    var at = profile_accel_type(p);
    if (at == ACCEL_TPU) { return tpu_training_x1000(profile_tpu_version(p)); }
    if (at == ACCEL_GAUDI) { return gaudi_training_x1000(profile_gaudi_gen(p)); }
    if (at == ACCEL_NEURON) {
        return neuron_training_x1000(
          profile_neuron_chip(p), profile_neuron_cores(p));
    }
    return accel_training_x1000(at);
}

# Get rank for this profile (higher = preferred)
fn profile_rank(p) {
    var at = profile_accel_type(p);
    if (at == ACCEL_TPU) { return tpu_rank(profile_tpu_version(p)); }
    if (at == ACCEL_GAUDI) { return gaudi_rank(profile_gaudi_gen(p)); }
    if (at == ACCEL_NEURON) { return neuron_rank(profile_neuron_chip(p)); }
    if (at == ACCEL_GROQ) { return groq_rank(); }
    return accel_rank(at);
}

# Whether this profile supports training
fn profile_supports_training(p) {
    return profile_training_x1000(p) > 0;
}

# --- Quantization support ---

fn profile_supports_quant(p, quant) {
    var fam = profile_family(p);
    # CPU and GPU support all quant levels
    if (fam == FAMILY_CPU) { return 1; }
    if (fam == FAMILY_GPU) { return 1; }
    # NPU: INT8 and INT4 only
    if (fam == FAMILY_NPU) {
        if (quant == QUANT_INT8) { return 1; }
        if (quant == QUANT_INT4) { return 1; }
        return 0;
    }
    # TPU: FP32, BF16, INT8
    if (fam == FAMILY_TPU) {
        if (quant == QUANT_NONE) { return 1; }
        if (quant == QUANT_BF16) { return 1; }
        if (quant == QUANT_INT8) { return 1; }
        return 0;
    }
    # A type this build does not know: nothing is claimed for it (2.5.5;
    # through 2.5.4 it was family CPU, and supported every level).
    if (fam == FAMILY_UNKNOWN) { return 0; }
    # AI ASICs: device-specific
    var at = profile_accel_type(p);
    if (at == ACCEL_QUALCOMM) {
        if (quant == QUANT_FP16) { return 1; }
        if (quant == QUANT_INT8) { return 1; }
        if (quant == QUANT_INT4) { return 1; }
        return 0;
    }
    if (at == ACCEL_GROQ) {
        if (quant == QUANT_FP16) { return 1; }
        if (quant == QUANT_INT8) { return 1; }
        if (quant == QUANT_INT4) { return 1; }
        return 0;
    }
    if (at == ACCEL_GRAPHCORE) {
        if (quant == QUANT_NONE) { return 1; }
        if (quant == QUANT_FP16) { return 1; }
        if (quant == QUANT_INT8) { return 1; }
        return 0;
    }
    # Gaudi, Neuron, Cerebras: FP32, BF16, FP16, INT8
    if (quant == QUANT_NONE) { return 1; }
    if (quant == QUANT_BF16) { return 1; }
    if (quant == QUANT_FP16) { return 1; }
    if (quant == QUANT_INT8) { return 1; }
    return 0;
}

# Preferred quantization for this profile
fn profile_preferred_quant(p) {
    var fam = profile_family(p);
    if (fam == FAMILY_CPU) { return QUANT_FP16; }
    if (fam == FAMILY_GPU) { return QUANT_FP16; }
    if (fam == FAMILY_NPU) { return QUANT_INT8; }
    if (fam == FAMILY_TPU) { return QUANT_BF16; }
    # AI ASICs
    var at = profile_accel_type(p);
    if (at == ACCEL_GAUDI) { return QUANT_BF16; }
    if (at == ACCEL_NEURON) { return QUANT_BF16; }
    if (at == ACCEL_QUALCOMM) { return QUANT_INT8; }
    if (at == ACCEL_CEREBRAS) { return QUANT_BF16; }
    if (at == ACCEL_GRAPHCORE) { return QUANT_FP16; }
    if (at == ACCEL_GROQ) { return QUANT_INT8; }
    return QUANT_FP16;
}

# --- system_io.cyr ---

# system_io.cyr — system-level I/O topology
# Interconnects, storage devices, runtime environment, sharding types.

# --- Interconnect kind ---

enum InterconnectKind {
    ICK_INFINIBAND = 0;
    ICK_ROCE = 1;
    ICK_ROCEV2 = 2;
    ICK_NVLINK = 3;
    ICK_NVSWITCH = 4;
    ICK_XGMI = 5;
    ICK_ICI = 6;
    ICK_PCIE = 7;
}

fn ick_name(k) {
    if (k == ICK_INFINIBAND) { return "InfiniBand"; }
    if (k == ICK_ROCE) { return "RoCE"; }
    if (k == ICK_ROCEV2) { return "RoCE v2"; }
    if (k == ICK_NVLINK) { return "NVLink"; }
    if (k == ICK_NVSWITCH) { return "NVSwitch"; }
    if (k == ICK_XGMI) { return "XGMI"; }
    if (k == ICK_ICI) { return "ICI"; }
    if (k == ICK_PCIE) { return "PCIe"; }
    return "Unknown";
}

# Interconnect — port/device + bandwidth + state descriptor.
# Struct name `ic` matches the `ic_*` accessor convention; constructor
# stays the descriptive `interconnect_new`. 2.1.4: hand-rolled
# accessors replaced with #derive(accessors).

#derive(accessors)
struct ic {
    kind;
    name;
    bw_x1000;
    state;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var INTERCONNECT_SIZE = sizeof(ic);

fn interconnect_new(kind, name, bw_x1000) {
    var ic = alloc(sizeof(ic));
    ic_set_kind(ic, kind);
    ic_set_name(ic, name);
    ic_set_bw_x1000(ic, bw_x1000);
    ic_set_state(ic, 0);
    return ic;
}

# --- Storage kind ---

enum StorageKind {
    STK_NVME = 0;
    STK_SATA_SSD = 1;
    STK_HDD = 2;
    STK_UNKNOWN = 3;
}

fn stk_name(k) {
    if (k == STK_NVME) { return "NVMe"; }
    if (k == STK_SATA_SSD) { return "SATA SSD"; }
    if (k == STK_HDD) { return "HDD"; }
    return "Unknown";
}

# StorageDevice — block device + bandwidth descriptor.
# 2.1.3: hand-rolled load64 accessors replaced with #derive(accessors).

#derive(accessors)
struct storage {
    name;
    kind;
    bw_x1000;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var STORAGE_SIZE = sizeof(storage);

fn storage_new(name, kind, bw_x1000) {
    var sd = alloc(sizeof(storage));
    storage_set_name(sd, name);
    storage_set_kind(sd, kind);
    storage_set_bw_x1000(sd, bw_x1000);
    return sd;
}

# --- Runtime environment ---
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `env` matches the `env_*` accessor convention; field
# names retain the `is_docker` / `is_k8s` semantics (sentinel: 0 for
# i64 fields means "not detected", 0 for ptr fields means cstr-null).
# Note: setter for `is_docker` is `env_set_is_docker` (derived from
# the field name); the legacy pre-derive name was `env_set_docker`.
# Same for `env_set_is_k8s` (was `env_set_k8s`). Detection code in
# environment.cyr was updated to the new names in this slot.

#derive(accessors)
struct env {
    is_docker;
    is_k8s;
    k8s_namespace;
    cloud_provider;
    instance_type;
    region;
    k8s_gpu_count;
    k8s_gpu_source;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var RUNTIME_ENV_SIZE = sizeof(env);

fn runtime_env_new() {
    var e = alloc(sizeof(env));
    env_set_is_docker(e, 0);
    env_set_is_k8s(e, 0);
    env_set_k8s_namespace(e, 0);
    env_set_cloud_provider(e, 0);
    env_set_instance_type(e, 0);
    env_set_region(e, 0);
    # PROFILE_NONE until NVIDIA_VISIBLE_DEVICES gives a count, so the JSON
    # omits it (2.5.5): through 2.5.4 every environment, k8s or not,
    # reported "k8s_gpu_count":0, a claim of zero GPUs.
    env_set_k8s_gpu_count(e, PROFILE_NONE);
    env_set_k8s_gpu_source(e, 0);
    return e;
}

# --- SystemIo container ---
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `sio` matches the existing `sio_*` accessor convention.
# Internal `load64(sio)` shortcuts in helpers below switched to the
# derived getters for consistency.

#derive(accessors)
struct sio {
    interconnects;
    storage;
    environment;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var SYSTEM_IO_SIZE = sizeof(sio);

fn system_io_new() {
    var sio = alloc(sizeof(sio));
    sio_set_interconnects(sio, vec_new());
    sio_set_storage(sio, vec_new());
    sio_set_environment(sio, 0);
    return sio;
}

fn sio_add_interconnect(sio, ic) {
    vec_push(sio_interconnects(sio), ic);
    return 0;
}

fn sio_add_storage(sio, sd) {
    vec_push(sio_storage(sio), sd);
    return 0;
}

fn sio_has_interconnect(sio) {
    return vec_len(sio_interconnects(sio)) > 0;
}

# Total interconnect bandwidth (x1000)
fn sio_total_ic_bw_x1000(sio) {
    var ics = sio_interconnects(sio);
    var total = 0;
    var n = vec_len(ics);
    for (var i = 0; i < n; i = i + 1) {
        total = total + ic_bw_x1000(vec_get(ics, i));
    }
    return total;
}

# Has NVSwitch?
fn sio_has_nvswitch(sio) {
    var ics = sio_interconnects(sio);
    var n = vec_len(ics);
    for (var i = 0; i < n; i = i + 1) {
        if (ic_kind(vec_get(ics, i)) == ICK_NVSWITCH) { return 1; }
    }
    return 0;
}

# Has NVLink?
fn sio_has_nvlink(sio) {
    var ics = sio_interconnects(sio);
    var n = vec_len(ics);
    for (var i = 0; i < n; i = i + 1) {
        var k = ic_kind(vec_get(ics, i));
        if (k == ICK_NVLINK) { return 1; }
        if (k == ICK_NVSWITCH) { return 1; }
    }
    return 0;
}

# Has ICI (TPU interconnect)?
fn sio_has_ici(sio) {
    var ics = sio_interconnects(sio);
    var n = vec_len(ics);
    for (var i = 0; i < n; i = i + 1) {
        if (ic_kind(vec_get(ics, i)) == ICK_ICI) { return 1; }
    }
    return 0;
}

# Max interconnect bandwidth (x1000) — used for sharding decisions
fn sio_max_ic_bw_x1000(sio) {
    var ics = sio_interconnects(sio);
    var best = 0;
    var n = vec_len(ics);
    for (var i = 0; i < n; i = i + 1) {
        var bw = ic_bw_x1000(vec_get(ics, i));
        if (bw > best) { best = bw; }
    }
    return best;
}

# --- Sharding strategy ---

enum ShardingStrategy {
    SHARD_NONE = 0;
    SHARD_PIPELINE = 1;
    SHARD_TENSOR = 2;
    SHARD_DATA = 3;
}

fn shard_strategy_name(s) {
    if (s == SHARD_NONE) { return "None"; }
    if (s == SHARD_PIPELINE) { return "Pipeline Parallel"; }
    if (s == SHARD_TENSOR) { return "Tensor Parallel"; }
    if (s == SHARD_DATA) { return "Data Parallel"; }
    return "Unknown";
}

# --- ModelShard ---
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `shard` matches the `shard_*` accessor convention;
# constructor stays `model_shard_new`. Field name `id` collides
# with the `shard_id` accessor only if read as `shard_id(ms)` —
# which is the actual accessor name we want, so the field is named
# `id` directly. Same for `layer_start` / `layer_end` etc.

#derive(accessors)
struct shard {
    id;
    layer_start;
    layer_end;
    device_type;
    device_id;
    memory_bytes;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var MODEL_SHARD_SIZE = sizeof(shard);

fn model_shard_new(sid, lstart, lend, devtype, devid, membytes) {
    var ms = alloc(sizeof(shard));
    shard_set_id(ms, sid);
    shard_set_layer_start(ms, lstart);
    shard_set_layer_end(ms, lend);
    shard_set_device_type(ms, devtype);
    shard_set_device_id(ms, devid);
    shard_set_memory_bytes(ms, membytes);
    return ms;
}

fn shard_num_layers(ms) {
    var s = shard_layer_start(ms);
    var e = shard_layer_end(ms);
    if (e >= s) { return e - s + 1; }
    return 0;
}

fn shard_is_valid(ms) {
    return shard_layer_start(ms) <= shard_layer_end(ms);
}

# ShardingPlan — sharding strategy + computed memory/throughput.
# Struct name `plan` matches the `plan_*` accessor convention;
# constructor stays the descriptive `sharding_plan_new`. The shards
# field carries a `vec` pointer (heterogeneous), initialised to a
# fresh empty vec by the constructor.
# 2.1.4: hand-rolled accessors replaced with #derive(accessors).
# 2.5.5: `fits` (1/0) says whether the shards fit the memory of the devices
# they name; the planner clears it when nothing holds the model (the Rust
# v1 `fits_in_memory`, dropped in the port). A new plan starts at 1.

#derive(accessors)
struct plan {
    shards;
    strategy;
    strategy_count;
    total_memory;
    est_tps_x1000;
    fits;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var SHARDING_PLAN_SIZE = sizeof(plan);

fn sharding_plan_new(strategy, count) {
    var sp = alloc(sizeof(plan));
    plan_set_shards(sp, vec_new());
    plan_set_strategy(sp, strategy);
    plan_set_strategy_count(sp, count);
    plan_set_total_memory(sp, 0);
    plan_set_est_tps_x1000(sp, PROFILE_NONE);
    plan_set_fits(sp, 1);
    return sp;
}

fn plan_add_shard(sp, ms) {
    vec_push(plan_shards(sp), ms);
    return 0;
}

fn plan_num_shards(sp) {
    return vec_len(plan_shards(sp));
}

fn plan_min_devices(sp) {
    var s = plan_strategy(sp);
    if (s == SHARD_NONE) { return 1; }
    return plan_strategy_count(sp);
}

# --- platform.cyr ---

# platform.cyr — sysfs/procfs/devfs helpers for hardware detection
# Wrappers around io.cyr and fs.cyr for common detection patterns.
#
# Windows has no sysfs, procfs or devfs, and a rooted "/sys/..." path there
# names a folder at the root of the current drive, which any local user may
# create (C:\sys\class\dmi\id\sys_vendor, C:\sys\block\nvme9n1). So on PE
# builds every helper below answers "absent" without touching the
# filesystem (2.5.5): through 2.5.4 a planted folder fed the report (a fake
# NVMe, a fake cloud provider) or, through the XGMI probe, crashed it.

var SYSFS_MAX_READ = 4096;

# Read a sysfs/procfs file into a Str. Returns Str or 0 on error. Reads at
# most SYSFS_MAX_READ - 1 bytes (through 2.5.0 a 4 KiB file put the NUL one
# byte past the buffer). A longer file is cut short without a warning: this
# runs on detector threads, which must not log, and every file read here is a
# short sysfs value or device-tree string. One trailing newline is dropped.
# The read goes to the stack and the Str is a copy of its own size: through
# 2.5.4 each read kept a 4 KiB buffer for a value of a few bytes, missing
# files included, and a long-lived consumer re-detects (2.5.5).
fn sysfs_read(path) {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    var tmp[4096];   # SYSFS_MAX_READ
    var n = file_read_all(path, &tmp, SYSFS_MAX_READ - 1);
    if (n <= 0) { return 0; }
    if (load8(&tmp + n - 1) == 10) { n = n - 1; }
    return str_from_buf(&tmp, n);
}

# Read a sysfs file as an integer. Returns value, or -1 on error.
fn sysfs_read_int(path) {
    var s = sysfs_read(path);
    if (s == 0) { return 0 - 1; }
    return str_to_int(s);
}

# Check if a path exists (file or directory). 0 on Windows (see the header).
fn aihw_path_exists(path) {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    return file_exists(path);
}

# Check if a directory exists. 0 on Windows (see the header).
fn dir_exists(path) {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    var s = str_from(path);
    return is_dir(s);
}

# Read symlink target. Returns Str or 0.
#
# The syscall NUMBER is per-target, and picking the wrong one is not a
# harmless no-op. readlink is #89 on Linux, but on AGNOS #89 is
# `gpu_caps(buf, len)` — a syscall that WRITES into its first argument.
# Through 2.3.16 this called `syscall(89, path, buf, 255)` unconditionally,
# so an AGNOS build handed a path pointer to the GPU capability syscall
# (the `mirshi: ENOSYS agnos#89` defect). AGNOS's readlink is **#70** and
# takes the path length explicitly: (path, pathlen, buf, buflen), a4 in r10.
#
# Each branch calls the stdlib `sys_readlink` peer for its target rather
# than a local number, so the number AND the arity come from the one file
# that owns both. cycc predefines exactly one CYRIUS_TARGET_* per compile,
# so exactly one branch survives the preprocessor. Windows has no readlink
# peer — and no /sys tree for the two callers (detect_rocm, detect_amd_xdna)
# to walk — so it falls through with n = 0, i.e. "not a symlink".
fn read_symlink(path) {
    var buf = alloc(256);
    var n = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    n = sys_readlink(path, strlen(path), buf, 255);
    #endif
    #ifdef CYRIUS_TARGET_LINUX
    n = sys_readlink(path, buf, 255);
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    n = sys_readlink(path, buf, 255);
    #endif
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    return str_new(buf, n);
}

# --- /dev scans ---

# The device id of directory entry `name` (`len` bytes at `name`) when it is
# `prefix` (a cstr) followed by 1 to 4 decimal digits, else -1. For "neuron"
# and "ipu": "neuron0" -> 0, "ipu12" -> 12; "ipu-psys0" (the Intel IPU6
# camera's processing-system node), "ipu7-psys0" (IPU7), "ipu0_ex" (a
# Graphcore IPU's companion node), "neuron" and "neuron_x" -> -1. Through
# 2.5.4 the suffix went through str_to_int, which skips non-digits, so every
# one of those was a device. Pure.
fn dev_entry_id(name, len, prefix) {
    var plen = strlen(prefix);
    var nd = len - plen;
    if (nd < 1 || nd > 4) { return 0 - 1; }
    if (memeq(name, prefix, plen) != 1) { return 0 - 1; }
    var id = 0;
    var i = plen;
    while (i < len) {
        var c = load8(name + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        id = id * 10 + c - 48;
        i = i + 1;
    }
    return id;
}

# One entry for dev_dir_scan: with `ids` a vec, push the entry's dev_entry_id
# and answer 1 when it has one; with `ids` 0, answer 1 when the entry is
# `prefix` followed by anything at all.
fn _dev_scan_entry(name, len, prefix, plen, ids) {
    if (ids == 0) {
        if (len > plen) {
            if (memeq(name, prefix, plen) == 1) { return 1; }
        }
        return 0;
    }
    var id = dev_entry_id(name, len, prefix);
    if (id < 0) { return 0; }
    vec_push(ids, id);
    return 1;
}

# Scan directory `dir` (a cstr) for entries named after `prefix` (a cstr).
# With `ids` a vec, push the id of every <prefix><digits> entry
# (dev_entry_id) and return how many; with `ids` 0, return 1 if some entry is
# `prefix` followed by anything, else 0. The names are listed into stack
# buffers (dir_list_into), so a scan keeps nothing but its ids: detection
# scans /dev up to 8 times and a long-lived consumer re-detects, and
# dir_list's Str per entry (about 12 KB for /dev here) was never freed. A
# directory past 2048 entries or 16 KiB of names is listed by dir_list.
fn dev_dir_scan(dir, prefix, ids) {
    var plen = strlen(prefix);
    var scratch[4096];
    var names[16384];
    var offs[16384];
    var dp = str_from(dir);
    var count = 0;
    var n = dir_list_into(dp, &scratch, 4096, &names, 16384, &offs, 2048);
    if (n >= 0) {
        var i = 0;
        while (i < n) {
            var nm = &names + load64(&offs + i * 8);
            i = i + 1;
            count = count + _dev_scan_entry(nm, strlen(nm), prefix, plen, ids);
            if (ids == 0 && count > 0) { return 1; }
        }
        return count;
    }
    if (n == 0 - 1) { return 0; }
    var entries = dir_list(dp);
    var nent = vec_len(entries);
    var ei = 0;
    while (ei < nent) {
        var e = vec_get(entries, ei);
        ei = ei + 1;
        count = count + _dev_scan_entry(str_data(e), str_len(e), prefix, plen, ids);
        if (ids == 0 && count > 0) { return 1; }
    }
    return count;
}

# Ids of the /dev/<prefix><digits> devices (dev_entry_id), e.g. "neuron" ->
# /dev/neuron0.. . Digits only, as the Rust releases' iter_dev_devices had
# it. Empty on Windows (see the header).
fn scan_dev_devices(prefix) {
    var ids = vec_new();
    #ifdef CYRIUS_TARGET_WIN
    return ids;
    #endif
    dev_dir_scan("/dev", prefix, ids);
    return ids;
}

# 1 when some /dev entry is <prefix> followed by anything at all, else 0
# (0 on Windows). Presence only, for the families whose node names need not
# end in a bare number, such as Qualcomm's /dev/qaic_aic100_0; a family whose
# nodes are /dev/<prefix><N> uses scan_dev_devices.
fn has_dev_device(prefix) {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    return dev_dir_scan("/dev", prefix, 0);
}

# Parse `wmic computersystem get TotalPhysicalMemory` output (a
# `TotalPhysicalMemory=<bytes>` line) into a byte count. 0 if absent.
# Pure — Linux-testable. v2.3.7. Only the fallback uses it now; see
# detect_system_memory.
fn win_parse_total_memory(out) {
    var lines = str_split(out, 10);
    var nl = vec_len(lines);
    var i = 0;
    while (i < nl) {
        var line = str_trim(vec_get(lines, i));
        var ld = str_data(line);
        var ll = str_len(line);
        if (ll >= 20) {
            if (memeq(ld, "TotalPhysicalMemory=", 20) == 1) {
                return str_to_int(str_new(ld + 20, ll - 20));
            }
        }
        i = i + 1;
    }
    return 0;
}

#ifdef CYRIUS_TARGET_WIN
# Total physical memory (bytes) from kernel32!GlobalMemoryStatusEx, or 0 on
# failure. The PE backend has no reroute for it, so it is resolved at run
# time: GetModuleHandleA("kernel32.dll") (syscall 0xF013) -> GetProcAddress
# (0xF014) -> callptr. MEMORYSTATUSEX is 64 bytes: dwLength@0 must hold its
# size on entry, ullTotalPhys@8. The result is the figure Windows reports as
# Win32_ComputerSystem.TotalPhysicalMemory (8405598208 on cass for both).
fn win_total_phys_bytes() {
    var k32 = syscall(0xF013, "kernel32.dll");
    if (k32 == 0) { return 0; }
    var gmse = syscall(0xF014, k32, "GlobalMemoryStatusEx");
    if (gmse == 0) { return 0; }
    var memstat[64];
    memset(&memstat, 0, 64);
    store32(&memstat, 64);
    var ok = callptr(gmse, &memstat);
    if ((ok & 0xFFFFFFFF) == 0) { return 0; }
    return load64(&memstat + 8);
}
#endif

#ifdef CYRIUS_TARGET_MACOS
# sysctl MIB for hw.memsize: {CTL_HW, HW_MEMSIZE} from <sys/sysctl.h>.
# Prefixed because lib/sys.cyr names them CTL_HW / HW_MEMSIZE, and a consumer
# may include both.
enum HwaMacSysctl {
    HWA_CTL_HW = 6;
    HWA_HW_MEMSIZE = 24;
}

# Total physical memory (bytes) from sysctl hw.memsize, or 0 on failure.
# macOS has no /proc/meminfo, so through 2.3.26 every macOS build reported
# the 16 GiB fallback. The MIB is two 32-bit ints, and the node is 8 bytes
# wide: Darwin rejects a read at the wrong width, so `len` starts at 8.
# SYS_SYSCTL is the syscalls peer's alias that the Mach-O backend translates
# to BSD sysctl (the call lib/sys.cyr's sys_sysinfo makes).
fn mac_total_phys_bytes() {
    var mib[8];
    store32(&mib, HWA_CTL_HW);
    store32(&mib + 4, HWA_HW_MEMSIZE);
    var total = 0;
    var len = 8;
    var r = syscall(SYS_SYSCTL, &mib, 2, &total, &len, 0, 0);
    if (r < 0) { return 0; }
    if (total < 0) { return 0; }
    return total;
}
#endif

# MemTotal from a /proc/meminfo image (`n` bytes at `buf`), in bytes, or 0
# when it has no MemTotal line. Pure.
fn meminfo_total_bytes(buf, n) {
    var pos = 0;
    while (pos < n) {
        if (n - pos >= 9 && memeq(buf + pos, "MemTotal:", 9) == 1) {
            pos = pos + 9;
            while (pos < n) {
                if (load8(buf + pos) != 32) { break; }
                pos = pos + 1;
            }
            var kb = 0;
            var nd = 0;
            while (pos < n) {
                var c = load8(buf + pos);
                if (c < 48 || c > 57) { break; }
                if (nd >= 15) { return 0; }
                kb = kb * 10 + c - 48;
                nd = nd + 1;
                pos = pos + 1;
            }
            return kb * 1024;
        }
        # Skip to the next line
        while (pos < n) {
            if (load8(buf + pos) == 10) {
                pos = pos + 1;
                break;
            }
            pos = pos + 1;
        }
    }
    return 0;
}

# A cgroup memory limit file's contents (`n` bytes at `buf`) as bytes, or 0
# for no limit: v2's "max", a value that does not start with a digit, more
# digits than an i64 holds, or 2^62 and up (v1's "unlimited" is
# 9223372036854771712, 2^63 less a page). Stops at the first non-digit. Pure.
fn cgroup_limit_parse(buf, n) {
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c < 48 || c > 57) { break; }
        if (v > 461168601842738790) { return 0; }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    if (i == 0) { return 0; }
    if (v >= 4611686018427387904) { return 0; }
    return v;
}

# cgroup_limit_parse of the file `rel` (a cstr) under directory `root`, or -1
# when it cannot be read.
fn _cgroup_read_limit(root, rel) {
    var path[512];
    var rl = strlen(root);
    var sl = strlen(rel);
    if (rl + sl + 2 > 512) { return 0 - 1; }
    memcpy(&path, root, rl);
    store8(&path + rl, 47);
    memcpy(&path + rl + 1, rel, sl);
    store8(&path + rl + 1 + sl, 0);
    var buf[64];
    var n = file_read_all(&path, &buf, 63);
    if (n <= 0) { return 0 - 1; }
    return cgroup_limit_parse(&buf, n);
}

# The memory limit of the cgroup mounted at `root` (a cstr; the system's is
# "/sys/fs/cgroup"), in bytes, or 0 for none: cgroup v2's memory.max, else
# v1's memory/memory.limit_in_bytes. In a container with its own cgroup
# namespace (Docker's and containerd's default on cgroup v2) and under v1,
# the mount shows the container's cgroup, so this is the container's limit.
# On a host the v2 root has no memory.max and the v1 root is unlimited, so
# both read as 0. A container that shares the host's cgroup namespace
# (--cgroupns=host) is not seen.
fn cgroup_mem_limit_bytes(root) {
    var v2 = _cgroup_read_limit(root, "memory.max");
    if (v2 >= 0) { return v2; }
    var v1 = _cgroup_read_limit(root, "memory/memory.limit_in_bytes");
    if (v1 > 0) { return v1; }
    return 0;
}

# Get total system memory (in bytes). Windows: GlobalMemoryStatusEx, with a
# `wmic computersystem` spawn only if that fails AND `allow_exec` is 1 (wmic
# is absent on Windows 11 24H2+), through run_tool_status (2.5.5; by the
# absolute path which() finds since 2.5.3). macOS: sysctl hw.memsize. Else:
# /proc/meminfo's MemTotal, or the cgroup memory limit when that is lower
# (2.5.5): inside a container MemTotal is the host's RAM, so a pod limited to
# 32 GiB on a 1 TiB node reported 1 TiB. `allow_exec` matters only on
# Windows. Returns 0 on failure (caller substitutes a default).
fn detect_system_memory_opts(allow_exec) {
    #ifdef CYRIUS_TARGET_WIN
    var native = win_total_phys_bytes();
    if (native > 0) { return native; }
    if (allow_exec == 0) { return 0; }
    var wargs = vec_new();
    vec_push(wargs, "computersystem");
    vec_push(wargs, "get");
    vec_push(wargs, "TotalPhysicalMemory");
    vec_push(wargs, "/value");
    # No warnings vec: a failure reads as 0, and the caller's default.
    var wst[16];
    var wout = run_tool_status("wmic", wargs, 0, &wst);
    if (wout == 0) { return 0; }
    return win_parse_total_memory(wout);
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    return mac_total_phys_bytes();
    #endif
    # MemTotal is the file's first line, so a cut-short read still holds it.
    # On the stack: only the number leaves.
    var buf[4096];
    var total = 0;
    var n = file_read_all("/proc/meminfo", &buf, 4096);
    if (n > 0) { total = meminfo_total_bytes(&buf, n); }
    var lim = cgroup_mem_limit_bytes("/sys/fs/cgroup");
    if (lim > 0) {
        if (total == 0 || lim < total) { total = lim; }
    }
    return total;
}

# detect_system_memory_opts with exec allowed.
fn detect_system_memory() {
    return detect_system_memory_opts(1);
}

# List entries in a sysfs directory. Returns vec of Str names (empty on
# Windows; see the header).
fn sysfs_list_dir(path) {
    #ifdef CYRIUS_TARGET_WIN
    return vec_new();
    #endif
    var s = str_from(path);
    return dir_list(s);
}

# Build a sysfs path: base/entry/suffix, from cstrs (`entry` and `suffix`
# may be 0). Returns a heap cstr.
fn sysfs_path(base, entry, suffix) {
    var es = 0;
    if (entry != 0) { es = str_from(entry); }
    return sysfs_path_str(base, es, suffix);
}

# sysfs_path with `entry_str` a Str (or 0). str_builder_build already
# returns a fresh NUL-terminated buffer, so its data is the cstr (through
# 2.5.4 both builders copied it a second time).
fn sysfs_path_str(base, entry_str, suffix) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, "/");
    if (entry_str != 0) {
        str_builder_add(sb, entry_str);
        if (suffix != 0) {
            str_builder_add_cstr(sb, "/");
        }
    }
    if (suffix != 0) {
        str_builder_add_cstr(sb, suffix);
    }
    return str_data(str_builder_build(sb));
}

# The decimal number a Str starts with, after blanks (space or tab), in
# thousandths: "64.67" -> 64670, " 2.5 GT/s" -> 2500, "16.0" -> 16000,
# "450" -> 450000, "70." -> 70000. Fraction digits past the third are
# dropped. -1 when `s` is 0 or does not start with a digit ("[N/A]", "",
# "<inactive>", ".5"), or when the whole part passes 1e12. Pure.
fn parse_decimal_x1000(s) {
    if (s == 0) { return 0 - 1; }
    var n = str_len(s);
    var d = str_data(s);
    var i = 0;
    while (i < n) {
        var b = load8(d + i);
        if (b != 32 && b != 9) { break; }
        i = i + 1;
    }
    if (i >= n) { return 0 - 1; }
    var c = load8(d + i);
    if (c < 48 || c > 57) { return 0 - 1; }
    var whole = 0;
    while (i < n) {
        c = load8(d + i);
        if (c < 48 || c > 57) { break; }
        if (whole > 1000000000000) { return 0 - 1; }
        whole = whole * 10 + c - 48;
        i = i + 1;
    }
    var frac = 0;
    var fd = 0;
    if (i < n && load8(d + i) == 46) {
        i = i + 1;
        while (i < n) {
            c = load8(d + i);
            if (c < 48 || c > 57) { break; }
            if (fd < 3) {
                frac = frac * 10 + c - 48;
                fd = fd + 1;
            }
            i = i + 1;
        }
    }
    while (fd < 3) {
        frac = frac * 10;
        fd = fd + 1;
    }
    return whole * 1000 + frac;
}

# The unsigned integer a Str starts with, after blanks (space or tab):
# " 42 W" -> 42, "7" -> 7. -1 when `s` is 0, does not start with a digit
# ("[N/A]", ""), or holds more than 18 digits. Unlike str_to_int it stops at
# the first non-digit, so "2.5" is 2 and "0x10" is 0. Pure.
fn str_leading_uint(s) {
    if (s == 0) { return 0 - 1; }
    var n = str_len(s);
    var d = str_data(s);
    var i = 0;
    while (i < n) {
        var b = load8(d + i);
        if (b != 32 && b != 9) { break; }
        i = i + 1;
    }
    var v = 0;
    var nd = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 48 || c > 57) { break; }
        if (nd >= 18) { return 0 - 1; }
        v = v * 10 + c - 48;
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) { return 0 - 1; }
    return v;
}

# The unsigned integer a Str starts with, after spaces, in whatever unit
# follows it ("44 GB" -> 44, "900MB" -> 900; MB stays MB, GB stays GB). It
# stops at the first non-digit, so "2.5 GT/s" -> 2 and "0: 96Mhz" -> 0; the
# suffix is neither read nor converted (parse_decimal_x1000 keeps fractions).
fn parse_value_with_suffix(s) {
    var slen = str_len(s);
    var sd = str_data(s);
    var num = 0;
    var pi = 0;
    # Skip leading whitespace
    while (pi < slen) {
        var c = load8(sd + pi);
        if (c != 32) { break; }
        pi = pi + 1;
    }
    # Parse digits
    while (pi < slen) {
        var c2 = load8(sd + pi);
        if (c2 >= 48) {
            if (c2 <= 57) {
                num = num * 10 + c2 - 48;
                pi = pi + 1;
                continue;
            }
        }
        break;
    }
    return num;
}

# --- command.cyr ---

# command.cyr — safe subprocess execution for hardware detection
# Wraps lib/process.cyr with:
#   - PATH resolution (absolute path to a regular executable file)
#   - An empty environment on POSIX (lib/process.cyr), so LD_PRELOAD and the
#     like never reach the tool; a Windows tool inherits the caller's
#   - Output size limits (1 MiB stdout)
#   - A deadline on a silent tool (2.5.1; see below for what it costs)
#   - One capture at a time (2.5.5; see cmd_capture)
#   - CSV parsing helpers
#   - Device ID validation

var CMD_MAX_STDOUT = 1048576;
var CMD_DEFAULT_TIMEOUT_MS = 10000;
var CMD_MAX_DEVICE_ID = 1024;

# --- Tool deadline (2.5.1) ---
# Through 2.5.0 every tool ran without a time limit, so a hung `nvidia-smi`
# blocked detection for ever. What a hung tool costs now, per tool:
#   - POSIX: the read is cut after CMD_DEFAULT_TIMEOUT_MS of silence (a tool
#     still printing is never cut), then lib/process.cyr waits a second
#     CMD_DEFAULT_TIMEOUT_MS for it to exit before it sends TERM, gives it up
#     to 5 s of grace and sends KILL: about 2x the deadline, plus up to 5 s
#     for a tool that ignores TERM. The reap after KILL does not time out, so
#     a tool stuck in the kernel (D state, a wedged driver) is not bounded.
#   - Windows: the bound is wall-clock over the whole run, so a tool still
#     printing when it passes is killed too.
#   - AGNOS: none (process_agnos.cyr has no proc_set_timeout_ms).
# The capture then reports -2 and run_tool_status drops what it read. The
# bound is a process-wide value (proc_set_timeout_ms). The first capture in
# flight sets it and the last one out restores the caller's own value, under a
# mutex, so an embedding program's subprocesses keep their deadline outside
# detection. AGNOS has no deadline, so there the helpers do nothing.
var _cmd_dl_mtx = 0;
var _cmd_dl_inflight = 0;
var _cmd_dl_saved = 0;

# The deadline mutex, created on first use. Two threads may race to create
# it; the CAS keeps one, and the loser's 8-byte cell is never freed.
fn _cmd_dl_mutex() {
    var m = atomic_load(&_cmd_dl_mtx);
    if (m != 0) { return m; }
    var fresh = mutex_new();
    if (atomic_cas(&_cmd_dl_mtx, 0, fresh) == 1) { return fresh; }
    return atomic_load(&_cmd_dl_mtx);
}

fn _cmd_dl_enter() {
    #ifndef CYRIUS_TARGET_AGNOS
    var m = _cmd_dl_mutex();
    mutex_lock(m);
    if (_cmd_dl_inflight == 0) { _cmd_dl_saved = proc_set_timeout_ms(CMD_DEFAULT_TIMEOUT_MS); }
    _cmd_dl_inflight = _cmd_dl_inflight + 1;
    mutex_unlock(m);
    #endif
    return 0;
}

fn _cmd_dl_exit() {
    #ifndef CYRIUS_TARGET_AGNOS
    var m = _cmd_dl_mutex();
    mutex_lock(m);
    _cmd_dl_inflight = _cmd_dl_inflight - 1;
    if (_cmd_dl_inflight == 0) { proc_set_timeout_ms(_cmd_dl_saved); }
    mutex_unlock(m);
    #endif
    return 0;
}

# --- One capture at a time (2.5.5) ---
# lib/process.cyr (cyrius 6.7.18) keeps a capture's state where another
# thread's capture can reach it, and registry_detect_threaded runs detectors
# on several threads:
#   - the idle cut is a global (_proc_read_cut): a capture still reading when
#     another thread's tool was cut read the cut as its own, and a healthy
#     tool was reported as a timeout, its output dropped;
#   - the capture pipe is not close-on-exec (Windows: an inheritable pipe and
#     bInheritHandles), so a tool another thread started mid-capture held the
#     pipe open, and the capture saw EOF only when that tool exited: one hung
#     tool made every capture beside it a deadline kill;
#   - a deadline kill snapshots the tool's descendants into one shared buffer
#     (_proc_tree), and Windows keeps its job table unlocked.
# So captures take turns, under their own mutex (the deadline helpers take
# _cmd_dl_mtx inside it, never the other way round). Detector threads still
# overlap their parsing, sysfs reads and DXGI calls; their tools run one
# after another. Issue 2026-10-29-cyrius-process-capture-state-not-thread-safe.
var _cmd_cap_mtx = 0;

# The capture mutex, created on first use (the same CAS as _cmd_dl_mutex).
fn _cmd_cap_mutex() {
    var m = atomic_load(&_cmd_cap_mtx);
    if (m != 0) { return m; }
    var fresh = mutex_new();
    if (atomic_cas(&_cmd_cap_mtx, 0, fresh) == 1) { return fresh; }
    return atomic_load(&_cmd_cap_mtx);
}

# exec_capture_status under the tool deadline: bytes read (-1 if nothing
# ran), with the end in `st` (two i64 slots; slot 0 is -2 when the deadline
# killed the tool). Every subprocess detection starts goes through here, one
# at a time.
fn cmd_capture(args, buf, buflen, st) {
    var m = _cmd_cap_mutex();
    mutex_lock(m);
    _cmd_dl_enter();
    var n = exec_capture_status(args, buf, buflen, st);
    _cmd_dl_exit();
    mutex_unlock(m);
    return n;
}

# Read an environment variable. Returns a null-terminated string, or 0 if
# unset.
#
# 2.3.21: this was a local /proc/self/environ reader, added long ago to work
# around an io.cyr getenv bug (variable re-declaration in a loop). That bug is
# gone, and cyrius 6.6.0 made the stdlib `getenv` correct on every target
# ai-hwaccel ships to — it derives envp from the init stack on macOS
# (`_macho_argv_base`) and calls the PE `GetEnvironmentVariableA` reroute
# (0xF015) on Windows, alongside the existing /proc and AGNOS paths.
#
# The local reader had the same /proc assumption the stdlib just shed, so it
# returned 0 for EVERY name on macOS and Windows. That made AI_HWACCEL_DATA_DIR
# a silent no-op on both (issue 2026-09-07-cmd-getenv-proc-only), and also
# broke `which()`'s $PATH lookup and NVIDIA_VISIBLE_DEVICES there.
#
# Kept as a named wrapper rather than replacing the four call sites: the name
# documents intent at the call site, and a single seam is the right place to
# put any future per-target quirk. Windows has one (2.5.5, below).
fn cmd_getenv(name) {
    #ifdef CYRIUS_TARGET_WIN
    return _cmd_getenv_win(name);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return getenv(name);
    #endif
}

#ifdef CYRIUS_TARGET_WIN
# A variable's value as a heap cstr of its own size, or 0 when it is unset or
# empty. The stdlib getenv reads into a fixed 4096-byte buffer and answers 0
# for a longer value (lib/io.cyr, cyrius 6.7.18), so a Windows PATH of 4096
# or more characters, which the CUDA toolkit, Visual Studio, conda and oneAPI
# reach between them, made which() find no tool at all. GetEnvironmentVariableA
# (the 0xF015 reroute) returns the length it wrote, NUL excluded, or, when the
# buffer is short, the size it needs, NUL included. A value under 512 bytes
# is read on the stack and copied; a longer one is read again into a buffer of
# the size asked for, a third time if the variable grew in between. Issue
# 2026-10-29-cyrius-pe-getenv-4096-cap.
fn _cmd_getenv_win(name) {
    alloc_init();
    var small[512];
    var n = syscall(0xF015, name, &small, 512);
    if (n <= 0) { return 0; }
    if (n < 512) {
        var v = alloc(n + 1);
        if (v == 0) { return 0; }
        memcpy(v, &small, n);
        store8(v + n, 0);
        return v;
    }
    var cap = n;
    var tries = 0;
    while (tries < 2) {
        var buf = alloc(cap);
        if (buf == 0) { return 0; }
        var got = syscall(0xF015, name, buf, cap);
        if (got <= 0) { return 0; }
        if (got < cap) {
            store8(buf + got, 0);
            return buf;
        }
        cap = got;
        tries = tries + 1;
    }
    return 0;
}
#endif

# --- Data directory (2.5.5) ---
# The directory data_file_path reads VERSION and data/*.json from, as the
# embedding program set it (data_dir_set), or 0.
var _cmd_data_dir = 0;

# Point data_file_path at directory `dir` (a cstr; 0 clears it). The CLI
# passes its --data-dir value here at startup. A library build never reads
# the process argv: through 2.5.4 data_file_path scanned it for --data-dir,
# and in a consumer binary that argv is the host's, whose own --data-dir flag
# (meaning something else there) silently moved load_cloud_instances and
# load_models to <its dir>/data/.
fn data_dir_set(dir) {
    _cmd_data_dir = dir;
    return 0;
}

# Scan argv for `--data-dir <path>`, returning the path cstr or 0.
#
# Self-contained (argv/argc/streq, no dependency on main.cyr's parser) so
# it works on PE: argv is populated from GetCommandLineW/CommandLineToArgvW
# (cyrius PE reroutes 0xF006/0xF010). Nothing calls it since 2.5.5: in a
# library build the argv it reads belongs to the host program. Removed in
# 2.6.0.
#deprecated("reads the host program's argv in a library build; the CLI hands --data-dir to data_dir_set")
fn cmd_data_dir_arg() {
    var n = argc();
    var i = 1;
    while (i < n) {
        var a = argv(i);
        if (a != 0) {
            if (streq(a, "--data-dir") == 1) {
                if (i + 1 < n) { return argv(i + 1); }
                return 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Resolve a data-file path. The binary reads VERSION (--version) and
# data/cloud_pricing.json (--cost) at runtime; invoked from outside the
# project root (e.g. a pip-installed wheel) those are not cwd-relative.
# Resolution precedence:
#   1. data_dir_set(<path>): the CLI's `--data-dir <path>` flag, on EVERY
#      platform including Windows PE, because argv is readable there. This
#      is the portable channel a consumer of the CLI (the Python _runner now,
#      agnos later) should use. A library consumer calls data_dir_set itself.
#   2. AI_HWACCEL_DATA_DIR env var — honoured on **every target** as of
#      2.3.21. It was a silent no-op on macOS and Windows through 2.3.21
#      because `cmd_getenv` read /proc/self/environ, which neither has; it
#      now delegates to the stdlib `getenv`. The flag still supersedes it
#      where both are present.
#   3. cwd-relative <rel> — the original fallback.
# See roadmap 2.3.3 (env var) and 2.3.12 (the --data-dir flag for PE).
fn data_file_path(rel) {
    var dir = _cmd_data_dir;
    if (dir == 0) { dir = cmd_getenv("AI_HWACCEL_DATA_DIR"); }
    if (dir == 0) { return rel; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_putc(sb, '/');
    str_builder_add_cstr(sb, rel);
    return str_data(str_builder_build(sb));
}

# 1 if the PATH entry `d` (a Str) is an absolute directory: "/..." on POSIX
# (`win` 0); on Windows (`win` 1) drive-rooted ("C:\..." or "C:/...") or UNC
# ("\\server\share"). Pure.
fn _which_dir_is_absolute(d, win) {
    var n = str_len(d);
    if (n == 0) { return 0; }
    var c0 = load8(str_data(d));
    if (win == 0) { return c0 == '/'; }
    if (n >= 3) {
        var c1 = load8(str_data(d) + 1);
        var c2 = load8(str_data(d) + 2);
        var letter = 0;
        if (c0 >= 'A' && c0 <= 'Z') { letter = 1; }
        if (c0 >= 'a' && c0 <= 'z') { letter = 1; }
        if (letter == 1 && c1 == ':' && (c2 == 92 || c2 == '/')) { return 1; }
    }
    if (n >= 2) {
        if (c0 == 92 && load8(str_data(d) + 1) == 92) { return 1; }
    }
    return 0;
}

# 1 if cstr `name` ends in ".exe", in any case. Pure.
fn _which_has_exe(name) {
    var n = strlen(name);
    if (n < 4) { return 0; }
    var i = 0;
    var ext = ".exe";
    while (i < 4) {
        var c = load8(name + n - 4 + i);
        if (c >= 'A' && c <= 'Z') { c = c + 32; }
        if (c != load8(ext + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The paths which() tries for tool `name` (a cstr) in the PATH value
# `path_val` (a cstr), in order, as a vec of cstrs (2.5.3). Pure.
#   - POSIX (`win` 0): PATH splits on ':', and a candidate is "<dir>/<name>".
#   - Windows (`win` 1): PATH splits on ';', a directory may be wrapped in
#     double quotes (they are dropped), and a candidate is "<dir>\<name>.exe"
#     (".exe" is not added twice).
# An empty or relative entry is skipped on both. POSIX reads an empty entry as
# the current directory, so a tool found through one is whatever file of that
# name the current directory holds. A Windows entry with a `"` left in it is
# skipped too: a path with a quote cannot be quoted on a command line
# (cmd_win_program_token). Through 2.5.2 which() split on ':' on every target,
# so on Windows no tool was ever found, and an empty POSIX entry became
# "/<name>".
fn which_candidates(path_val, name, win) {
    var out = vec_new();
    var sep = ':';
    var slash = '/';
    if (win == 1) {
        sep = ';';
        slash = 92;
    }
    var dirs = str_split(str_from(path_val), sep);
    var nd = vec_len(dirs);
    var di = 0;
    while (di < nd) {
        var dir = vec_get(dirs, di);
        di = di + 1;
        if (win == 1) {
            dir = str_trim(dir);
            var dl = str_len(dir);
            if (dl >= 2) {
                if (load8(str_data(dir)) == 34 && load8(str_data(dir) + dl - 1) == 34) {
                    dir = str_new(str_data(dir) + 1, dl - 2);
                }
            }
            if (str_index_of(dir, 34) >= 0) { continue; }
        }
        if (_which_dir_is_absolute(dir, win) == 0) { continue; }
        var sb = str_builder_new();
        str_builder_add(sb, dir);
        var last = load8(str_data(dir) + str_len(dir) - 1);
        var ends = 0;
        if (last == '/') { ends = 1; }
        if (win == 1 && last == 92) { ends = 1; }
        if (ends == 0) { str_builder_putc(sb, slash); }
        str_builder_add_cstr(sb, name);
        if (win == 1 && _which_has_exe(name) == 0) { str_builder_add_cstr(sb, ".exe"); }
        vec_push(out, str_cstr(str_builder_build(sb)));
    }
    return out;
}

# 1 if candidate `path` (a cstr) is a tool which() may return. POSIX: a
# regular file this process may execute, asked of stat(2) and access(X_OK)
# (2.5.5). Through 2.5.4 it was any path that opened read-only, so a
# directory or a file without the x bit earlier on PATH shadowed the real
# tool (it then failed with status 127), a tool this process may run but not
# read (another user's 0711) was never found, and a FIFO blocked the open,
# outside any deadline. stat opens nothing. Windows and AGNOS keep the open test: CreateFileW does not open a
# directory, and AGNOS has no access(2).
fn _which_runnable(path) {
    #ifdef CYRIUS_TARGET_WIN
    return file_exists(path);
    #endif
    #ifdef CYRIUS_TARGET_AGNOS
    return file_exists(path);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    var st[256];
    if (sys_stat(path, &st) != 0) { return 0; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x8000) { return 0; }   # S_IFREG
    if (sys_access(path, 1) != 0) { return 0; }                        # X_OK
    return 1;
    #endif
    #endif
}

# The first of which_candidates(`path_val`, `name`) that _which_runnable
# accepts, as a heap cstr, or 0. `path_val` is a PATH value (a cstr, or 0).
fn which_in(path_val, name) {
    if (path_val == 0) { return 0; }
    var win = 0;
    #ifdef CYRIUS_TARGET_WIN
    win = 1;
    #endif
    var cands = which_candidates(path_val, name, win);
    var n = vec_len(cands);
    var i = 0;
    while (i < n) {
        var c = vec_get(cands, i);
        if (_which_runnable(c) == 1) { return c; }
        i = i + 1;
    }
    return 0;
}

# Resolve tool name to an absolute path through $PATH (which_in). Returns a
# heap cstr, or 0 if not found.
fn which(name) {
    return which_in(cmd_getenv("PATH"), name);
}

# `path` as the first token of a Windows command line (2.5.3): wrapped in
# double quotes when it holds a blank, as "C:\Program Files\..." does.
# lib/process_win.cyr joins a command's arguments with spaces and quotes
# none of them. CreateProcessW reads an unquoted first token one blank at a
# time and starts the first prefix that exists: "C:\Program.exe", then
# "C:\Program Files\NVIDIA.exe", and so on, so a file planted at one of them
# runs instead of the tool. Measured on cass: with "...\dir with space\" first
# on PATH and a dir.exe planted next to it, the unquoted line ran dir.exe. A
# path from which() has no `"` in it. Pure.
fn cmd_win_program_token(path) {
    var n = strlen(path);
    var blank = 0;
    var i = 0;
    while (i < n) {
        var c = load8(path + i);
        if (c == ' ' || c == 9) { blank = 1; }
        i = i + 1;
    }
    if (blank == 0) { return path; }
    var q = alloc(n + 3);
    store8(q, 34);
    memcpy(q + 1, path, n);
    store8(q + n + 1, 34);
    store8(q + n + 2, 0);
    return q;
}

# The warning for a tool that ran and ended with exit status `code` (slot 0 of
# exec_capture_status's status) and signal flag `sig` (slot 1), or 0 when the
# status is not a failure (0) or not known (below 0; the deadline's -2 has its
# own warning). The message says "exited with status N", or "killed by signal
# N" (code 128 + N with the flag set); a Windows exit code past 255, such as
# 0xC0000005 for a crash, is shown in hex (2.5.4). Pure.
fn tool_exit_warning(tool, code, sig) {
    if (code <= 0) { return 0; }
    var sb = str_builder_new();
    if (sig == 1 && code > 128) {
        str_builder_add_cstr(sb, "killed by signal ");
        str_builder_add_int(sb, code - 128);
    } elif (code > 255) {
        str_builder_add_cstr(sb, "exited with status 0x");
        var digits = "0123456789ABCDEF";
        var shift = 28;
        var started = 0;
        while (shift >= 0) {
            var nib = (code >> shift) & 15;
            if (nib != 0 || started == 1 || shift == 0) {
                str_builder_putc(sb, load8(digits + nib));
                started = 1;
            }
            shift = shift - 4;
        }
    } else {
        str_builder_add_cstr(sb, "exited with status ");
        str_builder_add_int(sb, code);
    }
    return warning_tool_failed(tool, code, str_data(str_builder_build(sb)));
}

# The exit-status warning for a run that returned `out` with status `st`
# (exec_capture_status's two slots), or 0. A run whose output filled the
# buffer ends with the tool killed by SIGPIPE, which this side caused when it
# stopped reading; the cut is reported already, so the status is not.
fn tool_run_warning(tool, out, st) {
    if (out != 0) {
        if (str_len(out) >= CMD_MAX_STDOUT - 1) { return 0; }
    }
    return tool_exit_warning(tool, load64(st), load64(st + 8));
}

# run_tool without the exit-status check (2.5.4): the tool's status goes to
# `st_out` (exec_capture_status's two i64 slots, or 0), and a caller that
# asks for it decides what a non-zero one means. The other warnings are the
# same: not found, failed to start, the deadline, and output cut short.
fn run_tool_status(tool, args, warnings, st_out) {
    if (st_out != 0) {
        store64(st_out, 0 - 1);
        store64(st_out + 8, 0);
    }
    var abs_path = which(tool);
    if (abs_path == 0) {
        if (warnings != 0) { vec_push(warnings, warning_tool_not_found(tool)); }
        return 0;
    }

    # Build exec args vec
    var exec_args = vec_new();
    #ifdef CYRIUS_TARGET_WIN
    vec_push(exec_args, cmd_win_program_token(abs_path));
    #endif
    #ifndef CYRIUS_TARGET_WIN
    vec_push(exec_args, abs_path);
    #endif
    var ai = 0;
    var nargs = vec_len(args);
    while (ai < nargs) {
        vec_push(exec_args, vec_get(args, ai));
        ai = ai + 1;
    }

    # Capture stdout into a 1 MiB scratch buffer: fl_alloc maps a block this
    # size on its own, and fl_free unmaps it. One byte short of the buffer, so
    # the result's NUL always fits: through 2.5.0 a full read wrote it one byte
    # past. Through 2.5.4 the result pointed into a fresh alloc(CMD_MAX_STDOUT),
    # so every tool run kept 1 MiB for good, and each cached_get re-detection
    # grew a long-lived consumer by about that much per tool (2.5.5).
    var buf = fl_alloc(CMD_MAX_STDOUT);
    if (buf == 0) {
        if (warnings != 0) { vec_push(warnings, warning_tool_failed(tool, 0 - 1, "exec failed")); }
        return 0;
    }
    var st[16];
    var n = cmd_capture(exec_args, buf, CMD_MAX_STDOUT - 1, &st);
    if (st_out != 0) {
        store64(st_out, load64(&st));
        store64(st_out + 8, load64(&st + 8));
    }

    if (load64(&st) == 0 - 2) {
        fl_free(buf);
        if (warnings != 0) { vec_push(warnings, warning_timeout(tool, CMD_DEFAULT_TIMEOUT_MS)); }
        return 0;
    }
    if (n < 0) {
        fl_free(buf);
        if (warnings != 0) { vec_push(warnings, warning_tool_failed(tool, 0 - 1, "exec failed")); }
        return 0;
    }
    if (n >= CMD_MAX_STDOUT - 1) {
        if (warnings != 0) {
            vec_push(warnings, warning_parse(tool, "output filled the 1 MiB buffer and was cut short"));
        }
    }

    # Keep what the tool printed, NUL-terminated, in a buffer of its size.
    # Copied before the scratch goes back: parsers keep str_sub views of it.
    var out = str_from_buf(buf, n);
    fl_free(buf);
    return out;
}

# Run a tool with the args in vec `args` (cstrs). Returns Str with stdout, or
# 0 on error.
# Pushes a warning to the warnings vec on failure: not found, failed to run,
# killed at the deadline (warning_timeout), output that filled the buffer and
# was cut short (a parse warning; the truncated output is still returned), or
# a non-zero exit status (tool_exit_warning, 2.5.4; the output is still
# returned, so a detector parses whatever the tool printed). Through 2.5.3 the
# exit status was ignored, and a tool that failed with its error on stderr,
# which Linux and macOS do not capture, left no trace.
fn run_tool(tool, args, warnings) {
    var st[16];
    var out = run_tool_status(tool, args, warnings, &st);
    var w = tool_run_warning(tool, out, &st);
    if (w != 0 && warnings != 0) { vec_push(warnings, w); }
    return out;
}

# Convenience: run_tool with 1 to 3 cstr args
fn run_tool1(tool, arg1, warnings) {
    var args = vec_new();
    vec_push(args, arg1);
    return run_tool(tool, args, warnings);
}

fn run_tool2(tool, arg1, arg2, warnings) {
    var args = vec_new();
    vec_push(args, arg1);
    vec_push(args, arg2);
    return run_tool(tool, args, warnings);
}

fn run_tool3(tool, arg1, arg2, arg3, warnings) {
    var args = vec_new();
    vec_push(args, arg1);
    vec_push(args, arg2);
    vec_push(args, arg3);
    return run_tool(tool, args, warnings);
}

# --- CSV parsing helpers ---

# Split a line by commas into a vec of trimmed Str values.
# Returns vec, or 0 if fewer than min_fields.
fn parse_csv_line(line, min_fields) {
    var parts = str_split(line, 44);
    if (vec_len(parts) < min_fields) { return 0; }
    # Trim each field
    var trimmed = vec_new();
    var ci = 0;
    var nparts = vec_len(parts);
    while (ci < nparts) {
        vec_push(trimmed, str_trim(vec_get(parts, ci)));
        ci = ci + 1;
    }
    return trimmed;
}

# A "0x…" hex field (a Str, or 0) as an int, or -1: vulkaninfo's
# "vendorID = 0x8086", sysfs's "0x8086", nvidia-smi's "0x268410DE". Leading
# blanks and anything after the digits are ignored. At most 15 digits. Pure.
# (vulkan.cyr's _vk_hex until 2.4.0; CUDA needs it too, and cuda.cyr comes
# first.)
fn parse_hex_field(s) {
    if (s == 0) { return 0 - 1; }
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    if (i + 2 >= n) { return 0 - 1; }
    if (load8(d + i) != 48) { return 0 - 1; }
    var x = load8(d + i + 1);
    if (x != 120 && x != 88) { return 0 - 1; }
    i = i + 2;
    var v = 0;
    var digits = 0;
    while (i < n) {
        var h = load8(d + i);
        var dv = 0 - 1;
        if (h >= 48 && h <= 57) { dv = h - 48; }
        elif (h >= 97 && h <= 102) { dv = h - 87; }
        elif (h >= 65 && h <= 70) { dv = h - 55; }
        if (dv < 0) { break; }
        if (digits >= 15) { return 0 - 1; }
        v = v * 16 + dv;
        digits = digits + 1;
        i = i + 1;
    }
    if (digits == 0) { return 0 - 1; }
    return v;
}

# A field (a Str, already trimmed) that is all decimal digits, 1 to 18 of
# them, as an int; -1 otherwise: 0, "", "[N/A]", "1.5", "-3", 19+ digits.
# str_to_int skips non-digits, so it reads "[N/A]" as 0 and "1.5" as 15. Pure.
fn parse_field_int(field) {
    if (field == 0) { return 0 - 1; }
    var d = str_data(field);
    var n = str_len(field);
    if (n == 0 || n > 18) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 48 || c > 57) { return 0 - 1; }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    return v;
}

# Validate device ID is in sane range (0-1024). The field must be all digits
# (parse_field_int, 2.5.5): through 2.5.4 str_to_int read nvidia-smi's
# "[GPU is lost]" as device 0.
fn validate_device_id(raw_str) {
    var id = parse_field_int(raw_str);
    if (id < 0) { return 0 - 1; }
    if (id > CMD_MAX_DEVICE_ID) { return 0 - 1; }
    return id;
}

# Validate memory in MB (0 to 16 TiB). The field must be all digits, as for
# validate_device_id: "[N/A]" was 0 MB, "1.5" 15 MB, and 20 digits wrapped.
fn validate_memory_mb(raw_str) {
    var mb = parse_field_int(raw_str);
    if (mb < 0) { return 0 - 1; }
    if (mb > 16 * 1024 * 1024) { return 0 - 1; }
    return mb;
}

# --- cuda.cyr ---

# cuda.cyr — NVIDIA CUDA GPU detection via nvidia-smi

# nvidia-smi query args. pci.device_id (field 11, 2.4.0) is the PCI device and
# vendor ID, "0x268410DE"; profiles_dedup matches Vulkan's view of the same GPU
# on it. pci.bus_id (field 12, 2.5.5) is the PCI address, "00000000:3B:00.0",
# where enrich_pcie and enrich_numa read sysfs. Fields are read by position,
# so output without the trailing ones still parses.
var _NVSMI_QUERY = "--query-gpu=index,memory.total,memory.used,memory.free,compute_cap,driver_version,name,temperature.gpu,power.draw,utilization.gpu,clocks.max.memory,pci.device_id,pci.bus_id"; #skip-lint
# The same without compute_cap, which drivers before R510 (R470, the last
# with Kepler) reject, failing the whole query (2.5.5).
var _NVSMI_QUERY_NOCC = "--query-gpu=index,memory.total,memory.used,memory.free,driver_version,name,temperature.gpu,power.draw,utilization.gpu,clocks.max.memory,pci.device_id,pci.bus_id"; #skip-lint
var _NVSMI_FMT = "--format=csv,noheader,nounits";

# Memory bus width (bits) by compute capability: the width of the
# generation's flagship part, or 0 for a generation not listed, which leaves
# the bandwidth unknown. Through 2.5.4 an unlisted one got 256 bits, so a
# B200 (10.0) reported 256 GB/s of its 8 TB/s. Parts whose width differs from
# their generation's are in nvidia_bus_width_by_dev. Pure.
fn nvidia_bus_width(cc) {
    var cclen = str_len(cc);
    var ccd = str_data(cc);
    # 12.0 = RTX 5090 / RTX PRO 6000 Blackwell (512-bit GDDR7)
    if (cclen >= 4 && memeq(ccd, "12.0", 4) == 1) { return 512; }
    # 10.0 = B200/GB200, 10.3 = B300/GB300 (8192-bit HBM3e)
    if (cclen >= 4 && memeq(ccd, "10.0", 4) == 1) { return 8192; }
    if (cclen >= 4 && memeq(ccd, "10.3", 4) == 1) { return 8192; }
    # 9.0 = H100 (5120-bit HBM3)
    if (cclen >= 3 && memeq(ccd, "9.0", 3) == 1) { return 5120; }
    # 8.9 = RTX 4090 / L40S (384-bit)
    if (cclen >= 3 && memeq(ccd, "8.9", 3) == 1) { return 384; }
    # 8.6 = RTX 3090 / A40 (384-bit)
    if (cclen >= 3 && memeq(ccd, "8.6", 3) == 1) { return 384; }
    # 8.0 = A100 (5120-bit HBM2e)
    if (cclen >= 3 && memeq(ccd, "8.0", 3) == 1) { return 5120; }
    # 7.5 = T4/RTX 2080 (256-bit)
    if (cclen >= 3 && memeq(ccd, "7.5", 3) == 1) { return 256; }
    # 7.0 = V100 (4096-bit HBM2)
    if (cclen >= 3 && memeq(ccd, "7.0", 3) == 1) { return 4096; }
    # 6.0 = P100 (4096-bit HBM2)
    if (cclen >= 3 && memeq(ccd, "6.0", 3) == 1) { return 4096; }
    return 0;
}

# Memory bus width (bits) of the parts whose width is not their compute
# capability's (nvidia_bus_width), by PCI device ID, from NVIDIA's spec
# sheets; 0 for any other. One compute capability spans a 128-bit RTX 4060
# and a 384-bit RTX 4090. Pure.
fn nvidia_bus_width_by_dev(dev) {
    # 12.0 Blackwell
    if (dev == 0x2BB3) { return 384; }  # RTX PRO 5000 Blackwell
    if (dev == 0x2C02 || dev == 0x2C05) { return 256; }  # RTX 5080, 5070 Ti
    if (dev == 0x2C31 || dev == 0x2C3A) { return 256; }  # RTX PRO 4500 Blackwell
    if (dev == 0x2C34) { return 192; }  # RTX PRO 4000 Blackwell
    if (dev == 0x2F04) { return 192; }  # RTX 5070
    if (dev == 0x2D04 || dev == 0x2D05) { return 128; }  # RTX 5060 Ti, 5060
    if (dev == 0x2D30) { return 128; }  # RTX PRO 2000 Blackwell
    if (dev == 0x2D83) { return 128; }  # RTX 5050
    # 9.0 Hopper: six HBM stacks, not five
    if (dev == 0x2321 || dev == 0x233A) { return 6144; }  # H100 NVL, H800L
    if (dev == 0x2335 || dev == 0x233B) { return 6144; }  # H200 SXM, H200 NVL
    if (dev == 0x2338 || dev == 0x2339 || dev == 0x233D) { return 6144; }  # H100 94/96GB
    if (dev == 0x2342 || dev == 0x2348) { return 6144; }  # GH200, GH200 144G HBM3e
    if (dev == 0x2337) { return 4096; }  # H100 SXM5 64GB
    # 8.9 Ada
    if (dev == 0x2689) { return 256; }  # RTX 4070 Ti SUPER (AD102)
    if (dev == 0x26B2) { return 256; }  # RTX 5000 Ada
    if (dev >= 0x2702 && dev <= 0x2705) { return 256; }  # RTX 4080 (SUPER), 4070 Ti SUPER
    if (dev == 0x2709) { return 192; }  # RTX 4070 (AD103)
    if (dev == 0x2782 || dev == 0x2783 || dev == 0x2786) { return 192; }  # RTX 4070 (Ti, SUPER)
    if (dev == 0x27B1 || dev == 0x27B8) { return 192; }  # RTX 4500 Ada, L4
    if (dev == 0x27B0 || dev == 0x27B2) { return 160; }  # RTX 4000 (SFF) Ada
    if (dev == 0x2788 || dev == 0x2803 || dev == 0x2805) { return 128; }  # RTX 4060 Ti
    if (dev == 0x2808 || dev == 0x2882) { return 128; }  # RTX 4060
    if (dev == 0x28B0) { return 128; }  # RTX 2000 Ada
    # 8.6 Ampere
    if (dev == 0x2206 || dev == 0x2216) { return 320; }  # RTX 3080 10GB
    if (dev == 0x2207 || dev == 0x2414) { return 256; }  # RTX 3070 Ti (GA102), 3060 Ti (GA103)
    if (dev == 0x2482 || dev == 0x2484 || dev == 0x2486) { return 256; }  # RTX 3070 (Ti), 3060 Ti
    if (dev == 0x2488 || dev == 0x2489) { return 256; }  # RTX 3070, 3060 Ti (LHR)
    if (dev == 0x248C || dev == 0x248D || dev == 0x248E) { return 256; }  # RTX 3070 (Ti), 3060 Ti
    if (dev == 0x24B0 || dev == 0x24C8 || dev == 0x24C9) { return 256; }  # RTX A4000, 3070, 3060 Ti
    if (dev == 0x2487) { return 192; }  # RTX 3060 (GA104)
    if (dev == 0x2501 || dev == 0x2503 || dev == 0x2504) { return 192; }  # RTX 3060
    if (dev == 0x2509 || dev == 0x2544) { return 192; }  # RTX 3060
    if (dev == 0x24C7) { return 128; }  # RTX 3060 8GB
    if (dev == 0x2507 || dev == 0x2508 || dev == 0x2582) { return 128; }  # RTX 3050
    if (dev == 0x25B6) { return 128; }  # A2 / A16
    # 8.0 Ampere
    if (dev == 0x20B7 || dev == 0x20B9) { return 3072; }  # A30, A30X
    # 7.5 Turing
    if (dev == 0x1E02 || dev == 0x1E03) { return 384; }  # TITAN RTX, RTX 2080 Ti 12GB
    if (dev == 0x1E30 || dev == 0x1E36 || dev == 0x1E78) { return 384; }  # Quadro RTX 6000/8000
    if (dev == 0x1E04 || dev == 0x1E07) { return 352; }  # RTX 2080 Ti
    if (dev == 0x1E89 || dev == 0x1F03 || dev == 0x1F08) { return 192; }  # RTX 2060
    if (dev == 0x2182 || dev == 0x2184 || dev == 0x21C4) { return 192; }  # GTX 1660 (Ti, SUPER)
    if (dev == 0x1F0A || dev == 0x1F82 || dev == 0x2187 || dev == 0x2188) { return 128; }  # GTX 1650 (SUPER)
    # 7.0 Volta
    if (dev == 0x1D81) { return 3072; }  # TITAN V
    # 6.0 Pascal
    if (dev == 0x15F7) { return 3072; }  # P100 PCIe 12GB
    return 0;
}

# Estimate bandwidth from compute capability (GB/s * 1000)
fn nvidia_est_bw_x1000(cc) {
    var cclen = str_len(cc);
    var ccd = str_data(cc);
    if (cclen >= 4 && memeq(ccd, "12.0", 4) == 1) { return 1792000; }
    if (cclen >= 4 && memeq(ccd, "10.0", 4) == 1) { return 8000000; }
    if (cclen >= 4 && memeq(ccd, "10.3", 4) == 1) { return 8000000; }
    if (cclen >= 3 && memeq(ccd, "9.0", 3) == 1) { return 3350000; }
    if (cclen >= 3 && memeq(ccd, "8.9", 3) == 1) { return 1008000; }
    if (cclen >= 3 && memeq(ccd, "8.6", 3) == 1) { return 936000; }
    if (cclen >= 3 && memeq(ccd, "8.0", 3) == 1) { return 2039000; }
    if (cclen >= 3 && memeq(ccd, "7.5", 3) == 1) { return 320000; }
    if (cclen >= 3 && memeq(ccd, "7.0", 3) == 1) { return 900000; }
    return 0;
}

# 1 if nvidia-smi's memory.total field (a Str) says the GPU has no memory of
# its own: "[N/A]" or "[Not Supported]", as on the unified-memory GB10 (DGX
# Spark) and Jetson Thor. Other text ("[Unknown Error]") is a GPU nvidia-smi
# could not read. Pure.
fn cuda_mem_unified(f) {
    if (str_eq_cstr(f, "[N/A]") == 1) { return 1; }
    if (str_eq_cstr(f, "[Not Supported]") == 1) { return 1; }
    return 0;
}

# nvidia-smi's pci.bus_id (a Str, or 0), "00000000:3B:00.0", as the name
# sysfs gives the device, "0000:3b:00.0" (a fresh cstr): lower case, the
# domain cut to 4 digits but no fewer (a VMD domain is "10000"). 0 unless it
# is domain:bus:device.function in hex, so nothing else reaches a sysfs
# path. Pure.
fn nvsmi_bus_id_to_bdf(s) {
    if (s == 0) { return 0; }
    var d = str_data(s);
    var n = str_len(s);
    var colon = str_index_of(s, 58);
    if (colon < 4 || colon > 8) { return 0; }
    if (n - colon != 8) { return 0; }
    if (load8(d + colon + 3) != 58) { return 0; }
    if (load8(d + colon + 6) != 46) { return 0; }
    var skip = 0;
    while (colon - skip > 4) {
        if (load8(d + skip) != 48) { break; }
        skip = skip + 1;
    }
    var len = n - skip;
    var out = alloc(len + 1);
    var i = 0;
    while (i < len) {
        var k = skip + i;
        var c = load8(d + k);
        if (k != colon && k != colon + 3 && k != colon + 6) {
            if (c >= 65 && c <= 70) { c = c + 32; }
            var hex = 0;
            if (c >= 48 && c <= 57) { hex = 1; }
            if (c >= 97 && c <= 102) { hex = 1; }
            if (hex == 0) { return 0; }
        }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + len, 0);
    return out;
}

# `fields` with an empty Str at index 4, where the query without compute_cap
# leaves it out, so every later field keeps its position.
fn _cuda_insert_empty_cc(fields, empty) {
    var out = vec_new();
    var n = vec_len(fields);
    var i = 0;
    while (i < n) {
        if (i == 4) { vec_push(out, empty); }
        vec_push(out, vec_get(fields, i));
        i = i + 1;
    }
    return out;
}

# Parse nvidia-smi CSV output into profiles
fn parse_cuda_output(output, profiles, warnings) {
    return parse_cuda_output_cc(output, profiles, warnings, 1);
}

# parse_cuda_output for the output of _NVSMI_QUERY (`has_cc` 1) or of
# _NVSMI_QUERY_NOCC (0). `warnings` may be 0. A memory.total of "[N/A]"
# (cuda_mem_unified) gives a GPU with memory 0, which detect_cuda sizes from
# system RAM; any other memory.total that is not a MiB count above 0
# ("[Unknown Error]", "0") skips the line with a warning, where through 2.5.4
# it was a silent 0-byte GPU. Another numeric field that is not a number
# ("[N/A]") is unknown, and a real 0 is 0: str_to_int read "[N/A]" as 0,
# "64.67" W as 6467 W, and the parse took a 0 MiB used as unknown.
fn parse_cuda_output_cc(output, profiles, warnings, has_cc) {
    var lines = str_split(output, 10);
    var li = 0;
    var nlines = vec_len(lines);
    var empty = 0;
    if (has_cc == 0) { empty = str_from(""); }
    while (li < nlines) {
        var line = vec_get(lines, li);
        li = li + 1;
        if (str_len(line) == 0) { continue; }

        var fields = parse_csv_line(line, 6);
        if (fields == 0) {
            if (warnings != 0) { vec_push(warnings, warning_parse("cuda", "too few CSV fields")); }
            continue;
        }
        if (has_cc == 0) { fields = _cuda_insert_empty_cc(fields, empty); }

        var f_id = vec_get(fields, 0);
        var dev_id = validate_device_id(f_id);
        if (dev_id < 0) {
            if (warnings != 0) { vec_push(warnings, warning_parse("cuda", "bad device id")); }
            continue;
        }

        var f_mem = vec_get(fields, 1);
        var mem_mb = validate_memory_mb(f_mem);
        if (mem_mb <= 0) {
            if (cuda_mem_unified(f_mem) == 0) {
                if (warnings != 0) { vec_push(warnings, warning_parse("cuda", "bad memory")); }
                continue;
            }
            mem_mb = 0;
        }

        var mem_bytes = mem_mb * 1024 * 1024;
        var mem_used_mb = parse_field_int(vec_get(fields, 2));
        var mem_free_mb = parse_field_int(vec_get(fields, 3));

        var p = profile_cuda(dev_id, mem_bytes);

        # PCI device and vendor ID (field 11): "0x268410DE" is device 0x2684
        # of vendor 0x10DE.
        var dv_id = 0 - 1;
        if (vec_len(fields) > 11) { dv_id = parse_hex_field(vec_get(fields, 11)); }

        # Compute capability (field 4; empty from _NVSMI_QUERY_NOCC)
        var cc = vec_get(fields, 4);
        if (str_len(cc) > 0) { profile_set_compute_cap(p, str_cstr(cc)); }

        # Memory bandwidth from clocks.max.memory (field 10) and the bus
        # width, the device ID's where it is listed, else the compute
        # capability's: MHz * bits * 2 (DDR) / 8 = MB/s, GB/s x1000.
        var bw_bits = 0;
        if (dv_id > 0) { bw_bits = nvidia_bus_width_by_dev((dv_id >> 16) & 0xFFFF); }
        if (bw_bits == 0) { bw_bits = nvidia_bus_width(cc); }
        if (bw_bits > 0 && vec_len(fields) > 10) {
            var clock_mhz = parse_field_int(vec_get(fields, 10));
            if (clock_mhz > 0) { profile_set_mem_bw_x1000(p, clock_mhz * bw_bits * 2 / 8); }
        }
        # Fallback: estimate from CC
        if (profile_mem_bw_x1000(p) == PROFILE_NONE) {
            var est = nvidia_est_bw_x1000(cc);
            if (est > 0) { profile_set_mem_bw_x1000(p, est); }
        }

        # Driver version (field 5)
        if (vec_len(fields) > 5) {
            var dv = vec_get(fields, 5);
            if (str_len(dv) > 0) {
                profile_set_driver_version(p, str_cstr(dv));
            }
        }

        # GPU name (field 6)
        if (vec_len(fields) > 6) {
            var gn = vec_get(fields, 6);
            if (str_len(gn) > 0) {
                profile_set_device_name(p, str_cstr(gn));

                # Grace Hopper: add unified CPU+GPU memory. 80-160 GiB of HBM
                # covers the 96 GB HBM3 and 144 GB HBM3e parts (through 2.5.4
                # the bound was 100, which missed the second).
                if (str_contains_cstr(gn, "GH200") == 1) {
                    if (mem_bytes > 80 * BYTES_PER_GIB) {
                        if (mem_bytes < 160 * BYTES_PER_GIB) {
                            # Add 480 GB unified LPDDR5X. That part is the
                            # Grace CPU's memory, which the CPU profile also
                            # counts, so it is marked shared (2.3.28);
                            # detect_cuda caps it at system RAM.
                            profile_set_memory_bytes(p, mem_bytes + 480 * BYTES_PER_GIB);
                            profile_set_shared_mem(p, 480 * BYTES_PER_GIB);
                        }
                    }
                }
            }
        }

        # Memory usage
        if (mem_used_mb >= 0) { profile_set_mem_used(p, mem_used_mb * 1024 * 1024); }
        if (mem_free_mb >= 0) { profile_set_mem_free(p, mem_free_mb * 1024 * 1024); }

        # Temperature (field 7)
        if (vec_len(fields) > 7) {
            var tc = parse_field_int(vec_get(fields, 7));
            if (tc > 0) { profile_set_temp_c(p, tc); }
        }

        # Power (field 8): watts with two decimals, "64.67" -> 64670.
        if (vec_len(fields) > 8) {
            var pw = parse_decimal_x1000(vec_get(fields, 8));
            if (pw > 0) { profile_set_power_x1000(p, pw); }
        }

        # GPU utilization (field 9)
        if (vec_len(fields) > 9) {
            var gu = parse_field_int(vec_get(fields, 9));
            if (gu >= 0) { profile_set_gpu_util(p, gu); }
        }

        if (dv_id > 0) {
            profile_set_pci_id(p, pci_id_make(dv_id & 0xFFFF, (dv_id >> 16) & 0xFFFF));
        }

        # PCI address (field 12)
        if (vec_len(fields) > 12) {
            var bdf = nvsmi_bus_id_to_bdf(vec_get(fields, 12));
            if (bdf != 0) { profile_set_pci_bdf(p, bdf); }
        }

        vec_push(profiles, p);
    }
    return 0;
}

# 1 if nvidia-smi rejected the query itself rather than failed to run it:
# exit status 2, "a supplied argument or flag is invalid" (nvidia-smi(1)), or
# its 'Field "compute_cap" is not a valid field to query.' in `result` (a
# Str, or 0). Pure.
fn cuda_query_rejected(result, code) {
    if (code == 2) { return 1; }
    if (result == 0) { return 0; }
    return str_contains_cstr(result, "is not a valid field to query");
}

# Run nvidia-smi with `query`; its status goes to `st` (two i64 slots).
fn _nvsmi_run(query, warnings, st) {
    var args = vec_new();
    vec_push(args, query);
    vec_push(args, _NVSMI_FMT);
    return run_tool_status("nvidia-smi", args, warnings, st);
}

# Detect CUDA GPUs
# When nvidia-smi exits non-zero (2.5.4), its output is parsed all the same,
# so any rows it printed still count, but the parse warnings are dropped: its
# stdout is then its error text ("NVIDIA-SMI has failed because it couldn't
# communicate with the NVIDIA driver", exit 9, in a container without the
# driver), and the tool-failure warning says what happened. Through 2.5.3 that
# text became a "cuda: too few CSV fields" warning, logged on stderr at the
# default level. A driver that rejects the query (cuda_query_rejected: one
# before R510 knows no compute_cap) is asked again without compute_cap, and
# only the second run's failure is reported (2.5.5).
fn detect_cuda(profiles, warnings) {
    var first = vec_len(profiles);
    var st[16];
    var has_cc = 1;
    var result = _nvsmi_run(_NVSMI_QUERY, warnings, &st);
    var w = tool_run_warning("nvidia-smi", result, &st);
    if (w != 0 && cuda_query_rejected(result, load64(&st)) == 1) {
        result = _nvsmi_run(_NVSMI_QUERY_NOCC, warnings, &st);
        w = tool_run_warning("nvidia-smi", result, &st);
        has_cc = 0;
    }
    if (w != 0 && warnings != 0) { vec_push(warnings, w); }
    var failed = 0;
    if (w != 0) { failed = 1; }
    cuda_take_output_cc(result, failed, has_cc, profiles, warnings);
    # System RAM is read only for a GPU on it: unified memory, or a GH200.
    var k = first;
    while (k < vec_len(profiles)) {
        var p = vec_get(profiles, k);
        if (profile_memory_bytes(p) == 0 || profile_shared_mem(p) > 0) {
            cuda_size_unified(profiles, first, detect_system_memory_opts(0));
            break;
        }
        k = k + 1;
    }
    return 0;
}

# Parse nvidia-smi's output `result` (a Str, or 0) into profiles; after a run
# that failed (`failed` 1), without its parse warnings (see detect_cuda).
# Returns the number of profiles pushed. Pure.
fn cuda_take_output(result, failed, profiles, warnings) {
    return cuda_take_output_cc(result, failed, 1, profiles, warnings);
}

# cuda_take_output for the query with compute_cap (`has_cc` 1) or without it
# (0). Pure.
fn cuda_take_output_cc(result, failed, has_cc, profiles, warnings) {
    if (result == 0) { return 0; }
    var first = vec_len(profiles);
    var pw = warnings;
    if (failed == 1) { pw = vec_new(); }
    parse_cuda_output_cc(result, profiles, pw, has_cc);
    return vec_len(profiles) - first;
}

# Size the CUDA profiles from index `first` on from system RAM `ram` (bytes;
# nothing happens when it is not above 0): one with memory 0, whose
# memory.total nvidia-smi gave as "[N/A]" (a unified-memory part), gets all
# of it, all shared, as an integrated Vulkan GPU does; a GH200 whose Grace part
# (its shared part) passes `ram` has that part cut to it, so the CPU memory
# it shares is never more than the CPU profile holds. Through 2.5.4 a GB10
# came out as a GPU with 0 bytes. Pure.
fn cuda_size_unified(profiles, first, ram) {
    if (ram <= 0) { return 0; }
    var n = vec_len(profiles);
    var k = first;
    while (k < n) {
        var p = vec_get(profiles, k);
        k = k + 1;
        if (profile_accel_type(p) != ACCEL_CUDA) { continue; }
        var sh = profile_shared_mem(p);
        if (profile_memory_bytes(p) == 0) {
            profile_set_memory_bytes(p, ram);
            profile_set_shared_mem(p, ram);
        } elif (sh > ram) {
            profile_set_memory_bytes(p, profile_memory_bytes(p) - sh + ram);
            profile_set_shared_mem(p, ram);
        }
    }
    return 0;
}

# --- rocm.cyr ---

# rocm.cyr — AMD ROCm GPU detection via sysfs
#
# Each amdgpu DRM card is one profile, read from the card's own device
# directory (2.5.5): its PCI address (the device link), memory, sensors, and
# from the KFD topology node of the same PCI address its gfx target and
# memory bus width, which with pp_dpm_mclk give the memory bandwidth. Through
# 2.5.4 the bandwidth pass rebuilt "/sys/class/drm/card<device_id>" from the
# profile's ordinal, which names another card or none (simpledrm or a BMC
# holds card0 on many hosts), and the gfx target was the PCI revision byte.

fn detect_rocm(profiles, warnings) {
    return detect_rocm_at(profiles, "/sys/class/drm", "/sys/class/kfd/kfd/topology/nodes");
}

# --- Parsers ---

# The value of `key` (a cstr) in a KFD properties text `props` (a Str, or 0),
# one "key value" line each: "location_id 1024". -1 when the key is missing or
# its value is not a number. Pure.
fn kfd_prop(props, key) {
    if (props == 0) { return 0 - 1; }
    var d = str_data(props);
    var n = str_len(props);
    var kl = strlen(key);
    var i = 0;
    while (i < n) {
        if (i + kl < n) {
            if (memeq(d + i, key, kl) == 1) {
                if (load8(d + i + kl) == 32) {
                    return str_leading_uint(str_sub(props, i + kl + 1, n - i - kl - 1));
                }
            }
        }
        while (i < n) {
            if (load8(d + i) == 10) { break; }
            i = i + 1;
        }
        i = i + 1;
    }
    return 0 - 1;
}

# The `len` hex digits at `p` as an int, or -1 if one is not a hex digit.
fn _hex_digits(p, len) {
    var v = 0;
    var i = 0;
    while (i < len) {
        var h = load8(p + i);
        var dv = 0 - 1;
        if (h >= 48 && h <= 57) { dv = h - 48; }
        elif (h >= 97 && h <= 102) { dv = h - 87; }
        elif (h >= 65 && h <= 70) { dv = h - 55; }
        if (dv < 0) { return 0 - 1; }
        v = v * 16 + dv;
        i = i + 1;
    }
    return v;
}

# Split a sysfs PCI address (a Str), "0000:04:00.0", into KFD's domain and
# location_id ((bus << 8) | (device << 3) | function) in `out` (two i64
# slots). Returns 1, or 0 when it is not domain:bus:device.function. Pure.
fn pci_bdf_split(s, out) {
    if (s == 0) { return 0; }
    var d = str_data(s);
    var n = str_len(s);
    var c1 = str_index_of(s, 58);
    if (c1 < 1 || c1 > 8) { return 0; }
    if (n - c1 != 8) { return 0; }
    if (load8(d + c1 + 3) != 58) { return 0; }
    if (load8(d + c1 + 6) != 46) { return 0; }
    var dom = _hex_digits(d, c1);
    var bus = _hex_digits(d + c1 + 1, 2);
    var dev = _hex_digits(d + c1 + 4, 2);
    var func = _hex_digits(d + c1 + 7, 1);
    if (dom < 0 || bus < 0 || dev < 0 || func < 0) { return 0; }
    if (dev > 31 || func > 7) { return 0; }
    store64(out, dom);
    store64(out + 8, (bus << 8) | (dev << 3) | func);
    return 1;
}

# KFD's gfx_target_version (major * 10000 + minor * 100 + stepping) as the
# LLVM target name, a fresh cstr: 90012 -> "gfx90c", 110000 -> "gfx1100",
# 90402 -> "gfx942". 0 when it is not above 0 (a CPU node) or the minor or
# stepping passes one hex digit. Pure.
fn rocm_gfx_name(v) {
    if (v <= 0) { return 0; }
    var minor = (v / 100) % 100;
    var step = v % 100;
    if (minor > 15 || step > 15) { return 0; }
    var hex = "0123456789abcdef";
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "gfx");
    str_builder_add_int(sb, v / 10000);
    str_builder_putc(sb, load8(hex + minor));
    str_builder_putc(sb, load8(hex + step));
    return str_data(str_builder_build(sb));
}

# Highest clock (MHz) in amdgpu's pp_dpm_mclk text (a Str, or 0), one
# "<level>: <MHz>Mhz[ *]" line per DPM level: "2: 400Mhz \n3: 1600Mhz *" gives
# 1600. The number before ':' is the level index, which through 2.5.4 was read
# as the clock. 0 when no line has a clock. Pure.
fn amd_dpm_max_mhz(data) {
    if (data == 0) { return 0; }
    var lines = str_split(data, 10);
    var best = 0;
    var i = 0;
    while (i < vec_len(lines)) {
        var ln = vec_get(lines, i);
        i = i + 1;
        var colon = str_index_of(ln, 58);
        if (colon < 0) { continue; }
        var mhz = parse_value_with_suffix(str_sub(ln, colon + 1, str_len(ln) - colon - 1));
        if (mhz > best) { best = mhz; }
    }
    return best;
}

# Memory transfers per pp_dpm_mclk cycle for a gfx target (KFD's
# gfx_target_version), by the memory it ships with, or 0 when that is not
# known: 2 for HBM2/HBM2e (gfx900-gfx90a, gfx1011) and the DDR4 APUs (gfx902,
# gfx909, gfx90c; DDR4-3200 runs mclk 1600); 4 for HBM3 (gfx94x: MI300X
# 1300 MHz, 5.2 Gbps); 16 for GDDR6 (the RDNA dGPUs: RX 7900 XTX 1249 MHz,
# 20 Gbps). Not known: the later APUs (gfx1013, gfx1033, gfx1035, gfx1036,
# gfx1103, gfx115x), whose LPDDR5 clock this was not checked against, and
# gfx950. dGPU or APU per target is LLVM's AMDGPUUsage processor table. Pure.
fn amd_mem_rate(gfx) {
    var major = gfx / 10000;
    var minor = (gfx / 100) % 100;
    var step = gfx % 100;
    if (major == 9) {
        if (minor == 0) { return 2; }
        if (minor == 4) { return 4; }
        return 0;
    }
    if (major == 10 && minor == 1) {
        if (step == 1) { return 2; }
        if (step == 0 || step == 2) { return 16; }
        return 0;
    }
    if (major == 10 && minor == 3) {
        if (step <= 2 || step == 4) { return 16; }
        return 0;
    }
    if (major == 11 && minor == 0) {
        if (step <= 2) { return 16; }
        return 0;
    }
    if (major == 12 && minor == 0) { return 16; }
    return 0;
}

# Memory bandwidth (GB/s x1000, i.e. MB/s) from the top memory clock (MHz),
# the bus width (bits) and the transfers per clock (amd_mem_rate); 0 when one
# is unknown. Pure.
fn amd_mem_bw_x1000(mclk, width, rate) {
    if (mclk <= 0 || width <= 0 || rate <= 0) { return 0; }
    return mclk * width * rate / 8;
}

# --- KFD topology ---

# The GPU nodes under KFD topology root `root` (a cstr), five entries each:
# domain, location_id, device_id, gfx_target_version, and the bus width of
# its first memory bank. CPU nodes (gfx_target_version 0) are left out.
fn _kfd_gpu_nodes(root) {
    var out = vec_new();
    var entries = sysfs_list_dir(root);
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        i = i + 1;
        var props = sysfs_read(sysfs_path_str(root, e, "properties"));
        var gfx = kfd_prop(props, "gfx_target_version");
        if (gfx <= 0) { continue; }
        vec_push(out, kfd_prop(props, "domain"));
        vec_push(out, kfd_prop(props, "location_id"));
        vec_push(out, kfd_prop(props, "device_id"));
        vec_push(out, gfx);
        var bank = sysfs_read(sysfs_path_str(root, e, "mem_banks/0/properties"));
        vec_push(out, kfd_prop(bank, "width"));
    }
    return out;
}

# The index (a multiple of 5) in `nodes` (_kfd_gpu_nodes) of the node at PCI
# `domain` and `location`, or else of the first with PCI device ID `device`
# (a partition of a GPU can carry another location_id; the gfx target and bus
# width are the ASIC's), or -1. Pure.
fn kfd_node_for(nodes, domain, location, device) {
    var by_dev = 0 - 1;
    var n = vec_len(nodes);
    var k = 0;
    while (k + 4 < n) {
        if (domain >= 0 && vec_get(nodes, k) == domain && vec_get(nodes, k + 1) == location) { return k; }
        if (by_dev < 0 && device >= 0 && vec_get(nodes, k + 2) == device) { by_dev = k; }
        k = k + 5;
    }
    return by_dev;
}

# --- Detection ---

# detect_rocm over DRM root `drm` and KFD topology root `kfd` (cstrs), which a
# test points at a fake tree.
fn detect_rocm_at(profiles, drm, kfd) {
    var entries = sysfs_list_dir(drm);
    var nent = vec_len(entries);
    var dev_id = 0;
    var nodes = 0;
    var loc[16];

    var ei = 0;
    while (ei < nent) {
        var name = vec_get(entries, ei);
        ei = ei + 1;

        # Must start with "card" and not contain '-' (skip card0-DP-1 etc.)
        if (str_starts_with(name, "card") != 1) { continue; }
        if (str_index_of(name, 45) >= 0) { continue; }

        # The card's device directory; its driver must be amdgpu exactly.
        var dev = sysfs_path_str(drm, name, "device");
        var driver_link = read_symlink(sysfs_path(dev, 0, "driver"));
        if (driver_link == 0) { continue; }
        if (str_eq_cstr(path_basename(driver_link), "amdgpu") != 1) { continue; }

        # Read VRAM total
        var mem_total = sysfs_read_int(sysfs_path(dev, 0, "mem_info_vram_total"));
        if (mem_total <= 0) { mem_total = 8 * BYTES_PER_GIB; }

        # Read VRAM used
        var mem_used = sysfs_read_int(sysfs_path(dev, 0, "mem_info_vram_used"));

        var p = profile_rocm(dev_id, mem_total);
        var vendor_s = sysfs_read(sysfs_path(dev, 0, "vendor"));
        var device_s = sysfs_read(sysfs_path(dev, 0, "device"));
        var device = parse_hex_field(device_s);
        profile_set_pci_id(p, pci_id_make(parse_hex_field(vendor_s), device));

        # PCI address: the device link's target, "../../../0000:04:00.0".
        store64(&loc, 0 - 1);
        store64(&loc + 8, 0 - 1);
        var dlink = read_symlink(dev);
        if (dlink != 0) {
            var slot = path_basename(dlink);
            if (pci_bdf_split(slot, &loc) == 1) { profile_set_pci_bdf(p, str_cstr(slot)); }
        }

        # Device name: prefer the kernel-exposed product_name (newer
        # amdgpu drivers populate it for discrete cards); otherwise
        # build a synthesized "AMD Radeon (PCI vendor:device)" string
        # from the sysfs vendor + device files, which always exist.
        # Worst case (both missing) we fall through to "AMD Radeon".
        # This closes the 2.2.5 gap where ROCm GPUs reported a null
        # device name (mihi 0.4.0 smoke showed "(unnamed)").
        var prod = sysfs_read(sysfs_path(dev, 0, "product_name"));
        if (prod != 0 && str_len(prod) > 0) {
            profile_set_device_name(p, str_cstr(prod));
        } else {
            if (vendor_s != 0 && device_s != 0) {
                # Build "AMD Radeon (PCI 0x1002:0x1638)" — vendor + device
                # files come prefixed with "0x" already.
                var sb = str_builder_new();
                str_builder_add_cstr(sb, "AMD Radeon (PCI ");
                str_builder_add(sb, vendor_s);
                str_builder_add_cstr(sb, ":");
                str_builder_add(sb, device_s);
                str_builder_add_cstr(sb, ")");
                var nm = str_builder_build(sb);
                profile_set_device_name(p, str_data(nm));
            } else {
                profile_set_device_name(p, "AMD Radeon");
            }
        }

        if (mem_used > 0) {
            if (mem_used > mem_total) { mem_used = mem_total; }
            profile_set_mem_used(p, mem_used);
            profile_set_mem_free(p, mem_total - mem_used);
        }

        # Temperature from hwmon (millidegrees C)
        var hwmon_base = sysfs_path(dev, 0, "hwmon");
        var hwmon_entries = sysfs_list_dir(hwmon_base);
        if (vec_len(hwmon_entries) > 0) {
            var hw_name = vec_get(hwmon_entries, 0);
            var millideg = sysfs_read_int(sysfs_path_str(hwmon_base, hw_name, "temp1_input"));
            if (millideg > 0) { profile_set_temp_c(p, millideg / 1000); }

            # Power (microwatts)
            var microwatts = sysfs_read_int(sysfs_path_str(hwmon_base, hw_name, "power1_average"));
            if (microwatts <= 0) {
                microwatts = sysfs_read_int(sysfs_path_str(hwmon_base, hw_name, "power1_input"));
            }
            if (microwatts > 0) { profile_set_power_x1000(p, microwatts / 1000); }
        }

        # GPU busy percent
        var gpu_busy = sysfs_read_int(sysfs_path(dev, 0, "gpu_busy_percent"));
        if (gpu_busy >= 0) { profile_set_gpu_util(p, gpu_busy); }

        # VBIOS version as driver_version
        var vbios = sysfs_read(sysfs_path(dev, 0, "vbios_version"));
        if (vbios != 0) {
            if (str_len(vbios) > 0) {
                profile_set_driver_version(p, str_cstr(vbios));
            }
        }

        # The KFD node of this card (read once, at the first card): its gfx
        # target is the compute capability, and with its bus width and the
        # top memory clock it gives the memory bandwidth.
        if (nodes == 0) { nodes = _kfd_gpu_nodes(kfd); }
        var k = kfd_node_for(nodes, load64(&loc), load64(&loc + 8), device);
        if (k >= 0) {
            var gfx = vec_get(nodes, k + 3);
            var cc = rocm_gfx_name(gfx);
            if (cc != 0) { profile_set_compute_cap(p, cc); }
            var mclk = amd_dpm_max_mhz(sysfs_read(sysfs_path(dev, 0, "pp_dpm_mclk")));
            var bw = amd_mem_bw_x1000(mclk, vec_get(nodes, k + 4), amd_mem_rate(gfx));
            if (bw > 0) { profile_set_mem_bw_x1000(p, bw); }
        }

        vec_push(profiles, p);
        dev_id = dev_id + 1;
    }
    return 0;
}

# --- tpu.cyr ---

# tpu.cyr — Google TPU detection via sysfs, and the DRM accel class walk

# --- DRM accel class ---
#
# /sys/class/accel is the kernel's DRM compute-accel class (drivers/accel,
# Linux 6.2+), shared by every driver there: intel_vpu (the Core Ultra NPU),
# amdxdna (Ryzen AI), habanalabs (Gaudi), qaic (Cloud AI 100), ethosu and
# rocket (Arm Ethos-U, Rockchip). Through 2.5.4 detect_tpu took every node but
# amdxdna's as a 32 GiB "Google TPU v4", which outranked a real GPU in
# best_available and gained a 192 GB/s ICI link, and detect_intel_npu looked
# for /sys/class/misc/intel_npu, which intel_vpu never creates. Each node now
# goes to the backend its driver belongs to. The helpers live here because
# tpu.cyr comes first of the accel-class detectors in every include list.

enum AccelPciVendor {
    PCI_VENDOR_GOOGLE = 0x1ae0;
}

# The backend an accel node belongs to, from the basename of its
# device/driver link (a Str, or 0 when the link cannot be read) and its PCI
# vendor ID (-1 when device/vendor cannot be read). A known driver names its
# backend; ethosu and rocket have none (-1). An unknown driver is a TPU
# candidate unless a PCI vendor other than Google's (0x1ae0) says otherwise.
# Pure.
fn accel_driver_backend(drv, vendor) {
    if (drv != 0) {
        if (str_eq_cstr(drv, "intel_vpu") == 1) { return BACKEND_INTEL_NPU; }
        if (str_eq_cstr(drv, "amdxdna") == 1) { return BACKEND_AMD_XDNA; }
        if (str_eq_cstr(drv, "habanalabs") == 1) { return BACKEND_GAUDI; }
        if (str_eq_cstr(drv, "qaic") == 1) { return BACKEND_QUALCOMM; }
        if (str_eq_cstr(drv, "ethosu") == 1) { return 0 - 1; }
        if (str_eq_cstr(drv, "rocket") == 1) { return 0 - 1; }
    }
    if (vendor >= 0 && vendor != PCI_VENDOR_GOOGLE) { return 0 - 1; }
    return BACKEND_TPU;
}

# N of an accel class node named "accelN" (a Str), or -1 for any other name
# or an N past CMD_MAX_DEVICE_ID. Pure.
fn accel_node_index(name) {
    var n = str_len(name);
    if (n <= 5) { return 0 - 1; }
    if (memeq(str_data(name), "accel", 5) != 1) { return 0 - 1; }
    var id = parse_field_int(str_sub(name, 5, n - 5));
    if (id > CMD_MAX_DEVICE_ID) { return 0 - 1; }
    return id;
}

# accel_driver_backend for node `name` (a Str) of the accel class at `root`
# (a cstr). The PCI vendor is read only for a driver it does not know.
fn accel_node_backend(root, name) {
    var drv = 0;
    var link = read_symlink(sysfs_path_str(root, name, "device/driver"));
    if (link != 0) { drv = path_basename(link); }
    var b = accel_driver_backend(drv, 0 - 1);
    if (b == BACKEND_TPU) {
        var vs = sysfs_read(sysfs_path_str(root, name, "device/vendor"));
        if (vs != 0) { b = accel_driver_backend(drv, parse_hex_field(vs)); }
    }
    return b;
}

# The accelN nodes (their names, as Strs) of the accel class at `root` (a
# cstr: "/sys/class/accel", or a test's fake tree) that belong to `backend`,
# in directory order. Every accel-class detector walks it through here.
fn accel_class_nodes(root, backend) {
    var out = vec_new();
    var entries = sysfs_list_dir(root);
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var name = vec_get(entries, i);
        i = i + 1;
        if (accel_node_index(name) < 0) { continue; }
        if (accel_node_backend(root, name) == backend) { vec_push(out, name); }
    }
    return out;
}

# --- Google TPU ---

# TPU version from a Google PCI device ID, as Google's tpu-info maps them
# (0x005e v4, 0x0063 v5e, 0x0062 v5p), or -1 for any other ID. From the
# tool's source, not a capture. Pure.
fn tpu_version_from_pci_device(dev) {
    if (dev == 0x005e) { return TPU_V4; }
    if (dev == 0x0063) { return TPU_V5E; }
    if (dev == 0x0062) { return TPU_V5P; }
    return 0 - 1;
}

fn detect_tpu(profiles, warnings) {
    return detect_tpu_at("/sys/class/accel", profiles, warnings);
}

# detect_tpu over the accel class at `root` (a cstr). The version comes from
# the PCI device ID, then a tpu_version file, else v4; chip_count defaults to
# 1, and so does one past CMD_MAX_DEVICE_ID.
fn detect_tpu_at(root, profiles, warnings) {
    var nodes = accel_class_nodes(root, BACKEND_TPU);
    var nn = vec_len(nodes);
    var ni = 0;
    while (ni < nn) {
        var name = vec_get(nodes, ni);
        ni = ni + 1;
        var dev_id = accel_node_index(name);

        var pci_dev = parse_hex_field(sysfs_read(sysfs_path_str(root, name, "device/device")));
        var version = tpu_version_from_pci_device(pci_dev);
        if (version < 0) {
            version = TPU_V4;
            var ver_str = sysfs_read(sysfs_path_str(root, name, "device/tpu_version"));
            if (ver_str != 0) {
                if (str_contains_cstr(ver_str, "v5p") == 1) { version = TPU_V5P; }
                elif (str_contains_cstr(ver_str, "v5e") == 1) { version = TPU_V5E; }
                elif (str_contains_cstr(ver_str, "v5litepod") == 1) { version = TPU_V5E; }
            }
        }

        var chip_count = str_leading_uint(sysfs_read(sysfs_path_str(root, name, "device/chip_count")));
        if (chip_count <= 0 || chip_count > CMD_MAX_DEVICE_ID) { chip_count = 1; }

        var p = profile_tpu(dev_id, chip_count, version);
        # Device name: "Google TPU v4" / "v5e" / "v5p" via the
        # version-enum → string helper. 2.2.5 left this null.
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "Google TPU ");
        str_builder_add_cstr(sb, tpu_version_name(version));
        var tnm = str_builder_build(sb);
        profile_set_device_name(p, str_data(tnm));
        vec_push(profiles, p);
    }
    return 0;
}

# --- gaudi.cyr ---

# gaudi.cyr — Intel Gaudi (Habana Labs) detection via hl-smi

var _HLSMI_QUERY = "--query-aip=index,name,memory.total,memory.free";
var _HLSMI_FMT = "--format=csv,noheader,nounits";

# Gaudi generation from a board name: hl-smi's `name` field (HL-225 is the
# Gaudi2 OAM; HL-325L, HL-338, HL-328 and HL-388 are Gaudi3 OAM and PCIe
# boards) or the habanalabs device_type ("GAUDI2"). Every HL-3xx board is a
# Gaudi3; through 2.5.4 only HL-325 was, so the HL-338 PCIe card ranked and
# estimated as a Gaudi2. Anything else is a Gaudi2, the default (the enum has
# no Gaudi1, so the HL-205 is one too). Pure.
fn gaudi_gen_from_name(name) {
    if (str_contains_cstr(name, "HL-3") == 1) { return GAUDI3; }
    if (str_contains_cstr(name, "hl-3") == 1) { return GAUDI3; }
    if (str_contains_cstr(name, "Gaudi3") == 1) { return GAUDI3; }
    if (str_contains_cstr(name, "gaudi3") == 1) { return GAUDI3; }
    if (str_contains_cstr(name, "GAUDI3") == 1) { return GAUDI3; }
    return GAUDI2;
}

fn _gaudi_name_profile(p, gen) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Intel ");
    str_builder_add_cstr(sb, gaudi_gen_name(gen));
    profile_set_device_name(p, str_data(str_builder_build(sb)));
    return 0;
}

# Parse `hl-smi --query-aip=index,name,memory.total,memory.free
# --format=csv,noheader,nounits` output into ACCEL_GAUDI profiles. The index
# must be all digits, at most CMD_MAX_DEVICE_ID, or the row is skipped with a
# parse warning; memory.total is MiB, and a value that is not a number or is
# past 16 TiB takes the generation's HBM size (the second with a warning).
# Through 2.5.4 both went through str_to_int unchecked, and a garbled memory
# field wrapped to a negative size. Returns the number of profiles pushed.
# Pure.
fn parse_hl_smi_output(out, profiles, warnings) {
    var lines = str_split(out, 10);
    var nlines = vec_len(lines);
    var count = 0;
    var li = 0;
    while (li < nlines) {
        var line = str_trim(vec_get(lines, li));
        li = li + 1;
        if (str_len(line) == 0) { continue; }

        var fields = parse_csv_line(line, 3);
        if (fields == 0) {
            if (warnings != 0) { vec_push(warnings, warning_parse("gaudi", "too few CSV fields")); }
            continue;
        }

        var dev_id = parse_field_int(vec_get(fields, 0));
        if (dev_id < 0 || dev_id > CMD_MAX_DEVICE_ID) {
            if (warnings != 0) { vec_push(warnings, warning_parse("gaudi", "bad device index")); }
            continue;
        }

        var name_field = vec_get(fields, 1);
        var gen = gaudi_gen_from_name(name_field);
        var p = profile_gaudi(dev_id, gen);

        var mem_mb = parse_field_int(vec_get(fields, 2));
        if (mem_mb > 16 * 1024 * 1024) {
            if (warnings != 0) { vec_push(warnings, warning_parse("gaudi", "memory.total past 16 TiB")); }
            mem_mb = 0;
        }
        if (mem_mb > 0) { profile_set_memory_bytes(p, mem_mb * 1024 * 1024); }

        # Device name: the hl-smi `name` field ("HL-225") when present, else
        # "Intel Gaudi2" / "Intel Gaudi3". str_cstr copies the str_split slice
        # out as an owned, NUL-terminated buffer.
        if (str_len(name_field) > 0) {
            profile_set_device_name(p, str_cstr(name_field));
        } else {
            _gaudi_name_profile(p, gen);
        }

        vec_push(profiles, p);
        count = count + 1;
    }
    return count;
}

# Gaudi cards from the habanalabs nodes of the accel class at `root` (a cstr;
# see tpu.cyr), for when hl-smi lists none: the generation from the driver's
# device_type attribute, the memory from the generation. Returns the number
# pushed.
fn detect_gaudi_accel_at(root, profiles) {
    var nodes = accel_class_nodes(root, BACKEND_GAUDI);
    var n = vec_len(nodes);
    var i = 0;
    while (i < n) {
        var name = vec_get(nodes, i);
        i = i + 1;
        var gen = GAUDI2;
        var dt = sysfs_read(sysfs_path_str(root, name, "device/device_type"));
        if (dt != 0) { gen = gaudi_gen_from_name(dt); }
        var p = profile_gaudi(accel_node_index(name), gen);
        _gaudi_name_profile(p, gen);
        vec_push(profiles, p);
    }
    return n;
}

# Detect Gaudi cards through hl-smi, with `allow_exec` 1. A run that exits
# non-zero is reported once, by its exit-status warning, and its output is
# parsed without the parse warnings its error text would add (as detect_cuda
# does). When hl-smi lists no card (missing, failed, or a container without
# it), or with `allow_exec` 0, the habanalabs accel nodes are read instead
# (2.5.5; through 2.5.4 they became TPUs, and no-exec mode skipped Gaudi).
fn detect_gaudi_opts(profiles, warnings, allow_exec) {
    if (allow_exec == 1) {
        var args = vec_new();
        vec_push(args, _HLSMI_QUERY);
        vec_push(args, _HLSMI_FMT);
        var st[16];
        var result = run_tool_status("hl-smi", args, warnings, &st);
        var w = tool_run_warning("hl-smi", result, &st);
        if (w != 0 && warnings != 0) { vec_push(warnings, w); }
        if (result != 0) {
            var pw = warnings;
            if (w != 0) { pw = vec_new(); }
            if (parse_hl_smi_output(result, profiles, pw) > 0) { return 0; }
        }
    }
    detect_gaudi_accel_at("/sys/class/accel", profiles);
    return 0;
}

# detect_gaudi_opts with exec allowed.
fn detect_gaudi(profiles, warnings) {
    return detect_gaudi_opts(profiles, warnings, 1);
}

# --- neuron.cyr ---

# neuron.cyr — AWS Inferentia/Trainium detection via neuron-ls + sysfs fallback

# Chip from the DMI product name ("trn1.32xlarge"), else Inferentia.
fn _neuron_dmi_chip() {
    var dmi = sysfs_read("/sys/devices/virtual/dmi/id/product_name");
    if (dmi != 0) {
        if (str_contains_cstr(dmi, "trn") == 1) { return NEURON_TRAINIUM; }
        if (str_contains_cstr(dmi, "Trn") == 1) { return NEURON_TRAINIUM; }
    }
    return NEURON_INFERENTIA;
}

# A Neuron profile named "AWS Inferentia" / "AWS Trainium".
fn _neuron_profile(dev_id, chip, cores) {
    var p = profile_neuron(dev_id, chip, cores);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "AWS ");
    str_builder_add_cstr(sb, neuron_chip_name(chip));
    profile_set_device_name(p, str_data(str_builder_build(sb)));
    return p;
}

# neuron-ls first, with `allow_exec` 1; when it lists no device (missing,
# failed, or output this parser does not read), or with `allow_exec` 0,
# /dev/neuronN, two cores each, the chip from DMI. A run that exits non-zero
# is reported once, by its exit-status warning (as detect_cuda does).
# Through 2.5.4 any output over 2 bytes ended detection there, so a host
# whose neuron-ls printed nothing usable reported no device, and no-exec mode
# skipped Neuron.
fn detect_neuron_opts(profiles, warnings, allow_exec) {
    var chip = 0 - 1;
    if (allow_exec == 1) {
        var args = vec_new();
        vec_push(args, "--json-output");
        var st[16];
        var result = run_tool_status("neuron-ls", args, warnings, &st);
        var w = tool_run_warning("neuron-ls", result, &st);
        if (w != 0 && warnings != 0) { vec_push(warnings, w); }
        if (result != 0) {
            if (str_len(result) > 0) {
                chip = _neuron_dmi_chip();
                var pw = warnings;
                if (w != 0) { pw = vec_new(); }
                if (parse_neuron_ls_json(result, chip, profiles, pw) > 0) { return 0; }
            }
        }
    }

    var ids = scan_dev_devices("neuron");
    var nids = vec_len(ids);
    if (nids == 0) { return 0; }
    if (chip < 0) { chip = _neuron_dmi_chip(); }
    var ni = 0;
    while (ni < nids) {
        vec_push(profiles, _neuron_profile(vec_get(ids, ni), chip, 2));
        ni = ni + 1;
    }
    return 0;
}

# detect_neuron_opts with exec allowed.
fn detect_neuron(profiles, warnings) {
    return detect_neuron_opts(profiles, warnings, 1);
}

# --- neuron-ls --json-output ---
#
# AWS documents the output as an array of one object per device, with
# neuron_device (its index), bdf, connected_to, nc_count (its NeuronCores),
# memory_size (its memory, in bytes) and neuron_processes, a list of objects
# whose `command` is free text. Nothing in it names the chip, so that comes
# from DMI; a "model" member, if one is there, still names it. Through 2.5.4
# the parser keyed on "model", which that output does not have, read nc_count
# only within 200 bytes of it, ignored memory_size, and numbered devices by
# the length of the caller's vec (so after the CPU and any GPU). Members are
# now read at each device object's own level. From the AWS docs, not a
# capture.

# Index past blanks (space, tab, CR, LF) from d[i], at most `end`. Pure.
fn _nj_skip_ws(d, i, end) {
    while (i < end) {
        var c = load8(d + i);
        if (c != 32 && c != 9 && c != 10 && c != 13) { return i; }
        i = i + 1;
    }
    return end;
}

# Index past the JSON string whose opening quote is d[i], escapes honoured;
# `end` when it is unterminated. Pure.
fn _nj_skip_string(d, i, end) {
    i = i + 1;
    while (i < end) {
        var c = load8(d + i);
        if (c == 92) {
            i = i + 2;
            continue;
        }
        if (c == 34) { return i + 1; }
        i = i + 1;
    }
    return end;
}

# Index past the JSON value at d[i]: a string, a balanced {...} or [...]
# (strings inside skipped), or a scalar up to ',', '}' or ']'. Pure.
fn _nj_skip_value(d, i, end) {
    if (i >= end) { return end; }
    var c = load8(d + i);
    if (c == 34) { return _nj_skip_string(d, i, end); }
    if (c == 123 || c == 91) {
        var depth = 0;
        while (i < end) {
            var b = load8(d + i);
            if (b == 34) {
                i = _nj_skip_string(d, i, end);
                continue;
            }
            if (b == 123 || b == 91) { depth = depth + 1; }
            elif (b == 125 || b == 93) {
                depth = depth - 1;
                if (depth == 0) { return i + 1; }
            }
            i = i + 1;
        }
        return end;
    }
    while (i < end) {
        var s = load8(d + i);
        if (s == 44 || s == 125 || s == 93) { return i; }
        i = i + 1;
    }
    return end;
}

# Where the value of member `key` (a cstr, unquoted) of the object d[s..e)
# starts, at the object's own level (not inside a nested value), or -1. Pure.
fn _nj_member(d, s, e, key) {
    var klen = strlen(key);
    var i = s + 1;
    while (i < e) {
        i = _nj_skip_ws(d, i, e);
        if (i >= e) { return 0 - 1; }
        var c = load8(d + i);
        if (c == 125) { return 0 - 1; }
        if (c == 44) {
            i = i + 1;
            continue;
        }
        if (c != 34) { return 0 - 1; }
        var ks = i + 1;
        var ke = _nj_skip_string(d, i, e);
        i = _nj_skip_ws(d, ke, e);
        if (i >= e) { return 0 - 1; }
        if (load8(d + i) != 58) { return 0 - 1; }
        var vs = _nj_skip_ws(d, i + 1, e);
        if (ke - 1 - ks == klen && memeq(d + ks, key, klen) == 1) { return vs; }
        var ve = _nj_skip_value(d, vs, e);
        if (ve <= vs) { ve = vs + 1; }
        i = ve;
    }
    return 0 - 1;
}

# The unsigned integer at d[i] (1 to 18 digits, up to the first non-digit),
# or -1: none there ("null", a string), or `i` is -1. Pure.
fn _nj_uint(d, i, e) {
    if (i < 0) { return 0 - 1; }
    var v = 0;
    var nd = 0;
    while (i < e) {
        var c = load8(d + i);
        if (c < 48 || c > 57) { break; }
        if (nd >= 18) { return 0 - 1; }
        v = v * 10 + c - 48;
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) { return 0 - 1; }
    return v;
}

# The chip a "model" string at d[i] names ("trn1", "inf2"), else `dflt`
# (also when `i` is -1 or not a string). Pure.
fn _nj_model_chip(d, i, e, dflt) {
    if (i < 0 || i >= e) { return dflt; }
    if (load8(d + i) != 34) { return dflt; }
    var j = _nj_skip_string(d, i, e);
    var k = i;
    while (k + 3 <= j) {
        if (memeq(d + k, "trn", 3) == 1 || memeq(d + k, "Trn", 3) == 1) { return NEURON_TRAINIUM; }
        if (memeq(d + k, "inf", 3) == 1 || memeq(d + k, "Inf", 3) == 1) { return NEURON_INFERENTIA; }
        k = k + 1;
    }
    return dflt;
}

# Push the device the object d[s..e) describes, the `index`th of the array.
# An object with neither neuron_device nor nc_count is not a device (0). The
# id is neuron_device, else `index`; an nc_count that is missing or past 128
# is taken as 2, with a parse warning, so the device is still listed. Memory
# is memory_size, else memory_per_nc_mb per core, else the chip's per-core
# HBM; a figure past 16 TiB is not used. Returns 1 when it pushed one.
fn _neuron_json_device(d, s, e, index, chip, profiles, warnings) {
    var id_at = _nj_member(d, s, e, "neuron_device");
    var nc_at = _nj_member(d, s, e, "nc_count");
    if (id_at < 0 && nc_at < 0) { return 0; }
    var dev_id = _nj_uint(d, id_at, e);
    if (dev_id < 0 || dev_id > CMD_MAX_DEVICE_ID) { dev_id = index; }
    var cores = _nj_uint(d, nc_at, e);
    if (cores <= 0 || cores > 128) {
        if (warnings != 0) {
            vec_push(warnings, warning_parse("neuron", "nc_count missing or out of range; 2 NeuronCores assumed"));
        }
        cores = 2;
    }
    var c = _nj_model_chip(d, _nj_member(d, s, e, "model"), e, chip);
    var p = _neuron_profile(dev_id, c, cores);
    var cap = 16 * BYTES_PER_GIB * 1024;
    var mem = _nj_uint(d, _nj_member(d, s, e, "memory_size"), e);
    if (mem <= 0 || mem > cap) {
        mem = 0;
        var per_mb = _nj_uint(d, _nj_member(d, s, e, "memory_per_nc_mb"), e);
        if (per_mb > 0 && per_mb <= 16 * 1024 * 1024) { mem = per_mb * 1024 * 1024 * cores; }
        if (mem > cap) { mem = 0; }
    }
    if (mem > 0) { profile_set_memory_bytes(p, mem); }
    vec_push(profiles, p);
    return 1;
}

# Parse `neuron-ls --json-output` (see above) into ACCEL_NEURON profiles of
# chip `chip` (NEURON_*), at most 256. Output that is not an empty array but
# yields no device pushes a parse warning. Returns the number pushed. Pure.
fn parse_neuron_ls_json(output, chip, profiles, warnings) {
    var d = str_data(output);
    var e = str_len(output);
    var i = _nj_skip_ws(d, 0, e);
    if (i >= e) { return 0; }
    var added = 0;
    var empty = 0;
    var c = load8(d + i);
    if (c == 123) {
        added = _neuron_json_device(d, i, _nj_skip_value(d, i, e), 0, chip, profiles, warnings);
    } elif (c == 91) {
        var first = _nj_skip_ws(d, i + 1, e);
        if (first < e && load8(d + first) == 93) { empty = 1; }
        var index = 0;
        i = i + 1;
        while (i < e && added < 256) {
            i = _nj_skip_ws(d, i, e);
            if (i >= e) { break; }
            var b = load8(d + i);
            if (b == 93) { break; }
            if (b == 44) {
                i = i + 1;
                continue;
            }
            var ve = _nj_skip_value(d, i, e);
            if (ve <= i) { ve = i + 1; }
            if (b == 123) {
                added = added + _neuron_json_device(d, i, ve, index, chip, profiles, warnings);
            }
            index = index + 1;
            i = ve;
        }
    }
    if (added == 0 && empty == 0 && warnings != 0) {
        vec_push(warnings, warning_parse("neuron", "no device in `neuron-ls --json-output` output"));
    }
    return added;
}

# parse_neuron_ls_json with no DMI chip (Inferentia, unless a "model" says
# otherwise) and no warnings.
fn _parse_neuron_json(output, profiles) {
    return parse_neuron_ls_json(output, NEURON_INFERENTIA, profiles, 0);
}

# --- vulkan.cyr ---

# vulkan.cyr — Vulkan GPU detection via vulkaninfo + a sysfs scan
#
# `vulkaninfo --summary` names each Vulkan physical device with its vendorID,
# deviceID and deviceType. What a device's memory is depends on the type
# (2.3.29):
#   - An integrated GPU of any vendor but AMD has no memory of its own: its
#     heap is system RAM, which the CPU profile already counts. Its profile is
#     all shared (profile.cyr's shared_mem), sized from the largest
#     device-local heap in the full vulkaninfo output. That second run happens
#     only when such a GPU is present: the full output is 60-85 KB for one
#     device and run_tool keeps 1 MiB, so it cannot replace --summary for
#     naming every device on a many-GPU host.
#   - An AMD APU's own memory is its BIOS carve-out, which is outside
#     MemTotal. It is read from sysfs mem_info_vram_total, the figure ROCm
#     reports. RADV's heaps on an APU split carve-out plus GTT 2:1, so they
#     do not give it.
#   - A software implementation (deviceType CPU: lavapipe, SwiftShader) is not
#     a GPU and is not reported, as DXGI's Basic Render Driver is not.
#   - A virtual GPU, and a discrete one a vendor backend reports (CUDA on
#     NVIDIA's own driver, ROCm on amdgpu), keep the 4 GiB estimate:
#     profiles_dedup (src/registry.cyr, 2.4.0) drops this view of the
#     discrete card and keeps the backend's, with its memory figure. Any other
#     discrete GPU, such as an Intel Arc without xpu-smi or an NVIDIA card
#     under nouveau (NVK), is sized from its largest device-local heap, as
#     memory of its own (2.5.5; it kept the estimate before).
# Without vulkaninfo, and in no-exec mode, a sysfs scan of the DRM cards finds
# the GPUs by PCI vendor instead. Through 2.3.28 every Vulkan GPU carried the
# 4 GiB estimate and counted as memory of its own.

# vulkaninfo's deviceType, as vulkan_device_type() classifies it.
enum VulkanDevType {
    VK_DEV_OTHER = 0;
    VK_DEV_INTEGRATED = 1;
    VK_DEV_DISCRETE = 2;
    VK_DEV_VIRTUAL = 3;
    VK_DEV_CPU = 4;
}

# PCI vendor IDs, as vulkaninfo's vendorID and sysfs's device/vendor give them.
enum PciVendor {
    PCI_VENDOR_AMD = 0x1002;
    PCI_VENDOR_INTEL = 0x8086;
    PCI_VENDOR_NVIDIA = 0x10DE;
}

# Detect Vulkan GPUs. With `allow_exec` 1, vulkaninfo --summary names them and
# _vulkan_size_integrated sizes the integrated ones; otherwise, or when
# vulkaninfo is missing, or when it exits non-zero having named no device
# (2.5.4), the sysfs scan finds them. vulkaninfo exits 1 both when it finds no
# GPU and when it fails (Vulkan-Tools' main()), and through 2.5.3 a host
# where it failed after printing its header got neither its devices nor the
# scan. `leave_amdgpu` 1 makes the
# sysfs scan skip devices bound to amdgpu, which ROCm reports from the same
# sysfs nodes; registry_detect_with_opts sets it in no-exec mode when ROCm runs
# too.
fn detect_vulkan_opts(profiles, warnings, allow_exec, leave_amdgpu) {
    if (allow_exec == 1) {
        var args = vec_new();
        vec_push(args, "--summary");
        var st[16];
        var result = run_tool_status("vulkaninfo", args, warnings, &st);
        var w = tool_run_warning("vulkaninfo", result, &st);
        if (w != 0 && warnings != 0) { vec_push(warnings, w); }
        var failed = 0;
        if (w != 0) { failed = 1; }
        if (vulkan_take_summary(result, failed, profiles) == 1) { return 0; }
    }
    _detect_vulkan_sysfs(profiles, leave_amdgpu);
    return 0;
}

# Push the devices `vulkaninfo --summary` output `result` (a Str, or 0) names,
# and size the integrated ones. Returns 1 when the output stands as
# vulkaninfo's answer, or 0 when the caller should run the sysfs scan instead:
# no output, output too short to be a listing, or a failed run (`failed` 1)
# that named no device (2.5.4). A run that succeeded and named none (a host
# with only a software implementation) is an answer.
fn vulkan_take_summary(result, failed, profiles) {
    if (result == 0) { return 0; }
    if (str_len(result) <= 10) { return 0; }
    var first = vec_len(profiles);
    var ids = vec_new();
    _parse_vulkaninfo_ids(result, profiles, ids);
    if (failed == 1 && vec_len(profiles) == first) { return 0; }
    _vulkan_size_integrated(profiles, first, ids);
    return 1;
}

# detect_vulkan_opts with exec allowed and every sysfs device reported.
fn detect_vulkan(profiles, warnings) {
    return detect_vulkan_opts(profiles, warnings, 1, 0);
}

# --- vulkaninfo text ---

# 1 if `line` (a Str) is `key = value` for exactly `key` (a cstr): blanks, the
# key, then a blank or '='. Allocates nothing. Pure.
fn _vk_key_is(line, key) {
    var d = str_data(line);
    var n = str_len(line);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    var kl = strlen(key);
    if (i + kl >= n) { return 0; }
    if (memeq(d + i, key, kl) != 1) { return 0; }
    var after = load8(d + i + kl);
    if (after == 32 || after == 9 || after == 61) { return 1; }
    return 0;
}

# The trimmed text after the first '=' in `line` (a Str), or 0. Pure.
fn _vk_value(line) {
    var eq = str_index_of(line, 61);
    if (eq < 0) { return 0; }
    return str_trim(str_sub(line, eq + 1, str_len(line) - eq - 1));
}

# The decimal number that `s` (a Str, or 0) starts with, after blanks:
# "4202799104 (0xfa81a000) (3.91 GiB)" gives 4202799104. 0 if there is none
# or it runs past 18 digits. str_to_int cannot do this: it gathers every digit
# in the string. Pure.
fn _vk_leading_int(s) {
    if (s == 0) { return 0; }
    var d = str_data(s);
    var n = str_len(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    var v = 0;
    var digits = 0;
    while (i < n) {
        var c2 = load8(d + i);
        if (c2 < 48 || c2 > 57) { break; }
        if (digits >= 18) { return 0; }
        v = v * 10 + c2 - 48;
        digits = digits + 1;
        i = i + 1;
    }
    return v;
}

# 1 if `line` (a Str) opens a device: "GPU0:", or "GPU0" in old vulkaninfo.
# The presentable-surface and device-group lines ("GPU id : 0 (…)",
# "GPU id = 0 (…)") do not. Pure.
fn _vk_is_gpu_header(line) {
    var d = str_data(line);
    var n = str_len(line);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 32 && c != 9) { break; }
        i = i + 1;
    }
    if (i + 3 >= n) { return 0; }
    if (memeq(d + i, "GPU", 3) != 1) { return 0; }
    i = i + 3;
    var digits = 0;
    while (i < n) {
        var c2 = load8(d + i);
        if (c2 < 48 || c2 > 57) { break; }
        digits = digits + 1;
        i = i + 1;
    }
    if (digits == 0) { return 0; }
    if (i < n) {
        if (load8(d + i) == 58) { i = i + 1; }
    }
    while (i < n) {
        var c3 = load8(d + i);
        if (c3 != 32 && c3 != 9 && c3 != 13) { return 0; }
        i = i + 1;
    }
    return 1;
}

# vulkaninfo's deviceType value (a Str, or 0) as a VK_DEV_* constant:
# "PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU", and older vulkaninfo's
# "INTEGRATED_GPU" and "VK_PHYSICAL_DEVICE_TYPE_…" forms. Pure.
fn vulkan_device_type(v) {
    if (v == 0) { return VK_DEV_OTHER; }
    if (str_contains_cstr(v, "INTEGRATED") == 1) { return VK_DEV_INTEGRATED; }
    if (str_contains_cstr(v, "DISCRETE") == 1) { return VK_DEV_DISCRETE; }
    if (str_contains_cstr(v, "VIRTUAL") == 1) { return VK_DEV_VIRTUAL; }
    if (str_contains_cstr(v, "TYPE_CPU") == 1) { return VK_DEV_CPU; }
    if (str_eq_cstr(v, "CPU") == 1) { return VK_DEV_CPU; }
    return VK_DEV_OTHER;
}

# 1 if a Vulkan device of this type and PCI vendor draws its memory from system
# RAM: an integrated GPU of any vendor but AMD, whose APUs carve their own
# memory out of RAM at boot, outside MemTotal. Pure.
fn vulkan_uses_system_memory(dev_type, vendor) {
    if (dev_type != VK_DEV_INTEGRATED) { return 0; }
    if (vendor == PCI_VENDOR_AMD) { return 0; }
    return 1;
}

# 1 if a Vulkan device of this type and PCI vendor gets its memory from its
# heaps in the full vulkaninfo output: one on system RAM
# (vulkan_uses_system_memory), or a discrete GPU of a known vendor but AMD,
# whose cards ROCm reads from sysfs. An NVIDIA one needs it only without
# NVIDIA's driver (see _vulkan_size_integrated). Pure.
fn vulkan_needs_heap_size(dev_type, vendor) {
    if (vulkan_uses_system_memory(dev_type, vendor) == 1) { return 1; }
    if (dev_type != VK_DEV_DISCRETE) { return 0; }
    if (vendor < 0 || vendor == PCI_VENDOR_AMD) { return 0; }
    return 1;
}

# Push the device parsed so far: a profile with the 4 GiB estimate, all shared
# when vulkan_uses_system_memory holds, and, when `ids` is not 0, its vendor,
# device and type. A software implementation (VK_DEV_CPU) or a nameless record
# pushes nothing. Returns the number of profiles pushed (0 or 1).
fn _vk_emit(profiles, ids, dev_id, name, vendor, device, dev_type) {
    if (name == 0) { return 0; }
    if (dev_type == VK_DEV_CPU) { return 0; }
    var p = profile_new(ACCEL_VULKAN, dev_id, 4 * BYTES_PER_GIB);
    profile_set_device_name(p, str_cstr(name));
    profile_set_pci_id(p, pci_id_make(vendor, device));
    if (vulkan_uses_system_memory(dev_type, vendor) == 1) {
        profile_set_shared_mem(p, profile_memory_bytes(p));
    }
    vec_push(profiles, p);
    if (ids != 0) {
        vec_push(ids, vendor);
        vec_push(ids, device);
        vec_push(ids, dev_type);
    }
    return 1;
}

# Parse `vulkaninfo --summary` output into `profiles`. When `ids` is not 0,
# push vendor, device and type for each profile (three entries each), which
# _vulkan_size_integrated needs. A device runs from its "GPU<n>:" header to
# the next; the first vendorID, deviceID, deviceType and deviceName in it
# count. Input without headers (older or hand-written output) starts a device
# at each deviceName instead. Pure.
fn _parse_vulkaninfo_ids(output, profiles, ids) {
    var lines = str_split(output, 10);
    var nlines = vec_len(lines);
    var dev_id = 0;
    var headers = 0;
    var name = 0;
    var vendor = 0 - 1;
    var device = 0 - 1;
    var dev_type = VK_DEV_OTHER;

    var li = 0;
    while (li < nlines) {
        var line = vec_get(lines, li);
        li = li + 1;

        if (_vk_is_gpu_header(line) == 1) {
            dev_id = dev_id + _vk_emit(profiles, ids, dev_id, name, vendor, device, dev_type);
            headers = 1;
            name = 0;
            vendor = 0 - 1;
            device = 0 - 1;
            dev_type = VK_DEV_OTHER;
            continue;
        }
        if (_vk_key_is(line, "deviceName") == 1) {
            var nm = _vk_value(line);
            if (nm == 0) { continue; }
            if (str_len(nm) == 0) { continue; }
            if (name != 0) {
                # A second name inside one headed device is a nested struct's.
                if (headers == 1) { continue; }
                dev_id = dev_id + _vk_emit(profiles, ids, dev_id, name, vendor, device, dev_type);
                vendor = 0 - 1;
                device = 0 - 1;
                dev_type = VK_DEV_OTHER;
            }
            name = nm;
            continue;
        }
        if (_vk_key_is(line, "vendorID") == 1) {
            if (vendor < 0) { vendor = parse_hex_field(_vk_value(line)); }
            continue;
        }
        if (_vk_key_is(line, "deviceID") == 1) {
            if (device < 0) { device = parse_hex_field(_vk_value(line)); }
            continue;
        }
        if (_vk_key_is(line, "deviceType") == 1) {
            if (dev_type == VK_DEV_OTHER) { dev_type = vulkan_device_type(_vk_value(line)); }
            continue;
        }
    }
    _vk_emit(profiles, ids, dev_id, name, vendor, device, dev_type);
    return 0;
}

# Parse `vulkaninfo --summary` output into `profiles`. Pure.
fn _parse_vulkaninfo(output, profiles) {
    return _parse_vulkaninfo_ids(output, profiles, 0);
}

# The largest MEMORY_HEAP_DEVICE_LOCAL_BIT heap, in bytes, of the device in
# full `vulkaninfo` output whose vendorID, deviceID and deviceName (a cstr, or
# 0 for any) match; 0 if no device matches or it lists no such heap. Heaps are
# the "memoryHeaps[i]" entries before the memoryTypes list, each with a "size"
# line and its flags, in vulkaninfo 1.2+ and older alike. The largest, not the
# sum: NVIDIA lists its BAR window as a second device-local heap inside the
# first. Pure.
fn vulkan_local_heap_bytes(full, vendor, device, name) {
    var lines = str_split(full, 10);
    var nlines = vec_len(lines);
    var s_vendor = 0 - 1;
    var s_device = 0 - 1;
    var s_name = 0 - 1;
    var in_heaps = 0;
    var hsize = 0;
    var is_local = 0;
    var best = 0;

    var li = 0;
    while (li <= nlines) {
        var line = 0;
        if (li < nlines) { line = vec_get(lines, li); }
        li = li + 1;

        # A header or the end closes the device: return its heap if it matched.
        var closing = 0;
        if (line == 0) { closing = 1; }
        elif (_vk_is_gpu_header(line) == 1) { closing = 1; }
        if (closing == 1) {
            if (in_heaps == 1) {
                if (is_local == 1 && hsize > best) { best = hsize; }
            }
            if (s_vendor == vendor && s_device == device) {
                # A given name must be the device's own; 0 matches any.
                if (name == 0 || s_name == 1) {
                    if (best > 0) { return best; }
                }
            }
            s_vendor = 0 - 1;
            s_device = 0 - 1;
            s_name = 0 - 1;
            in_heaps = 0;
            hsize = 0;
            is_local = 0;
            best = 0;
            continue;
        }

        if (str_contains_cstr(line, "memoryHeaps[") == 1) {
            if (in_heaps == 1) {
                if (is_local == 1 && hsize > best) { best = hsize; }
            }
            in_heaps = 1;
            hsize = 0;
            is_local = 0;
            continue;
        }
        if (in_heaps == 1) {
            if (str_contains_cstr(line, "memoryType") == 1) {
                if (is_local == 1 && hsize > best) { best = hsize; }
                in_heaps = 0;
                continue;
            }
            if (_vk_key_is(line, "size") == 1) {
                hsize = _vk_leading_int(_vk_value(line));
                continue;
            }
            if (str_contains_cstr(line, "MEMORY_HEAP_DEVICE_LOCAL_BIT") == 1) {
                is_local = 1;
            }
            continue;
        }

        if (_vk_key_is(line, "vendorID") == 1) {
            if (s_vendor < 0) { s_vendor = parse_hex_field(_vk_value(line)); }
            continue;
        }
        if (_vk_key_is(line, "deviceID") == 1) {
            if (s_device < 0) { s_device = parse_hex_field(_vk_value(line)); }
            continue;
        }
        if (_vk_key_is(line, "deviceName") == 1) {
            if (s_name < 0) {
                s_name = 1;
                if (name != 0) {
                    var nm = _vk_value(line);
                    if (nm == 0) { s_name = 0; }
                    elif (str_eq_cstr(nm, name) != 1) { s_name = 0; }
                }
            }
            continue;
        }
    }
    return 0;
}

# Size the devices vulkan_needs_heap_size marks among the profiles from index
# `first` on, with a vendor/device/type triple each in `ids`, from `full`
# vulkaninfo output: memory becomes the device's largest device-local heap,
# and for one on system RAM (vulkan_uses_system_memory) so does the shared
# part; a discrete GPU's heap is its own memory. A device the output does not
# size keeps its estimate. Pure.
fn vulkan_size_shared(profiles, first, ids, full) {
    var n = vec_len(profiles) - first;
    var k = 0;
    while (k < n) {
        var vendor = vec_get(ids, k * 3);
        var device = vec_get(ids, k * 3 + 1);
        var dev_type = vec_get(ids, k * 3 + 2);
        if (vulkan_needs_heap_size(dev_type, vendor) == 1) {
            var p = vec_get(profiles, first + k);
            var heap = vulkan_local_heap_bytes(full, vendor, device, profile_device_name(p));
            if (heap > 0) {
                profile_set_memory_bytes(p, heap);
                if (vulkan_uses_system_memory(dev_type, vendor) == 1) { profile_set_shared_mem(p, heap); }
            }
        }
        k = k + 1;
    }
    return 0;
}

# On Windows, size each integrated GPU on system RAM among the profiles from
# `first` on from DXGI's SharedSystemMemory for its PCI IDs, the heap the full
# vulkaninfo output gives (2.5.3). Returns 1 when every such GPU was sized, 0
# when one was not (DXGI unavailable, or no adapter with its IDs).
fn _vulkan_size_from_dxgi(profiles, first, ids) {
    #ifdef CYRIUS_TARGET_WIN
    var n = vec_len(profiles) - first;
    var all = 1;
    var k = 0;
    while (k < n) {
        var vendor = vec_get(ids, k * 3);
        var device = vec_get(ids, k * 3 + 1);
        if (vulkan_uses_system_memory(vec_get(ids, k * 3 + 2), vendor) == 1) {
            var heap = win_dxgi_shared_bytes(vendor, device);
            if (heap > 0) {
                var p = vec_get(profiles, first + k);
                profile_set_memory_bytes(p, heap);
                profile_set_shared_mem(p, heap);
            } else {
                all = 0;
            }
        }
        k = k + 1;
    }
    return all;
    #endif
    return 0;
}

# Size the integrated GPUs that _parse_vulkaninfo_ids just pushed (profiles
# from index `first` on, a vendor/device/type triple each in `ids`), and the
# discrete ones no vendor backend reports. An AMD APU gets its sysfs
# carve-out. The others are sized by vulkan_size_shared from one run of the
# full vulkaninfo, made only when such a GPU is present, or on Windows from
# DXGI (_vulkan_size_from_dxgi), with the full run as the fallback; DXGI
# reports the discrete ones there. A discrete NVIDIA GPU asks for the run
# only when NVIDIA's driver is not loaded (/sys/module/nvidia): with it, CUDA
# reports the card.
fn _vulkan_size_integrated(profiles, first, ids) {
    var n = vec_len(profiles) - first;
    var need_full = 0;
    var nv_driver = 0 - 1;
    var k = 0;
    while (k < n) {
        var dev_type = vec_get(ids, k * 3 + 2);
        var vendor = vec_get(ids, k * 3);
        if (dev_type == VK_DEV_INTEGRATED && vendor == PCI_VENDOR_AMD) {
            var vram = _vulkan_sysfs_vram(vendor, vec_get(ids, k * 3 + 1));
            if (vram > 0) { profile_set_memory_bytes(vec_get(profiles, first + k), vram); }
        }
        if (vulkan_needs_heap_size(dev_type, vendor) == 1) {
            if (dev_type == VK_DEV_DISCRETE && vendor == PCI_VENDOR_NVIDIA) {
                if (nv_driver < 0) { nv_driver = aihw_path_exists("/sys/module/nvidia"); }
                if (nv_driver != 1) { need_full = 1; }
            } else {
                need_full = 1;
            }
        }
        k = k + 1;
    }
    if (need_full == 1) {
        if (_vulkan_size_from_dxgi(profiles, first, ids) == 1) { return 0; }
        # The --summary run already warned if vulkaninfo is missing.
        var full = run_tool("vulkaninfo", vec_new(), 0);
        if (full != 0) { vulkan_size_shared(profiles, first, ids, full); }
    }
    return 0;
}

# --- sysfs ---

# mem_info_vram_total of the DRM card with these PCI vendor and device IDs, or
# 0 (no such card, or not amdgpu).
fn _vulkan_sysfs_vram(vendor, device) {
    var entries = sysfs_list_dir("/sys/class/drm");
    var nent = vec_len(entries);
    var ei = 0;
    while (ei < nent) {
        var name = vec_get(entries, ei);
        ei = ei + 1;
        if (str_starts_with(name, "card") != 1) { continue; }
        if (str_index_of(name, 45) >= 0) { continue; }
        var v = parse_hex_field(sysfs_read(sysfs_path_str("/sys/class/drm", name, "device/vendor")));
        if (v != vendor) { continue; }
        var d = parse_hex_field(sysfs_read(sysfs_path_str("/sys/class/drm", name, "device/device")));
        if (d != device) { continue; }
        var vram = sysfs_read_int(sysfs_path_str("/sys/class/drm", name, "device/mem_info_vram_total"));
        if (vram > 0) { return vram; }
    }
    return 0;
}

# The PCI address of DRM card `card` (a Str such as "card0") under DRM root
# `drm` (a cstr), such as "0000:00:02.0", as a Str, or 0.
fn _drm_pci_slot(drm, card) {
    var link = read_symlink(sysfs_path_str(drm, card, "device"));
    if (link == 0) { return 0; }
    return path_basename(link);
}

# 1 if DRM card `card` (a Str) under DRM root `drm` (a cstr) is bound to the
# kernel driver `drv` (a cstr).
fn _drm_driver_is(drm, card, drv) {
    var link = read_symlink(sysfs_path_str(drm, card, "device/driver"));
    if (link == 0) { return 0; }
    return str_eq_cstr(path_basename(link), drv);
}

# 1 if `slot` (a Str PCI address, or 0) is where Intel puts its integrated
# GPU: device 2 on the root bus, on every platform since 2008. Arc cards sit
# behind a root port. Pure.
fn pci_slot_is_intel_igpu(slot) {
    if (slot == 0) { return 0; }
    return str_eq_cstr(slot, "0000:00:02.0");
}

# Sysfs scan: /sys/class/drm/card*/device/{vendor,device}. The fallback when
# vulkaninfo is missing, and the whole backend in no-exec mode. An Intel
# integrated GPU is all shared; `leave_amdgpu` 1 skips amdgpu devices, which
# ROCm reports.
fn _detect_vulkan_sysfs(profiles, leave_amdgpu) {
    return _detect_vulkan_sysfs_at(profiles, leave_amdgpu, "/sys/class/drm");
}

# _detect_vulkan_sysfs over DRM root `drm` (a cstr), which a test points at a
# fake tree.
fn _detect_vulkan_sysfs_at(profiles, leave_amdgpu, drm) {
    var entries = sysfs_list_dir(drm);
    var nent = vec_len(entries);
    var dev_id = 0;

    var ei = 0;
    while (ei < nent) {
        var name = vec_get(entries, ei);
        ei = ei + 1;
        if (str_starts_with(name, "card") != 1) { continue; }
        if (str_index_of(name, 45) >= 0) { continue; }

        var vendor_path = sysfs_path_str(drm, name, "device/vendor");
        var vendor_str = sysfs_read(vendor_path);
        if (vendor_str == 0) { continue; }
        var vendor = parse_hex_field(vendor_str);

        # Check for known GPU vendors
        var is_gpu = 0;
        var igpu = 0;
        var gpu_name = "Unknown GPU";
        var est_vram = 4 * BYTES_PER_GIB;

        if (vendor == PCI_VENDOR_NVIDIA) {
            is_gpu = 1;
            gpu_name = "NVIDIA GPU (Vulkan)";
        }
        elif (vendor == PCI_VENDOR_AMD) {
            if (leave_amdgpu == 1) {
                if (_drm_driver_is(drm, name, "amdgpu") == 1) { continue; }
            }
            is_gpu = 1;
            gpu_name = "AMD GPU (Vulkan)";
            # Try reading actual VRAM
            var vram_path = sysfs_path_str(drm, name, "device/mem_info_vram_total");
            var vram = sysfs_read_int(vram_path);
            if (vram > 0) { est_vram = vram; }
        }
        elif (vendor == PCI_VENDOR_INTEL) {
            is_gpu = 1;
            gpu_name = "Intel GPU (Vulkan)";
            est_vram = 2 * BYTES_PER_GIB;
            igpu = pci_slot_is_intel_igpu(_drm_pci_slot(drm, name));
        }

        if (is_gpu == 1) {
            var p = profile_new(ACCEL_VULKAN, dev_id, est_vram);
            profile_set_device_name(p, gpu_name);
            var dev_str = sysfs_read(sysfs_path_str(drm, name, "device/device"));
            profile_set_pci_id(p, pci_id_make(vendor, parse_hex_field(dev_str)));
            if (igpu == 1) { profile_set_shared_mem(p, est_vram); }
            vec_push(profiles, p);
            dev_id = dev_id + 1;
        }
    }
    return 0;
}

# --- apple.cyr ---

# apple.cyr — Apple Metal GPU + Neural Engine detection
#
# macOS: sysctl, no subprocess. machdep.cpu.brand_string names the chip
#   ("Apple M5 Pro") and hw.memsize sizes its unified memory, the same two
#   facts `system_profiler SPHardwareDataType` prints as "Chip:" / "Memory:".
#   Because nothing is spawned, registry_detect_no_exec() finds Apple Silicon
#   too (through 2.3.26 it returned the CPU alone on a Mac). system_profiler
#   is kept as the fallback for when sysctl cannot name an Apple Silicon chip,
#   and runs only when exec is allowed.
# Linux (Asahi): /proc/device-tree/compatible check, no subprocess.

# 1 if `chip` (a Str) names generation `gen` (a cstr, "M1") as a word: not
# right after a letter or digit, and not followed by a digit, so "Apple M10"
# is not an M1. Pure.
fn _apple_names_gen(chip, gen) {
    var d = str_data(chip);
    var n = str_len(chip);
    var gl = strlen(gen);
    var i = 0;
    while (i + gl <= n) {
        if (memeq(d + i, gen, gl) == 1) {
            var before = 32;
            if (i > 0) { before = load8(d + i - 1); }
            var after = 32;
            if (i + gl < n) { after = load8(d + i + gl); }
            var word = 1;
            if (before >= 48 && before <= 57) { word = 0; }
            if (before >= 65 && before <= 90) { word = 0; }
            if (before >= 97 && before <= 122) { word = 0; }
            if (after >= 48 && after <= 57) { word = 0; }
            if (word == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Neural Engine memory estimate by chip generation: M1 4 GiB, M2 6 GiB, and
# 8 GiB for M3, M4 and every chip past the table (the M5 Pro on ecb). Through
# 2.5.4 a chip past the table got the M1's 4 GiB, below an M2. `chip` is a
# Str. Pure.
fn _apple_ane_bytes(chip) {
    if (_apple_names_gen(chip, "M1") == 1) { return 4 * BYTES_PER_GIB; }
    if (_apple_names_gen(chip, "M2") == 1) { return 6 * BYTES_PER_GIB; }
    return 8 * BYTES_PER_GIB;
}

# The Neural Engine estimate for an Asahi device tree, whose `compatible` (a
# Str, NUL-separated strings) names the SoC: the M1 family is t8103 and t600x,
# the M2 family t8112 and t602x (Asahi's device trees); a later SoC takes
# _apple_ane_bytes' newest figure. Through 2.5.4 every Asahi Mac got 4 GiB.
# Pure.
fn _asahi_ane_bytes(compat) {
    if (str_contains_cstr(compat, "apple,t8103") == 1) { return 4 * BYTES_PER_GIB; }
    if (str_contains_cstr(compat, "apple,t600") == 1) { return 4 * BYTES_PER_GIB; }
    if (str_contains_cstr(compat, "apple,t8112") == 1) { return 6 * BYTES_PER_GIB; }
    if (str_contains_cstr(compat, "apple,t602") == 1) { return 6 * BYTES_PER_GIB; }
    return 8 * BYTES_PER_GIB;
}

# 1 if `brand` (a cstr from machdep.cpu.brand_string) names an Apple-designed
# CPU: "Apple M1" … "Apple M5 Pro", or "Apple M1 (Virtual)" in a VM. An Intel
# Mac reports "Intel(R) Core(TM) …". Pure.
fn apple_is_silicon_brand(brand) {
    if (brand == 0) { return 0; }
    if (strlen(brand) < 7) { return 0; }
    if (memeq(brand, "Apple ", 6) == 1) { return 1; }
    return 0;
}

# Push the Metal GPU (named `chip`, a cstr, with `mem` bytes of unified
# memory) and the Neural Engine for an Apple Silicon chip. Pure.
fn apple_emit_silicon(profiles, chip, mem) {
    var gpu = profile_new(ACCEL_METAL, 0, mem);
    profile_set_device_name(gpu, chip);
    vec_push(profiles, gpu);
    var ane = profile_new(ACCEL_APPLE_NPU, 0, _apple_ane_bytes(str_from(chip)));
    profile_set_device_name(ane, "Apple Neural Engine");
    vec_push(profiles, ane);
    return 0;
}

#ifdef CYRIUS_TARGET_MACOS
# A string sysctl looked up by name (e.g. "machdep.cpu.brand_string"), as a
# fresh cstr, or 0. A name without a fixed MIB is resolved through name2oid
# ({0, 3}, with the name as `newp`) first, as lib/sys.cyr does for
# vm.page_free_count. Darwin fails a read whose `oldlenp` is too short rather
# than truncating it, so the buffer is generous; the returned length includes
# the NUL.
fn _mac_sysctl_string(name) {
    var qmib[8];
    store32(&qmib, 0);
    store32(&qmib + 4, 3);
    var oid[64];
    var oidlen = 64;
    var r = syscall(SYS_SYSCTL, &qmib, 2, &oid, &oidlen, name, strlen(name));
    if (r < 0) { return 0; }
    var cap = 256;
    var buf = alloc(cap + 1);
    var len = cap;
    var r2 = syscall(SYS_SYSCTL, &oid, oidlen / 4, buf, &len, 0, 0);
    if (r2 < 0) { return 0; }
    if (len <= 0) { return 0; }
    if (len > cap) { len = cap; }
    store8(buf + len, 0);
    return buf;
}
#endif

# Detect Apple Silicon's Metal GPU and Neural Engine. On macOS, sysctl names
# the chip and sizes its unified memory without a subprocess, so this runs in
# registry_detect_no_exec() too; the system_profiler fallback runs only when
# `allow_exec` is 1. On Linux the Asahi device-tree check needs no subprocess.
#
# 2.5.1: the system_profiler fallback runs on macOS only. Through 2.5.0 it ran
# on every target, so every Linux and Windows run listed `system_profiler` in
# its warnings, a tool that cannot exist there.
fn detect_apple_opts(profiles, warnings, allow_exec) {
    #ifdef CYRIUS_TARGET_MACOS
    var brand = _mac_sysctl_string("machdep.cpu.brand_string");
    if (apple_is_silicon_brand(brand) == 1) {
        var mem = mac_total_phys_bytes();
        if (mem > 0) {
            apple_emit_silicon(profiles, brand, mem);
            return 0;
        }
    }
    if (allow_exec == 1) {
        var hw = run_tool1("system_profiler", "SPHardwareDataType", warnings);
        if (hw != 0) {
            if (str_len(hw) > 0) {
                _parse_apple_macos(hw, profiles);
                return 0;
            }
        }
    }
    #endif

    # Linux Asahi fallback
    var compat = sysfs_read("/proc/device-tree/compatible");
    if (compat != 0) {
        if (str_contains_cstr(compat, "apple") == 1) {
            # Detect system memory for Metal GPU
            var sys_mem = detect_system_memory();
            if (sys_mem == 0) { sys_mem = 8 * BYTES_PER_GIB; }
            var p = profile_new(ACCEL_METAL, 0, sys_mem);
            profile_set_device_name(p, "Apple Silicon (Asahi Linux)");
            vec_push(profiles, p);

            # Apple Neural Engine (ANE)
            var ane = profile_new(ACCEL_APPLE_NPU, 0, _asahi_ane_bytes(compat));
            profile_set_device_name(ane, "Apple Neural Engine");
            vec_push(profiles, ane);
        }
    }
    return 0;
}

# detect_apple_opts with exec allowed (the system_profiler fallback may run).
fn detect_apple(profiles, warnings) {
    return detect_apple_opts(profiles, warnings, 1);
}

# Parse `system_profiler SPHardwareDataType` output: "Chip: Apple M4 Pro" and
# "Memory: 36 GB". Only the fallback uses it now; see detect_apple_opts.
#
# 2.5.1: emits nothing without a `Chip:` line. An Intel Mac prints
# "Processor Name:" instead, and through 2.5.0 it got a Metal GPU and a Neural
# Engine named "Apple Silicon" and sized by its RAM.
fn _parse_apple_macos(hw_output, profiles) {
    var lines = str_split(hw_output, 10);
    var nlines = vec_len(lines);
    var chip_name = 0;
    var have_chip = 0;
    var mem_bytes = 8 * BYTES_PER_GIB;

    var li = 0;
    while (li < nlines) {
        var line = vec_get(lines, li);
        li = li + 1;

        # Chip name: "Chip: Apple M4 Pro"
        if (str_contains_cstr(line, "Chip:") == 1) {
            var col = str_index_of(line, 58);
            if (col >= 0) {
                var cn = str_trim(str_sub(line, col + 1, str_len(line) - col - 1));
                if (str_len(cn) > 0) {
                    chip_name = str_cstr(cn);
                    have_chip = 1;
                }
            }
        }

        # Memory: "Memory: 36 GB"
        if (str_contains_cstr(line, "Memory:") == 1) {
            var mcol = str_index_of(line, 58);
            if (mcol >= 0) {
                var mval = str_trim(str_sub(line, mcol + 1, str_len(line) - mcol - 1));
                var val = parse_value_with_suffix(mval);
                if (val > 0) { mem_bytes = val * BYTES_PER_GIB; }
            }
        }
    }

    if (have_chip == 0) { return 0; }
    apple_emit_silicon(profiles, chip_name, mem_bytes);
    return 0;
}

# --- intel.cyr ---

# intel.cyr — Intel NPU + Intel oneAPI GPU detection

# --- Intel NPU (Meteor Lake and later) ---
#
# The in-tree driver, intel_vpu (drivers/accel/ivpu, Linux 6.3+), registers
# the NPU in the DRM accel class: /sys/class/accel/accelN, device/driver ->
# intel_vpu (see tpu.cyr). Through 2.5.4 only /sys/class/misc/intel_npu was
# checked, a node nothing creates, so no NPU was found and detect_tpu listed
# it as a TPU instead. The misc node stays as a fallback for when the accel
# class has none.

fn detect_intel_npu(profiles, warnings) {
    detect_intel_npu_at("/sys/class/accel", "/sys/class/misc/intel_npu", profiles);
    return 0;
}

# detect_intel_npu over the accel class at `root` and the legacy node at
# `misc` (both cstrs): one 2 GiB profile per intel_vpu node, else one for the
# misc node. Returns the number pushed.
fn detect_intel_npu_at(root, misc, profiles) {
    var nodes = accel_class_nodes(root, BACKEND_INTEL_NPU);
    var n = vec_len(nodes);
    var i = 0;
    while (i < n) {
        var p = profile_new(ACCEL_INTEL_NPU, accel_node_index(vec_get(nodes, i)), 2 * BYTES_PER_GIB);
        profile_set_device_name(p, "Intel NPU");
        vec_push(profiles, p);
        i = i + 1;
    }
    if (n == 0 && aihw_path_exists(misc) == 1) {
        var p0 = profile_new(ACCEL_INTEL_NPU, 0, 2 * BYTES_PER_GIB);
        profile_set_device_name(p0, "Intel NPU");
        vec_push(profiles, p0);
        n = 1;
    }
    return n;
}

# --- Intel oneAPI GPUs (Arc, Flex, Data Center GPU Max): xpu-smi ---
#
# `xpu-smi discovery --dump 1,2,16,24` prints CSV: a header of property labels
# in the order asked, then a row per device. Properties 1, 2, 16 and 24 are
# Device ID, Device Name, Memory Physical Size and PCI Device ID, in Intel's
# XPU Manager V1.x user guide. Strings are quoted, and the memory size carries
# its unit ("32768.00 MiB"). Columns are found by their header label, not by
# position, so a release that orders them otherwise still parses. Not checked
# against a real capture yet (the roadmap's 2.6.x Data Center GPU Max item).
#
# Through 2.5.2 the detector passed "--dump 1,2,18,19" as ONE argument, and
# 18 and 19 are Memory Bus Width and Number of EUs, so a profile, if any came
# out, was sized from the bus width. It also set no pci_id, so profiles_dedup
# could not match a GPU that vulkaninfo reports too.

# `line` (a Str) split at commas outside double quotes, each field trimmed and
# unquoted, as Strs. xpu-smi does not escape a quote inside a field. Pure.
fn _xpu_csv_fields(line) {
    var out = vec_new();
    var d = str_data(line);
    var n = str_len(line);
    var start = 0;
    var inq = 0;
    var i = 0;
    while (i <= n) {
        var c = 44;
        if (i < n) { c = load8(d + i); }
        if (c == 34) { inq = 1 - inq; }
        if (c == 44 && inq == 0) {
            var f = str_trim(str_new(d + start, i - start));
            var fl = str_len(f);
            if (fl >= 2) {
                if (load8(str_data(f)) == 34 && load8(str_data(f) + fl - 1) == 34) {
                    f = str_new(str_data(f) + 1, fl - 2);
                }
            }
            vec_push(out, f);
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

# Index of the field labelled `label` (a cstr) in `fields`, or -1. Pure.
fn _xpu_column(fields, label) {
    var i = 0;
    while (i < vec_len(fields)) {
        if (str_eq_cstr(vec_get(fields, i), label) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Field `col` of `fields`, or 0 when the row is short, the column is missing
# (-1), or the value is N/A or empty. Pure.
fn _xpu_value(fields, col) {
    if (col < 0) { return 0; }
    if (col >= vec_len(fields)) { return 0; }
    var v = vec_get(fields, col);
    if (str_len(v) == 0) { return 0; }
    if (str_eq_cstr(v, "N/A") == 1) { return 0; }
    return v;
}

# The whole number a value (a Str, or 0) starts with, or -1 when it starts
# with no digit: 0 for "0", 32768 for "32768.00 MiB". Pure.
fn _xpu_leading_int(v) {
    if (v == 0) { return 0 - 1; }
    var d = str_data(v);
    var n = str_len(v);
    var x = 0;
    var digits = 0;
    while (digits < n && digits < 18) {
        var c = load8(d + digits);
        if (c < '0' || c > '9') { break; }
        x = x * 10 + (c - '0');
        digits = digits + 1;
    }
    if (digits == 0) { return 0 - 1; }
    return x;
}

# The bytes in a Memory Physical Size value: "32768.00 MiB", or "0.50 GiB",
# to three decimals (through 2.5.4 the fraction was dropped, so "0.50 GiB"
# fell back to 16 GiB). 0 when there is no leading number, or past
# validate_memory_mb's 16 TiB bound, which also keeps the multiply from
# wrapping. Pure.
fn _xpu_memory_bytes(v) {
    var mib_x1000 = parse_decimal_x1000(v);
    if (mib_x1000 <= 0) { return 0; }
    if (str_contains_cstr(v, "GiB") == 1) {
        if (mib_x1000 > 16 * 1024 * 1000) { return 0; }
        mib_x1000 = mib_x1000 * 1024;
    }
    if (mib_x1000 > 16 * 1024 * 1024 * 1000) { return 0; }
    return mib_x1000 * 1024 * 1024 / 1000;
}

# Parse `xpu-smi discovery --dump 1,2,16,24` output (see above) into
# ACCEL_INTEL_ONEAPI profiles: name, memory (16 GiB when missing) and pci_id
# from the PCI Device ID (Intel's vendor ID, which every xpu-smi device has).
# Output with no "Device ID" header, such as xpu-smi's "Error: XPUM Service
# Status Error." (printed with exit status 0), pushes a parse warning and no
# profile. A later line with fewer fields than the header, or with neither a
# name nor a PCI Device ID when the header has either column, is not a device:
# it pushes a parse warning (2.5.5; through 2.5.4 a trailing message line
# became a nameless 16 GiB GPU). Returns the number of profiles pushed. Pure.
fn parse_xpu_smi_dump(out, profiles, warnings) {
    var lines = str_split(out, 10);
    var nl = vec_len(lines);
    var hdr = 0 - 1;
    var hdr_n = 0;
    var c_id = 0 - 1;
    var c_name = 0 - 1;
    var c_mem = 0 - 1;
    var c_pci = 0 - 1;
    var count = 0;
    var li = 0;
    while (li < nl) {
        var line = str_trim(vec_get(lines, li));
        li = li + 1;
        if (str_len(line) == 0) { continue; }
        var fields = _xpu_csv_fields(line);
        if (hdr < 0) {
            c_id = _xpu_column(fields, "Device ID");
            if (c_id < 0) { continue; }
            hdr = li;
            hdr_n = vec_len(fields);
            c_name = _xpu_column(fields, "Device Name");
            c_mem = _xpu_column(fields, "Memory Physical Size");
            c_pci = _xpu_column(fields, "PCI Device ID");
            continue;
        }
        var nm = _xpu_value(fields, c_name);
        var pv = _xpu_value(fields, c_pci);
        var unnamed = 0;
        if (nm == 0 && pv == 0 && (c_name >= 0 || c_pci >= 0)) { unnamed = 1; }
        if (vec_len(fields) < hdr_n || unnamed == 1) {
            if (warnings != 0) {
                vec_push(warnings, warning_parse("xpu-smi", "a `discovery --dump` line that is not a device row"));
            }
            continue;
        }
        var dev_id = _xpu_leading_int(_xpu_value(fields, c_id));
        if (dev_id < 0) { dev_id = count; }
        var mem = _xpu_memory_bytes(_xpu_value(fields, c_mem));
        if (mem <= 0) { mem = 16 * BYTES_PER_GIB; }
        var p = profile_new(ACCEL_INTEL_ONEAPI, dev_id, mem);
        if (nm != 0) { profile_set_device_name(p, str_cstr(nm)); }
        if (pv != 0) { profile_set_pci_id(p, pci_id_make(PCI_VENDOR_INTEL, parse_hex_field(pv))); }
        vec_push(profiles, p);
        count = count + 1;
    }
    if (hdr < 0 && nl > 0 && str_len(str_trim(out)) > 0) {
        if (warnings != 0) {
            vec_push(warnings, warning_parse("xpu-smi", "no Device ID header in `discovery --dump` output"));
        }
    }
    return count;
}

# Intel oneAPI GPUs through xpu-smi. The property list is its own argument.
# A run that exits non-zero is reported once, by its exit-status warning: its
# output is still parsed, without the parse warnings its error text would add
# (2.5.5, as detect_cuda does).
fn detect_intel_oneapi(profiles, warnings) {
    var args = vec_new();
    vec_push(args, "discovery");
    vec_push(args, "--dump");
    vec_push(args, "1,2,16,24");
    var st[16];
    var result = run_tool_status("xpu-smi", args, warnings, &st);
    var w = tool_run_warning("xpu-smi", result, &st);
    if (w != 0 && warnings != 0) { vec_push(warnings, w); }
    var failed = 0;
    if (w != 0) { failed = 1; }
    xpu_take_output(result, failed, profiles, warnings);
    return 0;
}

# Parse xpu-smi's output `result` (a Str, or 0) into profiles; after a run
# that failed (`failed` 1), without its parse warnings (see
# detect_intel_oneapi). Returns the number of profiles pushed. Pure.
fn xpu_take_output(result, failed, profiles, warnings) {
    if (result == 0) { return 0; }
    var pw = warnings;
    if (failed == 1) { pw = vec_new(); }
    return parse_xpu_smi_dump(result, profiles, pw);
}

# --- amd_xdna.cyr ---

# amd_xdna.cyr — AMD Ryzen AI NPU detection via sysfs

fn detect_amd_xdna(profiles, warnings) {
    detect_amd_xdna_at("/sys/class/accel", profiles);
    return 0;
}

# One 2 GiB profile per amdxdna node of the accel class at `root` (a cstr; see
# tpu.cyr). Through 2.5.4 the driver name was matched as a 7-byte prefix.
# Returns the number pushed.
fn detect_amd_xdna_at(root, profiles) {
    var nodes = accel_class_nodes(root, BACKEND_AMD_XDNA);
    var n = vec_len(nodes);
    var i = 0;
    while (i < n) {
        var p = profile_new(ACCEL_AMD_XDNA, accel_node_index(vec_get(nodes, i)), 2 * BYTES_PER_GIB);
        profile_set_device_name(p, "AMD Ryzen AI NPU");
        vec_push(profiles, p);
        i = i + 1;
    }
    return n;
}

# --- edge.cyr ---

# edge.cyr — edge/mobile NPU detectors
# Qualcomm Cloud AI 100, Samsung Exynos NPU, MediaTek APU (MDLA)

fn detect_qualcomm(profiles, warnings) {
    detect_qualcomm_at("/sys/class/accel", profiles);
    return 0;
}

fn _qualcomm_profile(dev_id) {
    var p = profile_new(ACCEL_QUALCOMM, dev_id, 32 * BYTES_PER_GIB);
    profile_set_device_name(p, "Qualcomm Cloud AI 100");
    profile_set_compute_cap(p, "AI 100");
    return p;
}

# One profile per qaic node of the accel class at `root` (a cstr; see
# tpu.cyr), where the in-tree qaic driver (Linux 6.4+) registers each card.
# Through 2.5.4 only /sys/class/qaic and /dev/qaic_* were checked, and a qaic
# node became a TPU; they are still the fallback, for one card. Returns the
# number pushed.
fn detect_qualcomm_at(root, profiles) {
    var nodes = accel_class_nodes(root, BACKEND_QUALCOMM);
    var n = vec_len(nodes);
    var i = 0;
    while (i < n) {
        vec_push(profiles, _qualcomm_profile(accel_node_index(vec_get(nodes, i))));
        i = i + 1;
    }
    if (n > 0) { return n; }
    var found = 0;
    if (aihw_path_exists("/sys/class/qaic") == 1) { found = 1; }
    if (found == 0) {
        if (has_dev_device("qaic_") == 1) { found = 1; }
    }
    if (found == 1) { vec_push(profiles, _qualcomm_profile(0)); }
    return found;
}

fn detect_samsung_npu(profiles, warnings) {
    var found = 0;
    if (aihw_path_exists("/sys/class/misc/samsung_npu") == 1) { found = 1; }
    if (found == 0) {
        if (has_dev_device("samsung_npu") == 1) { found = 1; }
    }
    if (found == 1) {
        var p = profile_new(ACCEL_SAMSUNG_NPU, 0, 2 * BYTES_PER_GIB);
        profile_set_device_name(p, "Samsung Exynos NPU");
        profile_set_compute_cap(p, "Exynos AI");
        vec_push(profiles, p);
    }
    return 0;
}

fn detect_mediatek_apu(profiles, warnings) {
    var found = 0;
    if (aihw_path_exists("/sys/class/misc/mtk_apu") == 1) { found = 1; }
    if (found == 0) {
        if (has_dev_device("mtk_mdla") == 1) { found = 1; }
    }
    if (found == 1) {
        var p = profile_new(ACCEL_MEDIATEK_APU, 0, 2 * BYTES_PER_GIB);
        profile_set_device_name(p, "MediaTek APU");
        profile_set_compute_cap(p, "MDLA");
        vec_push(profiles, p);
    }
    return 0;
}

# --- cloud_asic.cyr ---

# cloud_asic.cyr — cloud/datacenter AI ASIC detectors
# Cerebras WSE, Graphcore IPU, Groq LPU

# --- Memory sizes in tool output ---
#
# Through 2.5.4 the Cerebras and Graphcore detectors handed the whole
# "Memory: 40 GB" line to parse_value_with_suffix, which reads only digits at
# the start of a line, so the 44 GiB and 900 MiB defaults always applied; the
# unit was ignored too, and only lowercase "memory" / "sram" matched.

# 1 if Str `s` contains `word` (a lowercase cstr) in any ASCII case. Pure.
fn _asic_contains_ci(s, word) {
    var d = str_data(s);
    var n = str_len(s);
    var wl = strlen(word);
    var i = 0;
    while (i + wl <= n) {
        var j = 0;
        while (j < wl) {
            var c = load8(d + i + j);
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != load8(word + j)) { break; }
            j = j + 1;
        }
        if (j == wl) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The bytes in the size after the first ':' of `line` (a Str), or at its
# start when it has none: "Memory: 40 GB", "sram: 900 MiB", "1.5 TB". K, M,
# G and T, in any case and with or without "B" / "iB", are binary units; a
# number with no unit is `dflt_unit` bytes. 0 when no number follows, when
# the unit is something else ("GB/s", "PB", "%"), or past 16 TiB. Pure.
fn asic_size_bytes(line, dflt_unit) {
    var rest = line;
    var colon = str_index_of(line, 58);
    if (colon >= 0) { rest = str_sub(line, colon + 1, str_len(line) - colon - 1); }
    var x = parse_decimal_x1000(rest);
    if (x <= 0) { return 0; }
    var d = str_data(rest);
    var n = str_len(rest);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 32 && c != 9 && c != 46 && (c < 48 || c > 57)) { break; }
        i = i + 1;
    }
    var unit = dflt_unit;
    if (i < n) {
        var u = load8(d + i);
        if (u >= 65 && u <= 90) { u = u + 32; }
        if (u == 107) { unit = 1024; }
        elif (u == 109) { unit = 1024 * 1024; }
        elif (u == 103) { unit = 1024 * 1024 * 1024; }
        elif (u == 116) { unit = 1024 * 1024 * 1024 * 1024; }
        else { return 0; }
        i = i + 1;
        if (i < n && (load8(d + i) == 105 || load8(d + i) == 73)) { i = i + 1; }
        if (i < n && (load8(d + i) == 98 || load8(d + i) == 66)) { i = i + 1; }
        if (i < n) {
            var t = load8(d + i);
            if (t == 47) { return 0; }
            if (t >= 65 && t <= 90) { return 0; }
            if (t >= 97 && t <= 122) { return 0; }
        }
    }
    var cap = 16 * 1024 * BYTES_PER_GIB;
    if (x > cap / unit * 1000) { return 0; }
    return x * unit / 1000;
}

# Cerebras WSE memory from `cerebras_cli system-info` output (a Str): the
# last line naming "memory" that holds a size (GB when it has no unit), else
# 44 GiB. Pure.
fn parse_cerebras_memory(out) {
    var mem = 44 * BYTES_PER_GIB;
    var lines = str_split(out, 10);
    var n = vec_len(lines);
    var li = 0;
    while (li < n) {
        var line = vec_get(lines, li);
        li = li + 1;
        if (_asic_contains_ci(line, "memory") != 1) { continue; }
        var b = asic_size_bytes(line, BYTES_PER_GIB);
        if (b > 0) { mem = b; }
    }
    return mem;
}

# Graphcore IPU memory from `gc-info -d 0 -i` output (a Str): the last line
# naming "memory" or "sram" that holds a size (MB when it has no unit), else
# 900 MiB. Pure.
fn parse_gcinfo_memory(out) {
    var mem = 900 * 1024 * 1024;
    var lines = str_split(out, 10);
    var n = vec_len(lines);
    var li = 0;
    while (li < n) {
        var line = vec_get(lines, li);
        li = li + 1;
        if (_asic_contains_ci(line, "memory") != 1 && _asic_contains_ci(line, "sram") != 1) { continue; }
        var b = asic_size_bytes(line, 1024 * 1024);
        if (b > 0) { mem = b; }
    }
    return mem;
}

# --- Detectors ---

# Detect a Cerebras system through cerebras_cli, with `allow_exec` 1, else
# (or when it prints nothing) a /dev/cerebras* node. Through 2.5.4 no-exec
# mode skipped the backend, node and all.
fn detect_cerebras_opts(profiles, warnings, allow_exec) {
    if (allow_exec == 1) {
        var result = run_tool1("cerebras_cli", "system-info", warnings);
        if (result != 0) {
            if (str_len(result) > 0) {
                var p = profile_new(ACCEL_CEREBRAS, 0, parse_cerebras_memory(result));
                profile_set_device_name(p, "Cerebras WSE");
                vec_push(profiles, p);
                return 0;
            }
        }
    }

    # Fallback: /dev/cerebras* check
    if (has_dev_device("cerebras") == 1) {
        var p = profile_new(ACCEL_CEREBRAS, 0, 44 * BYTES_PER_GIB);
        profile_set_device_name(p, "Cerebras WSE");
        vec_push(profiles, p);
    }
    return 0;
}

# detect_cerebras_opts with exec allowed.
fn detect_cerebras(profiles, warnings) {
    return detect_cerebras_opts(profiles, warnings, 1);
}

# 1 when directory `dev` (a cstr; "/dev" but in a test) holds a Graphcore
# IPU node, ipu<N> (dev_entry_id's rule), else 0, and 0 on Windows (see
# platform.cyr's header). Through 2.5.4 the fallback took any /dev/ipu*
# entry (has_dev_device), so an Intel IPU6 camera's /dev/ipu-psys0 was a
# Graphcore IPU.
fn graphcore_dev_present_at(dev) {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    var ids = vec_new();
    if (dev_dir_scan(dev, "ipu", ids) > 0) { return 1; }
    return 0;
}

# Detect a Graphcore IPU through gc-info, with `allow_exec` 1, else (or when
# it prints nothing) a /dev/ipu<N> node. Through 2.5.4 no-exec mode skipped
# the backend, node and all.
fn detect_graphcore_opts(profiles, warnings, allow_exec) {
    if (allow_exec == 1) {
        var result = run_tool3("gc-info", "-d", "0", "-i", warnings);
        if (result != 0) {
            if (str_len(result) > 0) {
                var p = profile_new(ACCEL_GRAPHCORE, 0, parse_gcinfo_memory(result));
                profile_set_device_name(p, "Graphcore IPU");
                profile_set_compute_cap(p, "IPU");
                vec_push(profiles, p);
                return 0;
            }
        }
    }

    # Fallback: a /dev/ipu<N> node
    if (graphcore_dev_present_at("/dev") == 1) {
        var p = profile_new(ACCEL_GRAPHCORE, 0, 900 * 1024 * 1024);
        profile_set_device_name(p, "Graphcore IPU");
        profile_set_compute_cap(p, "IPU");
        vec_push(profiles, p);
    }
    return 0;
}

# detect_graphcore_opts with exec allowed.
fn detect_graphcore(profiles, warnings) {
    return detect_graphcore_opts(profiles, warnings, 1);
}

fn detect_groq(profiles, warnings) {
    if (has_dev_device("groq") == 1) {
        var p = profile_new(ACCEL_GROQ, 0, 230 * 1024 * 1024);
        profile_set_device_name(p, "Groq LPU");
        profile_set_compute_cap(p, "LPU");
        vec_push(profiles, p);
    }
    return 0;
}

# --- bandwidth.cyr ---

# bandwidth.cyr — memory bandwidth enrichment post-pass
#
# The detectors set memory bandwidth themselves: CUDA from nvidia-smi's
# memory clock and the bus width (parse_cuda_output), ROCm from the card's
# pp_dpm_mclk and its KFD node (detect_rocm_at, 2.5.5). Through 2.5.4 this
# pass computed the ROCm figure from "/sys/class/drm/card<device_id>", a card
# the profile's ordinal does not name, and from the pp_dpm_mclk level index
# instead of the clock, so it was never right.

# Enrich profiles with memory bandwidth. The registry's post-passes and the
# library bundle call it; every backend that can report a bandwidth now sets
# it at detection, so there is nothing left to fill.
fn enrich_bandwidth(profiles) {
    return 0;
}

# --- pcie.cyr ---

# pcie.cyr — PCIe link bandwidth enrichment post-pass
# Reads the link capability of the device at a profile's PCI address
# (profile_pci_bdf): /sys/bus/pci/devices/<addr>/max_link_{width,speed},
# clipped to the upstream port's.

fn enrich_pcie(profiles) {
    return enrich_pcie_at(profiles, "/sys/bus/pci/devices");
}

# enrich_pcie over PCI device root `root` (a cstr), which a test points at a
# fake tree. A profile without a PCI address is left alone: through 2.5.4 it
# got the device_id-th device of the driver's sysfs directory, which lists
# devices in name-hash order, so on a multi-GPU host each GPU could get
# another's link.
fn enrich_pcie_at(profiles, root) {
    var np = vec_len(profiles);
    var pi = 0;
    while (pi < np) {
        var p = vec_get(profiles, pi);
        pi = pi + 1;

        # Skip if already has PCIe bandwidth
        if (profile_pcie_bw_x1000(p) != PROFILE_NONE) { continue; }
        var bdf = profile_pci_bdf(p);
        if (bdf == 0) { continue; }
        var dev = sysfs_path(root, bdf, 0);

        var width = pcie_link_cap(dev, "max_link_width", "current_link_width", 0);
        var speed = pcie_link_cap(dev, "max_link_speed", "current_link_speed", 1);
        var bw_x1000 = pcie_link_bw_x1000(speed, width);
        if (bw_x1000 > 0) { profile_set_pcie_bw_x1000(p, bw_x1000); }
    }
    return 0;
}

# PCIe bandwidth (GB/s x1000) of a link at `speed_x1000` (GT/s x1000, as
# parse_decimal_x1000 reads "2.5 GT/s PCIe") and `width` lanes, or 0 when
# either is unknown: GT/s * lanes * encoding / 8. Gen3 and later (8 GT/s and
# up) encode 128b/130b (~0.984), Gen1/2 8b/10b (0.8). Pure.
fn pcie_link_bw_x1000(speed_x1000, width) {
    if (speed_x1000 <= 0 || width <= 0) { return 0; }
    if (speed_x1000 >= PCIE_GEN3_SPEED_GTS * 1000) {
        return speed_x1000 * width * PCIE_GEN3_PLUS_ENCODING_X1000 / 8000;
    }
    return speed_x1000 * width * PCIE_GEN1_GEN2_ENCODING_X1000 / 8000;
}

# One link attribute of the device at sysfs dir `dev` (a cstr) as a number:
# a speed (`is_speed` 1) in GT/s x1000, or a width in lanes; 0 if unreadable.
fn _pcie_attr(dev, up, name, is_speed) {
    var s = sysfs_read(sysfs_path(dev, up, name));
    if (s == 0) { return 0; }
    var v = 0;
    if (is_speed == 1) { v = parse_decimal_x1000(s); } else { v = str_leading_uint(s); }
    if (v < 0) { return 0; }
    return v;
}

# The link capability of the device at sysfs dir `dev` (a cstr): its
# `max_name` attribute, clipped to the same attribute of the port above it
# ("<dev>/..", the parent bridge: a Gen5 card in a Gen4 slot runs Gen4), or
# its `cur_name` attribute when there is no max. Not the current link alone:
# an idle NVIDIA or amdgpu GPU trains its link down to Gen1, so on an idle
# host the current link reported 2.5 GT/s (through 2.5.4, read as 2). A link
# that trained down for a fault shows its capability, not the degraded rate.
fn pcie_link_cap(dev, max_name, cur_name, is_speed) {
    var v = _pcie_attr(dev, 0, max_name, is_speed);
    if (v <= 0) { return _pcie_attr(dev, 0, cur_name, is_speed); }
    var up = _pcie_attr(dev, "..", max_name, is_speed);
    if (up > 0 && up < v) { v = up; }
    return v;
}

# --- numa.cyr ---

# numa.cyr — NUMA node enrichment post-pass
# Reads /sys/bus/pci/devices/<addr>/numa_node at a profile's PCI address
# (profile_pci_bdf).

fn enrich_numa(profiles) {
    return enrich_numa_at(profiles, "/sys/bus/pci/devices");
}

# enrich_numa over PCI device root `root` (a cstr), which a test points at a
# fake tree. A profile without a PCI address is left alone (see
# enrich_pcie_at).
fn enrich_numa_at(profiles, root) {
    var np = vec_len(profiles);
    var pi = 0;
    while (pi < np) {
        var p = vec_get(profiles, pi);
        pi = pi + 1;
        if (profile_numa_node(p) != PROFILE_NONE) { continue; }
        var bdf = profile_pci_bdf(p);
        if (bdf == 0) { continue; }

        var node = sysfs_read_int(sysfs_path(root, bdf, "numa_node"));
        if (node >= 0) {
            profile_set_numa_node(p, node);
        }
    }
    return 0;
}

# --- interconnect.cyr ---

# interconnect.cyr — network interconnect detection
# InfiniBand, RoCE, NVLink, NVSwitch, XGMI, ICI

fn detect_interconnects(sio, profiles, warnings) {
    return detect_interconnects_opts(sio, profiles, warnings, 1);
}

# The interconnect pass. `allow_exec` 0 skips its one tool run,
# `nvidia-smi nvlink -s`; InfiniBand, NVSwitch and XGMI come from sysfs and
# ICI from the TPU profiles, so they are found either way (2.5.5; through
# 2.5.4 registry_detect_no_exec() skipped the whole pass).
fn detect_interconnects_opts(sio, profiles, warnings, allow_exec) {
    _detect_infiniband(sio);
    _detect_nvlink_nvswitch(sio, profiles, warnings, allow_exec);
    _detect_xgmi(sio);
    _detect_ici(sio, profiles);
    return 0;
}

# --- InfiniBand / RoCE ---

# An interconnect's `state` is the kernel's IB port-state number, the one
# ports/N/state starts with ("4: ACTIVE"): 1 DOWN, 2 INIT, 3 ARMED, 4 ACTIVE,
# 5 ACTIVE_DEFER, and 0 when not known (NVLink, XGMI, ICI). An NVSwitch, which
# is listed only when its nodes exist, reports ACTIVE. Through 2.5.4 the field
# held a C-string pointer, which the JSON printed as an integer: an address.
enum IbPortState {
    IB_PORT_STATE_UNKNOWN = 0;
    IB_PORT_STATE_ACTIVE = 4;
}

# The port-state number a sysfs ports/N/state value (a Str, or 0) starts
# with: 4 for "4: ACTIVE". IB_PORT_STATE_UNKNOWN when it starts with no
# digit or with more than two. Pure.
fn ib_port_state_code(s) {
    var v = str_leading_uint(s);
    if (v < 0 || v > 99) { return IB_PORT_STATE_UNKNOWN; }
    return v;
}

# GB/s x1000 of an InfiniBand ports/N/rate value (a Str, or 0): "200 Gb/sec
# (4X HDR)" gives 25000, "2.5 Gb/sec (1X SDR)" 312 (through 2.5.4 the .5 was
# dropped). 0 when it starts with no number. Pure.
fn ib_rate_gbps_x1000(s) {
    var gbit_x1000 = parse_decimal_x1000(s);
    if (gbit_x1000 <= 0) { return 0; }
    return gbit_x1000 / GBITS_PER_GBYTE;
}

fn _detect_infiniband(sio) {
    return _detect_infiniband_at(sio, "/sys/class/infiniband");
}

# One interconnect per device of the infiniband class at `root` (a cstr),
# from its port 1: rate, link layer (Ethernet is RoCE v2) and state.
fn _detect_infiniband_at(sio, root) {
    var entries = sysfs_list_dir(root);
    var nent = vec_len(entries);

    var ei = 0;
    while (ei < nent) {
        var name = vec_get(entries, ei);
        ei = ei + 1;

        var state = sysfs_read(sysfs_path_str(root, name, "ports/1/state"));
        var rate_str = sysfs_read(sysfs_path_str(root, name, "ports/1/rate"));
        var bw_x1000 = ib_rate_gbps_x1000(rate_str);

        # Determine kind: IB vs RoCE
        var kind = ICK_INFINIBAND;
        var ll = sysfs_read(sysfs_path_str(root, name, "ports/1/link_layer"));
        if (ll != 0) {
            if (str_contains_cstr(ll, "Ethernet") == 1) {
                kind = ICK_ROCEV2;
            }
        }

        var ic = interconnect_new(kind, str_cstr(name), bw_x1000);
        ic_set_state(ic, ib_port_state_code(state));
        sio_add_interconnect(sio, ic);
    }
    return 0;
}

# --- NVLink / NVSwitch ---

# 1 if `profiles` holds an NVIDIA GPU: a CUDA profile, or any profile with
# NVIDIA's PCI vendor ID (the Vulkan view of the card, when the CUDA backend
# did not run). Pure.
fn profiles_have_nvidia_gpu(profiles) {
    var n = vec_len(profiles);
    var i = 0;
    while (i < n) {
        var p = vec_get(profiles, i);
        i = i + 1;
        if (profile_accel_type(p) == ACCEL_CUDA) { return 1; }
        if ((profile_pci_id(p) >> 16) == PCI_VENDOR_NVIDIA) { return 1; }
    }
    return 0;
}

# 1 if `warnings` (a vec, or 0) holds a deadline kill of `tool` (a cstr).
fn _warnings_have_timeout(warnings, tool) {
    if (warnings == 0) { return 0; }
    var n = vec_len(warnings);
    var i = 0;
    while (i < n) {
        var w = vec_get(warnings, i);
        i = i + 1;
        if (warning_code(w) == HWA_ERR_TIMEOUT && streq(warning_tool(w), tool) == 1) { return 1; }
    }
    return 0;
}

# GB/s x1000 of one `nvidia-smi nvlink -s` link value (a Str, what follows
# "Link N:"): "26.562 GB/s" gives 26562. 0 for "<inactive>", for a value
# without "GB/s", and for one past 1000 GB/s, more than any link carries.
# Pure.
fn nvlink_link_gbps_x1000(v) {
    if (str_contains_cstr(v, "GB/s") != 1) { return 0; }
    var x = parse_decimal_x1000(v);
    if (x <= 0 || x > 1000000) { return 0; }
    return x;
}

# Add GPU `gpu`'s NVLink interconnect, "nvlinkN" at `bw` GB/s x1000, when
# there is a GPU (`gpu` 0 or more) with an active link (`bw` over 0).
# Returns the number added.
fn _nvlink_add(sio, gpu, bw) {
    if (gpu < 0 || bw <= 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "nvlink");
    str_builder_add_int(sb, gpu);
    sio_add_interconnect(sio, interconnect_new(ICK_NVLINK, str_data(str_builder_build(sb)), bw));
    return 1;
}

# Parse `nvidia-smi nvlink -s` output: under each "GPU N: <name>" line, a
# "Link N: <rate> GB/s" (or "<inactive>") line per link. Each GPU with an
# active link gets its own NVLink interconnect, "nvlinkN", with the sum of
# its active links, so the figure is one GPU's, as the NVSwitch one is.
# Through 2.5.4 every line containing "Link" counted as a 25 GB/s link (the
# rate was never read, inactive links and NVML's "NVLink" messages counted
# too), all summed across GPUs into one entry: two unbridged RTX 3090s were a
# 200 GB/s NVLink, enough for a tensor-parallel plan. At most 256 links count
# per GPU. Returns the number of interconnects added. Pure.
fn parse_nvlink_status(out, sio) {
    var lines = str_split(out, 10);
    var nl = vec_len(lines);
    var added = 0;
    var gpu = 0 - 1;
    var gpus = 0;
    var bw = 0;
    var links = 0;
    var li = 0;
    while (li < nl) {
        var t = str_trim(vec_get(lines, li));
        li = li + 1;
        if (str_starts_with(t, "GPU ") == 1) {
            added = added + _nvlink_add(sio, gpu, bw);
            gpu = str_leading_uint(str_sub(t, 4, str_len(t) - 4));
            if (gpu < 0 || gpu > CMD_MAX_DEVICE_ID) { gpu = gpus; }
            gpus = gpus + 1;
            bw = 0;
            links = 0;
            continue;
        }
        if (gpu < 0) { continue; }
        if (str_starts_with(t, "Link ") != 1) { continue; }
        var colon = str_index_of(t, 58);
        if (colon < 0) { continue; }
        if (links >= 256) { continue; }
        links = links + 1;
        bw = bw + nvlink_link_gbps_x1000(str_sub(t, colon + 1, str_len(t) - colon - 1));
    }
    return added + _nvlink_add(sio, gpu, bw);
}

fn _detect_nvlink_nvswitch(sio, profiles, warnings, allow_exec) {
    # Check for NVSwitch via sysfs
    if (dir_exists("/sys/devices/virtual/nvidia-nvswitch") == 1) {
        var ic = interconnect_new(ICK_NVSWITCH, "nvswitch", 900000);
        ic_set_state(ic, IB_PORT_STATE_ACTIVE);
        sio_add_interconnect(sio, ic);
        return 0;
    }
    if (aihw_path_exists("/sys/bus/nvidia_nvswitch/devices") == 1) {
        var nvsw_entries = sysfs_list_dir("/sys/bus/nvidia_nvswitch/devices");
        if (vec_len(nvsw_entries) > 0) {
            var ic = interconnect_new(ICK_NVSWITCH, "nvswitch", 900000);
            ic_set_state(ic, IB_PORT_STATE_ACTIVE);
            sio_add_interconnect(sio, ic);
            return 0;
        }
    }

    if (allow_exec == 0) { return 0; }
    # `nvidia-smi nvlink -s` only when there is an NVIDIA GPU to ask about
    # (2.5.2). Through 2.5.1 it ran whenever the NVSwitch nodes were missing:
    # a host without nvidia-smi was told so a second time, and one with
    # nvidia-smi but no GPU it can reach (a container without the driver)
    # spawned it again for nothing.
    if (profiles_have_nvidia_gpu(profiles) == 0) { return 0; }
    # Nor after the CUDA backend's nvidia-smi run hit the deadline in this
    # pass (2.5.5): the same driver would hang `nvlink -s` as long again, so a
    # wedged GPU cost two deadlines.
    if (_warnings_have_timeout(warnings, "nvidia-smi") == 1) { return 0; }
    # Its exit status is not judged (2.5.4): what `nvlink -s` returns on a GPU
    # without NVLink is not documented (nvidia-smi's 3 is "the requested
    # operation is not available on target device"), and the CUDA backend's
    # own nvidia-smi run already reports a tool that fails. Not found and the
    # deadline are still reported.
    var nargs = vec_new();
    vec_push(nargs, "nvlink");
    vec_push(nargs, "-s");
    var result = run_tool_status("nvidia-smi", nargs, warnings, 0);
    if (result != 0) { parse_nvlink_status(result, sio); }
    return 0;
}

# --- AMD XGMI / Infinity Fabric ---

fn _detect_xgmi(sio) {
    return _detect_xgmi_at(sio, "/sys/class/drm");
}

# One XGMI interconnect when a card of the drm class at `root` (a cstr) has
# device/xgmi_hive_info, which amdgpu creates only for a GPU in a hive.
# Through 2.5.4 the path went through str_data, which read its first 8 bytes
# as a pointer, so no hive was ever found.
fn _detect_xgmi_at(sio, root) {
    var entries = sysfs_list_dir(root);
    var nent = vec_len(entries);
    var has_xgmi = 0;

    var ei = 0;
    while (ei < nent) {
        var name = vec_get(entries, ei);
        ei = ei + 1;
        if (str_starts_with(name, "card") != 1) { continue; }
        if (str_index_of(name, 45) >= 0) { continue; }

        if (aihw_path_exists(sysfs_path_str(root, name, "device/xgmi_hive_info")) == 1) {
            has_xgmi = 1;
            break;
        }
    }

    if (has_xgmi == 1) {
        var ic = interconnect_new(ICK_XGMI, "xgmi", 400000);
        sio_add_interconnect(sio, ic);
    }
    return 0;
}

# --- Google TPU ICI ---

# One ICI interconnect over every TPU profile: the sum of each one's chips
# times its version's per-chip bandwidth (GB/s x1000). Through 2.5.4 only the
# first TPU profile counted, so a host with one profile per chip reported one
# chip's bandwidth while the planner used them all.
fn _detect_ici(sio, profiles) {
    var np = vec_len(profiles);
    var total_bw = 0;
    var seen = 0;
    var pi = 0;
    while (pi < np) {
        var p = vec_get(profiles, pi);
        pi = pi + 1;
        if (profile_accel_type(p) != ACCEL_TPU) { continue; }

        var version = profile_tpu_version(p);
        var chips = profile_tpu_chips(p);
        if (chips < 1) { chips = 1; }
        var per_chip_bw = 192000;
        if (version == TPU_V5E) { per_chip_bw = 204800; }
        elif (version == TPU_V5P) { per_chip_bw = 409600; }

        total_bw = total_bw + per_chip_bw * chips;
        seen = 1;
    }
    if (seen == 1) {
        sio_add_interconnect(sio, interconnect_new(ICK_ICI, "ici", total_bw));
    }
    return 0;
}

# --- disk.cyr ---

# disk.cyr — storage device detection via /sys/block/

# 1 when /sys/block entry `name` (a Str) is not a storage device to list:
# loop, device-mapper, RAM and compressed-RAM disks, optical (sr) and floppy
# (fd) drives and md RAID, and since 2.5.5 network block devices (nbd), ZFS
# zvols (zd), Ceph RBD (rbd), DRBD and MTD flash (mtdblock). The disks under
# md, dm and a ZFS pool are listed in their own right. Pure.
fn storage_name_skipped(name) {
    if (str_starts_with(name, "loop") == 1) { return 1; }
    if (str_starts_with(name, "dm-") == 1) { return 1; }
    if (str_starts_with(name, "ram") == 1) { return 1; }
    if (str_starts_with(name, "zram") == 1) { return 1; }
    if (str_starts_with(name, "sr") == 1) { return 1; }
    if (str_starts_with(name, "fd") == 1) { return 1; }
    if (str_starts_with(name, "md") == 1) { return 1; }
    if (str_starts_with(name, "nbd") == 1) { return 1; }
    if (str_starts_with(name, "zd") == 1) { return 1; }
    if (str_starts_with(name, "rbd") == 1) { return 1; }
    if (str_starts_with(name, "drbd") == 1) { return 1; }
    if (str_starts_with(name, "mtdblock") == 1) { return 1; }
    return 0;
}

# The kind of /sys/block entry `name` (a Str), from its queue/rotational
# flag `rot` (0, 1, or -1 when unreadable) and, for NVMe, its controller's
# model and transport (Strs, or 0). An NVMe device is STK_NVME unless it is
# backed by the network: NVMe over fabrics (transport tcp, rdma or fc), or an
# AWS EBS volume on Nitro, whose model is "Amazon Elastic Block Store" and
# whose gp3 baseline is 125 MB/s, not a local SSD's 3.5 GB/s (2.5.5). Those
# are STK_UNKNOWN; there is no network kind in the schema. Pure.
fn storage_classify(name, rot, model, transport) {
    if (str_starts_with(name, "nvme") == 1) {
        if (model != 0 && str_contains_cstr(model, "Elastic Block Store") == 1) { return STK_UNKNOWN; }
        if (transport != 0) {
            if (str_eq_cstr(transport, "tcp") == 1) { return STK_UNKNOWN; }
            if (str_eq_cstr(transport, "rdma") == 1) { return STK_UNKNOWN; }
            if (str_eq_cstr(transport, "fc") == 1) { return STK_UNKNOWN; }
        }
        return STK_NVME;
    }
    if (rot == 0) { return STK_SATA_SSD; }
    if (rot == 1) { return STK_HDD; }
    return STK_UNKNOWN;
}

# The nominal sequential bandwidth of a storage kind, in GB/s x1000. Pure.
fn storage_kind_bw_x1000(kind) {
    if (kind == STK_NVME) { return 3500; }
    if (kind == STK_SATA_SSD) { return 550; }
    if (kind == STK_HDD) { return 150; }
    return 100;
}

# detect_storage over the block-device directory `root` (a cstr;
# "/sys/block" on the system), so a test can point it at a fixture tree.
# A device whose size is 0 holds no medium (a card reader with no card, an
# nbd node with nothing attached) and is skipped; one whose size cannot be
# read is kept.
fn detect_storage_in(sio, root) {
    var entries = sysfs_list_dir(root);
    var nent = vec_len(entries);

    var ei = 0;
    while (ei < nent) {
        var name = vec_get(entries, ei);
        ei = ei + 1;
        if (storage_name_skipped(name) == 1) { continue; }
        if (sysfs_read_int(sysfs_path_str(root, name, "size")) == 0) { continue; }

        var rot = 0 - 1;
        var model = 0;
        var transport = 0;
        if (str_starts_with(name, "nvme") == 1) {
            model = sysfs_read(sysfs_path_str(root, name, "device/model"));
            transport = sysfs_read(sysfs_path_str(root, name, "device/transport"));
        } else {
            rot = sysfs_read_int(sysfs_path_str(root, name, "queue/rotational"));
        }
        var kind = storage_classify(name, rot, model, transport);
        var sd = storage_new(str_cstr(name), kind, storage_kind_bw_x1000(kind));
        sio_add_storage(sio, sd);
    }
    return 0;
}

fn detect_storage(sio) {
    return detect_storage_in(sio, "/sys/block");
}

# --- environment.cyr ---

# environment.cyr — runtime environment detection
# Docker, Kubernetes, cloud provider (AWS/GCP/Azure)

# The GPU count an NVIDIA_VISIBLE_DEVICES value (a cstr, or 0) names, or
# PROFILE_NONE when it does not enumerate devices. NVIDIA container toolkit
# semantics: "", "void" and "none" expose no GPU; "all" exposes every GPU of
# the node, a count the variable does not give; the device plugin's
# volume-mounts strategy sets a path (/var/run/nvidia-container-devices).
# Anything else is a comma list of indices or UUIDs, in which an empty item
# ("0,,1", "0,1,") is not a device. Through 2.5.4 the count was the commas
# plus one, so "all", "void", "none", "" and the path each read as 1 GPU.
# Pure.
fn visible_devices_count(v) {
    if (v == 0) { return PROFILE_NONE; }
    if (load8(v) == 0) { return 0; }
    if (streq(v, "void") == 1) { return 0; }
    if (streq(v, "none") == 1) { return 0; }
    if (streq(v, "all") == 1) { return PROFILE_NONE; }
    if (load8(v) == 47) { return PROFILE_NONE; }
    var count = 0;
    var in_item = 0;
    var ci = 0;
    while (load8(v + ci) != 0) {
        var c = load8(v + ci);
        if (c == 44) {
            in_item = 0;
        } elif (c != 32) {
            if (in_item == 0) {
                count = count + 1;
                in_item = 1;
            }
        }
        ci = ci + 1;
    }
    return count;
}

# The cloud provider DMI names, "aws" / "gcp" / "azure", or 0. Each argument
# is the Str of one /sys/class/dmi/id file, or 0: sys_vendor, bios_vendor,
# bios_version, product_name, chassis_asset_tag. The vendor alone is not
# enough (2.5.5): Surface hardware and every local Hyper-V VM report
# "Microsoft Corporation", and coreboot Chromebooks report "Google". So Azure
# needs its chassis asset tag (the one cloud-init checks) and GCP its
# product name. Nitro EC2 reports "Amazon EC2"; Xen-based EC2 (t2, m4, c4,
# p2, p3, g3) reports "Xen", with "amazon" only in bios_version
# ("4.11.amazon"), which through 2.5.4 was never read. Pure.
fn dmi_cloud_provider(vendor, bios, biosver, product, asset) {
    if (vendor != 0 && str_contains_cstr(vendor, "Amazon EC2") == 1) { return "aws"; }
    if (bios != 0 && str_contains_cstr(bios, "Amazon EC2") == 1) { return "aws"; }
    if (biosver != 0 && str_contains_cstr(biosver, "amazon") == 1) { return "aws"; }
    if (product != 0 && str_contains_cstr(product, "Google Compute Engine") == 1) { return "gcp"; }
    if (asset != 0 && str_contains_cstr(asset, "7783-7084-3265-9085-8269-3286-77") == 1) { return "azure"; }
    return 0;
}

fn detect_environment(sio) {
    var env = runtime_env_new();
    var detected = 0;

    # --- Container detection: Docker, Podman ---
    if (aihw_path_exists("/.dockerenv") == 1) {
        env_set_is_docker(env, 1);
        detected = 1;
    } elif (aihw_path_exists("/run/.containerenv") == 1) {
        env_set_is_docker(env, 1);
        detected = 1;
    } else {
        # Check /proc/1/cgroup for docker/containerd
        var cgroup = sysfs_read("/proc/1/cgroup");
        if (cgroup != 0) {
            if (str_contains_cstr(cgroup, "docker") == 1) {
                env_set_is_docker(env, 1);
                detected = 1;
            } elif (str_contains_cstr(cgroup, "containerd") == 1) {
                env_set_is_docker(env, 1);
                detected = 1;
            }
        }
    }

    # --- Kubernetes detection ---
    if (aihw_path_exists("/var/run/secrets/kubernetes.io") == 1) {
        env_set_is_k8s(env, 1);
        detected = 1;
        # Read namespace
        var ns = sysfs_read("/var/run/secrets/kubernetes.io/serviceaccount/namespace");
        if (ns != 0) {
            env_set_k8s_namespace(env, str_cstr(ns));
        }

        # GPU count from env vars
        var nv_devs = cmd_getenv("NVIDIA_VISIBLE_DEVICES");
        if (nv_devs != 0) {
            env_set_k8s_gpu_count(env, visible_devices_count(nv_devs));
            env_set_k8s_gpu_source(env, "NVIDIA_VISIBLE_DEVICES");
        }
    }

    # --- Cloud provider detection via DMI ---
    var vendor = sysfs_read("/sys/class/dmi/id/sys_vendor");
    var product = sysfs_read("/sys/class/dmi/id/product_name");
    var bios = sysfs_read("/sys/class/dmi/id/bios_vendor");
    var biosver = sysfs_read("/sys/class/dmi/id/bios_version");
    var asset = sysfs_read("/sys/class/dmi/id/chassis_asset_tag");
    var cloud = dmi_cloud_provider(vendor, bios, biosver, product, asset);
    if (cloud != 0) {
        env_set_cloud_provider(env, cloud);
        detected = 1;
        # Nitro names the instance type in product_name; Xen says "HVM domU".
        if (streq(cloud, "aws") == 1 && vendor != 0 && product != 0) {
            if (str_contains_cstr(vendor, "Amazon EC2") == 1) {
                env_set_instance_type(env, str_cstr(product));
            }
        }
    }

    if (detected == 1) {
        sio_set_environment(sio, env);
    }
    return 0;
}

# --- windows.cyr ---

# windows.cyr — Windows-side accelerator detection (DXGI adapter enumeration).
#
# `detect_windows` is compiled in only when the target is Win64 PE
# (CYRIUS_TARGET_WIN, predefined by `cyrius build --win`). On Linux / macOS
# it is preprocessed out, so registry_detect_with's call to it is also gated.
#
# Mechanism: GPUs come straight from DXGI — CreateDXGIFactory1 ->
# IDXGIFactory1::EnumAdapters1(i) until DXGI_ERROR_NOT_FOUND ->
# IDXGIAdapter1::GetDesc1 — one ACCEL_WIN_GPU profile per hardware adapter,
# named from DXGI_ADAPTER_DESC1.Description, sized from DedicatedVideoMemory.
# Software adapters (the Microsoft Basic Render Driver, which cass lists
# last) are skipped. No subprocess: the factory is the
# 0xF012 PE reroute (dxgi.dll) and its methods are COM vtable slots called
# through `callptr`. So it runs in every detection entry point, including
# registry_detect_no_exec(); only the wmic fallback depends on the caller
# allowing exec (see win_gpu_use_wmic_fallback).
#
# Through 2.3.24 detection spawned `wmic path win32_VideoController` to CREATE
# the profiles and DXGI only enriched their VRAM. Windows 11 24H2+ removes
# `wmic` by default, so on such a host (cass, build 26200) the Windows backend
# found no GPU at all, and detect_system_memory's `wmic computersystem` spawn
# failed too (16 GiB fallback). wmic is now only the fallback for a host where
# DXGI itself is unavailable (no factory, or the first EnumAdapters1 fails
# with anything other than DXGI_ERROR_NOT_FOUND). A host where DXGI works but
# lists only software adapters has no GPU, and wmic is not consulted.
# Total RAM comes from kernel32!GlobalMemoryStatusEx (platform.cyr).
#
# DXGI reports an integrated GPU's dedicated carve-out (the Intel UHD 600 on
# cass: 128 MiB), not the system memory it draws on, and DXGI_ADAPTER_DESC1
# cannot tell integrated from discrete. Each profile carries the adapter's PCI
# vendor and device IDs (2.5.3), so profiles_dedup (src/registry.cyr) matches
# it with vulkaninfo's view of the same GPU, which can: an integrated GPU on
# system RAM there gives the Windows profile its heap, all shared (4 202 799 104
# bytes on cass, half its RAM). Without vulkaninfo, and in no-exec mode, the
# carve-out stays. The wmic-era figure was the driver's AdapterRAM (1 GiB
# there).
#
# The descriptor readers (win_dxgi_desc_*, win_utf16_to_cstr) and the wmic
# parser (win_parse_videocontrollers) are ungated and pure, so the Linux-hosted
# fixture test (tests/tcyr/windows_test.tcyr) exercises them without a Windows
# host. Only the COM walk and the wmic spawn are CYRIUS_TARGET_WIN-only
# (callptr into Win64 COM and syscall 0xF012 exist only on PE).

# DXGI_ADAPTER_DESC1 (x64) field offsets, plus the adapter IDs and HRESULTs
# the enumeration needs. sizeof(DXGI_ADAPTER_DESC1) is 312; the buffer is 320.
enum WinDxgi {
    WIN_DXGI_DESC_NAME = 0;             # WCHAR Description[128]
    WIN_DXGI_DESC_NAME_WCHARS = 128;
    WIN_DXGI_DESC_VENDOR = 256;         # UINT VendorId
    WIN_DXGI_DESC_DEVICE = 260;         # UINT DeviceId
    WIN_DXGI_DESC_DEDICATED_VIDEO = 272;    # SIZE_T DedicatedVideoMemory
    WIN_DXGI_DESC_DEDICATED_SYSTEM = 280;   # SIZE_T DedicatedSystemMemory
    WIN_DXGI_DESC_SHARED_SYSTEM = 288;      # SIZE_T SharedSystemMemory
    WIN_DXGI_DESC_FLAGS = 304;          # UINT Flags
    WIN_DXGI_DESC_BUF = 320;
    WIN_DXGI_FLAG_SOFTWARE = 0x2;       # DXGI_ADAPTER_FLAG_SOFTWARE
    WIN_DXGI_VENDOR_MICROSOFT = 0x1414;
    WIN_DXGI_DEVICE_BASIC_RENDER = 0x8C;    # Microsoft Basic Render Driver
    WIN_DXGI_ERROR_NOT_FOUND = 0x887A0002;  # EnumAdapters1 past the last adapter
    WIN_DXGI_MAX_ADAPTERS = 64;             # loop bound only; NOT_FOUND ends it
}

# Convert UTF-16LE text at `w` (at most `max_units` code units, stopping at a
# NUL) into a fresh NUL-terminated UTF-8 cstr. Bounded on the input side
# because DXGI's Description is a fixed WCHAR[128] with no guarantee of a
# terminator. Surrogate pairs decode to 4-byte UTF-8; a lone surrogate becomes
# U+FFFD rather than invalid UTF-8. Pure.
fn win_utf16_to_cstr(w, max_units) {
    # <= 3 bytes per code unit (a 2-unit surrogate pair encodes to 4) + NUL.
    var buf = alloc(max_units * 3 + 1);
    var i = 0;
    var o = 0;
    while (i < max_units) {
        var cu = load8(w + i * 2) | (load8(w + i * 2 + 1) << 8);
        if (cu == 0) { break; }
        i = i + 1;
        var cp = cu;
        if (cu >= 0xD800) {
            if (cu <= 0xDFFF) {
                cp = 0xFFFD;
                if (cu <= 0xDBFF) {
                    if (i < max_units) {
                        var cu2 = load8(w + i * 2) | (load8(w + i * 2 + 1) << 8);
                        if (cu2 >= 0xDC00) {
                            if (cu2 <= 0xDFFF) {
                                cp = 0x10000 + ((cu - 0xD800) << 10) + (cu2 - 0xDC00);
                                i = i + 1;
                            }
                        }
                    }
                }
            }
        }
        if (cp < 0x80) {
            store8(buf + o, cp);
            o = o + 1;
        } elif (cp < 0x800) {
            store8(buf + o, 0xC0 | (cp >> 6));
            store8(buf + o + 1, 0x80 | (cp & 0x3F));
            o = o + 2;
        } elif (cp < 0x10000) {
            store8(buf + o, 0xE0 | (cp >> 12));
            store8(buf + o + 1, 0x80 | ((cp >> 6) & 0x3F));
            store8(buf + o + 2, 0x80 | (cp & 0x3F));
            o = o + 3;
        } else {
            store8(buf + o, 0xF0 | (cp >> 18));
            store8(buf + o + 1, 0x80 | ((cp >> 12) & 0x3F));
            store8(buf + o + 2, 0x80 | ((cp >> 6) & 0x3F));
            store8(buf + o + 3, 0x80 | (cp & 0x3F));
            o = o + 4;
        }
    }
    store8(buf + o, 0);
    return buf;
}

# 1 if a DXGI_ADAPTER_DESC1 describes a software adapter: the
# DXGI_ADAPTER_FLAG_SOFTWARE bit, or the Microsoft Basic Render Driver's
# 1414:008C IDs, a second check that does not rely on the flag. Pure.
fn win_dxgi_desc_is_software(desc) {
    if ((load32(desc + WIN_DXGI_DESC_FLAGS) & WIN_DXGI_FLAG_SOFTWARE) != 0) { return 1; }
    if (load32(desc + WIN_DXGI_DESC_VENDOR) == WIN_DXGI_VENDOR_MICROSOFT) {
        if (load32(desc + WIN_DXGI_DESC_DEVICE) == WIN_DXGI_DEVICE_BASIC_RENDER) { return 1; }
    }
    return 0;
}

# Memory (bytes) to report for a DXGI adapter: DedicatedVideoMemory, or
# DedicatedSystemMemory when a driver books its boot-time carve-out there
# instead (both are memory the CPU does not share). 0 when neither is set.
# SharedSystemMemory is deliberately not used. Pure.
fn win_dxgi_desc_vram(desc) {
    var v = load64(desc + WIN_DXGI_DESC_DEDICATED_VIDEO);
    if (v > 0) { return v; }
    var s = load64(desc + WIN_DXGI_DESC_DEDICATED_SYSTEM);
    if (s > 0) { return s; }
    return 0;
}

# The system memory (bytes) a DXGI adapter can share: SharedSystemMemory, the
# heap vulkaninfo reports for an integrated GPU (cass's UHD 600: both
# 4 202 799 104). Every adapter has one, discrete ones too, so it says nothing
# about whether the adapter is integrated. Pure.
fn win_dxgi_desc_shared(desc) {
    var v = load64(desc + WIN_DXGI_DESC_SHARED_SYSTEM);
    if (v < 0) { return 0; }
    return v;
}

# Push an ACCEL_WIN_GPU profile (device `dev_id`) for one DXGI_ADAPTER_DESC1
# unless it is a software adapter, with the adapter's VendorId and DeviceId as
# its pci_id (2.5.3). Returns 1 if a profile was pushed, else 0. Pure — the COM
# walk that fills `desc` is win_dxgi_enum_adapters.
fn win_dxgi_desc_emit(desc, dev_id, profiles) {
    if (win_dxgi_desc_is_software(desc) == 1) { return 0; }
    var p = profile_new(ACCEL_WIN_GPU, dev_id, win_dxgi_desc_vram(desc));
    profile_set_pci_id(p, pci_id_make(load32(desc + WIN_DXGI_DESC_VENDOR), load32(desc + WIN_DXGI_DESC_DEVICE)));
    var name = win_utf16_to_cstr(desc + WIN_DXGI_DESC_NAME, WIN_DXGI_DESC_NAME_WCHARS);
    if (load8(name) != 0) { profile_set_device_name(p, name); }
    vec_push(profiles, p);
    return 1;
}

# 1 if detect_windows_opts should fall back to wmic: only when DXGI itself
# is unavailable (`dxgi_count` < 0) and the caller allows spawning a process.
# DXGI answering 0 hardware adapters is an answer, not a failure. Pure.
fn win_gpu_use_wmic_fallback(dxgi_count, allow_exec) {
    if (dxgi_count >= 0) { return 0; }
    if (allow_exec == 1) { return 1; }
    return 0;
}

# The pci_id in a PnP device ID, as wmic's PNPDeviceID gives it
# ("PCI\VEN_8086&DEV_3185&SUBSYS_...", a Str): VEN_ and DEV_ each followed by
# four hex digits. 0 when either is missing or the ID is not a PCI one. Pure.
fn win_pnp_pci_id(s) {
    var d = str_data(s);
    var n = str_len(s);
    if (n < 4) { return 0; }
    if (memeq(d, "PCI", 3) == 0) { return 0; }
    var vendor = 0 - 1;
    var device = 0 - 1;
    var i = 0;
    while (i + 8 <= n) {
        var which_id = 0;
        if (memeq(d + i, "VEN_", 4) == 1) { which_id = 1; }
        if (memeq(d + i, "DEV_", 4) == 1) { which_id = 2; }
        if (which_id != 0) {
            var v = 0;
            var k = 0;
            while (k < 4) {
                var c = load8(d + i + 4 + k);
                var x = 0 - 1;
                if (c >= '0' && c <= '9') { x = c - '0'; }
                if (c >= 'a' && c <= 'f') { x = c - 'a' + 10; }
                if (c >= 'A' && c <= 'F') { x = c - 'A' + 10; }
                if (x < 0) { return 0; }
                v = v * 16 + x;
                k = k + 1;
            }
            if (which_id == 1 && vendor < 0) { vendor = v; }
            if (which_id == 2 && device < 0) { device = v; }
            i = i + 8;
            continue;
        }
        i = i + 1;
    }
    if (vendor < 0 || device < 0) { return 0; }
    return pci_id_make(vendor, device);
}

# 1 when the `n` bytes at `d` start with cstr `prefix`, ASCII letters in
# either case. Pure.
fn _win_starts_ci(d, n, prefix) {
    var pl = strlen(prefix);
    if (n < pl) { return 0; }
    var i = 0;
    while (i < pl) {
        var a = load8(d + i);
        var b = load8(prefix + i);
        if (a >= 'a' && a <= 'z') { a = a - 32; }
        if (b >= 'a' && b <= 'z') { b = b - 32; }
        if (a != b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when a wmic PNPDeviceID (`n` bytes at `d`) is a virtual display adapter,
# not a GPU (2.5.5): a software device (SWD\, such as an RDP session's
# Microsoft Remote Display Adapter, or Miracast), a root-enumerated display
# driver (ROOT\, the indirect-display drivers), or Hyper-V's synthetic video
# (VMBUS\{DA0A7802-E377-4AAC-8E77-0558EB1073F8}). DXGI lists none of them as
# an adapter. Every other ID is kept: PCI\, ACPI\ (Windows on Arm's Adreno
# is ACPI\QCOM...) and any other VMBUS\ device, which a partitioned GPU may
# be. Pure.
fn win_pnp_is_virtual(d, n) {
    if (_win_starts_ci(d, n, "SWD\\") == 1) { return 1; }
    if (_win_starts_ci(d, n, "ROOT\\") == 1) { return 1; }
    if (_win_starts_ci(d, n, "VMBUS\\{DA0A7802-E377-4AAC-8E77-0558EB1073F8}") == 1) { return 1; }
    return 0;
}

# Push an ACCEL_WIN_GPU profile (name copied to a NUL-terminated cstr).
fn win_emit_gpu(profiles, dev_id, name, ram, pci_id) {
    var mem = ram;
    if (mem < 0) { mem = 0; }
    var p = profile_new(ACCEL_WIN_GPU, dev_id, mem);
    profile_set_pci_id(p, pci_id);
    var sb = str_builder_new();
    str_builder_add(sb, name);
    profile_set_device_name(p, str_data(str_builder_build(sb)));
    vec_push(profiles, p);
}

# Parse `wmic ... win32_VideoController get Name,AdapterRAM,PNPDeviceID
# /format:list` output into ACCEL_WIN_GPU profiles. Each controller is a block
# of `Key=Value` lines (AdapterRAM=, Name= and PNPDeviceID=, any order)
# separated by blank lines; PNPDeviceID gives the pci_id (2.5.3), and a
# virtual adapter's (win_pnp_is_virtual) block is skipped (2.5.5). Returns the
# count of GPUs pushed. Pure — no I/O. Only reached when DXGI is unavailable
# (see detect_windows).
fn win_parse_videocontrollers(out, profiles) {
    var lines = str_split(out, 10);
    var nl = vec_len(lines);
    var i = 0;
    var dev_id = 0;
    var have_name = 0;
    var cur_name = 0;
    var cur_ram = 0;
    var cur_pci = 0;
    var cur_virtual = 0;
    var count = 0;
    while (i < nl) {
        var line = str_trim(vec_get(lines, i));
        var ld = str_data(line);
        var ll = str_len(line);
        if (ll == 0) {
            if (have_name == 1 && cur_virtual == 0) {
                win_emit_gpu(profiles, dev_id, cur_name, cur_ram, cur_pci);
                dev_id = dev_id + 1;
                count = count + 1;
            }
            have_name = 0;
            cur_ram = 0;
            cur_pci = 0;
            cur_virtual = 0;
        } else {
            if (ll >= 11) {
                if (memeq(ld, "AdapterRAM=", 11) == 1) {
                    cur_ram = str_to_int(str_new(ld + 11, ll - 11));
                }
            }
            if (ll >= 5) {
                if (memeq(ld, "Name=", 5) == 1) {
                    cur_name = str_new(ld + 5, ll - 5);
                    have_name = 1;
                }
            }
            if (ll >= 12) {
                if (memeq(ld, "PNPDeviceID=", 12) == 1) {
                    cur_pci = win_pnp_pci_id(str_new(ld + 12, ll - 12));
                    cur_virtual = win_pnp_is_virtual(ld + 12, ll - 12);
                }
            }
        }
        i = i + 1;
    }
    if (have_name == 1 && cur_virtual == 0) {
        win_emit_gpu(profiles, dev_id, cur_name, cur_ram, cur_pci);
        count = count + 1;
    }
    return count;
}

#ifdef CYRIUS_TARGET_WIN

# --- DXGI adapter enumeration (PE only) --------------------------------------
# Walks the COM vtable through `callptr` as cyrius's reference lib/dxgi.cyr
# does (GPU-verified on cass). Each method N lives at load64(vtbl + N*8):
# IUnknown::Release @2, IDXGIFactory1::EnumAdapters1 @12,
# IDXGIAdapter1::GetDesc1 @10. HRESULTs are 32-bit, so they are masked before
# being compared with a specific code.

# Fill `dst` (>=16 bytes) with IID_IDXGIFactory1
# {770aae78-f26f-4dba-a829-253c83d1b387} in COM's little-endian-Data1..3 +
# big-endian-Data4 byte order.
fn win_dxgi_iid_factory1(dst) {
    store8(dst + 0, 0x78);  store8(dst + 1, 0xAE);  store8(dst + 2, 0x0A);  store8(dst + 3, 0x77);
    store8(dst + 4, 0x6F);  store8(dst + 5, 0xF2);  store8(dst + 6, 0xBA);  store8(dst + 7, 0x4D);
    store8(dst + 8, 0xA8);  store8(dst + 9, 0x29);  store8(dst + 10, 0x25); store8(dst + 11, 0x3C);
    store8(dst + 12, 0x83); store8(dst + 13, 0xD1); store8(dst + 14, 0xB3); store8(dst + 15, 0x87);
}

# IUnknown::Release(obj) @ vtable slot 2. No-op on NULL. (callptr is an
# expression-only builtin, so its discarded refcount return is bound to a
# local.)
fn win_dxgi_release(obj) {
    if (obj == 0) { return 0; }
    var vtbl = load64(obj);
    var rc = callptr(load64(vtbl + 2 * 8), obj);
    return 0;
}

# Push one ACCEL_WIN_GPU profile per hardware DXGI adapter, in enumeration
# order, with device ids 0,1,2… over the adapters kept. Returns the number
# pushed (0 is a real answer: DXGI works and lists only software adapters),
# or -1 when DXGI is unavailable — no factory, or EnumAdapters1(0) fails with
# anything but DXGI_ERROR_NOT_FOUND. A later index that fails, or an adapter
# whose GetDesc1 fails, is reported in `warnings` (once per kind) and
# enumeration carries on, so one bad adapter never hides the ones after it.
fn win_dxgi_enum_adapters(profiles, warnings) {
    var iid[16];
    win_dxgi_iid_factory1(&iid);
    var pFactory = 0;
    var hr = syscall(0xF012, &iid, &pFactory);     # CreateDXGIFactory1
    if ((hr & 0xFFFFFFFF) != 0) { return 0 - 1; }
    if (pFactory == 0) { return 0 - 1; }
    var fvtbl = load64(pFactory);
    var count = 0;
    var idx = 0;
    var unavailable = 0;
    var warned_enum = 0;
    var warned_desc = 0;
    while (idx < WIN_DXGI_MAX_ADAPTERS) {
        var pAdapter = 0;
        # EnumAdapters1(this, index, &pAdapter) @ IDXGIFactory1 slot 12.
        var hr2 = callptr(load64(fvtbl + 12 * 8), pFactory, idx, &pAdapter);
        hr2 = hr2 & 0xFFFFFFFF;
        if (hr2 == WIN_DXGI_ERROR_NOT_FOUND) { break; }
        var failed = 0;
        if (hr2 != 0) { failed = 1; }
        if (pAdapter == 0) { failed = 1; }
        if (failed == 1) {
            if (idx == 0) {
                unavailable = 1;
                break;
            }
            hwlog_debug_n("windows: dxgi EnumAdapters1 failed at index ", idx);
            if (warnings != 0) {
                if (warned_enum == 0) {
                    vec_push(warnings, warning_tool_failed("dxgi", 0 - 1, "EnumAdapters1 failed for an adapter"));
                    warned_enum = 1;
                }
            }
            idx = idx + 1;
            continue;
        }
        var avtbl = load64(pAdapter);
        var desc[WIN_DXGI_DESC_BUF];                   # DXGI_ADAPTER_DESC1
        # GetDesc1(this, &desc) @ IDXGIAdapter1 slot 10.
        var hr3 = callptr(load64(avtbl + 10 * 8), pAdapter, &desc);
        if ((hr3 & 0xFFFFFFFF) == 0) {
            count = count + win_dxgi_desc_emit(&desc, count, profiles);
        } else {
            hwlog_debug_n("windows: dxgi GetDesc1 failed at index ", idx);
            if (warnings != 0) {
                if (warned_desc == 0) {
                    vec_push(warnings, warning_tool_failed("dxgi", 0 - 1, "GetDesc1 failed for an adapter"));
                    warned_desc = 1;
                }
            }
        }
        var r1 = win_dxgi_release(pAdapter);
        idx = idx + 1;
    }
    var r2 = win_dxgi_release(pFactory);
    if (unavailable == 1) { return 0 - 1; }
    return count;
}

# SharedSystemMemory of the first hardware adapter with these PCI vendor and
# device IDs, or 0 (no such adapter, or DXGI unavailable). The Vulkan detector
# sizes an integrated GPU with it on Windows (2.5.3), instead of running the
# full vulkaninfo a second time (about 0.9 s on cass).
fn win_dxgi_shared_bytes(vendor, device) {
    var iid[16];
    win_dxgi_iid_factory1(&iid);
    var pFactory = 0;
    var hr = syscall(0xF012, &iid, &pFactory);     # CreateDXGIFactory1
    if ((hr & 0xFFFFFFFF) != 0) { return 0; }
    if (pFactory == 0) { return 0; }
    var fvtbl = load64(pFactory);
    var found = 0;
    var idx = 0;
    while (idx < WIN_DXGI_MAX_ADAPTERS) {
        var pAdapter = 0;
        var hr2 = callptr(load64(fvtbl + 12 * 8), pFactory, idx, &pAdapter);
        if ((hr2 & 0xFFFFFFFF) != 0) { break; }
        if (pAdapter == 0) { break; }
        var avtbl = load64(pAdapter);
        var desc[WIN_DXGI_DESC_BUF];
        var hr3 = callptr(load64(avtbl + 10 * 8), pAdapter, &desc);
        var r1 = win_dxgi_release(pAdapter);
        idx = idx + 1;
        if ((hr3 & 0xFFFFFFFF) != 0) { continue; }
        if (win_dxgi_desc_is_software(&desc) == 1) { continue; }
        if (load32(&desc + WIN_DXGI_DESC_VENDOR) != vendor) { continue; }
        if (load32(&desc + WIN_DXGI_DESC_DEVICE) != device) { continue; }
        found = win_dxgi_desc_shared(&desc);
        break;
    }
    var r2 = win_dxgi_release(pFactory);
    return found;
}

# Detect Windows-visible GPUs. DXGI always runs (no subprocess). Only when
# DXGI is unavailable, and only if `allow_exec` is 1, does it fall back to
# wmic, found through which() and started by that absolute path (2.5.3).
# Through 2.5.2 it was started by its bare name, which CreateProcessW looks up
# in the current directory before System32. DXGI being unavailable is always
# reported in `warnings`, so a missing GPU list is never silent.
fn detect_windows_opts(profiles, warnings, allow_exec) {
    var n = win_dxgi_enum_adapters(profiles, warnings);
    if (n >= 0) {
        hwlog_debug_n("windows: dxgi hardware adapters=", n);
        return n;
    }
    if (warnings != 0) {
        vec_push(warnings, warning_tool_failed("dxgi", 0 - 1, "DXGI adapter enumeration unavailable"));
    }
    if (win_gpu_use_wmic_fallback(n, allow_exec) == 0) {
        hwlog_debug("windows: dxgi unavailable, wmic fallback not allowed (no-exec)");
        return 0;
    }
    hwlog_debug("windows: dxgi unavailable, falling back to wmic");
    # Through run_tool_status (2.5.5), as every other tool runs: which(), the
    # quoted program token, the deadline, the capture buffer and its
    # warnings. Through 2.5.4 this was a hand-made copy of it that pushed no
    # "exec failed" or output-cut warning, and both an exit-status warning and
    # "query failed" when wmic failed silently.
    var args = vec_new();
    vec_push(args, "path");
    vec_push(args, "win32_VideoController");
    vec_push(args, "get");
    vec_push(args, "Name,AdapterRAM,PNPDeviceID");
    vec_push(args, "/format:list");
    var st[16];
    var out = run_tool_status("wmic", args, warnings, &st);
    if (out == 0) { return 0; }
    var ew = tool_run_warning("wmic", out, &st);
    if (ew != 0 && warnings != 0) { vec_push(warnings, ew); }
    if (str_len(out) == 0) {
        if (ew == 0 && warnings != 0) {
            vec_push(warnings, warning_tool_failed("wmic", 0 - 1, "win32_VideoController query failed"));
        }
        return 0;
    }
    return win_parse_videocontrollers(out, profiles);
}

# detect_windows_opts with exec allowed (the wmic fallback may run).
fn detect_windows(profiles, warnings) {
    return detect_windows_opts(profiles, warnings, 1);
}

#endif

# --- registry.cyr ---

# registry.cyr — accelerator registry: detect, query, plan
#
# Registry — profiles + warnings + system_io + schema_version.
# Struct named `reg` to match the `reg_*` accessor convention;
# constructor is `hw_registry_new` (renamed from `registry_new` to
# avoid the bote-core `registry_new` symbol collision — fns/enum
# members are global in Cyrius, last-def-wins; see
# docs/development/issues/2026-06-11-registry-new-collision.md).
# No `registry_new` alias: an alias by that name would reintroduce
# the exact collision. 2.1.5: hand-rolled accessors
# replaced with #derive(accessors); the internal `load64(r)` /
# `load64(r + N)` shortcuts in helpers below switched to the
# derived `reg_*` getters for consistency with the rest of the file.

#derive(accessors)
struct reg {
    profiles;
    warnings;
    system_io;
    schema;
}

# sizeof, not a literal (2.5.5); REGISTRY_SIZE stays for consumers.
var REGISTRY_SIZE = sizeof(reg);

fn hw_registry_new() {
    var r = alloc(sizeof(reg));
    reg_set_profiles(r, vec_new());
    reg_set_warnings(r, vec_new());
    reg_set_system_io(r, system_io_new());
    reg_set_schema(r, SCHEMA_VERSION);
    return r;
}

fn reg_add_profile(r, p) {
    vec_push(reg_profiles(r), p);
    return 0;
}

# --- Query methods ---

fn reg_num_profiles(r) {
    return vec_len(reg_profiles(r));
}

# The profile at `idx`, or 0 when `idx` is outside [0, reg_num_profiles(r))
# (2.5.5). Through 2.5.4 a stale index reached vec_get's abort, which exits
# the calling thread, so a library consumer lost its thread, or its process.
fn reg_get_profile(r, idx) {
    var profs = reg_profiles(r);
    if (idx < 0 || idx >= vec_len(profs)) { return 0; }
    return vec_get(profs, idx);
}

fn reg_num_warnings(r) {
    return vec_len(reg_warnings(r));
}

# Total memory of the available devices (`skip_cpu` 1: the accelerators
# only), counting system RAM once.
#
# A profile's `shared_mem` part is system RAM (see src/profile.cyr): all of the
# CPU's memory, all of a unified-memory device's (Apple Silicon's GPU and
# Neural Engine, the client NPUs), GH200's 480 GiB of Grace memory. Summing
# memory_bytes counted that RAM once per profile: a 48 GB M5 Pro totalled
# 100 GiB in 2.3.27 (CPU 48 + GPU 48 + Neural Engine 4). So the shared parts
# fold into one pool, the largest of them, and only the rest adds up. With no
# shared-memory device the pool is the CPU's RAM and the result is the plain
# sum, as before. One host per registry: the pool is a max, not a sum. Both
# totals used a copy of this loop through 2.5.4.
fn _reg_total_mem(r, skip_cpu) {
    var profs = reg_profiles(r);
    var total = 0;
    var pool = 0;
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (skip_cpu == 1) {
            if (profile_accel_type(p) == ACCEL_CPU) { continue; }
        }
        # profile_shared_bytes, inlined: a call per profile cost +70% on
        # total_memory_13dev. A device that shares nothing adds its memory
        # as before, for one extra load and compare.
        if (profile_shared_mem(p) == 0) {
            total = total + profile_memory_bytes(p);
            continue;
        }
        var part = profile_shared_mem(p);
        if (part > profile_memory_bytes(p)) { part = profile_memory_bytes(p); }
        if (part < 0) { part = 0; }
        if (part > pool) { pool = part; }
        total = total + profile_memory_bytes(p) - part;
    }
    return total + pool;
}

# Total memory across all available devices, counting system RAM once.
fn reg_total_memory(r) {
    return _reg_total_mem(r, 0);
}

# Total accelerator memory (excludes CPU), counting shared system RAM once:
# dedicated accelerator memory plus the largest shared part any accelerator
# can address (48 GiB on that M5 Pro, not GPU 48 + Neural Engine 4).
fn reg_total_accel_memory(r) {
    return _reg_total_mem(r, 1);
}

# Whether any non-CPU accelerator is available
fn reg_has_accelerator(r) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_accel_type(p) != ACCEL_CPU) { return 1; }
    }
    return 0;
}

# Best available device (highest rank)
fn reg_best_available(r) {
    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var best = 0;
    var best_rank = 0;
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        var rank = profile_rank(p);
        if (rank > best_rank) {
            best_rank = rank;
            best = p;
        }
    }
    return best;
}

# How many profiles in `profs` are available and of `family`.
fn _profiles_count_by_family(profs, family) {
    var count = 0;
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_family(p) == family) { count = count + 1; }
    }
    return count;
}

# Count available profiles by family
fn reg_count_by_family(r, family) {
    return _profiles_count_by_family(reg_profiles(r), family);
}

# Refill vec `out` with the available profiles of `family` in `profs`, in
# order, and return it. The one family filter, behind reg_by_family_into and
# lazy_by_family_into (through 2.5.4 lazy.cyr had its own copy).
fn _profiles_by_family_into(profs, family, out) {
    vec_truncate(out, 0);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        if (profile_family(p) == family) { vec_push(out, p); }
    }
    return out;
}

# The available profiles of `family`, into the caller's vec `out` (emptied
# first), which is returned. A reused `out` keeps its buffer, so a consumer
# that queries a long-lived registry per request stops allocating once it
# has grown (2.5.5).
fn reg_by_family_into(r, family, out) {
    return _profiles_by_family_into(reg_profiles(r), family, out);
}

# The available profiles of `family`, in a new vec. Allocates a vec per
# call, which the bump allocator never frees; repeat queries use
# reg_by_family_into.
fn reg_by_family(r, family) {
    return reg_by_family_into(r, family, vec_new());
}

# Estimate memory for model_params at given quantization
fn reg_estimate_memory(model_params, quant) {
    return quant_model_bytes_with_overhead(model_params, quant);
}

# Suggest a quantization level for `model_params` from the available
# hardware: the largest device of the first kind that holds the model, at
# that kind's preferred level or the next one down it supports. The kinds, in
# order: TPU (BF16, INT8); the BF16 AI ASICs, Gaudi, Neuron and Cerebras
# (BF16, INT8); GPU (FP16, INT8, INT4); Graphcore (FP16, INT8); Qualcomm and
# Groq (INT8, INT4); NPU (INT8, INT4); then the CPU's RAM (FP16, INT8, INT4).
# Through 2.5.4 only Gaudi counted among the AI ASICs, so a Trainium,
# Inferentia, Cloud AI 100, Cerebras, Graphcore or Groq host was answered
# from its host RAM. An accel type this build does not know counts as
# nothing.
fn reg_suggest_quant(r, model_params) {
    var best_tpu = 0;
    var best_asic_bf16 = 0;
    var best_gpu = 0;
    var best_asic_fp16 = 0;
    var best_asic_int8 = 0;
    var best_npu = 0;
    var best_cpu = 0;

    var profs = reg_profiles(r);
    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        var mem = profile_memory_bytes(p);
        var fam = profile_family(p);
        if (fam == FAMILY_TPU) { if (mem > best_tpu) { best_tpu = mem; } }
        elif (fam == FAMILY_GPU) { if (mem > best_gpu) { best_gpu = mem; } }
        elif (fam == FAMILY_NPU) { if (mem > best_npu) { best_npu = mem; } }
        elif (fam == FAMILY_CPU) { if (mem > best_cpu) { best_cpu = mem; } }
        elif (fam == FAMILY_AI_ASIC) {
            var pq = profile_preferred_quant(p);
            if (pq == QUANT_BF16) { if (mem > best_asic_bf16) { best_asic_bf16 = mem; } }
            elif (pq == QUANT_INT8) { if (mem > best_asic_int8) { best_asic_int8 = mem; } }
            elif (mem > best_asic_fp16) { best_asic_fp16 = mem; }
        }
    }

    var est_bf16 = reg_estimate_memory(model_params, QUANT_BF16);
    var est_fp16 = reg_estimate_memory(model_params, QUANT_FP16);
    var est_int8 = reg_estimate_memory(model_params, QUANT_INT8);
    var est_int4 = reg_estimate_memory(model_params, QUANT_INT4);

    # TPU -> BF16
    if (best_tpu > 0) {
        if (est_bf16 <= best_tpu) { return QUANT_BF16; }
        if (est_int8 <= best_tpu) { return QUANT_INT8; }
    }
    # Gaudi, Neuron, Cerebras -> BF16
    if (best_asic_bf16 > 0) {
        if (est_bf16 <= best_asic_bf16) { return QUANT_BF16; }
        if (est_int8 <= best_asic_bf16) { return QUANT_INT8; }
    }
    # GPU -> FP16
    if (best_gpu > 0) {
        if (est_fp16 <= best_gpu) { return QUANT_FP16; }
        if (est_int8 <= best_gpu) { return QUANT_INT8; }
        if (est_int4 <= best_gpu) { return QUANT_INT4; }
    }
    # Graphcore -> FP16 (no INT4)
    if (best_asic_fp16 > 0) {
        if (est_fp16 <= best_asic_fp16) { return QUANT_FP16; }
        if (est_int8 <= best_asic_fp16) { return QUANT_INT8; }
    }
    # Qualcomm, Groq -> INT8/INT4
    if (best_asic_int8 > 0) {
        if (est_int8 <= best_asic_int8) { return QUANT_INT8; }
        if (est_int4 <= best_asic_int8) { return QUANT_INT4; }
    }
    # NPU -> INT8/INT4
    if (best_npu > 0) {
        if (est_int8 <= best_npu) { return QUANT_INT8; }
        if (est_int4 <= best_npu) { return QUANT_INT4; }
    }
    # CPU fallback
    var cpu_mem = best_cpu;
    if (cpu_mem == 0) { cpu_mem = 16 * BYTES_PER_GIB; }
    if (est_fp16 <= cpu_mem) { return QUANT_FP16; }
    if (est_int8 <= cpu_mem) { return QUANT_INT8; }
    return QUANT_INT4;
}

# --- Detection builder (bitmask) ---

# All backends enabled
fn builder_all() { return (1 << AIHW_BACKEND_COUNT) - 1; }

# No backends enabled
fn builder_none() { return 0; }

# Enable/disable a backend
fn builder_with(mask, backend) { return mask | (1 << backend); }
fn builder_without(mask, backend) { return mask & (~(1 << backend)); }
fn builder_is_enabled(mask, backend) { return (mask >> backend) & 1; }

# Mask of backends that can run without spawning a subprocess (sysfs,
# syscalls, DXGI, sysctl). registry_detect_with() of this mask, or of any mask
# without an exec backend, spawns nothing (2.5.1; see registry_detect_with).
# registry_detect_no_exec() is the same call.
fn builder_no_exec() {
    var mask = 0;
    var b = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (backend_uses_exec(b) == 0) {
            mask = mask | (1 << b);
        }
        b = b + 1;
    }
    return mask;
}

# 1 if `mask` enables a backend that runs a vendor tool (backend_uses_exec),
# else 0. Without one, the detect entry points spawn nothing (2.5.1).
fn builder_uses_exec(mask) {
    if ((mask & (~builder_no_exec())) == 0) { return 0; }
    return 1;
}

# --- One physical device, one profile (2.4.0) ---

# 1 if `name` (a cstr, or 0) is a backend's stand-in rather than a model name:
# missing, ROCm's sysfs fallback ("AMD Radeon (PCI 0x1002:0x1638)", or "AMD
# Radeon"), the Apple backend's "Apple Silicon" / "Apple Silicon (Asahi
# Linux)", or the Vulkan sysfs scan's "<vendor> GPU (Vulkan)" and "Unknown
# GPU". Through 2.5.3 the scan's names did not count, so where vulkaninfo was
# missing (or, since 2.5.4, fails) ROCm's GPU took "AMD GPU (Vulkan)" in place
# of its own placeholder. Pure.
fn profile_name_is_placeholder(name) {
    if (name == 0) { return 1; }
    var n = strlen(name);
    if (n == 0) { return 1; }
    if (streq(name, "AMD Radeon") == 1) { return 1; }
    if (n >= 16) {
        if (memeq(name, "AMD Radeon (PCI ", 16) == 1) { return 1; }
    }
    if (streq(name, "Apple Silicon") == 1) { return 1; }
    if (streq(name, "Apple Silicon (Asahi Linux)") == 1) { return 1; }
    if (streq(name, "Unknown GPU") == 1) { return 1; }
    if (n > 13) {
        if (memeq(name + n - 13, " GPU (Vulkan)", 13) == 1) { return 1; }
    }
    return 0;
}

# 1 if profile `q` lacks what a dropped view hands its twin: a model name
# (its name is a placeholder) or a memory figure (0). Pure.
fn _dedup_unfilled(q) {
    if (profile_memory_bytes(q) == 0) { return 1; }
    return profile_name_is_placeholder(profile_device_name(q));
}

# The profile that `p` is another view of, or 0 (2.5.3). Several backends can
# report one GPU, and they rank: a vendor backend (CUDA, ROCm, oneAPI) above
# Windows's DXGI above Vulkan. For a Vulkan or Windows GPU profile with a
# nonzero pci_id, the twin is the best-ranked profile above it with that
# pci_id: a vendor profile, else (for Vulkan) the first Windows GPU. Among
# vendor profiles it is the first one that still lacks what a view gives
# (_dedup_unfilled), else the first: pci_id is the PCI model ID, so identical
# cards share it, and through 2.5.4 every view paired with the first card,
# which left the second card's placeholder name in place. For a Vulkan
# integrated GPU on system RAM with no such profile, it is the first Apple
# Metal profile. Every other type has no twin. Pure.
#
# The ranks are inline type tests, not a rank function: the pass runs once
# per detection, and dedup_17dev measured a call per profile at +6% (2.5.3).
fn _dedup_twin(profiles, p) {
    var tp = profile_accel_type(p);
    var is_vk = 0;
    if (tp == ACCEL_VULKAN) { is_vk = 1; }
    elif (tp != ACCEL_WIN_GPU) { return 0; }
    var pid = profile_pci_id(p);
    var on_ram = 0;
    if (is_vk == 1) {
        if (profile_shared_bytes(p) > 0) { on_ram = 1; }
    }
    var vend = 0;
    var win = 0;
    var metal = 0;
    var n = vec_len(profiles);
    var i = 0;
    while (i < n) {
        var q = vec_get(profiles, i);
        i = i + 1;
        var t = profile_accel_type(q);
        if (pid != 0) {
            if (profile_pci_id(q) == pid) {
                if (t == ACCEL_CUDA || t == ACCEL_ROCM || t == ACCEL_INTEL_ONEAPI) {
                    if (_dedup_unfilled(q) == 1) { return q; }
                    if (vend == 0) { vend = q; }
                }
                if (t == ACCEL_WIN_GPU && is_vk == 1 && win == 0) { win = q; }
            }
        }
        if (on_ram == 1) {
            if (metal == 0 && t == ACCEL_METAL) { metal = q; }
        }
    }
    if (vend != 0) { return vend; }
    if (win != 0) { return win; }
    return metal;
}

# Log (at debug) that profile `p` was dropped as a view of `twin`, and that
# `twin` takes its name (`renamed` 1) and its memory figure (`took_mem` 1).
# Call before renaming.
fn _dedup_log(p, twin, renamed, took_mem) {
    if (hwlog_enabled(SK_DEBUG) == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "dedup: ");
    str_builder_add_cstr(sb, accel_name(profile_accel_type(p)));
    str_builder_add_cstr(sb, " ");
    if (profile_device_name(p) != 0) { str_builder_add_cstr(sb, profile_device_name(p)); }
    str_builder_add_cstr(sb, " is the ");
    str_builder_add_cstr(sb, accel_name(profile_accel_type(twin)));
    str_builder_add_cstr(sb, " ");
    if (profile_device_name(twin) != 0) { str_builder_add_cstr(sb, profile_device_name(twin)); }
    str_builder_add_cstr(sb, "; dropped");
    if (renamed == 1) { str_builder_add_cstr(sb, ", its name kept"); }
    if (took_mem == 1) { str_builder_add_cstr(sb, ", its memory size kept"); }
    var m = str_builder_build(sb);
    sakshi_debug(str_data(m), str_len(m));
    return 0;
}

# Several backends can report one GPU. Vulkan sees the cards CUDA, ROCm and
# oneAPI see, and on Apple Silicon the GPU the Apple backend reports; on
# Windows, DXGI lists every GPU too (2.5.3). The best-ranked view survives
# (_dedup_twin: vendor backend, then DXGI, then Vulkan), with its own memory
# figure and fields, and the others are dropped:
#   - a Vulkan or Windows GPU profile whose pci_id (PCI vendor and device ID)
#     matches a better-ranked profile's. Every such profile goes, so a GPU
#     listed by two Vulkan drivers (RADV and AMDVLK) goes twice. A device no
#     better backend reports, such as an Intel iGPU next to an NVIDIA card,
#     stays. The Rust releases dropped every Vulkan GPU whenever any CUDA or
#     ROCm GPU was found, that iGPU included.
#   - an integrated Vulkan GPU on system RAM when an Apple Metal profile exists:
#     MoltenVK (macOS) and Honeykrisp (Asahi Linux) list the same SoC GPU.
# A survivor whose name is a placeholder (profile_name_is_placeholder) takes
# the dropped profile's name, which has the model: on the dev host, ROCm's
# "AMD Radeon (PCI 0x1002:0x1638)" becomes RADV's "AMD Radeon Graphics (RADV
# RENOIR)". A Windows GPU survivor of a Vulkan view on system RAM takes that
# view's memory and shared part: DXGI gives an integrated GPU its boot-time
# carve-out, and vulkaninfo its heap (cass's UHD 600: 128 MiB becomes
# 4 202 799 104 bytes, all shared). So does a survivor with no memory figure
# (2.5.5) from a view vulkaninfo named, such as a GB10 from nvidia-smi's
# "[N/A]" that nothing sized from system RAM. Order is kept; `profiles` is
# compacted in place. Returns the number of profiles dropped. Through 2.3.29
# nothing was dropped: the dev host listed its one iGPU twice and counted its
# 8 GiB twice.
fn profiles_dedup(profiles) {
    var n = vec_len(profiles);
    if (n < 2) { return 0; }
    var drop = alloc(n);
    var i = 0;
    while (i < n) {
        store8(drop + i, 0);
        var p = vec_get(profiles, i);
        var t = profile_accel_type(p);
        if (t == ACCEL_VULKAN || t == ACCEL_WIN_GPU) {
            var twin = _dedup_twin(profiles, p);
            if (twin != 0) {
                store8(drop + i, 1);
                var rename = 0;
                if (profile_name_is_placeholder(profile_device_name(twin)) == 1) {
                    if (profile_name_is_placeholder(profile_device_name(p)) == 0) { rename = 1; }
                }
                var take_mem = 0;
                if (profile_accel_type(twin) == ACCEL_WIN_GPU) {
                    if (profile_shared_bytes(p) > 0) { take_mem = 1; }
                }
                # A twin with no memory figure takes a vulkaninfo view's heap;
                # the sysfs scan's figure is a guess, and its name says so.
                if (profile_memory_bytes(twin) == 0 && profile_memory_bytes(p) > 0) {
                    if (profile_name_is_placeholder(profile_device_name(p)) == 0) { take_mem = 1; }
                }
                _dedup_log(p, twin, rename, take_mem);
                if (rename == 1) { profile_set_device_name(twin, profile_device_name(p)); }
                if (take_mem == 1) {
                    profile_set_memory_bytes(twin, profile_memory_bytes(p));
                    profile_set_shared_mem(twin, profile_shared_mem(p));
                }
            }
        }
        i = i + 1;
    }
    var kept = 0;
    i = 0;
    while (i < n) {
        if (load8(drop + i) == 0) {
            vec_set(profiles, kept, vec_get(profiles, i));
            kept = kept + 1;
        }
        i = i + 1;
    }
    vec_truncate(profiles, kept);
    return n - kept;
}

# --- Logging the detectors' diagnostics ---

# Log each warning in `warns` from index `from` on that says something went
# wrong: at warn, a parse warning as "<tool>: <message>" and a tool killed at
# its deadline as warning_describe gives it ("hl-smi: timed out after 10s");
# at info, a tool that ran and failed ("nvidia-smi: exited with status 9").
# Tool-not-found and sysfs warnings stay in the JSON `warnings` array only,
# so a host without a vendor tool stays silent at the default WARN level. The JSON lists tool names
# only, so through 2.5.4, which logged parse warnings alone, a failing tool
# looked the same as a missing one to a CLI or wheel user.
#
# Every entry point calls this on its own thread after the detectors are
# done (2.3.21): lib/sakshi.cyr's logger is single-threaded, and the parsers
# run on registry_detect_threaded's detector threads, so they push warnings
# and never log. It lives here, not in error.cyr, because it needs log.cyr,
# which units that test error.cyr alone do not include (2.5.5). Issue
# 2026-09-07-threaded-detect-vs-single-threaded-sakshi.
fn warnings_log_parse(warns, from) {
    if (hwlog_enabled(SK_WARN) == 0) { return 0; }
    var n = vec_len(warns);
    var i = from;
    while (i < n) {
        var w = vec_get(warns, i);
        i = i + 1;
        var code = warning_code(w);
        var m = 0;
        var info = 0;
        if (code == HWA_ERR_PARSE) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, warning_tool(w));
            str_builder_add_cstr(sb, ": ");
            if (warning_message(w) != 0) { str_builder_add_cstr(sb, warning_message(w)); }
            m = str_builder_build(sb);
        } elif (code == HWA_ERR_TIMEOUT) {
            m = warning_describe(w);
        } elif (code == HWA_ERR_TOOL_FAILED) {
            # At INFO (-v), not the default WARN: vulkaninfo exits 1 on any
            # host without a Vulkan GPU, which is no news worth a line there.
            # The JSON warnings array names the tool either way.
            if (hwlog_enabled(SK_INFO) == 1) {
                m = warning_describe(w);
                info = 1;
            }
        }
        if (m != 0) {
            if (info == 1) { hwlog_info(str_data(m)); } else { hwlog_warn(str_data(m)); }
        }
    }
    return 0;
}

# --- Full detection orchestration ---

# Post-passes shared by every detection entry point (registry_detect_with_opts,
# registry_detect_threaded_with, lazy_into_registry), in two halves (2.5.2):
# registry_profile_passes, which works on the profiles alone, then
# registry_system_passes, which fills the registry's system I/O. The lazy
# registry runs the first on each family's new profiles and the second once,
# in lazy_into_registry; the other entry points run both, through this.
fn registry_post_passes(r, allow_exec) {
    registry_profile_passes(reg_profiles(r));
    registry_system_passes(r, allow_exec);
    return 0;
}

# Drop duplicate views of one device (profiles_dedup, 2.4.0), then enrich the
# profiles from sysfs. Nothing here spawns a process, and every enrichment
# skips a field already set.
fn registry_profile_passes(profs) {
    # First, so enrichment runs once per physical device.
    profiles_dedup(profs);
    enrich_bandwidth(profs);
    enrich_pcie(profs);
    enrich_numa(profs);
    return 0;
}

# Fill the registry's system I/O from its profiles. The three passes take the
# registry's system_io, NOT the registry — through 2.3.24 the threaded and lazy
# paths passed `r`, which pushed interconnects into profiles and storage into
# warnings and replaced system_io with the environment struct, so serializing
# that registry segfaulted. The interconnect pass runs either way, and
# `allow_exec` 0 leaves out only its `nvidia-smi nvlink -s` run (InfiniBand,
# NVSwitch and XGMI it reads from sysfs, ICI from the TPU profiles); through
# 2.5.4 it was skipped whole without exec.
fn registry_system_passes(r, allow_exec) {
    var profs = reg_profiles(r);
    var sio = reg_system_io(r);
    detect_interconnects_opts(sio, profs, reg_warnings(r), allow_exec);
    detect_storage(sio);
    detect_environment(sio);
    # Last, so the interconnect pass's own "nvidia-smi not found" folds into
    # the CUDA backend's.
    warnings_dedup_missing(reg_warnings(r));
    return 0;
}

# Run the detectors `builder_mask` enables, pushing their profiles onto `profs`
# and their diagnostics onto `warns`; no CPU profile, no post-passes. Every
# entry point detects through this: the threaded one per thread, the lazy
# registry one family's backends at a time (2.5.2). `allow_exec` (0 or 1) is
# passed down as is: the native backends that can run a tool (Apple, Vulkan,
# Gaudi, Neuron, Windows) run it only with 1, and a caller that forbids exec
# strips the exec backends from the mask itself.
fn registry_run_detectors(profs, warns, builder_mask, allow_exec) {
    if (builder_is_enabled(builder_mask, BACKEND_CUDA) == 1) { detect_cuda(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_ROCM) == 1) { detect_rocm(profs, warns); }
    if (builder_is_enabled(builder_mask, BACKEND_APPLE) == 1) {
        detect_apple_opts(profs, warns, allow_exec);
    }
    if (builder_is_enabled(builder_mask, BACKEND_VULKAN) == 1) {
        # vulkaninfo only with exec; otherwise the sysfs scan. With exec off it
        # leaves amdgpu devices to ROCm when ROCm runs too, so no-exec mode
        # gains the Intel and NVIDIA GPUs it lacked without a second AMD
        # profile.
        var leave_amd = 0;
        if (allow_exec == 0) { leave_amd = builder_is_enabled(builder_mask, BACKEND_ROCM); }
        detect_vulkan_opts(profs, warns, allow_exec, leave_amd);
    }
    if (builder_is_enabled(builder_mask, BACKEND_INTEL_NPU) == 1) {
        detect_intel_npu(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_AMD_XDNA) == 1) {
        detect_amd_xdna(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_TPU) == 1) { detect_tpu(profs, warns); }
    # hl-smi, neuron-ls, cerebras_cli and gc-info only with exec; otherwise
    # the habanalabs accel nodes, /dev/neuron<N>, /dev/cerebras* and
    # /dev/ipu<N> (2.5.5: through 2.5.4 no-exec mode skipped all four).
    if (builder_is_enabled(builder_mask, BACKEND_GAUDI) == 1) {
        detect_gaudi_opts(profs, warns, allow_exec);
    }
    if (builder_is_enabled(builder_mask, BACKEND_NEURON) == 1) {
        detect_neuron_opts(profs, warns, allow_exec);
    }
    if (builder_is_enabled(builder_mask, BACKEND_INTEL_ONEAPI) == 1) {
        detect_intel_oneapi(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_QUALCOMM) == 1) {
        detect_qualcomm(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_CEREBRAS) == 1) {
        detect_cerebras_opts(profs, warns, allow_exec);
    }
    if (builder_is_enabled(builder_mask, BACKEND_GRAPHCORE) == 1) {
        detect_graphcore_opts(profs, warns, allow_exec);
    }
    if (builder_is_enabled(builder_mask, BACKEND_GROQ) == 1) {
        detect_groq(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_SAMSUNG_NPU) == 1) {
        detect_samsung_npu(profs, warns);
    }
    if (builder_is_enabled(builder_mask, BACKEND_MEDIATEK_APU) == 1) {
        detect_mediatek_apu(profs, warns);
    }
    #ifdef CYRIUS_TARGET_WIN
    # Windows-native GPU detection: DXGI adapter enumeration, which spawns
    # nothing, so it runs with allow_exec 0 too; only its wmic fallback
    # (DXGI unavailable) needs allow_exec. detect_windows_opts exists only on
    # PE builds, so both the symbol and call are gated.
    if (builder_is_enabled(builder_mask, BACKEND_WINDOWS) == 1) {
        detect_windows_opts(profs, warns, allow_exec);
    }
    #endif
    return 0;
}

fn registry_detect() {
    return registry_detect_with_opts(builder_all(), 1);
}

# Detect with only the backends in `builder_mask`. A mask that holds no exec
# backend (backend_uses_exec) spawns nothing: it runs with allow_exec 0, so
# Vulkan uses its sysfs scan instead of `vulkaninfo`, Gaudi and Neuron their
# device nodes instead of `hl-smi` and `neuron-ls`, the system_profiler and
# wmic fallbacks are skipped, and so is the interconnect pass's
# `nvidia-smi nvlink -s`. Through 2.5.0 every mask ran with exec allowed, so
# registry_detect_with(builder_no_exec()) still spawned all four. For tools
# with an exec-free mask, call registry_detect_with_opts(mask, 1).
fn registry_detect_with(builder_mask) {
    return registry_detect_with_opts(builder_mask, builder_uses_exec(builder_mask));
}

# No-subprocess detection — masks off exec-shelling backends (defense
# in depth: even if the caller's mask had them set), runs the native ones
# without their tools, and runs the interconnect pass without its
# `nvidia-smi nvlink -s` (InfiniBand, NVSwitch, XGMI and ICI come from sysfs
# and the profiles). Safe to call from contexts that forbid process
# spawning, e.g. mihi probes. See backend_uses_exec() in types.cyr for the
# per-backend classification.
fn registry_detect_no_exec() {
    return registry_detect_with_opts(builder_no_exec(), 0);
}

fn registry_detect_with_opts(builder_mask, allow_exec) {
    # Any nonzero allow_exec is 1 (2.5.5): the detectors and passes test
    # `== 1`, so through 2.5.4 a 2 kept the exec backends but ran Vulkan,
    # Apple and the interconnect pass as if exec were off.
    if (allow_exec != 0) { allow_exec = 1; }
    # When exec is forbidden, force-strip any exec backends the caller
    # may have enabled. backend_uses_exec() is the source of truth.
    if (allow_exec == 0) {
        builder_mask = builder_mask & builder_no_exec();
    }

    hwlog_span_enter("detect");
    hwlog_debug_n("detect: builder_mask=", builder_mask);

    var r = hw_registry_new();
    var profs = reg_profiles(r);
    var warns = reg_warnings(r);

    # Always add CPU profile
    var sys_mem = detect_system_memory_opts(allow_exec);
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    reg_add_profile(r, profile_cpu(sys_mem));

    registry_run_detectors(profs, warns, builder_mask, allow_exec);

    # Post-passes: enrich profiles, then system I/O (the interconnect pass
    # runs `nvidia-smi nvlink -s` only with allow_exec).
    registry_post_passes(r, allow_exec);

    # The warnings that say something went wrong, at warn (warnings_log_parse),
    # then one summary line per detection pass at info. Counts are cheap
    # (vec_len); the messages are guarded inside hwlog_*_n so nothing builds
    # when suppressed.
    var nwarn = vec_len(warns);
    warnings_log_parse(warns, 0);
    if (nwarn > 0) { hwlog_info_n("detect: warnings=", nwarn); }
    hwlog_info_n("detect: profiles=", vec_len(profs));
    hwlog_span_exit();

    return r;
}

# Build a registry from a list of profiles (for testing)
fn registry_from_profiles(profile_vec) {
    var r = hw_registry_new();
    var n = vec_len(profile_vec);
    var i = 0;
    while (i < n) {
        reg_add_profile(r, vec_get(profile_vec, i));
        i = i + 1;
    }
    return r;
}

# --- plan.cyr ---

# plan.cyr — sharding and workload planning logic
# Strategy selection: single device -> tensor parallel -> pipeline parallel

# Largest TPU slice a plan tensor-parallelises over: a full Ironwood pod
# (9216 chips; a v5p pod is 8960). Case 2 makes one shard per chip, and a
# registry rebuilt from JSON can claim any tpu_chips.
enum PlanLimits {
    PLAN_MAX_TPU_CHIPS = 9216;
}

# Estimate tokens/sec for a single device
# Returns x1000 fixed-point. `accel_type` is unused; the signature is public.
fn estimate_tps_x1000(accel_type, tput_x1000, model_params, quant) {
    if (model_params <= 0) { return 0; }
    # tok/s = (1B / model_params) * throughput multiplier * quant speedup,
    # multiplied out before the one division so a large model keeps its
    # precision (through 2.5.4, 405B on Metal lost 19% and > 1T gave 0).
    # 1e6 * tput * quant (<= 8000) stays in i64 for tput <= 1e9; only a
    # hand-built profile claims more.
    var t = tput_x1000;
    if (t > 1000000000) { t = 1000000000; }
    var quant_x1000 = quant_reduction_x1000(quant);
    return TOKENS_PER_SEC_BASE / 1000 * t * quant_x1000 / model_params;
}

# Layers of `per_layer` bytes that device `d` holds, at most `est_layers`.
fn _pp_layer_cap(d, per_layer, est_layers) {
    var c = profile_memory_bytes(d) / per_layer;
    if (c < 0) { return 0; }
    if (c > est_layers) { return est_layers; }
    return c;
}

# Pipeline parallel over `devs`: layers in proportion to each device's
# memory and never more than it holds, each shard reporting the memory of
# its own layers. Through 2.5.4 every stage got needed/n bytes and the last
# one the whole layer remainder, so a small card (an 8 GiB dGPU beside a
# shared-memory iGPU) was handed more than it has. 0 when whole layers
# cannot be placed.
fn _plan_pipeline(devs, needed, model_params, quant, max_bw) {
    var n = vec_len(devs);
    var est_layers = model_params / PARAMS_PER_LAYER_ESTIMATE;
    if (est_layers < 1) { est_layers = 1; }
    # No more layers than the largest model the CLI takes, so the split's
    # layers * capacity product stays in i64.
    var max_layers = MODEL_PARAMS_MAX / PARAMS_PER_LAYER_ESTIMATE;
    if (est_layers > max_layers) { est_layers = max_layers; }
    var per_layer = needed / est_layers;
    if (needed > per_layer * est_layers) { per_layer = per_layer + 1; }

    var sum_cap = 0;
    var i = 0;
    while (i < n) {
        sum_cap = sum_cap + _pp_layer_cap(vec_get(devs, i), per_layer, est_layers);
        i = i + 1;
    }
    if (sum_cap < est_layers) { return 0; }

    # Floor shares leave fewer than n layers over. Every device with room
    # has a share below its capacity unless the pool is exactly full, so one
    # extra layer each to the first devices with room places all of them.
    var assigned = 0;
    i = 0;
    while (i < n) {
        assigned = assigned + est_layers * _pp_layer_cap(vec_get(devs, i), per_layer, est_layers) / sum_cap;
        i = i + 1;
    }
    var rem = est_layers - assigned;

    var sp = sharding_plan_new(SHARD_PIPELINE, 0);
    var stages = 0;
    var lnext = 0;
    var slowest = 999999000;
    i = 0;
    while (i < n) {
        var d = vec_get(devs, i);
        i = i + 1;
        var cap = _pp_layer_cap(d, per_layer, est_layers);
        var lc = est_layers * cap / sum_cap;
        if (rem > 0 && lc < cap) {
            lc = lc + 1;
            rem = rem - 1;
        }
        if (lc == 0) { continue; }
        var ms = model_shard_new(stages, lnext, lnext + lc - 1,
          profile_accel_type(d), profile_device_id(d), lc * per_layer);
        plan_add_shard(sp, ms);
        lnext = lnext + lc;
        stages = stages + 1;
        var st = profile_throughput_x1000(d);
        if (st < slowest) { slowest = st; }
    }
    plan_set_strategy_count(sp, stages);
    plan_set_total_memory(sp, needed);

    # Steady state: each stage runs at the slowest stage's per-device rate.
    var ic_eff = PP_PCIE_ONLY_EFFICIENCY_X1000;
    if (max_bw > 0) { ic_eff = PP_HIGH_BW_EFFICIENCY_X1000; }
    var per_stage = estimate_tps_x1000(
      profile_accel_type(vec_get(devs, 0)), slowest, model_params, quant);
    plan_set_est_tps_x1000(sp, per_stage * ic_eff / 1000 * stages);
    return sp;
}

# Generate a sharding plan for a model
fn reg_plan_sharding(r, model_params, quant) {
    var needed = reg_estimate_memory(model_params, quant);
    var sio = reg_system_io(r);
    var profs = reg_profiles(r);
    hwlog_debug_n("plan: model_params=", model_params);

    # Find best available device
    var best = reg_best_available(r);
    if (best == 0) {
        hwlog_warn("plan: no available accelerator, defaulting to data-parallel");
        var sp0 = sharding_plan_new(SHARD_DATA, 0);
        plan_set_fits(sp0, 0);
        return sp0;
    }

    # Case 1: fits on single best device
    if (needed <= profile_memory_bytes(best)) {
        var sp = sharding_plan_new(SHARD_NONE, 1);
        var at = profile_accel_type(best);
        var did = profile_device_id(best);
        var ms = model_shard_new(0, 0, 0, at, did, needed);
        plan_add_shard(sp, ms);
        plan_set_total_memory(sp, needed);
        var tps = estimate_tps_x1000(
          at, profile_throughput_x1000(best), model_params, quant);
        plan_set_est_tps_x1000(sp, tps);
        return sp;
    }

    # Collect TPU and GPU/ASIC devices
    var tpu_devs = vec_new();
    var tpu_mem = 0;
    var tpu_chips = 0;
    var tpu_chip_mem = HW_I64_MAX;
    var tpu_min_tput = 999999000;
    var gpu_devs = vec_new();
    var gpu_mem = 0;

    var n = vec_len(profs);
    var i = 0;
    while (i < n) {
        var p = vec_get(profs, i);
        i = i + 1;
        if (profile_available(p) != 1) { continue; }
        var at = profile_accel_type(p);

        if (at == ACCEL_TPU) {
            # An unknown chip count is one chip; an absurd one is a pod.
            var chips = profile_tpu_chips(p);
            if (chips < 1) { chips = 1; }
            if (chips > PLAN_MAX_TPU_CHIPS) { chips = PLAN_MAX_TPU_CHIPS; }
            vec_push(tpu_devs, p);
            tpu_mem = tpu_mem + profile_memory_bytes(p);
            tpu_chips = tpu_chips + chips;
            var cm = profile_memory_bytes(p) / chips;
            if (cm < tpu_chip_mem) { tpu_chip_mem = cm; }
            var tt = profile_throughput_x1000(p);
            if (tt < tpu_min_tput) { tpu_min_tput = tt; }
        }
        if (accel_is_gpu(at) == 1 || accel_is_ai_asic(at) == 1 || at == ACCEL_TPU) {
            vec_push(gpu_devs, p);
            gpu_mem = gpu_mem + profile_memory_bytes(p);
        }
    }
    if (tpu_chips > PLAN_MAX_TPU_CHIPS) { tpu_chips = PLAN_MAX_TPU_CHIPS; }

    # Case 2: TPU tensor parallel. Every chip holds an equal slice, so the
    # slice has to fit the smallest chip, not only the pooled memory.
    if (vec_len(tpu_devs) > 0 && tpu_mem >= needed) {
        var per_chip = needed / tpu_chips;
        if (needed > per_chip * tpu_chips) { per_chip = per_chip + 1; }
        if (per_chip <= tpu_chip_mem) {
            var sp = sharding_plan_new(SHARD_TENSOR, tpu_chips);
            var ci = 0;
            while (ci < tpu_chips) {
                var ms = model_shard_new(ci, 0, 0, ACCEL_TPU, ci, per_chip);
                plan_add_shard(sp, ms);
                ci = ci + 1;
            }
            plan_set_total_memory(sp, needed);
            var per_tpu = estimate_tps_x1000(ACCEL_TPU, tpu_min_tput, model_params, quant);
            plan_set_est_tps_x1000(sp, per_tpu * TPU_TP_ICI_BONUS_X1000 / 1000 * tpu_chips);
            return sp;
        }
    }

    # Case 3: GPU/ASIC multi-device
    if (vec_len(gpu_devs) > 0 && gpu_mem >= needed) {
        var has_nvsw = sio_has_nvswitch(sio);
        var max_bw = sio_max_ic_bw_x1000(sio);
        var num_devs = vec_len(gpu_devs);

        # Decide tensor vs pipeline parallel
        var use_tp = 0;
        var tp_bw_ok = max_bw > TP_MIN_INTERCONNECT_BW * 1000;
        var tp_devs_ok = num_devs <= TP_MAX_DEVICES_WITHOUT_NVSWITCH;
        if (has_nvsw == 1) { use_tp = 1; }
        elif (tp_bw_ok == 1 && tp_devs_ok == 1) {
            use_tp = 1;
        }

        # Tensor parallel puts an equal slice on every device: it needs one
        # kind of device, and the slice has to fit the smallest of them
        # (2.5.4 put 56 GB of a 70B model on a 24 GiB iGPU beside two H100s).
        var per_dev = needed / num_devs;
        if (needed > per_dev * num_devs) { per_dev = per_dev + 1; }
        var t0 = profile_accel_type(vec_get(gpu_devs, 0));
        if (use_tp == 1) {
            var ti = 0;
            while (ti < num_devs) {
                var tq = vec_get(gpu_devs, ti);
                if (profile_accel_type(tq) != t0 || per_dev > profile_memory_bytes(tq)) { use_tp = 0; }
                ti = ti + 1;
            }
        }

        if (use_tp == 1) {
            var sp = sharding_plan_new(SHARD_TENSOR, num_devs);
            var di = 0;
            while (di < num_devs) {
                var gp = vec_get(gpu_devs, di);
                var gat = profile_accel_type(gp);
                var gdid = profile_device_id(gp);
                var ms = model_shard_new(di, 0, 0, gat, gdid, per_dev);
                plan_add_shard(sp, ms);
                di = di + 1;
            }
            plan_set_total_memory(sp, needed);

            # Throughput: slowest device's rate * num_devices * IC bonus
            var slowest = 999999000;
            di = 0;
            while (di < num_devs) {
                var gt = profile_throughput_x1000(vec_get(gpu_devs, di));
                if (gt < slowest) { slowest = gt; }
                di = di + 1;
            }
            var ic_bonus = 1000;
            if (has_nvsw == 1) { ic_bonus = NVSWITCH_TP_BONUS_X1000; }
            else {
                ic_bonus = 1000 + max_bw / TP_INTERCONNECT_BW_DIVISOR;
                var ic_max = 1000 + MAX_NON_NVSWITCH_TP_BONUS_X1000;
                if (ic_bonus > ic_max) { ic_bonus = ic_max; }
            }
            var per_gpu = estimate_tps_x1000(t0, slowest, model_params, quant);
            plan_set_est_tps_x1000(sp, per_gpu * ic_bonus / 1000 * num_devs);
            return sp;
        }

        var spp = _plan_pipeline(gpu_devs, needed, model_params, quant, max_bw);
        if (spp != 0) { return spp; }
    }

    # Case 4: CPU fallback. It fits only when the largest available CPU
    # profile holds the whole model; otherwise the plan says so (through
    # 2.5.4 it looked exactly like a plan that fits).
    var cpu_mem = 0;
    i = 0;
    while (i < n) {
        var cp = vec_get(profs, i);
        i = i + 1;
        if (profile_available(cp) != 1) { continue; }
        if (profile_accel_type(cp) != ACCEL_CPU) { continue; }
        if (profile_memory_bytes(cp) > cpu_mem) { cpu_mem = profile_memory_bytes(cp); }
    }
    var sp = sharding_plan_new(SHARD_NONE, 1);
    if (needed > cpu_mem) {
        hwlog_warn("plan: the model does not fit in accelerator or CPU memory");
        plan_set_fits(sp, 0);
    }
    var ms = model_shard_new(0, 0, 0, ACCEL_CPU, 0, needed);
    plan_add_shard(sp, ms);
    plan_set_total_memory(sp, needed);
    var cpu_tps = estimate_tps_x1000(ACCEL_CPU, 1000, model_params, quant);
    plan_set_est_tps_x1000(sp, cpu_tps);
    return sp;
}

# --- training.cyr ---

# training.cyr — training method types and memory estimation
# All memory values in GiB x1000 fixed-point to avoid floats
# (14000 = 14.0 GiB, 1400 = 1.4 GiB). Weights are bf16, 2 B/param ("base").
#
# Full fine-tuning is mixed-precision AdamW, about 16 B/param before
# activations: the bf16 weights (2) plus an optimizer figure of 7x base
# that counts the gradients (2), the fp32 master copy (4) and Adam's m and
# v (4 + 4). DPO, RLHF and distillation train one model with the same 7x
# and hold the others frozen. Through 2.5.4 the optimizer was 2x base, so a
# 7B full fine-tune read 52 GiB, half of what it needs. Activations are a
# batch-1 heuristic: treat every total as a lower bound.

enum TrainingMethod {
    TRAIN_FULL = 0;
    TRAIN_LORA = 1;
    TRAIN_QLORA_4 = 2;
    TRAIN_QLORA_8 = 3;
    TRAIN_PREFIX = 4;
    TRAIN_DPO = 5;
    TRAIN_RLHF = 6;
    TRAIN_DISTILL = 7;
}

fn training_method_name(m) {
    if (m == TRAIN_FULL) { return "full"; }
    if (m == TRAIN_LORA) { return "lora"; }
    if (m == TRAIN_QLORA_4) { return "qlora-4bit"; }
    if (m == TRAIN_QLORA_8) { return "qlora-8bit"; }
    if (m == TRAIN_PREFIX) { return "prefix"; }
    if (m == TRAIN_DPO) { return "dpo"; }
    if (m == TRAIN_RLHF) { return "rlhf"; }
    if (m == TRAIN_DISTILL) { return "distillation"; }
    return "unknown";
}

# Parse a training method name (the --method CLI arg) to its enum, in any
# letter case ("LoRA", "QLoRA-4bit"). Returns -1 on an unrecognized name so
# callers can fall back.
fn training_method_from_str(s) {
    if (hw_streq_ci(s, "full") == 1) { return TRAIN_FULL; }
    if (hw_streq_ci(s, "lora") == 1) { return TRAIN_LORA; }
    if (hw_streq_ci(s, "qlora-4bit") == 1) { return TRAIN_QLORA_4; }
    if (hw_streq_ci(s, "qlora-8bit") == 1) { return TRAIN_QLORA_8; }
    if (hw_streq_ci(s, "prefix") == 1) { return TRAIN_PREFIX; }
    if (hw_streq_ci(s, "dpo") == 1) { return TRAIN_DPO; }
    if (hw_streq_ci(s, "rlhf") == 1) { return TRAIN_RLHF; }
    if (hw_streq_ci(s, "distillation") == 1) { return TRAIN_DISTILL; }
    return 0 - 1;
}

enum TrainingTarget {
    TARGET_GPU = 0;
    TARGET_TPU = 1;
    TARGET_GAUDI = 2;
    TARGET_CPU = 3;
}

# MemoryEstimate — model + optimizer + activation + computed total
# (all in GiB x1000 fixed-point). Struct name `est` matches the
# `est_*` accessor convention; constructor stays the descriptive
# `mem_est_new`. 2.1.4: hand-rolled accessors replaced with
# #derive(accessors). Param `e` is ambiguous across the codebase
# (system_io.cyr's runtime_env uses the same canonical name), so
# this struct gets the field-count bound CI check rather than the
# cross-file specific-struct guard.

#derive(accessors)
struct est {
    model_x1000;
    optimizer_x1000;
    activation_x1000;
    total_x1000;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var MEM_EST_SIZE = sizeof(est);

fn mem_est_new(model, optimizer, activation) {
    var e = alloc(sizeof(est));
    est_set_model_x1000(e, model);
    est_set_optimizer_x1000(e, optimizer);
    est_set_activation_x1000(e, activation);
    est_set_total_x1000(e, model + optimizer + activation);
    return e;
}

# Estimate training memory for a model
# model_params_millions: e.g., 7000 for 7B
# Returns MemoryEstimate pointer
fn estimate_training_memory(model_params_m, method, target) {
    if (model_params_m <= 0) { return mem_est_new(0, 0, 0); }
    # base_gb = params_M * 1M * 2 bytes / GiB
    # base_gb_x1000 = params_M * 2 * 1000000 / 1073741824 * 1000
    # Simplified: base_gb_x1000 ~= params_M * 1863 / 1000
    var base_x1000 = model_params_m * 1863 / 1000;

    if (target == TARGET_TPU) { return _est_tpu(base_x1000, method); }
    if (target == TARGET_GAUDI) { return _est_gaudi(base_x1000, method); }
    return _est_gpu(base_x1000, method);
}

# DPO and RLHF hold a frozen reference next to the trained policy (2x base
# of weights); distillation a frozen teacher next to a half-size student
# (1.5x base), whose optimizer is 7x its own 0.5x base.
fn _est_gpu(base, method) {
    if (method == TRAIN_FULL) { return mem_est_new(base, base * 7, base); }
    if (method == TRAIN_LORA) { return mem_est_new(base, base / 10, base / 10); }
    if (method == TRAIN_QLORA_4) { return mem_est_new(base / 4, base / 10, base / 40); }
    if (method == TRAIN_QLORA_8) { return mem_est_new(base / 2, base / 10, base / 20); }
    if (method == TRAIN_PREFIX) { return mem_est_new(base, base / 20, base / 20); }
    if (method == TRAIN_DPO) { return mem_est_new(base * 2, base * 7, base * 3 / 2); }
    if (method == TRAIN_RLHF) { return mem_est_new(base * 2, base * 7, base * 3 / 2); }
    if (method == TRAIN_DISTILL) { return mem_est_new(base * 3 / 2, base * 7 / 2, base * 4 / 5); }
    return mem_est_new(base, base * 7, base);
}

# TPU and Gaudi keep the same AdamW optimizer accounting as the GPU; only
# their activation factors differ.
fn _est_tpu(base, method) {
    if (method == TRAIN_FULL) {
        return mem_est_new(base, base * 7, base * 4 / 5);
    }
    if (method == TRAIN_LORA) {
        return mem_est_new(base, base * 15 / 100, base * 12 / 100);
    }
    if (method == TRAIN_QLORA_4) {
        return mem_est_new(base * 2 / 5, base * 15 / 100, base * 12 / 250);
    }
    if (method == TRAIN_QLORA_8) {
        return mem_est_new(base * 3 / 5, base * 15 / 100, base * 12 / 167);
    }
    if (method == TRAIN_PREFIX) {
        return mem_est_new(base, base / 20, base / 20);
    }
    if (method == TRAIN_DPO) {
        return mem_est_new(base * 2, base * 7, base * 6 / 5);
    }
    if (method == TRAIN_RLHF) {
        return mem_est_new(base * 2, base * 7, base * 6 / 5);
    }
    if (method == TRAIN_DISTILL) {
        return mem_est_new(base * 3 / 2, base * 7 / 2, base * 3 / 5);
    }
    return mem_est_new(base, base * 7, base * 4 / 5);
}

fn _est_gaudi(base, method) {
    if (method == TRAIN_FULL) {
        return mem_est_new(base, base * 7, base * 9 / 10);
    }
    if (method == TRAIN_LORA) {
        return mem_est_new(base, base * 12 / 100, base * 12 / 100);
    }
    if (method == TRAIN_QLORA_4) {
        return mem_est_new(base * 35 / 100, base * 12 / 100, base * 12 / 286);
    }
    if (method == TRAIN_QLORA_8) {
        return mem_est_new(base * 55 / 100, base * 12 / 100, base * 12 / 182);
    }
    if (method == TRAIN_PREFIX) { return mem_est_new(base, base / 20, base * 6 / 100); }
    if (method == TRAIN_DPO) { return mem_est_new(base * 2, base * 7, base * 13 / 10); }
    if (method == TRAIN_RLHF) { return mem_est_new(base * 2, base * 7, base * 13 / 10); }
    if (method == TRAIN_DISTILL) { return mem_est_new(base * 3 / 2, base * 7 / 2, base * 7 / 10); }
    return mem_est_new(base, base * 7, base * 9 / 10);
}

# --- cost.cyr ---

# cost.cyr — cloud instance cost recommendation
# Reads data/cloud_pricing.json at runtime.
# Recommends cheapest instance that fits model memory requirements.

# CloudGpuInstance — pricing-driven cloud instance descriptor.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `cloud_inst` matches the existing `cloud_inst_*`
# accessor convention; param `ci` is unambiguous across src/.
# Note the field-name mapping: layout had `gpu_mem_gb` and
# `total_gpu_mem_gb`; we keep those names. `price_x100` is cents
# per hour (x100 fixed-point) to avoid floats.
# Construction goes through `cloud_instances_parse` below; there is no
# public constructor. The string fields are never 0 ("" when the file
# leaves them out).

#derive(accessors)
struct cloud_inst {
    name;
    provider;
    gpu;
    gpu_count;
    gpu_mem_gb;
    total_mem_gb;
    vcpus;
    ram_gb;
    interconnect;
    price_x100;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var CLOUD_INST_SIZE = sizeof(cloud_inst);

# CloudProvider enum
enum CloudProvider {
    CLOUD_AWS = 0;
    CLOUD_GCP = 1;
    CLOUD_AZURE = 2;
}

fn cloud_provider_str(p) {
    if (p == CLOUD_AWS) { return "aws"; }
    if (p == CLOUD_GCP) { return "gcp"; }
    if (p == CLOUD_AZURE) { return "azure"; }
    return "unknown";
}

# InstanceRecommendation — paired instance + computed headroom.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `rec` matches the existing `rec_*` accessor convention;
# constructor stays `inst_rec_new`. Param `rec` unambiguous across src/.

#derive(accessors)
struct rec {
    instance;
    mem_required;
    headroom_x100;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var INST_REC_SIZE = sizeof(rec);

fn inst_rec_new(inst, mem_req) {
    var rec = alloc(sizeof(rec));
    rec_set_instance(rec, inst);
    rec_set_mem_required(rec, mem_req);
    var total_mem = cloud_inst_total_mem_gb(inst) * BYTES_PER_GIB;
    var headroom = 0;
    if (mem_req > 0) {
        headroom = (total_mem - mem_req) * 10000 / mem_req;
    }
    rec_set_headroom_x100(rec, headroom);
    return rec;
}

# --- Flat JSON scanning ---
# data/cloud_pricing.json and data/models.json (model.cyr uses these too)
# are arrays of flat objects, each under a {"instances": [...]} or
# {"models": [...]} wrapper. The scanners skip quoted strings, so a brace or
# a key name inside a value cannot throw them off; they take a key only
# where it is a key (a whole quoted name followed by ':'); and they check
# the value's type, so a null or a missing field leaves the default instead
# of borrowing the next key's name or a later number (2.5.4 did both).

fn _js_ws(c) {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn _js_skip_ws(buf, n, i) {
    while (i < n && _js_ws(load8(buf + i)) == 1) { i = i + 1; }
    return i;
}

# Index of the quote that closes the string whose body starts at `i`, or `n`
# when it is unterminated.
fn _js_string_end(buf, n, i) {
    while (i < n) {
        var c = load8(buf + i);
        if (c == 34) { return i; }
        if (c == 92) { i = i + 1; }
        i = i + 1;
    }
    return n;
}

# Index just past the object that opens at `pos`, or `n` if it never closes.
fn _js_object_end(buf, n, pos) {
    var depth = 0;
    var i = pos;
    while (i < n) {
        var c = load8(buf + i);
        if (c == 34) {
            i = _js_string_end(buf, n, i + 1) + 1;
            continue;
        }
        if (c == 123) { depth = depth + 1; }
        elif (c == 125) {
            depth = depth - 1;
            if (depth == 0) { return i + 1; }
        }
        i = i + 1;
    }
    return n;
}

# Offset of the value of `key` among the top-level keys of the object at
# [buf, buf + n) (or of a whole document), or -1.
fn _js_value_at(buf, n, key) {
    var klen = strlen(key);
    var depth = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c == 34) {
            var ks = i + 1;
            var ke = _js_string_end(buf, n, ks);
            i = _js_skip_ws(buf, n, ke + 1);
            if (i < n && load8(buf + i) == 58) {
                i = _js_skip_ws(buf, n, i + 1);
                if (depth == 1 && ke - ks == klen && memeq(buf + ks, key, klen) == 1) {
                    if (i < n) { return i; }
                    return 0 - 1;
                }
            }
            continue;
        }
        if (c == 123 || c == 91) { depth = depth + 1; }
        elif (c == 125 || c == 93) { depth = depth - 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# Offset just past the '[' of a top-level `"key": [` wrapper, or 0 for a
# document with none (a bare top-level array).
fn _js_array_start(buf, n, key) {
    var vi = _js_value_at(buf, n, key);
    if (vi >= 0 && load8(buf + vi) == 91) { return vi + 1; }
    return 0;
}

# The string value of `key` as a fresh C string, its common escapes decoded
# (a \u escape is kept as written), or 0 when the key is missing, its value
# is not a string, or the string is empty.
fn _js_str(buf, n, key) {
    var vi = _js_value_at(buf, n, key);
    if (vi < 0 || load8(buf + vi) != 34) { return 0; }
    var vs = vi + 1;
    var ve = _js_string_end(buf, n, vs);
    if (ve >= n || ve == vs) { return 0; }
    var out = alloc(ve - vs + 1);
    var o = 0;
    var i = vs;
    while (i < ve) {
        var c = load8(buf + i);
        if (c == 92 && i + 1 < ve) {
            i = i + 1;
            c = load8(buf + i);
            if (c == 110) { c = 10; }
            elif (c == 116) { c = 9; }
            elif (c == 114) { c = 13; }
            elif (c == 98) { c = 8; }
            elif (c == 102) { c = 12; }
            elif (c == 117) {
                store8(out + o, 92);
                o = o + 1;
            }
        }
        store8(out + o, c);
        o = o + 1;
        i = i + 1;
    }
    store8(out + o, 0);
    return out;
}

# The non-negative decimal value of `key` scaled by 10^places ("98.32" at
# 2 -> 9832, "70" at 3 -> 70000; finer fraction digits are dropped), or -1
# when the key is missing, its value is not a number, or it passes 1e15.
fn _js_fixed(buf, n, key, places) {
    var vi = _js_value_at(buf, n, key);
    if (vi < 0) { return 0 - 1; }
    var c = load8(buf + vi);
    if (c < 48 || c > 57) { return 0 - 1; }
    var whole = 0;
    while (vi < n) {
        c = load8(buf + vi);
        if (c < 48 || c > 57) { break; }
        if (whole > 100000000000000) { return 0 - 1; }
        whole = whole * 10 + c - 48;
        vi = vi + 1;
    }
    var frac = 0;
    var fd = 0;
    if (vi < n && load8(buf + vi) == 46) {
        vi = vi + 1;
        while (vi < n) {
            c = load8(buf + vi);
            if (c < 48 || c > 57) { break; }
            if (fd < places) {
                frac = frac * 10 + c - 48;
                fd = fd + 1;
            }
            vi = vi + 1;
        }
    }
    var scale = 1;
    var k = 0;
    while (k < places) {
        scale = scale * 10;
        k = k + 1;
    }
    while (fd < places) {
        frac = frac * 10;
        fd = fd + 1;
    }
    return whole * scale + frac;
}

# --- Pricing table ---

# A row whose total_gpu_memory_gb is past this (about 98 TiB) is a typo, and
# refusing it keeps inst_rec_new's bytes * 10000 headroom product in i64.
enum CloudLimits {
    CLOUD_MAX_TOTAL_GB = 100000;
}

fn _cloud_str(od, ol, key) {
    var v = _js_str(od, ol, key);
    if (v == 0) { return ""; }
    return v;
}

fn _cloud_count(od, ol, key) {
    var v = _js_fixed(od, ol, key, 0);
    if (v < 0) { return 0; }
    return v;
}

# One pricing row from the object at [od, od + ol), or 0 when it has no
# name, no price_per_hour or no usable total_gpu_memory_gb. Missing strings
# are "": through 2.5.4 a row without "gpu" crashed the --cost text output.
fn _cloud_inst_parse(od, ol) {
    var name = _js_str(od, ol, "name");
    var price = _js_fixed(od, ol, "price_per_hour", 2);
    var total = _js_fixed(od, ol, "total_gpu_memory_gb", 0);
    if (name == 0 || price < 0) { return 0; }
    if (total <= 0 || total > CLOUD_MAX_TOTAL_GB) { return 0; }
    var ci = alloc(sizeof(cloud_inst));
    cloud_inst_set_name(ci, name);
    cloud_inst_set_provider(ci, _cloud_str(od, ol, "provider"));
    cloud_inst_set_gpu(ci, _cloud_str(od, ol, "gpu"));
    cloud_inst_set_gpu_count(ci, _cloud_count(od, ol, "gpu_count"));
    cloud_inst_set_gpu_mem_gb(ci, _cloud_count(od, ol, "gpu_memory_gb"));
    cloud_inst_set_total_mem_gb(ci, total);
    cloud_inst_set_vcpus(ci, _cloud_count(od, ol, "vcpus"));
    cloud_inst_set_ram_gb(ci, _cloud_count(od, ol, "ram_gb"));
    cloud_inst_set_interconnect(ci, _cloud_str(od, ol, "interconnect"));
    cloud_inst_set_price_x100(ci, price);
    return ci;
}

# Pricing rows in [buf, buf + n): the shipped {"instances": [...]} wrapper or
# a bare array of objects. Returns a vec of cloud_inst pointers. Through
# 2.5.4 the wrapper was brace-matched as one object and only the first of
# the file's rows came back (load_models had the same defect until 2.3.22).
fn cloud_instances_parse(buf, n) {
    var instances = vec_new();
    var skipped = 0;
    var pos = _js_array_start(buf, n, "instances");
    while (pos < n) {
        var c = load8(buf + pos);
        if (c == 93) { break; }
        if (c != 123) {
            pos = pos + 1;
            continue;
        }
        var obj_end = _js_object_end(buf, n, pos);
        var ci = _cloud_inst_parse(buf + pos, obj_end - pos);
        if (ci != 0) { vec_push(instances, ci); }
        else { skipped = skipped + 1; }
        pos = obj_end;
    }
    if (skipped > 0) {
        hwlog_warn("cloud_pricing.json: skipped rows without name, price_per_hour or total_gpu_memory_gb");
    }
    return instances;
}

# Load cloud pricing from a JSON file at `path`.
# Returns vec of CloudGpuInstance pointers (empty when unreadable).
fn load_cloud_instances_from(path) {
    # One byte short of the buffer, so the NUL below always fits (through
    # 2.5.0 a 32 KiB file put it one byte past), and a warning when the file
    # fills it, as load_models has done since 2.3.22.
    var buf = alloc(32768);
    var n = file_read_all(path, buf, 32767);
    if (n <= 0) { return vec_new(); }
    store8(buf + n, 0);
    if (n >= 32767) {
        hwlog_warn("load_cloud_instances: cloud_pricing.json filled the read buffer — instances may be missing");
    }
    return cloud_instances_parse(buf, n);
}

# Load data/cloud_pricing.json from the data dir (see data_file_path).
fn load_cloud_instances() {
    return load_cloud_instances_from(data_file_path("data/cloud_pricing.json"));
}

# recommend_instances parses the pricing file once per data path, so a
# long-lived caller does not re-read and re-allocate it on every query. A
# caller that replaces the file at run time loads it again itself and uses
# recommend_instances_from.
var _cloud_cache = 0;
var _cloud_cache_path = 0;

fn _cloud_instances_cached() {
    var path = data_file_path("data/cloud_pricing.json");
    if (_cloud_cache != 0 && streq(path, _cloud_cache_path) == 1) { return _cloud_cache; }
    var v = load_cloud_instances_from(path);
    if (vec_len(v) > 0) {
        _cloud_cache = v;
        _cloud_cache_path = path;
    }
    return v;
}

# Recommend instances from `instances` for a model, sorted by price
# (cheapest first, file order on a tie). provider_filter: -1 for any, or a
# CloudProvider value. Empty for model_params <= 0.
fn recommend_instances_from(instances, model_params, quant, provider_filter) {
    var recs = vec_new();
    if (model_params <= 0) { return recs; }
    var needed = reg_estimate_memory(model_params, quant);
    # Whole GB the model needs, rounded up, so the check is exact in bytes:
    # through 2.5.4 it rounded down and a 640.4 GiB need got a 640 GB
    # instance with negative headroom.
    var needed_gb = needed / BYTES_PER_GIB;
    if (needed % BYTES_PER_GIB != 0) { needed_gb = needed_gb + 1; }
    var target = 0;
    if (provider_filter >= 0) { target = cloud_provider_str(provider_filter); }

    var ni = vec_len(instances);
    var i = 0;
    while (i < ni) {
        var inst = vec_get(instances, i);
        i = i + 1;
        if (target != 0) {
            var prov = cloud_inst_provider(inst);
            if (prov == 0 || streq(prov, target) != 1) { continue; }
        }
        if (cloud_inst_total_mem_gb(inst) < needed_gb) { continue; }
        vec_push(recs, inst_rec_new(inst, needed));
    }

    # Insertion sort by price: a short list, and stable.
    var nr = vec_len(recs);
    var si = 1;
    while (si < nr) {
        var cur = vec_get(recs, si);
        var cp = cloud_inst_price_x100(rec_instance(cur));
        var sj = si;
        while (sj > 0 && cloud_inst_price_x100(rec_instance(vec_get(recs, sj - 1))) > cp) {
            vec_set(recs, sj, vec_get(recs, sj - 1));
            sj = sj - 1;
        }
        vec_set(recs, sj, cur);
        si = si + 1;
    }
    return recs;
}

# Recommend instances from data/cloud_pricing.json, as recommend_instances_from.
fn recommend_instances(model_params, quant, provider_filter) {
    return recommend_instances_from(_cloud_instances_cached(), model_params, quant, provider_filter);
}

# Serialize a cost recommendation to JSON (schema v4, 2.3.1).
# Mirrors the --cost text path in main.cyr (_handle_cost): parses the model
# size ("70B", "1.5B", "350M"; model_params_from_str), computes the memory
# requirement, and lists the cheapest matching instances (capped at 5, like
# the text output). An invalid size reports 0 bytes and no instances; the
# CLI rejects it before it gets here.
fn cost_to_json(model_str, quant) {
    var params = model_params_from_str(model_str);
    if (params < 0) { params = 0; }
    var needed = quant_model_bytes_with_overhead(params, quant);

    var sb = str_builder_new();
    str_builder_putc(sb, '{');
    _json_str(sb, "model", model_str, 0);
    _json_str(sb, "quantization", quant_name(quant), 1);
    _json_int(sb, "memory_required_bytes", needed, 1);
    str_builder_add_cstr(sb, ",\"recommendations\":[");

    var recs = recommend_instances(params, quant, 0 - 1);
    var nr = vec_len(recs);
    var limit = nr;
    if (limit > 5) { limit = 5; }
    var ri = 0;
    while (ri < limit) {
        if (ri > 0) { str_builder_putc(sb, ','); }
        var inst = rec_instance(vec_get(recs, ri));
        str_builder_putc(sb, '{');
        _json_str(sb, "instance", cloud_inst_name(inst), 0);
        _json_str(sb, "provider", cloud_inst_provider(inst), 1);
        _json_str(sb, "gpu", cloud_inst_gpu(inst), 1);
        _json_int(sb, "gpu_count", cloud_inst_gpu_count(inst), 1);
        _json_int(sb, "total_memory_gb", cloud_inst_total_mem_gb(inst), 1);
        _json_int(sb, "price_per_hour_usd_x100", cloud_inst_price_x100(inst), 1);
        str_builder_putc(sb, '}');
        ri = ri + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

# --- model.cyr ---

# model.cyr — model compatibility database
# Reads data/models.json at runtime for model profiles.

# ModelProfile — name + family + params_billions (x1000 fixed-point,
# e.g. 70000 = 70B) + default dtype string.
# 2.1.5: hand-rolled accessors replaced with #derive(accessors). Param
# `m` is shared with the `meta` struct in model_format.cyr — both go
# through the field-count bound check in CI rather than the cross-file
# specific-struct guard.

#derive(accessors)
struct model {
    name;
    family;
    params_b_x1000;
    dtype;
}

# sizeof, not a literal (2.5.5); the var stays for consumers.
var MODEL_PROFILE_SIZE = sizeof(model);

# Total parameter count (not billions)
fn model_param_count(m) {
    return model_params_b_x1000(m) * 1000000;
}

# Estimate memory at given quantization (bytes)
fn model_memory_bytes(m, quant) {
    return reg_estimate_memory(model_param_count(m), quant);
}

# Check if model fits in available memory
fn model_can_run(m, quant, avail_bytes) {
    return model_memory_bytes(m, quant) <= avail_bytes;
}

# Load model catalogue from JSON.
#
# 2.3.22 — four defects fixed here at once
# (issue 2026-07-30-load-models-misparses-its-own-data-file):
#
#  1. WRONG PATH. It read a bare cwd-relative "data/models.json" while its
#     sibling loader (`cost.cyr:79`) already went through `data_file_path()`.
#     Invoked from anywhere but the repo root — a pip-installed wheel, say —
#     it read nothing and returned an empty vec.
#  2. THE WRAPPER. The scanner finds the first `{`, brace-matches to its close,
#     and resumes past it. That is correct for a TOP-LEVEL ARRAY of objects,
#     but `data/models.json` ships as `{"models":[ … ]}` — so the first `{`
#     was the WRAPPER, brace-matching ran to the last byte of the document,
#     and the whole file became one "object". `_parse_model_field_str` then
#     matched model one's `"name"`, pushed a single profile, and `pos` was
#     already at EOF. **26 models in the file, 1 returned, no error.** Fixed by
#     starting the scan just past the `[` that follows a `"models"` key when
#     one is present; a top-level array still starts at 0, so BOTH shapes now
#     parse and no shipped artifact had to change.
#  3. OFF-BY-ONE. `alloc(32768)` + `file_read_all(..., 32768)` + `store8(buf +
#     n, 0)` writes the NUL one byte past the allocation on an exactly-full
#     read. Now reads at most `MODELS_BUF - 1`.
#  4. SILENT TRUNCATION. `file_read_all` stops at the cap and reports the
#     count with no error, so a catalogue over the cap quietly loses models —
#     the same failure shape as (2): fewer models, no signal. Now warns.
#
# The function has no callers inside ai-hwaccel, which is why the suite stayed
# green through all four: it is shipped API exercised only downstream (hoosh
# hit (2) and vendors an unwrapped copy to work around it).
#
# 2.5.5 — the scan goes through cost.cyr's string-aware `_js_*` helpers,
# shared with load_cloud_instances (which had kept defect (2) until then).
# A key is matched only as a key, and a null or missing field stays unset
# instead of taking the next key's text. The file is read on every call:
# load it once and keep the vec.
var MODELS_BUF = 32768;

fn load_models() {
    var buf = alloc(MODELS_BUF);
    var n = file_read_all(data_file_path("data/models.json"), buf, MODELS_BUF - 1);
    if (n <= 0) { return vec_new(); }
    store8(buf + n, 0);
    if (n >= MODELS_BUF - 1) {
        hwlog_warn("load_models: models.json filled the read buffer — catalogue may be truncated");
    }
    return models_parse(buf, n);
}

# Model profiles in [buf, buf + n): a `{"models": [...]}` wrapper or a bare
# array of objects. Entries without a name are skipped.
fn models_parse(buf, n) {
    var models = vec_new();
    var pos = _js_array_start(buf, n, "models");
    while (pos < n) {
        var c = load8(buf + pos);
        if (c == 93) { break; }
        if (c != 123) {
            pos = pos + 1;
            continue;
        }
        var obj_end = _js_object_end(buf, n, pos);
        var od = buf + pos;
        var ol = obj_end - pos;
        var name = _js_str(od, ol, "name");
        if (name != 0) {
            var m = alloc(sizeof(model));
            model_set_name(m, name);
            model_set_family(m, _js_str(od, ol, "family"));
            # params_billions as x1000 (70.0 -> 70000)
            var pb = _js_fixed(od, ol, "params_billions", 3);
            if (pb < 0) { pb = 0; }
            model_set_params_b_x1000(m, pb);
            model_set_dtype(m, _js_str(od, ol, "default_dtype"));
            vec_push(models, m);
        }
        pos = obj_end;
    }
    return models;
}

# Find all models that fit in available memory at given quantization
fn compatible_models(models, quant, avail_bytes) {
    var result = vec_new();
    var nm = vec_len(models);
    var i = 0;
    while (i < nm) {
        var m = vec_get(models, i);
        i = i + 1;
        if (model_can_run(m, quant, avail_bytes) == 1) {
            vec_push(result, m);
        }
    }
    return result;
}

# Find a model by name (substring match)
fn find_model(models, name) {
    var nm = vec_len(models);
    var name_str = str_from(name);
    var i = 0;
    while (i < nm) {
        var m = vec_get(models, i);
        i = i + 1;
        var mn = model_name(m);
        if (mn != 0) {
            var mn_str = str_from(mn);
            if (str_contains(mn_str, name_str) == 1) { return m; }
        }
    }
    return 0;
}

# Find models by family (case-sensitive match)
fn models_by_family(models, family) {
    var result = vec_new();
    var nm = vec_len(models);
    var i = 0;
    while (i < nm) {
        var m = vec_get(models, i);
        i = i + 1;
        var mf = model_family(m);
        if (mf != 0) {
            if (streq(mf, family) == 1) {
                vec_push(result, m);
            }
        }
    }
    return result;
}

# Headroom percentage (x100 fixed-point, e.g., 2500 = 25.00%)
# Returns how much spare memory is available after loading the model
fn model_headroom_x100(m, quant, avail_bytes) {
    var needed = model_memory_bytes(m, quant);
    if (avail_bytes == 0) { return 0; }
    if (needed > avail_bytes) { return 0; }
    return (avail_bytes - needed) * 10000 / avail_bytes;
}

# Compatible models with headroom, using registry total accel memory
fn compatible_with_registry(models, r, quant) {
    var avail = reg_total_accel_memory(r);
    return compatible_models(models, quant, avail);
}

# --- model_format.cyr ---

# model_format.cyr — model file format detection
# Parses .safetensors, .gguf, .onnx, .pt file headers to extract
# model metadata without loading the full file.
# Only the first 16 KB are read.

# --- Format enum ---

enum ModelFormat {
    FMT_SAFETENSORS = 1;
    FMT_GGUF = 2;
    FMT_ONNX = 3;
    FMT_PYTORCH = 4;
}

fn format_name(f) {
    if (f == FMT_SAFETENSORS) { return "SafeTensors"; }
    if (f == FMT_GGUF) { return "GGUF"; }
    if (f == FMT_ONNX) { return "ONNX"; }
    if (f == FMT_PYTORCH) { return "PyTorch"; }
    return "Unknown";
}

# --- ModelMetadata struct ---
# Sentinel meaning: 0 = unknown for everything except `format`, which
# always carries one of the FMT_* enum values.
# 2.1.3: hand-rolled load64 accessors replaced with #derive(accessors).
# Constructor `meta_new` stays manual (derive only generates accessors).

#derive(accessors)
struct meta {
    format;
    param_count;
    dtype;
    tensor_count;
    format_version;
}

fn meta_new(fmt, params, dtype, tensors, version) {
    var m = alloc(sizeof(meta));
    meta_set_format(m, fmt);
    meta_set_param_count(m, params);
    meta_set_dtype(m, dtype);
    meta_set_tensor_count(m, tensors);
    meta_set_format_version(m, version);
    return m;
}

# Constants inlined where used to avoid global var limit

# --- Top-level API ---

# Detect format from file path (reads first 16 KB)
# Returns ModelMetadata ptr or 0 on failure. The read buffer is freed before
# returning (the metadata copies what it keeps), so a scan over a model
# cache does not grow the bump heap by 16 KiB a file as it did through 2.5.4.
fn detect_model_format(path) {
    var buf = fl_alloc(16384);
    if (buf == 0) { return 0; }
    var n = file_read_all(path, buf, 16384);
    var m = 0;
    if (n > 0) { m = detect_format_from_bytes(buf, n); }
    fl_free(buf);
    return m;
}

# Detect format from raw bytes (no file I/O)
# Returns ModelMetadata ptr or 0 on failure
fn detect_format_from_bytes(buf, len) {
    var meta = _parse_safetensors(buf, len);
    if (meta != 0) { return meta; }

    meta = _parse_gguf(buf, len);
    if (meta != 0) { return meta; }

    meta = _parse_onnx(buf, len);
    if (meta != 0) { return meta; }

    if (_is_pytorch(buf, len) == 1) {
        return meta_new(FMT_PYTORCH, 0, 0, 0, 0);
    }
    return 0;
}

# --- SafeTensors parser ---
# Format: 8-byte LE header_size, then JSON metadata.
# JSON keys are tensor names with {dtype, shape, data_offsets}.

fn _parse_safetensors(buf, len) {
    if (len < 8) { return 0; }

    # Read header_size as 64-bit LE
    var header_size = load64(buf);
    # Sanity: > 0, < 100 MB
    if (header_size <= 0) { return 0; }
    if (header_size > 104857600) { return 0; }

    # Check JSON starts with '{'
    var json_start = buf + 8;
    var json_avail = len - 8;
    if (json_avail <= 0) { return 0; }

    # Skip whitespace
    var ws_i = 0;
    while (ws_i < json_avail) {
        var c = load8(json_start + ws_i);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        ws_i = ws_i + 1;
    }
    if (ws_i >= json_avail) { return 0; }
    if (load8(json_start + ws_i) != 123) { return 0; }  # '{'

    # If we have the complete header, extract metadata
    if (json_avail >= header_size) {
        return _extract_safetensors_meta(json_start, header_size);
    }

    # Partial header — format identified but no metadata
    return meta_new(FMT_SAFETENSORS, 0, 0, 0, 0);
}

# Extract tensor count, dtype, and param count from SafeTensors JSON.
# A shape or a sum past the i64 makes the count unknown (0), never a
# wrapped or negative one.
fn _extract_safetensors_meta(json, json_len) {
    var total_params = 0;
    var overflow = 0;
    var tensor_count = 0;
    var dtype = 0;
    var pos = 0;

    # Scan for top-level keys (tensor names)
    # Each key maps to {dtype, shape, data_offsets}
    while (pos < json_len) {
        # Find opening quote of a key
        if (load8(json + pos) != 34) { pos = pos + 1; continue; }

        # Read key name
        var key_start = pos + 1;
        var key_end = key_start;
        while (key_end < json_len && load8(json + key_end) != 34) {
            key_end = key_end + 1;
        }
        var key_len = key_end - key_start;
        pos = key_end + 1;

        # Skip __metadata__
        if (key_len == 12) {
            if (memeq(json + key_start, "__metadata__", 12) == 1) {
                # Skip to matching closing brace
                pos = _skip_json_value(json, json_len, pos);
                continue;
            }
        }

        # Find the value object '{'
        while (pos < json_len && load8(json + pos) != 123) {
            pos = pos + 1;
        }
        if (pos >= json_len) { break; }

        # This is a tensor entry
        tensor_count = tensor_count + 1;

        # Find end of tensor object
        var obj_start = pos;
        var obj_end = _skip_json_object(json, json_len, pos);

        # Extract dtype from this tensor (first tensor wins)
        if (dtype == 0) {
            dtype = _find_json_string(json + obj_start,
              obj_end - obj_start, "dtype");
        }

        # Extract shape and multiply dimensions for param count
        var params = _extract_shape_product(json + obj_start,
          obj_end - obj_start);
        if (params < 0 || total_params > HW_I64_MAX - params) { overflow = 1; }
        else { total_params = total_params + params; }

        pos = obj_end;
    }
    if (overflow == 1) { total_params = 0; }

    return meta_new(FMT_SAFETENSORS, total_params,
      dtype, tensor_count, 0);
}

# Skip a JSON value (object, array, string, number, etc.)
fn _skip_json_value(json, json_len, pos) {
    while (pos < json_len && load8(json + pos) != 123) {
        if (load8(json + pos) == 44) { return pos; }  # ','
        if (load8(json + pos) == 125) { return pos; }  # '}'
        pos = pos + 1;
    }
    if (pos < json_len && load8(json + pos) == 123) {
        return _skip_json_object(json, json_len, pos);
    }
    return pos;
}

# Skip a JSON object, returns position after closing '}', at most json_len
# (through 2.5.4 an unterminated string, or one ending in a backslash, gave
# json_len + 1 or + 2, and the dtype and shape scans read past the header).
fn _skip_json_object(json, json_len, pos) {
    if (pos >= json_len) { return pos; }
    if (load8(json + pos) != 123) { return pos; }
    var depth = 1;
    pos = pos + 1;
    while (pos < json_len && depth > 0) {
        var c = load8(json + pos);
        if (c == 123) { depth = depth + 1; }
        if (c == 125) { depth = depth - 1; }
        if (c == 34) {
            # Skip quoted strings (may contain braces)
            pos = pos + 1;
            while (pos < json_len && load8(json + pos) != 34) {
                if (load8(json + pos) == 92) { pos = pos + 1; }
                pos = pos + 1;
            }
        }
        pos = pos + 1;
    }
    if (pos > json_len) { pos = json_len; }
    return pos;
}

fn _mf_ws(c) {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

# Find a JSON string value for a given key within a buffer
# Returns cstr ptr or 0. The key must be followed by ':' and a string: a
# null or a number is no value, rather than the next quoted text in the
# object, and an escaped quote does not end it. The bytes are copied as
# they stand (escapes kept); model_meta_to_json escapes them on output.
fn _find_json_string(buf, len, key) {
    var klen = strlen(key);
    var i = 0;
    while (i < len - klen - 4) {
        if (load8(buf + i) == 34) {
            if (memeq(buf + i + 1, key, klen) == 1) {
                if (load8(buf + i + 1 + klen) == 34) {
                    var vi = i + klen + 2;
                    while (vi < len && _mf_ws(load8(buf + vi)) == 1) { vi = vi + 1; }
                    if (vi >= len || load8(buf + vi) != 58) {
                        i = i + 1;
                        continue;
                    }
                    vi = vi + 1;
                    while (vi < len && _mf_ws(load8(buf + vi)) == 1) { vi = vi + 1; }
                    if (vi >= len || load8(buf + vi) != 34) { return 0; }
                    vi = vi + 1;
                    var vstart = vi;
                    while (vi < len && load8(buf + vi) != 34) {
                        if (load8(buf + vi) == 92) { vi = vi + 1; }
                        vi = vi + 1;
                    }
                    # Unterminated inside the object: no value.
                    if (vi >= len) { return 0; }
                    var vlen = vi - vstart;
                    if (vlen > 0) {
                        var val = alloc(vlen + 1);
                        memcpy(val, buf + vstart, vlen);
                        store8(val + vlen, 0);
                        return val;
                    }
                    return 0;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Extract shape array and compute product of dimensions.
# Returns 0 for a missing shape, 1 for a scalar (shape [], one element:
# 2.5.4 counted it 0), and -1 when a dimension or the product passes the
# i64, so the caller can report the count as unknown.
fn _extract_shape_product(buf, len) {
    # Find "shape" key
    var needle = "shape";
    var nlen = 5;
    var i = 0;
    while (i < len - nlen - 4) {
        if (load8(buf + i) == 34) {
            if (memeq(buf + i + 1, needle, nlen) == 1) {
                if (load8(buf + i + 1 + nlen) == 34) {
                    # Found "shape", find '['
                    var vi = i + nlen + 2;
                    while (vi < len && load8(buf + vi) != 91) {
                        vi = vi + 1;
                    }
                    if (vi >= len) { return 0; }
                    vi = vi + 1;  # skip '['

                    # Parse comma-separated integers; no dimension at all
                    # (a scalar, `[]` with any whitespace) leaves product 1
                    var product = 1;
                    var num = 0;
                    var has_num = 0;
                    while (vi < len) {
                        var c2 = load8(buf + vi);
                        if (c2 >= 48 && c2 <= 57) {
                            # (i64 max - 9) / 10: one more digit would wrap
                            if (num > 922337203685477579) { return 0 - 1; }
                            num = num * 10 + c2 - 48;
                            has_num = 1;
                        } elif (c2 == 44 || c2 == 93) {
                            if (has_num == 1) {
                                # Both under sqrt(i64 max) cannot wrap; divide
                                # only for the rare big operand.
                                if (product > 3037000499 || num > 3037000499) {
                                    if (num != 0 && product > HW_I64_MAX / num) { return 0 - 1; }
                                }
                                product = product * num;
                            }
                            if (c2 == 93) { return product; }
                            num = 0;
                            has_num = 0;
                        }
                        vi = vi + 1;
                    }
                    return product;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# --- GGUF parser ---
# Format: 4-byte magic "GGUF", 4-byte version, 8-byte tensor count,
# 8-byte KV count, then metadata pairs.

fn _parse_gguf(buf, len) {
    if (len < 24) { return 0; }

    # Check magic bytes "GGUF"
    if (load8(buf) != 71) { return 0; }
    if (load8(buf + 1) != 71) { return 0; }
    if (load8(buf + 2) != 85) { return 0; }
    if (load8(buf + 3) != 70) { return 0; }

    # Read version (32-bit LE) — manual LE read
    var version = load8(buf + 4);
    version = version + load8(buf + 5) * 256;
    version = version + load8(buf + 6) * 65536;
    version = version + load8(buf + 7) * 16777216;

    # Read tensor_count (64-bit LE)
    var tensor_count = load64(buf + 8);

    # Try to extract dtype from metadata
    var dtype = _extract_gguf_dtype(buf, len, 24);

    var tc = tensor_count;
    if (tc < 0) { tc = 0; }

    return meta_new(FMT_GGUF, 0, dtype, tc, version);
}

# Scan for "general.file_type" key in GGUF metadata
fn _extract_gguf_dtype(buf, len, offset) {
    var needle = "general.file_type";
    var nlen = 17;

    var i = offset;
    while (i < len - nlen) {
        if (memeq(buf + i, needle, nlen) == 1) {
            # Found key. Value type + value follow.
            var voff = i + nlen;
            if (voff + 8 > len) { return 0; }

            # Value type 4 = UINT32
            var vtype = load8(buf + voff);
            vtype = vtype + load8(buf + voff + 1) * 256;
            vtype = vtype + load8(buf + voff + 2) * 65536;
            vtype = vtype + load8(buf + voff + 3) * 16777216;
            if (vtype != 4) { return 0; }

            var ftype = load8(buf + voff + 4);
            ftype = ftype + load8(buf + voff + 5) * 256;
            ftype = ftype + load8(buf + voff + 6) * 65536;
            ftype = ftype + load8(buf + voff + 7) * 16777216;

            return _gguf_file_type_name(ftype);
        }
        i = i + 1;
    }
    return 0;
}

fn _gguf_file_type_name(ft) {
    if (ft == 0) { return "F32"; }
    if (ft == 1) { return "F16"; }
    if (ft == 2) { return "Q4_0"; }
    if (ft == 3) { return "Q4_1"; }
    if (ft == 7) { return "Q8_0"; }
    if (ft == 8) { return "Q5_0"; }
    if (ft == 9) { return "Q5_1"; }
    if (ft == 10) { return "Q2_K"; }
    if (ft == 11) { return "Q3_K_S"; }
    if (ft == 12) { return "Q3_K_M"; }
    if (ft == 13) { return "Q3_K_L"; }
    if (ft == 14) { return "Q4_K_S"; }
    if (ft == 15) { return "Q4_K_M"; }
    if (ft == 16) { return "Q5_K_S"; }
    if (ft == 17) { return "Q5_K_M"; }
    if (ft == 18) { return "Q6_K"; }
    if (ft == 19) { return "IQ2_XXS"; }
    if (ft == 20) { return "IQ2_XS"; }
    # llama.cpp LLAMA_FTYPE 21-38; 4-6 and 33-35 are retired and stay unknown.
    if (ft == 21) { return "Q2_K_S"; }
    if (ft == 22) { return "IQ3_XS"; }
    if (ft == 23) { return "IQ3_XXS"; }
    if (ft == 24) { return "IQ1_S"; }
    if (ft == 25) { return "IQ4_NL"; }
    if (ft == 26) { return "IQ3_S"; }
    if (ft == 27) { return "IQ3_M"; }
    if (ft == 28) { return "IQ2_S"; }
    if (ft == 29) { return "IQ2_M"; }
    if (ft == 30) { return "IQ4_XS"; }
    if (ft == 31) { return "IQ1_M"; }
    if (ft == 32) { return "BF16"; }
    if (ft == 36) { return "TQ1_0"; }
    if (ft == 37) { return "TQ2_0"; }
    if (ft == 38) { return "MXFP4_MOE"; }
    return "unknown";
}

# --- ONNX parser ---
# ONNX uses Protocol Buffers. Field 1 (ir_version) tag = 0x08.

fn _parse_onnx(buf, len) {
    if (len < 4) { return 0; }
    if (load8(buf) != 8) { return 0; }

    # Parse ir_version as varint. At most 5 bytes: any ir_version 1-20 fits
    # in one, and through 2.5.4 a 10-byte varint shifted a bit into the sign
    # and a negative ir_version passed the range check.
    var ir_ver = 0;
    var consumed = 0;
    var shift = 0;
    var vi = 1;
    while (vi < len) {
        var b = load8(buf + vi);
        ir_ver = ir_ver + ((b & 127) << shift);
        consumed = consumed + 1;
        if ((b & 128) == 0) { break; }
        shift = shift + 7;
        if (shift >= 35) { return 0; }
        vi = vi + 1;
    }
    if (consumed == 0) { return 0; }

    # Sanity: ir_version 1-20
    if (ir_ver < 1 || ir_ver > 20) { return 0; }

    # Validate second protobuf field
    var next_off = 1 + consumed;
    if (next_off >= len) { return 0; }
    var next_tag = load8(buf + next_off);
    var wire_type = next_tag & 7;
    var field_num = next_tag / 8;
    if (wire_type > 2) { return 0; }
    if (field_num == 0) { return 0; }

    return meta_new(FMT_ONNX, 0, 0, 0, ir_ver);
}

# --- PyTorch detector ---
# PyTorch files are ZIP archives: magic PK\x03\x04

fn _is_pytorch(buf, len) {
    if (len < 4) { return 0; }
    if (load8(buf) != 80) { return 0; }      # 'P'
    if (load8(buf + 1) != 75) { return 0; }   # 'K'
    if (load8(buf + 2) != 3) { return 0; }
    if (load8(buf + 3) != 4) { return 0; }
    return 1;
}

# --- JSON output for ModelMetadata ---

fn model_meta_to_json(m) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"format\":\"");
    str_builder_add_cstr(sb, format_name(meta_format(m)));
    str_builder_add_cstr(sb, "\"");

    if (meta_param_count(m) > 0) {
        str_builder_add_cstr(sb, ",\"param_count\":");
        str_builder_add_int(sb, meta_param_count(m));
    }
    if (meta_dtype(m) != 0) {
        # The dtype comes from an untrusted file header: escape it.
        str_builder_add_cstr(sb, ",\"dtype\":");
        str_builder_add_json_cstr(sb, meta_dtype(m));
    }
    if (meta_tensor_count(m) > 0) {
        str_builder_add_cstr(sb, ",\"tensor_count\":");
        str_builder_add_int(sb, meta_tensor_count(m));
    }
    if (meta_format_version(m) > 0) {
        str_builder_add_cstr(sb, ",\"format_version\":");
        str_builder_add_int(sb, meta_format_version(m));
    }
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# --- requirement.cyr ---

# requirement.cyr — workload accelerator requirements
# Used for scheduling integration: "does this profile meet the requirement?"

# Requirement type enum
enum AccelRequirement {
    REQ_NONE = 0;            # CPU is sufficient
    # REQ_GPU: any accel_is_gpu type (CUDA, ROCm, Metal, Vulkan, oneAPI,
    # Windows GPU, AGNOS GPU)
    REQ_GPU = 1;
    REQ_TPU = 2;             # TPU (check min_chips separately)
    REQ_GAUDI = 3;           # Intel Gaudi HPU
    REQ_AWS_NEURON = 4;      # Inferentia or Trainium
    REQ_GPU_OR_TPU = 5;      # Either GPU or TPU
    REQ_ANY_ACCELERATOR = 6; # Any non-CPU accelerator
}

fn requirement_name(r) {
    if (r == REQ_NONE) { return "none"; }
    if (r == REQ_GPU) { return "gpu"; }
    if (r == REQ_TPU) { return "tpu"; }
    if (r == REQ_GAUDI) { return "gaudi"; }
    if (r == REQ_AWS_NEURON) { return "aws-neuron"; }
    if (r == REQ_GPU_OR_TPU) { return "gpu-or-tpu"; }
    if (r == REQ_ANY_ACCELERATOR) { return "any-accelerator"; }
    return "unknown";
}

# Check if a profile satisfies a requirement
# For REQ_TPU, min_chips is checked against profile_tpu_chips
fn requirement_satisfied(req, min_chips, profile) {
    if (profile_available(profile) != 1) { return 0; }
    var at = profile_accel_type(profile);

    if (req == REQ_NONE) { return 1; }

    if (req == REQ_GPU) {
        return accel_is_gpu(at);
    }

    if (req == REQ_TPU) {
        if (at != ACCEL_TPU) { return 0; }
        var chips = profile_tpu_chips(profile);
        return chips >= min_chips;
    }

    if (req == REQ_GAUDI) {
        return at == ACCEL_GAUDI;
    }

    if (req == REQ_AWS_NEURON) {
        return at == ACCEL_NEURON;
    }

    if (req == REQ_GPU_OR_TPU) {
        if (accel_is_gpu(at) == 1) { return 1; }
        return accel_is_tpu(at);
    }

    if (req == REQ_ANY_ACCELERATOR) {
        return at != ACCEL_CPU;
    }

    return 0;
}

# The best profile in `profiles` that satisfies the requirement, or 0: the
# highest profile_rank, then the most memory, then the lowest index, as
# reg_best_available ranks. Through 2.5.4 it was the first match in vector
# order, and registry_detect and registry_detect_threaded push the backends
# in different orders, so with a ROCm iGPU and a CUDA card REQ_GPU gave CUDA
# from one and ROCm from the other.
fn find_satisfying_profile(req, min_chips, profiles) {
    var best = 0;
    var best_rank = 0;
    var best_mem = 0;
    var np = vec_len(profiles);
    var i = 0;
    while (i < np) {
        var p = vec_get(profiles, i);
        i = i + 1;
        if (requirement_satisfied(req, min_chips, p) != 1) { continue; }
        var rank = profile_rank(p);
        var mem = profile_memory_bytes(p);
        if (best != 0) {
            if (rank < best_rank) { continue; }
            if (rank == best_rank && mem <= best_mem) { continue; }
        }
        best = p;
        best_rank = rank;
        best_mem = mem;
    }
    return best;
}

# Count profiles that satisfy requirement
fn count_satisfying(req, min_chips, profiles) {
    var np = vec_len(profiles);
    var count = 0;
    var i = 0;
    while (i < np) {
        var p = vec_get(profiles, i);
        if (requirement_satisfied(req, min_chips, p) == 1) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

# --- async_detect.cyr ---

# async_detect.cyr — threaded concurrent hardware detection
# Runs the backends that can start a vendor tool (nvidia-smi, hl-smi,
# neuron-ls, vulkaninfo, xpu-smi, system_profiler, cerebras_cli, gc-info) on
# threads of their own, and the rest (sysfs reads, OS calls, DXGI) on the
# calling thread, then merges the results into the registry. The tools
# themselves run one at a time (cmd_capture, src/detect/command.cyr, 2.5.5):
# lib/process.cyr's capture state is not thread-safe, so what overlaps is
# everything around them, not the tools.
#
# Usage:
#   var r = registry_detect_threaded();
#
# Requires: lib/thread.cyr, lib/fnptr.cyr

# A detector thread's argument: its own profiles and warnings vecs, merged
# into the registry after the join, and the backend it runs.
#derive(accessors)
struct targ {
    profs;
    warns;
    backend;
}

fn targ_new(backend) {
    var ta = alloc(sizeof(targ));
    targ_set_profs(ta, vec_new());
    targ_set_warns(ta, vec_new());
    targ_set_backend(ta, backend);
    return ta;
}

# Thread entry: one backend into the thread's own vecs, through the same
# dispatch every other entry point uses, with exec allowed.
fn _detect_thread_entry(ta) {
    registry_run_detectors(targ_profs(ta), targ_warns(ta), 1 << targ_backend(ta), 1);
    return 0;
}

# The backends of `builder_mask` that run on a thread of their own: every one
# that can start a vendor tool (backend_may_exec). Through 2.5.4 the list was
# written out three times, and Cerebras and Graphcore ran their tools on the
# calling thread, under a "no subprocess" comment.
fn _threaded_mask(builder_mask) {
    var m = 0;
    var b = 0;
    while (b < AIHW_BACKEND_COUNT) {
        if (backend_may_exec(b) == 1) { m = m | (1 << b); }
        b = b + 1;
    }
    return builder_mask & m;
}

# Merge thread results into main registry vecs
fn _merge_results(main_profs, main_warns, ta) {
    var tp = targ_profs(ta);
    var tw = targ_warns(ta);
    var np = vec_len(tp);
    var nw = vec_len(tw);
    var i = 0;
    while (i < np) {
        vec_push(main_profs, vec_get(tp, i));
        i = i + 1;
    }
    i = 0;
    while (i < nw) {
        vec_push(main_warns, vec_get(tw, i));
        i = i + 1;
    }
    return 0;
}

# Threaded detection: CLI backends run in parallel threads
fn registry_detect_threaded() {
    return registry_detect_threaded_with(builder_all());
}

fn registry_detect_threaded_with(builder_mask) {
    # A mask without an exec backend spawns nothing, as in registry_detect_with
    # (2.5.1), and with no tool to wait for there is nothing to run in parallel.
    if (builder_uses_exec(builder_mask) == 0) {
        return registry_detect_with_opts(builder_mask, 0);
    }
    hwlog_span_enter("detect_threaded");
    var r = hw_registry_new();
    var profs = reg_profiles(r);
    var warns = reg_warnings(r);

    # CPU profile (always)
    var sys_mem = detect_system_memory();
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    reg_add_profile(r, profile_cpu(sys_mem));

    # Load lib/io.cyr's environment cache on this thread before a detector
    # thread can reach which() (2.5.5). _env_load marks the cache loaded,
    # empty, before it reads /proc/self/environ (macOS: before it copies
    # envp), so a getenv on another thread in that window answers 0, PATH
    # reads as unset, and the tool as not found. A library consumer whose
    # first getenv was this call lost its vendor tools, nearly always once
    # the environment passed about 32 KB. Nothing on Windows or AGNOS, where
    # getenv keeps no cache. Issue 2026-10-29-cyrius-env-load-first-getenv-race.
    env_block(0);

    # Spawn a thread per threaded backend, in backend order
    var tmask = _threaded_mask(builder_mask);
    var threads = vec_new();
    var targs = vec_new();
    var bid = 0;
    while (bid < AIHW_BACKEND_COUNT) {
        if (builder_is_enabled(tmask, bid) == 1) {
            var ta = targ_new(bid);
            var t = thread_create(&_detect_thread_entry, ta);
            if (t == 0) {
                # Thread creation failed — run synchronously
                hwlog_warn_n("detect_threaded: thread_create failed, sync fallback for backend ", bid);
                _detect_thread_entry(ta);
            }
            vec_push(threads, t);
            vec_push(targs, ta);
        }
        bid = bid + 1;
    }

    # While they run, every other enabled backend on this thread (on Windows
    # that includes DXGI, and its wmic fallback).
    registry_run_detectors(profs, warns, builder_mask & (~tmask), 1);

    # Join all threads and merge results
    var nt = vec_len(threads);
    var i = 0;
    while (i < nt) {
        var th = vec_get(threads, i);
        if (th != 0) { thread_join(th); }
        _merge_results(profs, warns, vec_get(targs, i));
        i = i + 1;
    }

    # Post-passes: enrich profiles, then system I/O.
    registry_post_passes(r, 1);

    # Main thread, after every join+merge — see warnings_log_parse in
    # src/error.cyr for why the detector threads no longer log directly.
    var nwarn = vec_len(warns);
    warnings_log_parse(warns, 0);
    if (nwarn > 0) { hwlog_info_n("detect_threaded: warnings=", nwarn); }
    hwlog_info_n("detect_threaded: profiles=", vec_len(profs));
    hwlog_span_exit();

    return r;
}

# --- cache.cyr ---

# cache.cyr — detection result caching with configurable TTL
# Avoids redundant hardware detection for apps that poll frequently.
#
# Usage:
#   var c = cached_registry_new(60);  # 60 second TTL
#   var r = cached_get(c);            # first call: detects
#   var r = cached_get(c);            # within TTL: returns cached
#   cached_invalidate(c);             # force re-detect on next get
#
# Memory: the allocator frees nothing, and a caller may still hold the
# registry a re-detection replaces, so every expiry keeps one detection's
# heap: the registry with its strings and vecs, about 40 KB on the dev host
# (2.5.5; 1.28 MB through 2.5.4, most of it a 1 MiB buffer per tool run, see
# run_tool_status). Choose the TTL with that in mind.

# Monotonic clock → whole seconds. Used only for TTL expiry, so second
# resolution is enough and a monotonic-since-boot source is fine.
#
# 2.3.21: this was a bare `syscall(228, 1, &ts); return load64(&ts);` with NO
# target guard, and the Linux assumption baked into it holds on exactly one
# target. cyrius `lib/chrono.cyr` documents the divergence, and this mirrors
# its branches rather than re-deriving them:
#
#   Linux   — 228 fills the timespec at &ts; CLOCK_MONOTONIC is 1.
#   macOS   — arm64 routes 228 to libSystem `_clock_gettime_nsec_np(clock_id)`,
#             which RETURNS the ns count and does NOT touch &ts; and Darwin's
#             CLOCK_MONOTONIC is **6**, not 1. x86-macOS has routed 228 since
#             cyrius 6.5.16, with the same return-value contract (lib/chrono.cyr).
#   Windows — 228 routes to kernel32!GetTickCount64, which RETURNS ms since
#             boot and does NOT touch &ts.
#   AGNOS   — no 228; `sys_uptime_ms()` is the peer.
#
# Unguarded, the two return-value targets returned `load64(&ts)` on a timespec
# nothing had written — an uninitialised stack read, so TTL expiry was
# undefined on both. Issue 2026-09-07-monotonic-secs-unguarded-on-macos-windows.
# A clock that reads 0 or less is "no clock" (see _cache_fresh).
fn _monotonic_secs() {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_uptime_ms() / 1000;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ts[16];
    #ifdef CYRIUS_TARGET_MACOS
    return syscall(228, 6, &ts) / 1000000000;
    #endif
    #ifdef CYRIUS_TARGET_WIN
    return syscall(228, 1, &ts) / 1000;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    syscall(228, 1, &ts);
    return load64(&ts);
    #endif
    #endif
    #endif
}

# CachedRegistry — in-memory cache with TTL + mutex.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `cached` matches the existing `cached_*` accessor
# convention; constructor stays `cached_registry_new`. Param `c`
# is unambiguous across src/.

#derive(accessors)
struct cached {
    registry;
    last_detect_secs;
    ttl_secs;
    mutex;
}

# 1 when registry `reg` (or 0), stored at `last` seconds, is still fresh at
# `now` for a TTL of `ttl` seconds. A clock that reads 0 or less is no clock,
# and then nothing is fresh, so every get detects (2.5.5): through 2.5.4 the
# store time was 0 too, `0 - 0 < ttl` held for any TTL, and the first
# registry was served for ever. Pure.
fn _cache_fresh(reg, last, ttl, now) {
    if (reg == 0) { return 0; }
    if (now <= 0) { return 0; }
    if (now - last < ttl) { return 1; }
    return 0;
}

fn cached_registry_new(ttl_secs) {
    var c = alloc(sizeof(cached));
    cached_set_registry(c, 0);
    cached_set_last_detect_secs(c, 0);
    cached_set_ttl_secs(c, ttl_secs);
    cached_set_mutex(c, mutex_new());
    return c;
}

fn cached_get(c) {
    var mtx = cached_mutex(c);
    mutex_lock(mtx);

    var reg = cached_registry(c);
    if (_cache_fresh(reg, cached_last_detect_secs(c), cached_ttl_secs(c), _monotonic_secs()) == 1) {
        mutex_unlock(mtx);
        hwlog_debug("cache: hit (in-memory)");
        return reg;
    }

    # Miss: detect UNDER the lock (2.5.5). A concurrent miss waits on the
    # mutex and then takes this registry instead of running a detection of its
    # own, and a cached_invalidate waits for this store and then clears it.
    # Through 2.5.4 detection ran unlocked: N threads missing together each
    # ran it, and an invalidate that landed mid-detection was overwritten by a
    # registry detected before it, which was then served for a whole TTL.
    hwlog_debug("cache: miss -> detecting");
    reg = registry_detect();
    cached_set_registry(c, reg);
    cached_set_last_detect_secs(c, _monotonic_secs());
    mutex_unlock(mtx);
    return reg;
}

# Drop the cached registry, so the next cached_get detects. Waits for a
# detection in flight to finish (2.5.5).
fn cached_invalidate(c) {
    var mtx = cached_mutex(c);
    mutex_lock(mtx);
    cached_set_registry(c, 0);
    cached_set_last_detect_secs(c, 0);
    mutex_unlock(mtx);
    return 0;
}

fn cached_ttl(c) {
    return cached_ttl_secs(c);
}

# 1 when cached_get would answer from the cache now. Unlocked: the answer
# is advisory, and the lock would make it wait out a detection in flight.
fn cached_is_valid(c) {
    return _cache_fresh(cached_registry(c), cached_last_detect_secs(c), cached_ttl_secs(c), _monotonic_secs());
}

# --- Disk-backed cache (deprecated, 2.5.1) ---
# Through 2.5.0 disk_cached_get wrote ~/.cache/ai-hwaccel/registry.json after
# every detection, but its read path was never written: a cold start read the
# file, dropped it and detected again. The file was never used, and without HOME the
# write went to /tmp/ai-hwaccel-cache.json and followed symlinks, so another
# local user could aim it at a file the caller can write. The disk_cached_*
# functions keep their signatures and touch no file: they cache in memory with
# a TTL, as cached_registry_new / cached_get / cached_invalidate do, and they
# warn at every call site. They are removed in 2.6.0. A file an earlier release
# wrote is left in place; nothing reads it.

#derive(accessors)
struct disk_cached {
    registry;
    last_detect_secs;
    ttl_secs;
    mutex;
    cache_path;
}

# cache_path is 0: there is no file.
#deprecated("the disk cache never read its file and now caches in memory only; use cached_registry_new")
fn disk_cached_new(ttl_secs) {
    var c = alloc(sizeof(disk_cached));
    disk_cached_set_registry(c, 0);
    disk_cached_set_last_detect_secs(c, 0);
    disk_cached_set_ttl_secs(c, ttl_secs);
    disk_cached_set_mutex(c, mutex_new());
    disk_cached_set_cache_path(c, 0);
    return c;
}

#deprecated("the disk cache never read its file and now caches in memory only; use cached_get")
fn disk_cached_get(c) {
    var mtx = disk_cached_mutex(c);
    mutex_lock(mtx);

    var reg = disk_cached_registry(c);
    if (_cache_fresh(reg, disk_cached_last_detect_secs(c), disk_cached_ttl_secs(c), _monotonic_secs()) == 1) {
        mutex_unlock(mtx);
        hwlog_debug("disk_cache: hit (in-memory)");
        return reg;
    }

    # Detect under the lock, as cached_get does (2.5.5).
    hwlog_debug("disk_cache: miss -> detecting");
    reg = registry_detect();
    disk_cached_set_registry(c, reg);
    disk_cached_set_last_detect_secs(c, _monotonic_secs());
    mutex_unlock(mtx);
    return reg;
}

#deprecated("the disk cache never read its file and now caches in memory only; use cached_invalidate")
fn disk_cached_invalidate(c) {
    var mtx = disk_cached_mutex(c);
    mutex_lock(mtx);
    disk_cached_set_registry(c, 0);
    disk_cached_set_last_detect_secs(c, 0);
    mutex_unlock(mtx);
    return 0;
}

# --- lazy.cyr ---

# lazy.cyr — lazy per-family detection
# Defers backend probing until a specific family is queried.
# Avoids spawning nvidia-smi when only TPU info is needed.
#
# Usage:
#   var lr = lazy_new();
#   var gpus = lazy_by_family(lr, FAMILY_GPU);  # probes GPU backends only
#   var all = lazy_into_registry(lr);           # probe everything

# LazyRegistry — deferred per-family detection.
# 2.1.7: hand-rolled accessors replaced with #derive(accessors).
# Struct name `lazy` matches the existing `lazy_*` accessor
# convention; constructor stays `lazy_new`. The `probed` field is
# an i64 bitmask (bit 0 = CPU probed, 1 = GPU, 2 = NPU, 3 = TPU,
# 4 = AI_ASIC) — getter returns the raw mask, bit-manipulation
# helpers below use `lazy_probed` + `lazy_set_probed` plus a shift.
# `backends` (2.3.26) is a builder mask of the backends already run, so a
# backend whose profiles span two families runs once however the families
# are queried. `warns` (2.5.2; `warnings` through 2.5.4, renamed so that
# lazy_warnings can be the locked copy) holds the probes' diagnostics, which
# lazy_into_registry hands to its registry; read them with lazy_warnings(lr)
# after lazy_by_family.
#
# A lazy registry may be shared between threads: every call below takes its
# mutex, and what it hands out is a copy (2.5.5). The derived lazy_profiles
# and lazy_warns getters are the live vecs, which a probe grows and then
# compacts in place (profiles_dedup); they are for this file. Through 2.5.4
# lazy_probed_profiles and lazy_warnings returned those vecs, so a reader on
# another thread could index past a probe's vec_truncate, and vec_get's
# abort exited its thread. The profiles themselves are shared: a later probe
# may still rename one or set its memory (profiles_dedup), each an 8-byte
# store.

#derive(accessors)
struct lazy {
    profiles;
    probed;
    mutex;
    backends;
    warns;
}

fn lazy_new() {
    var lr = alloc(sizeof(lazy));
    var profs = vec_new();
    # Always include CPU
    var sys_mem = detect_system_memory();
    if (sys_mem == 0) { sys_mem = 16 * BYTES_PER_GIB; }
    vec_push(profs, profile_cpu(sys_mem));
    lazy_set_profiles(lr, profs);
    lazy_set_probed(lr, 1);  # bit 0 = CPU probed
    lazy_set_mutex(lr, mutex_new());
    lazy_set_backends(lr, 0);
    lazy_set_warns(lr, vec_new());
    return lr;
}

# Append every element of vec `src` to vec `dst`.
fn _lazy_append(dst, src) {
    var n = vec_len(src);
    var i = 0;
    while (i < n) {
        vec_push(dst, vec_get(src, i));
        i = i + 1;
    }
    return 0;
}

# Check if family has been probed. A family outside the mask's 64 bits never
# is: an unguarded `1 << 70` wraps the count on x86 and reads bit 6 (2.5.5;
# through 2.5.4 a doubling loop ran `family` times, and overflowed to 0).
fn _lazy_is_probed(lr, family) {
    if (family < 0 || family > 63) { return 0; }
    return (lazy_probed(lr) >> family) & 1;
}

# Mark family as probed (nothing for a family outside the mask).
fn _lazy_mark_probed(lr, family) {
    if (family < 0 || family > 63) { return 0; }
    lazy_set_probed(lr, lazy_probed(lr) | (1 << family));
    return 0;
}

# Build a builder mask of the backends that can emit profiles of `family`.
# A backend sits in the mask of every family its profiles belong to: Apple
# emits the Metal GPU and the Neural Engine, so it is in the GPU and NPU
# masks; _lazy_ensure's `backends` tracking still runs it only once. Through
# 2.3.25 Apple was in the GPU mask only, so a lazy NPU query found the Neural
# Engine only if GPUs had been queried first. Intel oneAPI and Windows (DXGI)
# emit GPU profiles; through 2.3.24 oneAPI sat in the AI_ASIC mask and
# Windows in none, so lazy_by_family(lr, FAMILY_GPU) never probed either.
fn _family_builder_mask(family) {
    var mask = 0;
    if (family == FAMILY_GPU) {
        mask = builder_with(mask, BACKEND_CUDA);
        mask = builder_with(mask, BACKEND_ROCM);
        mask = builder_with(mask, BACKEND_VULKAN);
        mask = builder_with(mask, BACKEND_APPLE);
        mask = builder_with(mask, BACKEND_INTEL_ONEAPI);
        mask = builder_with(mask, BACKEND_WINDOWS);
        return mask;
    }
    if (family == FAMILY_NPU) {
        mask = builder_with(mask, BACKEND_APPLE);
        mask = builder_with(mask, BACKEND_INTEL_NPU);
        mask = builder_with(mask, BACKEND_AMD_XDNA);
        mask = builder_with(mask, BACKEND_SAMSUNG_NPU);
        mask = builder_with(mask, BACKEND_MEDIATEK_APU);
        return mask;
    }
    if (family == FAMILY_TPU) {
        mask = builder_with(mask, BACKEND_TPU);
        return mask;
    }
    if (family == FAMILY_AI_ASIC) {
        mask = builder_with(mask, BACKEND_GAUDI);
        mask = builder_with(mask, BACKEND_NEURON);
        mask = builder_with(mask, BACKEND_QUALCOMM);
        mask = builder_with(mask, BACKEND_CEREBRAS);
        mask = builder_with(mask, BACKEND_GRAPHCORE);
        mask = builder_with(mask, BACKEND_GROQ);
        return mask;
    }
    return mask;
}

# Ensure a family is probed, run detection if not. Only backends that no
# earlier probe has run are detected: one that spans two families (Apple)
# delivered all its profiles the first time, so running it again would
# push them twice.
#
# 2.5.2: a probe runs the family's detectors and the profile passes on what
# they found (dedup, sysfs enrichment), nothing else; the system passes
# (interconnects, storage, environment) wait for lazy_into_registry. Through
# 2.5.1 each probe was a registry_detect_with(mask): it re-read system memory
# for a CPU profile it then dropped, ran every post-pass, `nvidia-smi nvlink
# -s` included, and threw its warnings away. The detectors run with exec
# allowed, as in registry_detect: the family's own backends are all that run,
# and Apple, the one backend in two families, must not run without its
# system_profiler fallback because the NPU family happened to be asked first.
fn _lazy_ensure(lr, family) {
    if (family == FAMILY_CPU) { return 0; }
    if (_lazy_is_probed(lr, family) == 1) { return 0; }
    _lazy_mark_probed(lr, family);

    var mask = _family_builder_mask(family) & (~lazy_backends(lr));
    if (mask == 0) { return 0; }
    lazy_set_backends(lr, lazy_backends(lr) | mask);
    hwlog_span_enter("lazy");
    hwlog_debug_n("lazy: builder_mask=", mask);
    var warns = lazy_warns(lr);
    var w0 = vec_len(warns);
    var found = vec_new();
    registry_run_detectors(found, warns, mask, 1);
    registry_profile_passes(found);
    var main_profs = lazy_profiles(lr);
    _lazy_append(main_profs, found);
    # `found` is already deduplicated; this catches one device seen by two
    # families' probes, such as the Metal GPU from an NPU query (Apple) and
    # its MoltenVK view from a later GPU query (Vulkan).
    profiles_dedup(main_profs);
    warnings_log_parse(warns, w0);
    hwlog_info_n("lazy: profiles=", vec_len(main_profs));
    hwlog_span_exit();
    return 0;
}

# The available profiles of `family` (probed on first access), into the
# caller's vec `out` (emptied first), which is returned: reg_by_family_into's
# filter, under the lock. A reused `out` keeps its buffer, so a long-lived
# consumer that queries per request stops allocating (2.5.5).
fn lazy_by_family_into(lr, family, out) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, family);
    _profiles_by_family_into(lazy_profiles(lr), family, out);
    mutex_unlock(mtx);
    return out;
}

# Query profiles by family (probes on first access), in a new vec. Allocates
# a vec per call; repeat queries use lazy_by_family_into.
fn lazy_by_family(lr, family) {
    return lazy_by_family_into(lr, family, vec_new());
}

# How many available profiles of `family` there are (probed on first
# access), allocating nothing once probed.
fn lazy_count_by_family(lr, family) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, family);
    var count = _profiles_count_by_family(lazy_profiles(lr), family);
    mutex_unlock(mtx);
    return count;
}

# All profiles detected so far (no new detection): a copy, taken under the
# lock.
fn lazy_probed_profiles(lr) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    var out = vec_new();
    _lazy_append(out, lazy_profiles(lr));
    mutex_unlock(mtx);
    return out;
}

# The probes' warnings so far: a copy, taken under the lock.
fn lazy_warnings(lr) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    var out = vec_new();
    _lazy_append(out, lazy_warns(lr));
    mutex_unlock(mtx);
    return out;
}

# Probe all families and return a full registry: the probes' profiles and
# warnings, and the system passes, run here once (2.5.2). Through 2.5.1 the
# registry had no detector warnings, and every post-pass ran twice.
fn lazy_into_registry(lr) {
    var mtx = lazy_mutex(lr);
    mutex_lock(mtx);
    _lazy_ensure(lr, FAMILY_GPU);
    _lazy_ensure(lr, FAMILY_NPU);
    _lazy_ensure(lr, FAMILY_TPU);
    _lazy_ensure(lr, FAMILY_AI_ASIC);
    var r = hw_registry_new();
    _lazy_append(reg_profiles(r), lazy_profiles(lr));
    _lazy_append(reg_warnings(r), lazy_warns(lr));
    mutex_unlock(mtx);

    registry_system_passes(r, 1);
    return r;
}

# --- json_out.cyr ---

# json_out.cyr — JSON serialization for registry output
# Manual JSON building via str_builder (no serde)
#
# Structural punctuation (`{`, `}`, `[`, `]`, `,`, `"`, `:`) is emitted
# with str_builder_putc — a single store8, no strlen + memcpy round-trip
# that str_builder_add_cstr pays per call. Variable-length pieces (keys,
# values, multi-byte literals like "true") stay on add_cstr. 2.3.0
# hot-path optimization; see benches/registry.bcyr json_serialize_13dev.

# --- String values ---
#
# A string value from outside the program (tool output, sysfs and DMI text,
# a data file, the caller's model string, a profile read back from JSON) is
# written JSON-escaped (2.5.5). Through 2.5.4 it was copied raw: one '"', '\'
# or control byte made the whole document invalid, and a crafted device name
# could add keys after memory_bytes, which a last-key-wins reader (Python)
# then believed. The program's own names (accel_name, family_name and the
# other enum tables) go through _json_lit, unscanned.

# Length of cstr `s` when no byte of it needs a JSON escape, else -1. A byte
# needs one when it is '"', '\' or below 0x20. Word at a time, as strlen is:
# each aligned word is tested at once for a byte below 0x20 (the NUL among
# them), a '"' and a '\', and only a flagged word is walked byte by byte.
fn _json_clean_len(s) {
    var n = 0;
    while (((s + n) & 7) != 0) {
        var c = load8(s + n);
        if (c == 0) { return n; }
        if (c < 32 || c == 34 || c == 92) { return 0 - 1; }
        n = n + 1;
    }
    var ones = 0x0101010101010101;
    var highs = 0x8080808080808080;
    var done = 0;
    while (done == 0) {
        var v = load64(s + n);
        var q = v ^ 0x2222222222222222;
        var b = v ^ 0x5C5C5C5C5C5C5C5C;
        var t = ((v - 0x2020202020202020) & (v ^ 0xFFFFFFFFFFFFFFFF));
        t = t | ((q - ones) & (q ^ 0xFFFFFFFFFFFFFFFF));
        t = t | ((b - ones) & (b ^ 0xFFFFFFFFFFFFFFFF));
        if ((t & highs) != 0) {
            var i = 0;
            while (i < 8) {
                var c2 = load8(s + n + i);
                if (c2 == 0) { return n + i; }
                if (c2 < 32 || c2 == 34 || c2 == 92) { return 0 - 1; }
                i = i + 1;
            }
        }
        n = n + 8;
    }
    return n;
}

# Write cstr `val` as a quoted JSON string, "" for 0. A value with nothing
# to escape, the usual one, is copied as is with the length the scan found;
# any other goes through the stdlib's RFC 8259 escaper.
fn _json_str_val(sb, val) {
    if (val == 0) {
        str_builder_putc(sb, '"');
        str_builder_putc(sb, '"');
        return 0;
    }
    var n = _json_clean_len(val);
    # str_builder_add_json_cstr writes both quotes itself.
    if (n < 0) { return str_builder_add_json_cstr(sb, val); }
    str_builder_putc(sb, '"');
    # A Str cell on the stack, passed by address, as str_builder_add_json_cstr
    # does: no strlen a second time, no allocation.
    var t[16];
    store64(&t, val);
    store64(&t + 8, n);
    str_builder_add(sb, &t);
    str_builder_putc(sb, '"');
    return 0;
}

# Write a JSON string field: "key": "value", the value escaped.
fn _json_str(sb, key, val, comma) {
    if (comma == 1) { str_builder_putc(sb, ','); }
    str_builder_putc(sb, '"');
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, '"');
    str_builder_putc(sb, ':');
    _json_str_val(sb, val);
    return 0;
}

# Write a string field whose value is one of the program's own literals
# (accel_name, family_name, ick_name, ...): copied unscanned. Never for a
# value that came from outside the program.
fn _json_lit(sb, key, val, comma) {
    if (comma == 1) { str_builder_putc(sb, ','); }
    str_builder_putc(sb, '"');
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, '"');
    str_builder_putc(sb, ':');
    str_builder_putc(sb, '"');
    str_builder_add_cstr(sb, val);
    str_builder_putc(sb, '"');
    return 0;
}

# Write a JSON integer field: "key": value
fn _json_int(sb, key, val, comma) {
    if (comma == 1) { str_builder_putc(sb, ','); }
    str_builder_putc(sb, '"');
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, '"');
    str_builder_putc(sb, ':');
    str_builder_add_int(sb, val);
    return 0;
}

# Write a JSON bool field: "key": true/false
fn _json_bool(sb, key, val, comma) {
    if (comma == 1) { str_builder_putc(sb, ','); }
    str_builder_putc(sb, '"');
    str_builder_add_cstr(sb, key);
    str_builder_putc(sb, '"');
    str_builder_putc(sb, ':');
    if (val == 1) { str_builder_add_cstr(sb, "true"); }
    else { str_builder_add_cstr(sb, "false"); }
    return 0;
}

# Write an optional int field (skip if PROFILE_NONE)
fn _json_opt_int(sb, key, val) {
    if (val == PROFILE_NONE) { return 0; }
    _json_int(sb, key, val, 1);
    return 0;
}

# Write an optional string field (skip if 0)
fn _json_opt_str(sb, key, val) {
    if (val == 0) { return 0; }
    _json_str(sb, key, val, 1);
    return 0;
}

# Write an optional int field, skipping the "not applicable" 0 sentinel
# (tpu_chips / neuron_cores use 0, not PROFILE_NONE, for n/a).
fn _json_opt_int_nz(sb, key, val) {
    if (val == 0) { return 0; }
    _json_int(sb, key, val, 1);
    return 0;
}

# Serialize a profile to JSON.
#
# Every serialized field round-trips: `profile_from_json` restores each one.
# Two fields are not serialized and come back 0: pci_id and pci_bdf, the
# internal keys profiles_dedup and the sysfs passes use (profile.cyr), so a
# profile read back is not matched by profiles_dedup. A system-memory type
# whose shared_memory_bytes is 0 emits no key and is read back all-shared,
# profile_new's default; no detector builds one. `accelerator` (display
# name) and `family` (derived) are kept for human/binding consumers but
# ignored on parse; `accel_type_id` (raw AcceleratorType enum) is the
# authoritative type tag on the way back.
# Accelerator-specific and perf fields are emitted only when set, so CPU/GPU
# output is unchanged from the pre-2.3.15 shape apart from the new
# `accel_type_id` key. `shared_memory_bytes` (schema v6, 2.3.28) appears on an
# accelerator whose memory is partly or wholly system RAM; the CPU's is all of
# its memory, which the reader restores without the key.
fn profile_to_json(sb, p) {
    str_builder_putc(sb, '{');
    _json_lit(sb, "accelerator", accel_name(profile_accel_type(p)), 0);
    _json_int(sb, "accel_type_id", profile_accel_type(p), 1);
    _json_int(sb, "device_id", profile_device_id(p), 1);
    _json_bool(sb, "available", profile_available(p), 1);
    _json_int(sb, "memory_bytes", profile_memory_bytes(p), 1);
    _json_lit(sb, "family", family_name(profile_family(p)), 1);
    _json_opt_str(sb, "compute_capability", profile_compute_cap(p));
    _json_opt_str(sb, "driver_version", profile_driver_version(p));
    _json_opt_str(sb, "device_name", profile_device_name(p));
    _json_opt_int(sb, "memory_used_bytes", profile_mem_used(p));
    _json_opt_int(sb, "memory_free_bytes", profile_mem_free(p));
    _json_opt_int(sb, "numa_node", profile_numa_node(p));
    _json_opt_int(sb, "temperature_c", profile_temp_c(p));
    _json_opt_int(sb, "gpu_utilization_percent", profile_gpu_util(p));
    # Perf + accelerator-specific fields — previously dropped, so a TPU/Gaudi/
    # Neuron profile could not round-trip. Emitted only when meaningful.
    _json_opt_int(sb, "mem_bandwidth_x1000", profile_mem_bw_x1000(p));
    _json_opt_int(sb, "pcie_bandwidth_x1000", profile_pcie_bw_x1000(p));
    _json_opt_int(sb, "power_x1000", profile_power_x1000(p));
    _json_opt_int(sb, "tpu_version", profile_tpu_version(p));
    _json_opt_int_nz(sb, "tpu_chips", profile_tpu_chips(p));
    _json_opt_int(sb, "gaudi_gen", profile_gaudi_gen(p));
    _json_opt_int(sb, "neuron_chip", profile_neuron_chip(p));
    _json_opt_int_nz(sb, "neuron_cores", profile_neuron_cores(p));
    if (profile_shared_mem(p) > 0 && profile_accel_type(p) != ACCEL_CPU) {
        _json_opt_int_nz(sb, "shared_memory_bytes", profile_shared_bytes(p));
    }
    str_builder_putc(sb, '}');
    return 0;
}

# --- Profile deserialization (2.3.15) ---
#
# Inverse of profile_to_json, over the bayan JSON DOM. Added so consumers
# (e.g. samay's NodeCapacity.accel_profiles) can round-trip a profile
# through JSON — previously there was no from_json at all, and the emit was
# lossy for TPU/Gaudi/Neuron. Absent keys fall back to profile_new's
# defaults, so old-shape JSON (pre-accel_type_id) still parses, defaulting
# the type to CPU.
#
# The document is untrusted input (threat-model.md), so since 2.5.5:
#   - a key holding another type than the schema's (null, a string, a float,
#     an int where a bool belongs) reads as absent. Through 2.5.4 it read as
#     0, a plausible value: "temperature_c":null was 0 °C, "available":1 an
#     unavailable device, a null shared_memory_bytes no shared memory;
#   - a value no producer can mean refuses the profile, as malformed JSON
#     does: a negative accel_type_id, a device_id outside 0..1024, memory
#     past PJ_MAX_*_MEMORY, shared memory past memory_bytes, and
#     tpu_chips or neuron_cores outside 0..1024 (planning loops once per
#     chip). An accel_type_id this build does not know is kept: a newer
#     producer's device stays an accelerator of an unknown kind.

# The bounds profile_from_json applies: CMD_MAX_DEVICE_ID and
# validate_memory_mb's 16 TiB, the ones the tool parsers apply (command.cyr,
# which some of this module's units do not include). The CPU profile is the
# host's RAM, which /proc/meminfo reports past 16 TiB on the largest hosts,
# so it gets 1 PiB.
var PJ_MAX_DEVICE_ID = 1024;
var PJ_MAX_DEVICE_MEMORY = 17592186044416;
var PJ_MAX_HOST_MEMORY = 1125899906842624;

# Read an int field from a bayan object value, or `dflt` if the key is
# absent or does not hold an integer (a float too: the schema has none, and
# bayan would saturate 1e30 to INT64_MAX).
fn _pj_int(v, key, dflt) {
    var el = bayan_json_v_obj_get_by_cstr(v, key);
    if (bayan_json_v_is_int(el) == 0) { return dflt; }
    return bayan_json_v_int(el);
}

# Read a bool field (0/1), or `dflt` if absent or not a bool.
fn _pj_bool(v, key, dflt) {
    var el = bayan_json_v_obj_get_by_cstr(v, key);
    if (bayan_json_v_is_bool(el) == 0) { return dflt; }
    return bayan_json_v_bool(el);
}

# Read a string field as a fresh NUL-terminated cstr (profiles store cstr),
# or 0 (the null-cstr sentinel) if the key is absent or not a string.
fn _pj_cstr(v, key) {
    var el = bayan_json_v_obj_get_by_cstr(v, key);
    if (el == 0) { return 0; }
    if (bayan_json_v_is_str(el) == 0) { return 0; }
    var s = bayan_json_v_str(el);
    var n = str_len(s);
    var out = alloc(n + 1);
    memcpy(out, str_data(s), n);
    store8(out + n, 0);
    return out;
}

# 1 if `n` lies in 0..hi. Pure.
fn _pj_in(n, hi) {
    if (n < 0 || n > hi) { return 0; }
    return 1;
}

# Reconstruct a profile from a bayan JSON object value (json_v*). Returns a
# fresh profile pointer, or 0 if `v` is not a JSON object or holds a value
# out of range (above). Rebuilds the raw stored state directly (not via the
# profile_cuda/tpu/... convenience constructors), so memory_bytes and every
# accelerator-specific field come straight from the document rather than
# being recomputed.
fn profile_from_json(v) {
    if (v == 0) { return 0; }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var atype = _pj_int(v, "accel_type_id", ACCEL_CPU);
    var dev_id = _pj_int(v, "device_id", 0);
    var mem = _pj_int(v, "memory_bytes", 0);
    var m_used = _pj_int(v, "memory_used_bytes", PROFILE_NONE);
    var m_free = _pj_int(v, "memory_free_bytes", PROFILE_NONE);
    var chips = _pj_int(v, "tpu_chips", 0);
    var cores = _pj_int(v, "neuron_cores", 0);
    var m_shared = _pj_int(v, "shared_memory_bytes", 0);
    var mem_max = PJ_MAX_DEVICE_MEMORY;
    # The CPU's shared memory is all of its memory: the emit never writes the
    # key for it, so one here is ignored, as 0 (the emit's "no key") is.
    if (atype == ACCEL_CPU) {
        mem_max = PJ_MAX_HOST_MEMORY;
        m_shared = 0;
    }
    if (atype < 0) { return 0; }
    if (_pj_in(dev_id, PJ_MAX_DEVICE_ID) == 0) { return 0; }
    if (_pj_in(mem, mem_max) == 0) { return 0; }
    if (m_used != PROFILE_NONE && _pj_in(m_used, mem_max) == 0) { return 0; }
    if (m_free != PROFILE_NONE && _pj_in(m_free, mem_max) == 0) { return 0; }
    if (m_shared != 0 && _pj_in(m_shared, mem) == 0) { return 0; }
    if (_pj_in(chips, PJ_MAX_DEVICE_ID) == 0) { return 0; }
    if (_pj_in(cores, PJ_MAX_DEVICE_ID) == 0) { return 0; }
    var p = profile_new(atype, dev_id, mem);
    profile_set_available(p, _pj_bool(v, "available", 1));
    profile_set_compute_cap(p, _pj_cstr(v, "compute_capability"));
    profile_set_driver_version(p, _pj_cstr(v, "driver_version"));
    profile_set_device_name(p, _pj_cstr(v, "device_name"));
    profile_set_mem_used(p, m_used);
    profile_set_mem_free(p, m_free);
    profile_set_numa_node(p, _pj_int(v, "numa_node", PROFILE_NONE));
    profile_set_temp_c(p, _pj_int(v, "temperature_c", PROFILE_NONE));
    profile_set_gpu_util(p, _pj_int(v, "gpu_utilization_percent", PROFILE_NONE));
    profile_set_mem_bw_x1000(p, _pj_int(v, "mem_bandwidth_x1000", PROFILE_NONE));
    profile_set_pcie_bw_x1000(p, _pj_int(v, "pcie_bandwidth_x1000", PROFILE_NONE));
    profile_set_power_x1000(p, _pj_int(v, "power_x1000", PROFILE_NONE));
    profile_set_tpu_version(p, _pj_int(v, "tpu_version", PROFILE_NONE));
    profile_set_tpu_chips(p, chips);
    profile_set_gaudi_gen(p, _pj_int(v, "gaudi_gen", PROFILE_NONE));
    profile_set_neuron_chip(p, _pj_int(v, "neuron_chip", PROFILE_NONE));
    profile_set_neuron_cores(p, cores);
    # No key: keep what profile_new derived from the type and memory.
    if (m_shared != 0) { profile_set_shared_mem(p, m_shared); }
    return p;
}

# Convenience: parse a JSON cstr and reconstruct a profile in one step.
# Returns 0 on malformed JSON, a non-object root, a profile_from_json
# refusal, or a 0 `js_cstr` (2.5.5: strlen(0) faulted). Uses the explicit
# buf+len parse entry (bayan_json_v_parse_buf) directly on the cstr.
#
# 2.3.16: was `json_v_parse_str`, which bayan 1.3.0 (cyrius 6.5.0) removed.
# `X_str` is a RESERVED OVERLOAD SLOT in Cyrius — a call `X(a, …)` routes to
# `X_str` whenever `a` is Str-typed at the call site — so a `(ptr, len)` form
# may never occupy that name. Do not rename it back.
#
# 2.3.19: the whole json_v_* family here moved from bayan's LEGACY back-compat
# aliases to the canonical `bayan_json_v_*` names. The aliases are documented as
# legacy (cyrius docs/stdlib-modules.md, the v6.1.25 carve) and — critically —
# they exist ONLY in the monolithic `dist/bayan.cyr`. bayan's focused sublib
# `dist/bayan-json.cyr` exports the canonical names only, so calling the aliases
# was what forced every consumer of this bundle to link the full 641 KB bayan
# instead of the 100 KB json sublib.
fn profile_from_json_str(js_cstr) {
    if (js_cstr == 0) { return 0; }
    var v = bayan_json_v_parse_buf(js_cstr, strlen(js_cstr));
    if (v == 0) { return 0; }
    return profile_from_json(v);
}

# profile_from_json_str with the parse tree on allocator `scratch` (2.5.5).
# The DOM is several times the size of the profile and garbage once the
# fields are copied; on the default heap, which never frees, a long-lived
# consumer decoding profiles grows by it on every call. The returned profile
# and its strings are on the default heap and never point into `scratch`,
# so the caller may reset_via(scratch) as soon as this returns.
fn profile_from_json_str_a(scratch, js_cstr) {
    if (js_cstr == 0) { return 0; }
    var v = bayan_json_v_parse_buf_a(scratch, js_cstr, strlen(js_cstr));
    if (v == 0) { return 0; }
    return profile_from_json(v);
}

# Serialize full registry to JSON
fn registry_to_json(r) {
    var sb = str_builder_new();
    str_builder_putc(sb, '{');
    _json_int(sb, "schema_version", reg_schema(r), 0);

    # Profiles array
    str_builder_add_cstr(sb, ",\"profiles\":[");
    var profs = reg_profiles(r);
    var np = vec_len(profs);
    var i = 0;
    while (i < np) {
        if (i > 0) { str_builder_putc(sb, ','); }
        profile_to_json(sb, vec_get(profs, i));
        i = i + 1;
    }
    str_builder_putc(sb, ']');

    # Warnings array
    var warns = reg_warnings(r);
    var nw = vec_len(warns);
    if (nw > 0) {
        str_builder_add_cstr(sb, ",\"warnings\":[");
        i = 0;
        while (i < nw) {
            if (i > 0) { str_builder_putc(sb, ','); }
            _json_str_val(sb, warning_tool(vec_get(warns, i)));
            i = i + 1;
        }
        str_builder_putc(sb, ']');
    }

    # System I/O topology (interconnects, storage, runtime env). Added
    # in schema v4 (2.3.1) so language bindings see the full surface.
    str_builder_add_cstr(sb, ",\"system_io\":");
    system_io_to_json(sb, reg_system_io(r));

    str_builder_putc(sb, '}');
    return str_builder_build(sb);
}

# Summary JSON (compact overview)
fn registry_to_summary_json(r) {
    var sb = str_builder_new();
    str_builder_putc(sb, '{');
    _json_int(sb, "device_count", reg_num_profiles(r), 0);
    _json_bool(sb, "has_accelerator", reg_has_accelerator(r), 1);
    _json_int(sb, "total_memory_bytes", reg_total_memory(r), 1);
    _json_int(sb, "accelerator_memory_bytes", reg_total_accel_memory(r), 1);
    _json_int(sb, "gpu_count", reg_count_by_family(r, FAMILY_GPU), 1);
    _json_int(sb, "tpu_count", reg_count_by_family(r, FAMILY_TPU), 1);
    _json_int(sb, "npu_count", reg_count_by_family(r, FAMILY_NPU), 1);
    _json_int(sb, "warnings", reg_num_warnings(r), 1);
    str_builder_putc(sb, '}');
    return str_builder_build(sb);
}

# --- System I/O topology (schema v4, 2.3.1) ---
#
# Bandwidth is exposed uniformly as bytes/sec. Internally interconnects
# store GB/s x1000 and storage stores MB/s; both convert to bytes/sec
# via x1_000_000 (GB/s x1000 -> /1000 *1e9 = x1e6; MB/s -> *1e6).

fn _ic_to_json(sb, ic) {
    str_builder_putc(sb, '{');
    _json_lit(sb, "kind", ick_name(ic_kind(ic)), 0);
    _json_str(sb, "name", ic_name(ic), 1);
    _json_int(sb, "bandwidth_bytes_per_sec", ic_bw_x1000(ic) * 1000000, 1);
    _json_int(sb, "state", ic_state(ic), 1);
    str_builder_putc(sb, '}');
    return 0;
}

fn _storage_to_json(sb, sd) {
    str_builder_putc(sb, '{');
    _json_str(sb, "name", storage_name(sd), 0);
    _json_lit(sb, "kind", stk_name(storage_kind(sd)), 1);
    _json_int(sb, "bandwidth_bytes_per_sec", storage_bw_x1000(sd) * 1000000, 1);
    str_builder_putc(sb, '}');
    return 0;
}

fn _env_to_json(sb, env) {
    if (env == 0) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    str_builder_putc(sb, '{');
    _json_bool(sb, "is_docker", env_is_docker(env), 0);
    _json_bool(sb, "is_k8s", env_is_k8s(env), 1);
    _json_opt_str(sb, "k8s_namespace", env_k8s_namespace(env));
    _json_opt_str(sb, "cloud_provider", env_cloud_provider(env));
    _json_opt_str(sb, "instance_type", env_instance_type(env));
    _json_opt_str(sb, "region", env_region(env));
    _json_opt_int(sb, "k8s_gpu_count", env_k8s_gpu_count(env));
    _json_opt_str(sb, "k8s_gpu_source", env_k8s_gpu_source(env));
    str_builder_putc(sb, '}');
    return 0;
}

fn system_io_to_json(sb, sio) {
    if (sio == 0) {
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    str_builder_add_cstr(sb, "{\"interconnects\":[");
    var ics = sio_interconnects(sio);
    var ni = vec_len(ics);
    var i = 0;
    while (i < ni) {
        if (i > 0) { str_builder_putc(sb, ','); }
        _ic_to_json(sb, vec_get(ics, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"storage\":[");
    var sds = sio_storage(sio);
    var ns = vec_len(sds);
    i = 0;
    while (i < ns) {
        if (i > 0) { str_builder_putc(sb, ','); }
        _storage_to_json(sb, vec_get(sds, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"environment\":");
    _env_to_json(sb, sio_environment(sio));
    str_builder_putc(sb, '}');
    return 0;
}

# --- Sharding plan (schema v4, 2.3.1) ---

fn _shard_to_json(sb, ms) {
    str_builder_putc(sb, '{');
    _json_int(sb, "id", shard_id(ms), 0);
    _json_int(sb, "layer_start", shard_layer_start(ms), 1);
    _json_int(sb, "layer_end", shard_layer_end(ms), 1);
    _json_lit(sb, "device", accel_name(shard_device_type(ms)), 1);
    _json_int(sb, "device_id", shard_device_id(ms), 1);
    _json_int(sb, "memory_bytes", shard_memory_bytes(ms), 1);
    str_builder_putc(sb, '}');
    return 0;
}

fn plan_to_json(sb, sp) {
    str_builder_putc(sb, '{');
    _json_lit(sb, "strategy", shard_strategy_name(plan_strategy(sp)), 0);
    _json_int(sb, "strategy_count", plan_strategy_count(sp), 1);
    _json_int(sb, "total_memory_bytes", plan_total_memory(sp), 1);
    _json_bool(sb, "fits", plan_fits(sp), 1);
    _json_opt_int(sb, "est_tokens_per_sec_x1000", plan_est_tps_x1000(sp));
    str_builder_add_cstr(sb, ",\"shards\":[");
    var shards = plan_shards(sp);
    var n = vec_len(shards);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_putc(sb, ','); }
        _shard_to_json(sb, vec_get(shards, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    return 0;
}

# --- Training memory estimate (schema v4, 2.3.1) ---
#
# Internal values are GiB x1000 fixed-point. Emit both the byte count
# (val_x1000 * BYTES_PER_GIB / 1000) for ergonomics and the raw
# fixed-point for losslessness. The bytes are worked out in whole and
# thousandth GiB, the same value without the product that wrapped the i64
# past about 8.6e9 (a 1000T --train ran into it).

fn _est_field(sb, key_bytes, key_gib, val_x1000, comma) {
    var bytes = val_x1000 / 1000 * BYTES_PER_GIB + val_x1000 % 1000 * BYTES_PER_GIB / 1000;
    _json_int(sb, key_bytes, bytes, comma);
    _json_int(sb, key_gib, val_x1000, 1);
    return 0;
}

fn training_to_json(sb, e) {
    str_builder_putc(sb, '{');
    _est_field(sb, "model_bytes", "model_gib_x1000", est_model_x1000(e), 0);
    _est_field(sb, "optimizer_bytes", "optimizer_gib_x1000", est_optimizer_x1000(e), 1);
    _est_field(sb, "activation_bytes", "activation_gib_x1000", est_activation_x1000(e), 1);
    _est_field(sb, "total_bytes", "total_gib_x1000", est_total_x1000(e), 1);
    str_builder_putc(sb, '}');
    return 0;
}
